{"firstHeader":"class","last_chapter_rule":"","pageList":[],"title":"蜜语翻译器","author":"jufb.cn","version":1,"type":"other","url":"hiker://empty","col_type":"text_3","class_name":"","class_url":"","area_name":"","area_url":"","sort_name":"","year_name":"","sort_url":"","year_url":"","find_rule":"js:\nvar API = 'https://www.jufb.cn/tool/14/ajax.php';\n\nvar dialects = [{\n        n: '🐶 动物',\n        v: 'dw'\n    }, {\n        n: '🍑 水果',\n        v: 'sg'\n    }, {\n        n: '😀 表情',\n        v: 'bq'\n    },\n    {\n        n: '✌️ 手势',\n        v: 'ss'\n    }, {\n        n: '🐱 猫语',\n        v: 'my'\n    }, {\n        n: '🐻 兽语',\n        v: 'sy'\n    },\n    {\n        n: '🐕 狗语',\n        v: 'gy'\n    }, {\n        n: '❤️ 爱语',\n        v: 'ay'\n    }, {\n        n: '～ 符号',\n        v: 'fh'\n    },\n    {\n        n: '🔢 数字',\n        v: 'sz'\n    }, {\n        n: '🔤 字母',\n        v: 'zm'\n    }\n];\n\nvar cur = getMyVar('miyu_dialect', 'fh');\nvar curName = cur;\nfor (var q = 0; q < dialects.length; q++) {\n    if (dialects[q].v === cur) {\n        curName = dialects[q].n;\n        break;\n    }\n}\n\nvar d = [];\n\nd.push({\n    title: '蜜语方言（当前：' + curName + '）',\n    col_type: 'text_1'\n});\nfor (var i = 0; i < dialects.length; i++) {\n    (function(o) {\n        d.push({\n            title: (cur === o.v ? '✓ ' : '') + o.n,\n            col_type: 'flex_button',\n            url: $('#noLoading#').lazyRule(function(v) {\n                putMyVar('miyu_dialect', v);\n                refreshPage();\n                return 'toast://已切换方言';\n            }, o.v)\n        });\n    })(dialects[i]);\n}\n\nfunction actRule(act, label, done) {\n    return $().lazyRule(function(api, act, label, done) {\n        var text = getMyVar('miyu_text', '');\n        if (!text) return 'toast://请先输入内容';\n\n        var miyu = getMyVar('miyu_dialect', 'fh');\n        try {\n            var raw = post(api + '?act=' + act, {\n                body: {\n                    content: text,\n                    miyu: miyu\n                }\n            });\n            if (!raw || String(raw).charAt(0) !== '{') {\n                return 'toast://接口返回异常，请检查方言是否匹配';\n            }\n            var j = JSON.parse(String(raw).trim());\n            var c = j.content;\n            if (!c || c === String.fromCharCode(0) || c === String.fromCharCode(15)) {\n                return 'toast://呜呜呜，这应该不是我们星球的语言吧';\n            }\n            putMyVar('miyu_result', c);\n            putMyVar('miyu_result_act', label);\n            refreshPage();\n            return 'toast://' + done;\n        } catch (e) {\n            return 'toast://请求失败：' + e;\n        }\n    }, API, act, label, done);\n}\n\nd.push({\n    title: '',\n    col_type: 'input',\n    url: 'toast://已保存',\n    extra: {\n        type: 'textarea',\n        height: 2,\n        titleVisible: false,\n        defaultValue: getMyVar('miyu_text', ''),\n        onChange: \"putMyVar('miyu_text', input)\"\n    }\n});\n\nd.push({\n    title: '🔒 立即加蜜',\n    col_type: 'text_2',\n    url: actRule('jm', '加密', '加蜜完成')\n}, {\n    title: '🔓 立即破译',\n    col_type: 'text_2',\n    url: actRule('py', '破译', '破译完成')\n});\n\nvar result = getMyVar('miyu_result', '');\nif (result) {\n    var actName = getMyVar('miyu_result_act', '结果');\n    d.push({\n        title: '🗑 清空结果',\n        col_type: 'text_2',\n        url: $().lazyRule(function() {\n            putMyVar('miyu_result', '');\n            putMyVar('miyu_result_act', '');\n            putMyVar('miyu_text', '');\n            refreshPage();\n            return 'toast://已清空结果和输入';\n        })\n    }, {\n        title: '📋 点我复制',\n        col_type: 'text_2',\n        url: 'copy://' + result\n    }, {\n        title: ' ' + actName + '结果',\n        col_type: 'text_center_1'\n    }, {\n        title: result,\n        col_type: 'rich_text'\n    });\n}\nsetResult(d);","searchFind":"","search_url":"","group":"实用工具","detail_col_type":"movie_1","detail_find_rule":"","sdetail_col_type":"movie_1","sdetail_find_rule":"","ua":"auto","preRule":"","pages":"[]","proxy":"","icon":""}