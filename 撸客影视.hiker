 try {\\n                    var lastMod = f.lastModified();\\n                    if ((now - lastMod) >= maxAgeMs) { bytes += f.length(); if (f.delete()) count++; }\\n                } catch (e) {}\\n            }\\n        } catch (e) {}\\n        return { count: count, bytes: bytes };\\n    },\\n    _countDir: function(hikerDir, pattern, target) {\\n        try {\\n            var dir = new java.io.File(this._resolveDir(hikerDir));\\n            if (!dir.exists() || !dir.isDirectory()) return;\\n            var files = dir.listFiles();\\n            if (!files) return;\\n            var regex = this._patternToRegex(pattern);\\n            for (var i = 0; i < files.length; i++) {\\n                var f = files[i];\\n                if (f.isDirectory()) continue;\\n                if (!regex.test(String(f.getName()))) continue;\\n                target.count++;\\n                try { target.size += f.length(); } catch (e) {}\\n            }\\n        } catch (e) {}\\n    },\\n    autoCleanIfExpired: function() {\\n        try {\\n            var lastClean = parseInt(getMyVar('qd_last_auto_clean', '0')) || 0;\\n            var now = Date.now();\\n            if (now - lastClean < 24 * 60 * 60 * 1000) return null;\\n            putMyVar('qd_last_auto_clean', String(now));\\n            var days = parseInt(getItem('qd_cache_max_days', '7'));\\n            if (isNaN(days) || days <= 0) return null;\\n            return this.cleanExpired(days);\\n        } catch (e) { return null; }\\n    },\\n    cleanExpired: function(maxAgeDays) {\\n        var result = { danmu: 0, layer: 0, tmp: 0, bytes: 0 };\\n        try {\\n            if (maxAgeDays === undefined || maxAgeDays === null) maxAgeDays = 7;\\n            maxAgeDays = parseInt(maxAgeDays);\\n            if (isNaN(maxAgeDays) || maxAgeDays < 0) maxAgeDays = 7;\\n            var maxAgeMs = maxAgeDays * 24 * 60 * 60 * 1000;\\n            var now = Date.now();\\n            var r1 = this._cleanDir(this.danmuDir, 'external_danmu_*.json', maxAgeMs, now);\\n            var r2 = this._cleanDir(this.cacheDir, 'qd_*.json', maxAgeMs, now);\\n            var r3 = this._cleanDir(this.tmpDir, 'qd_*', maxAgeMs, now);\\n            result.danmu = r1.count; result.layer = r2.count; result.tmp = r3.count;\\n            result.bytes = r1.bytes + r2.bytes + r3.bytes;\\n        } catch (e) {}\\n        return result;\\n    },\\n    cleanAll: function() {\\n        return this.cleanExpired(0);\\n    },\\n    getStats: function() {\\n        var stats = {\\n            danmu: { count: 0, size: 0 },\\n            layer: { count: 0, size: 0 },\\n            tmp: { count: 0, size: 0 },\\n            total: { count: 0, size: 0 }\\n        };\\n        try {\\n            this._countDir(this.danmuDir, 'external_danmu_*.json', stats.danmu);\\n            this._countDir(this.cacheDir, 'qd_*.json', stats.layer);\\n            this._countDir(this.tmpDir, 'qd_*', stats.tmp);\\n            stats.total.count = stats.danmu.count + stats.layer.count + stats.tmp.count;\\n            stats.total.size = stats.danmu.size + stats.layer.size + stats.tmp.size;\\n        } catch (e) {}\\n        return stats;\\n    },\\n    formatSize: function(bytes) {\\n        bytes = Number(bytes) || 0;\\n        if (bytes < 1024) return bytes + 'B';\\n        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + 'KB';\\n        if (bytes < 1024 * 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + 'MB';\\n        return (bytes / (1024 * 1024 * 1024)).toFixed(2) + 'GB';\\n    }\\n};\\n\\nfunction qdTvboxJoinPath(base, rel) {\\n    if (!rel || typeof rel !== 'string') return rel;\\n    if (rel.indexOf('http') === 0 || rel.indexOf('file://') === 0 || rel.indexOf('/') === 0) return rel;\\n    if (rel.indexOf('./') !== 0 && rel.indexOf('../') !== 0) return rel;\\n    if (base.indexOf('file://') === 0) {\\n        var baseDir = base.substring(7, base.lastIndexOf('/'));\\n        var parts = baseDir.split('/');\\n        var relParts = rel.split('/');\\n        for (var i = 0; i < relParts.length; i++) {\\n            if (relParts[i] === '.') continue;\\n            else if (relParts[i] === '..') parts.pop();\\n            else parts.push(relParts[i]);\\n        }\\n        return 'file://' + parts.join('/');\\n    } else if (base.indexOf('http') === 0) {\\n        return joinUrl(base, rel);\\n    }\\n    return rel;\\n}\\n\\nfunction qdFetchTvboxContent(path) {\\n    if (!path) return '';\\n    if (path.indexOf('http') === 0) {\\n        return fetch(path, { headers: { \\\"User-Agent\\\": \\\"okhttp/4.12.0\\\" }, timeout: 20000 }) || '';\\n    }\\n    if (path.indexOf('file://') === 0) {\\n        return readFile(path.substring(7)) || '';\\n    }\\n    return readFile(path) || '';\\n}\\n\\nfunction qdParseTvboxConfig(content) {\\n    if (!content) return null;\\n    content = content.replace(/\\\\/\\\\*[\\\\s\\\\S]*?\\\\*\\\\//g, '').trim();\\n    var cfgObj;\\n    try {\\n        cfgObj = JSON.parse(content);\\n    } catch (e) {\\n        try {\\n            var module = { exports: {} };\\n            var exports = module.exports;\\n            eval(content);\\n            cfgObj = module.exports || {};\\n            if (typeof cfgObj === 'string') cfgObj = JSON.parse(cfgObj);\\n        } catch (e2) {\\n            return null;\\n        }\\n    }\\n    return cfgObj;\\n}\\n\\nfunction qdResolveTvboxExt(configPath, ext) {\\n    var sExt = '';\\n    if (typeof ext === 'object') {\\n        sExt = JSON.stringify(ext);\\n    } else if (typeof ext === 'string') {\\n        if (ext.indexOf('./') === 0 || ext.indexOf('../') === 0) {\\n            var absExtPath = qdTvboxJoinPath(configPath, ext);\\n            if (absExtPath.indexOf('.json') > 0 || absExtPath.indexOf('.js') > 0) {\\n                try {\\n                    var extContent = qdFetchTvboxContent(absExtPath);\\n                    if (absExtPath.indexOf('.js') > 0 && extContent) {\\n                        var module = { expor