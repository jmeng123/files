 Tab排序\\nd.push({\\n    title: '<b><font color=\\\"' + FontColor + '\\\">Tab排序</font></b>',\\n    desc: '<font color=\\\"' + FontColor + '\\\">调整当前模式下Tab的显示顺序</font>',\\n    pic_url: \\\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/269.png\\\",\\n    col_type: \\\"avatar\\\",\\n    url: $('#noLoading#').lazyRule(function() {\\n        var TabConfig = $.require('Tab配置');\\n        var mode = getItem('content_mode', '') || 'normal';\\n        var modeNameMap = { normal: '影视', short_drama: '短剧', live: '直播', adult: '成人' };\\n        var modeName = modeNameMap[mode] || mode;\\n\\n        var tabIds = (TabConfig.modeTabs && TabConfig.modeTabs[mode]) ? TabConfig.modeTabs[mode].slice() : [];\\n        if (tabIds.length === 0) { toast('当前模式没有 Tab'); return 'hiker://empty'; }\\n\\n        var savedOrder = getItem('tab_sort_' + mode, '');\\n        if (savedOrder) {\\n            var savedArr = savedOrder.split(',').filter(function(x) { return tabIds.indexOf(x) > -1; });\\n            tabIds.forEach(function(id) {\\n                if (savedArr.indexOf(String(id)) === -1) savedArr.push(String(id));\\n            });\\n            tabIds = savedArr;\\n        }\\n\\n        putMyVar('wfm_sort_mode', mode);\\n        putMyVar('wfm_sort_ids', tabIds.join(','));\\n\\n        var names = tabIds.map(function(id) { return TabConfig.tabNames[id] || ('Tab' + id); });\\n        var display = names.map(function(n, i) { return (i + 1) + '. ' + n; });\\n\\n        showSelectOptions({\\n            title: '选择要移动的 Tab（' + modeName + '模式）',\\n            options: display,\\n            col: 1,\\n            js: $.toString(function() {\\n                var picked = input;\\n                var m = picked.match(/^(\\\\d+)\\\\./);\\n                if (!m) { toast('选择无效'); return 'hiker://empty'; }\\n                var fromIdx = parseInt(m[1], 10) - 1;\\n\\n                var idsStr = getMyVar('wfm_sort_ids', '');\\n                var arr = idsStr ? idsStr.split(',') : [];\\n                if (fromIdx < 0 || fromIdx >= arr.length) { toast('选择无效'); return 'hiker://empty'; }\\n\\n                putMyVar('wfm_sort_from', String(fromIdx));\\n\\n                var posList = [];\\n                for (var i = 0; i < arr.length; i++) posList.push('移动到第 ' + (i + 1) + ' 位');\\n\\n                showSelectOptions({\\n                    title: '移动到第几位？',\\n                    options: posList,\\n                    col: 1,\\n                    js: $.toString(function() {\\n                        var pm = input.match(/第 (\\\\d+) 位/);\\n                        if (!pm) { toast('选择无效'); return 'hiker://empty'; }\\n                        var toIdx = parseInt(pm[1], 10) - 1;\\n\\n                        var fromIdx2 = parseInt(getMyVar('wfm_sort_from', '0'), 10) || 0;\\n                        var idsStr2 = getMyVar('wfm_sort_ids', '');\\n                        var arr2 = idsStr2 ? idsStr2.split(',') : [];\\n                        if (arr2.length === 0) { toast('数据丢失'); return 'hiker://empty'; }\\n\\n                        var movedId = arr2.splice(fromIdx2, 1)[0];\\n                        arr2.splice(toIdx, 0, movedId);\\n\\n                        var mode2 = getMyVar('wfm_sort_mode', 'normal');\\n                        setItem('tab_sort_' + mode2, arr2.join(','));\\n\\n                        clearMyVar('wfm_sort_mode');\\n                        clearMyVar('wfm_sort_ids');\\n                        clearMyVar('wfm_sort_from');\\n\\n                        toast('✅ 已调整顺序');\\n                        refreshPage();\\n                    })\\n                });\\n            })\\n        });\\n        return 'hiker://empty';\\n    }),\\n    extra: { backgroundColor: bgTint, lineVisible: true }\\n});\\n\\nd.push({ col_type: 'blank_block' });\\nd.push({col_type: 'line'});\\n\\nd.push({\\n    title: '<b><font color=\\\"' + FontColor + '\\\">Tab样式</font></b>',\\n    desc: '<font color=\\\"' + FontColor + '\\\">当前：' + (f