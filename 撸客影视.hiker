[0];\n    putMyVar('current_tab', String(currentTab));\n    putMyVar('page', '1');\n}\n\nd.push(主页助手.buildTitleCard(Color, FIXED_TEXT_COLOR));\n\nif (getItem('show_banner', '1') === '1') {\n    var lunboArr = 轮播图模块.getBanner();\n    if (lunboArr && lunboArr.length > 0) d = d.concat(lunboArr);\n    else d.push({ title: '⚠️ 轮播加载失败', desc: '请检查网络或图片源设置', url: 'hiker://empty', col_type: 'text_center_1' });\n}\n\nd.push({ col_type: 'blank_block' });\nd.push({\n    title: '搜索', desc: '输入搜索关键词', col_type: 'input', extra: { defaultValue: '' },\n    url: $.toString(function() {\n        var v = (input || '').trim();\n        if (!v) { toast('请输入关键词'); return 'hiker://empty'; }\n        return 'hiker://page/聚合搜索?kw=' + encodeURIComponent(v);\n    })\n});\nd.push({ col_type: 'blank_block' });\n\nvar mainTabs = [];\nfor (var _oi = 0; _oi < autoTabs.length; _oi++) {\n    var _oid = autoTabs[_oi];\n    if (tabInfo[_oid] != null) mainTabs.push({ id: _oid, title: tabInfo[_oid] });\n}\n\nif (mainTabs.length === 0) {\n    var keys = Object.keys(tabInfo);\n    if (keys.length > 0) {\n        currentTab = parseInt(keys[0]);\n        putMyVar('current_tab', String(currentTab));\n        putMyVar('page', '1');\n        mainTabs = [{ id: currentTab, title: tabInfo[currentTab] }];\n    }\n}\n\nvar currentStyle = getItem('card_style', 'scroll_button');\nfunction colorTab(a, b, txt) {\n    return a == b ? '““””<b><font color=' + FIXED_TEXT_COLOR + '>' + txt + '</font></b>' : txt;\n}\nvar tabColType = (currentStyle === 'scroll_button') ? 'scroll_button' : currentStyle;\n\nvar longClickMenu = 主页助手.getLongClickMenu();\nvar _hasLongClick = longClickMenu && longClickMenu.length > 0;\n\nvar tabIcons = 主页助手.getTabIcons();\nfor (var _tk in _skTabIcons) {\n    if (_skTabIcons.hasOwnProperty(_tk)) tabIcons[_tk] = _skTabIcons[_tk];\n}\n\nfor (var i = 0; i < mainTabs.length; i++) {\n    var tab = mainTabs[i];\n    var isActive = (tab.id == currentTab);\n    var _tabExtra = {\n        backgroundColor: isActive ? Color : 'transparent',\n        borderColor: Color,\n        borderWidth: '1px', borderStyle: 'solid', borderRadius: '8px',\n        padding: '6px 14px', lineVisible: false\n    };\n    if (_hasLongClick) {\n        _tabExtra.longClick = isActive ? longClickMenu : [longClickMenu[0]];\n    }\n    d.push({\n        title: colorTab(currentTab, tab.id, tab.title),\n        pic_url: tabIcons[tab.id],\n        url: $('#noLoading#').lazyRule(function(tabId) {\n            putMyVar('current_tab', String(tabId));\n            putMyVar('page', '1');\n            refreshPage();\n            return 'hiker://empty';\n        }, tab.id),\n        col_type: tabColType,\n        extra: _tabExtra\n    });\n}\nd.push({ col_type: 'blank_block' });\n\nvar _skPageKey = _skTabPages[currentTab] || '';\nvar _skWarmKey = _skPageKey ? ('tab_warm_' + _skPageKey) : '';\nvar _skIsFirstTime = (!_需要弹模式) && (_skWarmKey !== '') && (getMyVar(_skWarmKey, '0') !== '1');\n\nif (!_需要弹模式) {\n    if (_skIsFirstTime) {\n        d.push({ col_type: 'big_blank_block' });\n        d.push({ col_type: 'big_blank_block' });\n        d.push({ title: '⏳ 正在加载，请稍候...', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: '#999999', text_size: '15' } });\n        d.push({ col_type: 'blank_block' });\n        d.push({ title: '数据就绪后自动刷新', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: '#cccccc', text_size: '12' } });\n        d.push({ col_type: 'big_blank_block' });\n    } else {\n        var pageKey = _skPageKey;\n        var _cloudTabs = [];\n        for (var _k in _skTabPages) {\n            if (_skTabPages.hasOwnProperty(_k)) _cloudTabs.push(_skTabPages[_k]);\n        }\n        if (_cloudTabs.indexOf(pageKey) > -1) {\n            try {\n                var 内容 = $.require('内容');\n                内容.render(d, pageKey);\n            } catch(e) {\n                d.push({ title: '❌ ' + pageKey + ' 加载失败：' + (e.message || e), col_type: 'text_center_1', url: 'hiker://empty' });\n            }\n        } else {\n            d.push({ title: '❌ 未知 Tab：' + pageKey, col_type: 'text_center_1', url: 'hiker://empty' });\n        }\n    }\n} else {\n    d.push({ col_type: 'big_blank_block' });\n    d.push({ title: '请先选择模式', col_type: 'text_center_1', url: 'hiker://empty' });\n}\n\nvar _annText = getItem(\"tab_announcement\", \"\");\nif (_annText) {\n    var _annKey = \"read_ann_\" + _annText.substring(0, 20);\n    var _hasRead = getItem(_annKey, \"\");\n    if (!_hasRead) {\n        var _pop = $.require('弹窗工具');\n        if (_pop && _pop.show) {\n            _pop.show(\"📢 公告\", [{ title: \"公告内容\", records: [_annText] }]);\n            setItem(_annKey, String(new Date().getTime()));\n        }\n    }\n}\n\nvar _pauseMsg = getItem(\"pause_msg\", \"\");\nif (_pauseMsg) {\n    d = [];\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({ title: \"🛑 暂停使用中\", col_type: \"text_center_1\", url: \"hiker://page/管理\" });\n    d.push({ col_type: \"blank_block\" });\n    d.push({ title: _pauseMsg, col_type: \"text_center_1\", url: \"hiker://empty\" });\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({\n        title: \"🔄 点击重试\", col_type: \"flex_button\",\n        url: $('#noLoading#').lazyRule(function() {\n            setItem(\"tab_cloud_time\", \"0\");\n            setItem(\"tab_jg_time\", \"0\");\n            refreshPage();\n            return \"hiker://empty\";\n        })\n    });\n}\n\nvar _minVer = getItem(\"min_version\", \"\");\nvar _useBetaF = (getItem('use_beta_mode', '0') === '1');\nvar _curVerF = \"\";\ntry {\n    var _mF = _useBetaF ? $.require('更新日志Beta版') : $.require('更新日志正式版');\n    _curVerF = _useBetaF ? (_mF.CURRENT_BETA_VERSION || \"\") : (_mF.CURRENT_VERSION || \"\");\n} catch(e) {}\n\nif (_minVer && _curVerF && Number(_curVerF) < Number(_minVer)) {\n    var _cmdF = getItem(_useBetaF ? \"cmd_beta\" : \"cmd_stable\", \"\");\n    d = [];\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({ title: \"⚠️ 当前版本过低\", col_type: \"text_center_1\", url: \"hiker://page/管理\" });\n    d.push({ col_type: \"blank_block\" });\n    d.push({ title: \"当前版本：\" + _curVerF + \"\\n需要更新到：\" + _minVer + \" 以上\", col_type: \"text_center_1\", url: \"hiker://empty\" });\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({\n        title: \"✅ 立即更新（复制口令）\", col_type: \"flex_button\",\n        url: $('#noLoading#').lazyRule(function(cmd) {\n            if (!cmd) { toast(\"❌ 未设置云口令\"); return \"hiker://empty\"; }\n            var ok = false;\n            try { if (typeof setClipboard === \"function\") { setClipboard(cmd); ok = true; } } catch(e) {}\n            if (!ok) { try { if (typeof copy === \"function\") { copy(cmd); ok = true; } } catch(e) {} }\n            if (ok) toast(\"✅ 口令已复制\"); else toast(\"口令：\" + cmd);\n            return \"hiker://empty\";\n        }, _cmdF),\n        extra: { text_color: \"#1565c0\" }\n    });\n    d.push({ title: \"❌ 取消\", col_type: \"flex_button\", url: \"hiker://empty\", extra: { text_color: \"#666666\" } });\n}\n\nif (_skIsFirstTime) {\n    putMyVar(_skWarmKey, '1');\n    setResult(d);\n    try { setTimeout(function() { refreshPage(); }, 1200); } catch(e) { refreshPage(); }\n} else {\n    setResult(d);\n}","searchFind":"","search_url":"","group":"①推荐","detail_col_type":"movie_1","detail_find_rule":"","sdetail_col_type":"movie_1","sdetail_find_rule":"*","ua":"mobile","preRule":"","pages":"[{\"col_type\":\"movie_3\",\"name\":\"存储cookie\",\"path\":\"repair\",\"rule\":\"js:\\nvar document = {};\\nvar window = {\\n    location: {\\n        reload: function() {\\n            return;\\n        }\\n    }\\n};\\n\\n// 定义一个对象用于存储 cookie 名称和值的键值对\\nvar cookies = {};\\nObject.defineProperty(document, 'cookie', {\\n    enumerable: true,\\n    configurable: true,\\n    get: function() {\\n        return Object.entries(cookies).map(([key, value]) => `${key}=${value}`).join('; ');\\n    },\\n    set: function(value) {\\n        var list = [];\\n        if (value.includes(';')) {\\n            list = value.split(';');\\n        } else {\\n            list = [value];\\n        }\\n        list.forEach(x => {\\n            var index = x.indexOf(\\\"=\\\");\\n            var key = x.substring(0, index).trim();\\n            var value = x.substring(index + 1);\\n            cookies[key] = value;\\n        })\\n    }\\n});\"},{\"col_type\":\"text_1\",\"name\":\"函数（管理）\",\"path\":\"function\",\"rule\":\"var GLOBAL_XJ_FOLD_KEY = 'global_xj_fold_state';\\n\\nfunction toggleGlobalFoldState() {\\n    var currentState = getMyVar(GLOBAL_XJ_FOLD_KEY, '0');\\n    var newState = currentState === '1' ? '0' : '1';\\n    putMyVar(GLOBAL_XJ_FOLD_KEY, newState);\\n}\\n\\nfunction cachedFetch(cacheKey, id, fetchFn) {\\n    var CACHE_EXPIRY = 30 * 60 * 1000;\\n    var cached = getMyVar(cacheKey, '');\\n    if (cached) {\\n        try {\\n            var data = JSON.parse(cached);\\n            if (data.id === id && data.ts && (Date.now() - data.ts < CACHE_EXPIRY)) {\\n                return data.data;\\n            }\\n        } catch (e) {}\\n    }\\n    var result = fetchFn();\\n    if (result) {\\n        putMyVar(cacheKey, JSON.stringify({ id: id, ts: Date.now(), data: result }));\\n    }\\n    return result;\\n}\\n\\nfunction setProgress(id, progress) {\\n    try {\\n        let historyData = {};\\n        try {\\n            let historyContent = readFile('progress_history.json', 0);\\n            if (historyContent) historyData = JSON.parse(historyContent);\\n        } catch (e) {}\\n        var existing = historyData[id] || {};\\n        progress.lastPlayTime = Date.now();\\n        if (!progress.playLink && existing.playLink) progress.playLink = existing.playLink;\\n        if (!progress.playType && existing.playType) progress.playType = existing.playType;\\n        historyData[id] = progress;\\n        let thirtyDaysAgo = Date.now() - (30 * 24 * 60 * 60 * 1000);\\n        for (let key in historyData) {\\n            if (historyData[key] && historyData[key].lastPlayTime && historyData[key].lastPlayTime < thirtyDaysAgo) {\\n                delete historyData[key];\\n            }\\n        }\\n        saveFile('progress_history.json', JSON.stringify(historyData), 0);\\n    } catch (e) {}\\n}\\n\\nfunction fpUpdate(doubanId, sourceTitle, episodeIndex, episodeTitle, playLink, playType) {\\n    try {\\n        putMyVar('_fp_doubanId', doubanId);\\n        putMyVar('_fp_sourceTitle', sourceTitle);\\n        putMyVar('_fp_epIndex', String(episodeIndex));\\n        putMyVar('_fp_epTitle', episodeTitle);\\n        putMyVar('_fp_playLink', playLink || '');\\n        putMyVar('_fp_playType', playType || '');\\n        updateItem('play_footprint', {\\n            title: '<b><font color=\\\"#FF5D50\\\">📍 当前播放到: ' + sourceTitle + ' · ' + episodeTitle + '</font></b>'\\n        });\\n    } catch (e) {}\\n}\\n\\nfunction getProgress(id) {\\n    try {\\n        let historyContent = readFile('progress_history.json', 0);\\n        if (historyContent) {\\n            let historyData = JSON.parse(historyContent);\\n            return historyData[id] || null;\\n        }\\n        return null;\\n    } catch (e) { return null; }\\n}\\n\\nfunction playAndUpdateProgress(doubanId, sourceTitle, episodeIndex, episodeTitle, playLink) {\\n    setProgress(doubanId, { sourceTitle: sourceTitle, episodeIndex: episodeIndex, episodeTitle: episodeTitle, playLink: playLink, playType: 'official' });\\n    return playLink;\\n}\\n\\nfunction playBocaiEpisode(doubanId, sourceTitle, episodeIndex, episodeTitle, rawPlayLink, movieTitle) {\\n    setProgress(doubanId, { sourceTitle: sourceTitle, episodeIndex: episodeIndex, episodeTitle: episodeTitle, playLink: rawPlayLink, playType: 'bocai' });\\n    fpUpdate(doubanId, sourceTitle, episodeIndex, episodeTitle, rawPlayLink, 'bocai');\\n    var dmMode = getExternalDanmuConfig().mode;\\n    if (/\\\\[画\\\\]/.test(sourceTitle) || /\\\\[音\\\\]/.test(sourceTitle)) dmMode = 'off';\\n    var dmPath = (dmMode === 'external' || dmMode === 'local') ? getExternalDanmuUrl(rawPlayLink, movieTitle || '', '', episodeTitle) : '';\\n    var dmSource = dmPath ? (dmMode === 'local' ? '本地弹幕' : '外接弹幕') : '';\\n    var dmCacheKey = 'dm_url_' + doubanId + '_' + episodeIndex;\\n    var dmCached = dmMode === 'box' ? getMyVar(dmCacheKey, '') : '';\\n    if (dmCached) {\\n        try {\\n            var dmData = JSON.parse(dmCached);\\n            if (dmData.ts && (Date.now() - dmData.ts < 2 * 60 * 60 * 1000) && dmData.url) {\\n                dmPath = dmData.url;\\n                putVar('dm_share', dmPath);\\n                var result = { urls: ['video://' + rawPlayLink + '#isVideo=true#'] };\\n                result.danmu = dmPath;\\n                log('弹幕获取完毕[' + (dmSource || '弹幕盒子') + ']');\\n                return JSON.stringify(result);\\n            }\\n        } catch (e) {}\\n    }\\n    if (dmMode === 'box') try {\\n        var eps = getEpisodes(doubanId);\\n        if (eps && eps.playList && eps.playList.length > 0) {\\n            var matchedUrl = '';\\n            for (var i = 0; i < eps.playList.length; i++) {\\n                var list = eps.playList[i].list;\\n                if (episodeIndex < list.length) {\\n                    matchedUrl = list[episodeIndex].play_link;\\n                    break;\\n                }\\n            }\\n            if (!matchedUrl) {\\n                var lastSrc = eps.playList[eps.playList.length - 1];\\n                matchedUrl = lastSrc.list[lastSrc.list.length - 1].play_link;\\n            }\\n            if (matchedUrl) {\\n                try {\\n                    var dmFun = $.require('hiker://page/dmFun?rule=dm盒子');\\n                    var dm = dmFun.dmRoute(matchedUrl);\\n                    if (dm && dm !== false) {\\n                        dmPath = dm;\\n                        dmSource = '弹幕盒子';\\n                        putVar('dm_share', dm);\\n                        putMyVar(dmCacheKey, JSON.stringify({ url: dm, ts: Date.now() }));\\n                    }\\n                } catch (e) {}\\n            }\\n        }\\n    } catch (e) {}\\n    if (dmPath) putVar('dm_share', dmPath);\\n    var result = { urls: ['video://' + rawPlayLink + '#isVideo=true#'] };\\n    if (dmPath) {\\n        result.danmu = dmPath;\\n        log('弹幕获取完毕[' + (dmSource || '弹幕盒子') + ']');\\n    }\\n    return JSON.stringify(result);\\n}\\n\\nfunction getDoubanRes(url) {\\n    var cc = null;\\n    if ($.type(url) == 'object') {\\n        cc = url.cc;\\n        url = url.url;\\n    }\\n    var _url = url;\\n    if (url.indexOf('apikey') === -1) {\\n        _url += (url.indexOf('?') === -1 ? '?' : '&') + \\\"apikey=0dad551ec0f84ed02907ff5c42e8ec70\\\";\\n    }\\n    var _ts = parseInt(Date.now() / 1000).toString();\\n    var m = 'GET&' + encodeURIComponent(url.split('douban.com')[1].split('?')[0]) + '&' + _ts;\\n    eval(getCryptoJS());\\n    var _sig = hexToBase64(CryptoJS.HmacSHA1(m, 'bf7dddc7c9cfe6f7').toString());\\n    _url += '&_sig=' + _sig + '&_ts=' + _ts;\\n    var s = fetch(_url, {\\n        headers: {\\n            \\\"User-Agent\\\": \\\"Rexxar-Core/0.1.3 api-client/1 com.douban.frodo/7.9.0.beta2(215) Android/25 product/TAS-AL00 vendor/HUAWEI model/TAS-AL00  rom/android  network/wifi  platform/mobile com.douban.frodo/7.9.0.beta2(215) Rexxar/1.2.151  platform/mobile 1.2.151\\\"\\n        },\\n        method: 'GET'\\n    });\\n    var json = JSON.parse(s);\\n    if (json.localized_message) {\\n        cc = cc == null ? 1 : cc + 1;\\n        log('重试次数:' + cc);\\n        if (cc > 2) {\\n            throw new Error('超时');\\n        }\\n        java.lang.Thread.sleep(2000);\\n        return getDoubanRes({ url: url, cc: cc });\\n    }\\n    return json;\\n}\\n\\nfunction colorHtml(color, text) {\\n    return '\\\\u2018\\\\u2018\\\\u2019\\\\u2019<font color=\\\"' + color + '\\\">' + text + '</font>';\\n}\\n\\nfunction parseQueryString(url) {\\n    var str = url.split('?', 2)[1]; var arr = str.split('&'); var obj = {};\\n    for (var i = 0; i < arr.length; i++) { var arr2 = arr[i].split('='); obj[arr2[0]] = arr2[1]; }\\n    return obj;\\n}\\n\\nfunction star(number) {\\n    var text = '';\\n    for (var i = 0; i < 5; i++) text = text + (i * 2 < number ? '★' : '☆');\\n    return text;\\n}\\n\\nfunction setDesc(d, desc, num) {\\n    if (desc == undefined || !desc.trim()) return;\\n    desc = desc.constructor === Array ? desc.join('<br>') : desc;\\n    desc = desc.replace(/(<br>|\\\\s+|<\\\\/?p>|&nbsp;)/g, '').length === 0 ? '' : desc;\\n    if (!desc) return;\\n    var mark = 'global_desc_fold';\\n    num = typeof(num) === 'undefined' ? 45 : num;\\n    desc = desc.startsWith('　　') ? desc : '　　' + desc;\\n    desc = desc.replace(/'/g, \\\"&#39;\\\");\\n    desc = desc.replace(/\\\\r\\\\n/g, \\\"<br>\\\");\\n    desc = desc.replace(/\\\\r/g, \\\"<br>\\\");\\n    desc = desc.replace(/\\\\n/g, \\\"<br>\\\");\\n\\n    function substr(str, maxLength) {\\n        var len = 0;\\n        for (var i = 0; i < str.length; i++) {\\n            if (str.charCodeAt(i) > 255) {\\n                len += 2;\\n            } else {\\n                len++;\\n            }\\n            if (len > maxLength) {\\n                return str.slice(0, i) + '...';\\n            }\\n        }\\n        return str;\\n    }\\n    var sdesc = substr(desc, num);\\n    var colors = {\\n        show: \\\"black\\\",\\n        hide: \\\"grey\\\"\\n    };\\n    var lazy = $(`#noLoading#`).b64().lazyRule((dc, sdc, m, cs) => {\\n        var show = getMyVar(m, '0');\\n        var title = findItem('desc').title;\\n        var re = /(<\\\\/small><br>.*?>).+/g;\\n        var exp = '展开:';\\n        var ret = '收起:';\\n        if (show == '1') {\\n            updateItem('desc', {\\n                title: title.replace(ret, exp).replace(re, '$1' + sdc + '</small>').replace(/(<\\\\/small><br>\\\\<font color=\\\").*?(\\\">)/, '$1' + cs.hide + '$2')\\n            });\\n            putMyVar(m, '0');\\n        } else {\\n            updateItem('desc', {\\n                title: title.replace(exp, ret).replace(re, '$1' + dc + '</small>').replace(/(<\\\\/small><br>\\\\<font color=\\\").*?(\\\">)/, '$1' + cs.show + '$2')\\n            });\\n            putMyVar(m, '1');\\n        }\\n        return `hiker://empty`;\\n    }, desc, sdesc, mark, colors);\\n    var sc = getMyVar(mark, '0') == '0' ? '展开:' : '收起:';\\n    var dc = getMyVar(mark, '0') == '0' ? sdesc : desc;\\n    var cs = getMyVar(mark, '0') == '0' ? colors.hide : colors.show;\\n    d.push({\\n        title: '' + '<b><font color=\\\"#098AC1\\\">∷剧情简介\\\\t</font></b>' + \\\"<small><a style='text-decoration: none;' href='\\\" + lazy + \\\"'>\\\" + sc + '</a></small><br><font color=\\\"' + cs + '\\\">' + dc + '</font></small>',\\n        col_type: 'rich_text',\\n        extra: {\\n            id: 'desc',\\n            lineSpacing: 6,\\n            textSize: 15,\\n            lineVisible: true,\\n        }\\n    });\\n}\\n\\nvar BOCAI_CONFIG_FILE = \\\"hiker://files/rules/青豆剧场/qd_configs\\\";\\n\\nvar _bocaiSitesCache = null;\\nfunction getBocaiSites() {\\n    if (_bocaiSitesCache) return _bocaiSitesCache;\\n    try {\\n        var cfg = JSON.parse(readFile(BOCAI_CONFIG_FILE) || '{}');\\n        if (cfg.bocai_sites) { _bocaiSitesCache = cfg.bocai_sites; return _bocaiSitesCache; }\\n    } catch (e) {}\\n    return [];\\n}\\n\\nfunction saveBocaiSites(sites) {\\n    _bocaiSitesCache = null;\\n    _bocai_api_cache = null;\\n    try {\\n        var cfg = JSON.parse(readFile(BOCAI_CONFIG_FILE) || '{}');\\n        cfg.bocai_sites = sites;\\n        saveFile(BOCAI_CONFIG_FILE, JSON.stringify(cfg));\\n    } catch (e) {}\\n}\\n\\nfunction parseBocaiApiSiteText(raw) {\\n    raw = String(raw || '').replace(/^\\\\uFEFF/, '').trim();\\n    if (!raw) return null;\\n    var jsonStr = raw;\\n    var varMatch = raw.match(/(?:var|let|const)\\\\s+\\\\w+\\\\s*=\\\\s*([\\\\s\\\\S]*?);?\\\\s*$/);\\n    if (varMatch) jsonStr = varMatch[1].trim();\\n    var parsed = JSON.parse(jsonStr);\\n    if (Array.isArray(parsed) && parsed.length > 0 && parsed[0].api_site) {\\n        return parsed[0].api_site;\\n    }\\n    if (parsed && parsed.api_site && !Array.isArray(parsed)) {\\n        return parsed.api_site;\\n    }\\n    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\\n        var keys = Object.keys(parsed);\\n        var looksLikeApiSite = keys.length > 0;\\n        for (var i = 0; i < keys.length; i++) {\\n            var item = parsed[keys[i]];\\n            if (!item || typeof item !== 'object' || !(item.api || item.url)) {\\n                looksLikeApiSite = false;\\n                break;\\n            }\\n        }\\n        if (looksLikeApiSite) return parsed;\\n    }\\n    return null;\\n}\\n\\nfunction importBocaiSitesFromText(raw) {\\n    var apiSite = parseBocaiApiSiteText(raw);\\n    if (!apiSite || typeof apiSite !== 'object') {\\n        return { ok: false, message: '无法识别配置格式，请检查内容', addCount: 0, skipCount: 0, invalidCount: 0 };\\n    }\\n    var keys = Object.keys(apiSite);\\n    if (keys.length === 0) {\\n        return { ok: false, message: '未发现有效的源数据', addCount: 0, skipCount: 0, invalidCount: 0 };\\n    }\\n    try {\\n        var cfg = JSON.parse(readFile(BOCAI_CONFIG_FILE) || '{}');\\n        if (!cfg.bocai_sites) cfg.bocai_sites = [];\\n        var existKeys = {};\\n        var existEnabledCount = 0;\\n        for (var i = 0; i < cfg.bocai_sites.length; i++) {\\n            existKeys[cfg.bocai_sites[i].key] = true;\\n            if (cfg.bocai_sites[i].enabled !== false) existEnabledCount++;\\n        }\\n        var maxEnabled = parseInt(getItem('qd_bocai_max_enabled', '5'));\\n        if (isNaN(maxEnabled) || maxEnabled < 1) maxEnabled = 5;\\n        var addCount = 0;\\n        var skipCount = 0;\\n        var invalidCount = 0;\\n        for (var j = 0; j < keys.length; j++) {\\n            var k = String(keys[j] || '').trim();\\n            if (!k) { invalidCount++; continue; }\\n            if (existKeys[k]) { skipCount++; continue; }\\n            var s = apiSite[keys[j]];\\n            if (!s || typeof s !== 'object') { invalidCount++; continue; }\\n            var api = String(s.api || s.url || '').trim();\\n            if (!api) { invalidCount++; continue; }\\n            var newEnabled = existEnabledCount < maxEnabled;\\n            cfg.bocai_sites.push({\\n                key: k,\\n                name: s.name || k,\\n                api: api,\\n                detail: s.detail || '',\\n                enabled: newEnabled\\n            });\\n            existKeys[k] = true;\\n            if (newEnabled) existEnabledCount++;\\n            addCount++;\\n        }\\n        saveFile(BOCAI_CONFIG_FILE, JSON.stringify(cfg));\\n        _bocaiSitesCache = null;\\n        _bocai_api_cache = null;\\n        return { ok: true, addCount: addCount, skipCount: skipCount, invalidCount: invalidCount };\\n    } catch (e) {\\n        return { ok: false, message: '导入失败: ' + e.message, addCount: 0, skipCount: 0, invalidCount: 0 };\\n    }\\n}\\n\\nfunction speedTestBocaiSites() {\\n    var sites = getBocaiSites();\\n    var requests = [];\\n    var reqIndex = [];\\n    var results = [];\\n    for (var i = 0; i < sites.length; i++) {\\n        var site = sites[i];\\n        if (site.name.indexOf('🔞') !== -1) {\\n            results.push({key: site.key, time: 99999, name: site.name, skipped: true});\\n            continue;\\n        }\\n        reqIndex.push({idx: results.length, site: site, start: Date.now()});\\n        results.push({key: site.key, time: 99999, name: site.name});\\n        requests.push({\\n            url: site.api + '?ac=detail&wd=你好',\\n            options: {timeout: 5000, headers: {'User-Agent': 'Mozilla/5.0'}}\\n        });\\n    }\\n    if (requests.length > 0 && (typeof batchFetch === 'function' || typeof bf === 'function')) {\\n        try {\\n            var fetcher = typeof batchFetch === 'function' ? batchFetch : bf;\\n            var bodies = fetcher(requests);\\n            for (var r = 0; r < reqIndex.length; r++) {\\n                var body = bodies && bodies[r] ? bodies[r] : '';\\n                var elapsed = Date.now() - reqIndex[r].start;\\n                try {\\n                    var json = JSON.parse(body);\\n                    var count = (json && json.list) ? json.list.length : 0;\\n                    results[reqIndex[r].idx].time = count > 0 ? elapsed : 99999;\\n                } catch (e) {\\n                    results[reqIndex[r].idx].time = 99999;\\n                }\\n            }\\n        } catch (e2) {\\n            for (var s = 0; s < reqIndex.length; s++) {\\n                var start = Date.now();\\n                try {\\n                    var resp = fetch(reqIndex[s].site.api + '?ac=detail&wd=你好', {timeout: 5000, headers: {'User-Agent': 'Mozilla/5.0'}});\\n                    var json2 = JSON.parse(resp);\\n                    var count2 = (json2 && json2.list) ? json2.list.length : 0;\\n                    results[reqIndex[s].idx].time = count2 > 0 ? (Date.now() - start) : 99999;\\n                } catch (e3) {}\\n            }\\n        }\\n    } else {\\n        for (var j = 0; j < reqIndex.length; j++) {\\n            var start2 = Date.now();\\n            try {\\n                var resp2 = fetch(reqIndex[j].site.api + '?ac=detail&wd=你好', {timeout: 5000, headers: {'User-Agent': 'Mozilla/5.0'}});\\n                var json3 = JSON.parse(resp2);\\n                var count3 = (json3 && json3.list) ? json3.list.length : 0;\\n                results[reqIndex[j].idx].time = count3 > 0 ? (Date.now() - start2) : 99999;\\n            } catch (e4) {}\\n        }\\n    }\\n    results.sort(function(a, b) { return a.time - b.time; });\\n    var maxEnabled = Math.min(parseInt(getItem('qd_bocai_max_enabled', '5')), results.length);\\n    var topKeys = [];\\n    for (var t = 0; t < maxEnabled; t++) {\\n        if (!results[t].skipped) topKeys.push(results[t].key);\\n    }\\n    var cfg = {};\\n    try { cfg = JSON.parse(readFile(BOCAI_CONFIG_FILE) || '{}'); } catch (e5) { cfg = {}; }\\n    var list = cfg.bocai_sites || [];\\n    for (var k = 0; k < list.length; k++) {\\n        list[k].enabled = topKeys.indexOf(list[k].key) !== -1;\\n    }\\n    var topItems = [];\\n    var restItems = [];\\n    for (var n = 0; n < list.length; n++) {\\n        if (topKeys.indexOf(list[n].key) !== -1) topItems.push(list[n]);\\n        else restItems.push(list[n]);\\n    }\\n    cfg.bocai_sites = topItems.concat(restItems);\\n    saveFile(BOCAI_CONFIG_FILE, JSON.stringify(cfg));\\n    _bocaiSitesCache = null;\\n    _bocai_api_cache = null;\\n    var msg = '批量测速完成，结果如下：\\\\n\\\\n';\\n    for (var m = 0; m < results.length; m++) {\\n        var timeStr = results[m].skipped ? '⏭已跳过' : (results[m].time >= 99999 ? '超时/无结果' : results[m].time + 'ms');\\n        var flag = results[m].skipped ? '🔞跳过' : (topKeys.indexOf(results[m].key) !== -1 ? '✅开启' : '❌关闭');\\n        msg += flag + ' ' + results[m].name + '：' + timeStr + '\\\\n';\\n    }\\n    return msg;\\n}\\n\\nfunction getBocaiApiSite() {\\n    var sites = getBocaiSites();\\n    var apiSite = {};\\n    for (var i = 0; i < sites.length; i++) {\\n        apiSite[sites[i].key] = {name: sites[i].name, api: sites[i].api, detail: sites[i].detail || \\\"\\\"};\\n    }\\n    return apiSite;\\n}\\n\\nvar _bocai_api_cache = null;\\nfunction getBocaiApi() {\\n    if (_bocai_api_cache) return _bocai_api_cache;\\n    _bocai_api_cache = [{\\n        \\\"cache_time\\\": 7200,\\n        \\\"api_site\\\": getBocaiApiSite()\\n    }];\\n    return _bocai_api_cache;\\n}\\nfunction bocai_api_lazy() { return getBocaiApi(); }\\nvar bocai_api = bocai_api_lazy;\\n\\nfunction getEnabledSiteKeys() {\\n    var sites = getBocaiSites();\\n    var enabled = [];\\n    for (var i = 0; i < sites.length; i++) {\\n        if (sites[i].enabled !== false) {\\n            enabled.push(sites[i].key);\\n        }\\n    }\\n    return enabled;\\n}\\n\\nfunction cnToNum(cn) {\\n    var cnMap = {'零':0,'一':1,'二':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9,'十':10,'百':100,'千':1000};\\n    if (!cn) return 0;\\n    if (/^\\\\d+$/.test(cn)) return parseInt(cn, 10);\\n    if (cn.length === 1 && cnMap[cn] !== undefined) return cnMap[cn];\\n    var r = 0, cur = 0;\\n    for (var i = 0; i < cn.length; i++) {\\n        var v = cnMap[cn[i]];\\n        if (v >= 10) { cur = cur === 0 ? v : cur * v; r += cur; cur = 0; }\\n        else cur = v;\\n    }\\n    r += cur;\\n    return r || 0;\\n}\\n\\nfunction extractSeasonInfo(title) {\\n    var s = title || '';\\n    var m;\\n    m = s.match(/第([一二三四五六七八九十百千\\\\d]+)[季部集期]/i);\\n    if (m) return { type: 'season', num: cnToNum(m[1]) };\\n    m = s.match(/([一二三四五六七八九十百千\\\\d]+)[季部]/);\\n    if (m) return { type: 'season', num: cnToNum(m[1]) };\\n    m = s.match(/年番(\\\\d*)/);\\n    if (m) return { type: 'nianfan', num: parseInt(m[1] || '0', 10) || 0 };\\n    m = s.match(/\\\\bS(\\\\d+)/i);\\n    if (m) return { type: 'season', num: parseInt(m[1], 10) };\\n    m = s.match(/剧场版/);\\n    if (m) return { type: '剧场版', num: 0 };\\n    m = s.match(/\\\\b(OVA|OAD|SP)\\\\b/i);\\n    if (m) return { type: m[1].toUpperCase(), num: 0 };\\n    m = s.match(/特别[篇编]|番外[篇编]?/);\\n    if (m) return { type: '特别篇', num: 0 };\\n    return null;\\n}\\n\\nfunction matchSeasonInfo(searchName, resultName) {\\n    var a = extractSeasonInfo(searchName);\\n    var b = extractSeasonInfo(resultName);\\n    if (!a && !b) return true;\\n    if (!a) return true;  // 搜索词没有季节信息时，匹配所有结果\\n    if (!b) return false;\\n    if (a.type !== b.type) return false;\\n    return a.num === b.num;\\n}\\n\\nfunction stripTitleTags(title) {\\n    return (title || '')\\n        .replace(/<[^>]+>/g, '')\\n        .replace(/&nbsp;/gi, '')\\n        .replace(/[【\\\\[][^\\\\]】]*(?:4K|8K|1080|720|2160|HDR|HD|臻彩|杜比|高码|中字|国语)[^\\\\]】]*[\\\\]】]/gi, '')\\n        .replace(/[（(][^）)]*(?:4K|8K|1080|720|2160|HDR|HD|臻彩|杜比|高码|中字|国语)[^）)]*[）)]/gi, '')\\n        .replace(/\\\\s+/g, '')\\n        .trim();\\n}\\n\\nfunction isCollectionTitle(title) {\\n    var s = stripTitleTags(title);\\n    return /全系列|合集|汇总|全集|附.{0,8}(前|全)?\\\\d*季|前\\\\d+季|总第[一二三四五六七八九十百千\\\\d]+季/.test(s);\\n}\\n\\nfunction isTargetTitle(movieName, resultTitle) {\\n    var title = stripTitleTags(resultTitle);\\n    if (!title) return false;\\n    var norm = normalizeTitle(movieName);\\n    var baseKey = normalizeSearchText(norm.baseName || norm.cleanName);\\n    var titleKey = normalizeSearchText(title);\\n    if (baseKey && titleKey.indexOf(baseKey) === -1) return false;\\n    if (norm.seasonInfo) {\\n        if (!matchSeasonInfo(movieName, title)) return false;\\n        if (isCollectionTitle(title)) return false;\\n    }\\n    return true;\\n}\\n\\nfunction filterPanPlayUrlByTitle(playUrl, movieName) {\\n    if (!playUrl) return playUrl;\\n    var norm = normalizeTitle(movieName);\\n    var baseKey = normalizeSearchText(norm.baseName || norm.cleanName);\\n    if (!baseKey) return playUrl;\\n    var parts = playUrl.split('#').filter(function(e) { return e; });\\n    var kept = [];\\n    for (var i = 0; i < parts.length; i++) {\\n        var title = (parts[i].split('$')[0] || '').trim();\\n        var titleKey = normalizeSearchText(title);\\n        if (!titleKey || titleKey.indexOf(baseKey) === -1) continue;\\n        if (norm.seasonInfo && !matchSeasonInfo(movieName, title)) continue;\\n        if (norm.seasonInfo && isCollectionTitle(title)) continue;\\n        kept.push(parts[i]);\\n    }\\n    return kept.join('#');\\n}\\n\\nfunction isPanAggResult(r) {\\n    if (!r) return false;\\n    if (r.type === 'pan' || r.type === 'pan_sub' || r._isPan || r.panType) return true;\\n    if (r.type === 'merged_rule' && r.sources && Array.isArray(r.sources)) {\\n        for (var i = 0; i < r.sources.length; i++) {\\n            var s = r.sources[i];\\n            if (s && (s.type === 'pan' || s.type === 'pan_sub' || s._isPan || s.panType)) return true;\\n        }\\n    }\\n    return false;\\n}\\n\\nfunction filterAggResultsByTitle(results, movieName) {\\n    if (!results || !Array.isArray(results) || !movieName) return results;\\n    var out = [];\\n    for (var i = 0; i < results.length; i++) {\\n        var r = results[i];\\n        if (!r || !r.playUrl) {\\n            out.push(r);\\n            continue;\\n        }\\n        if (isPanAggResult(r)) {\\n            var filtered = filterPanPlayUrlByTitle(r.playUrl, movieName);\\n            if (!filtered) continue;\\n            var nr = JSON.parse(JSON.stringify(r));\\n            nr.playUrl = filtered;\\n            nr.epCount = filtered.split('#').filter(function(e) { return e; }).length;\\n            out.push(nr);\\n        } else {\\n            out.push(r);\\n        }\\n    }\\n    return out;\\n}\\n\\nfunction buildBocaiTasks(movieName) {\\n    var apiSites = bocai_api()[0].api_site;\\n    var enabledKeys = getEnabledSiteKeys();\\n    var tasks = [];\\n    var norm = normalizeTitle(movieName);\\n    var searchName = norm.baseName || norm.cleanName;\\n    var cleanMovieName = norm.cleanName;\\n    for (var i = 0; i < enabledKeys.length; i++) {\\n        var key = enabledKeys[i];\\n        var site = apiSites[key];\\n        tasks.push({\\n            func: function(obj) {\\n                try {\\n                    var searchUrl = obj.api + '?ac=detail&wd=' + encodeURIComponent(obj.searchName);\\n                    var resp = fetch(searchUrl, { timeout: 12000, headers: { 'User-Agent': 'Mozilla/5.0' } });\\n                    var json = JSON.parse(resp);\\n                    if (json && json.list && json.list.length > 0) {\\n                        var seasonNum = (obj.seasonInfo && obj.seasonInfo.type === 'season') ? obj.seasonInfo.num : 0;\\n                        function nameOf(item) { return (item.vod_name || '').replace(/\\\\s+/g, ''); }\\n                        function hasBase(n) { return n.indexOf(obj.baseName) >= 0; }\\n                        function seasonMark(n, num) {\\n                            if (!num) return false;\\n                            var cnMap = ['','一','二','三','四','五','六','七','八','九','十'];\\n                            var cn = cnMap[num] || '';\\n                            var pad = num < 10 ? ('0' + num) : String(num);\\n                            var reParts = ['S0*' + num + '(?!\\\\\\\\d)', '第\\\\\\\\s*' + num + '\\\\\\\\s*[季部]', num + '\\\\\\\\s*[季部]'];\\n                            if (cn) reParts.push('第\\\\\\\\s*' + cn + '\\\\\\\\s*[季部]', cn + '\\\\\\\\s*[季部]');\\n                            if (num === 1) reParts.push('S0*1(?!\\\\\\\\d)');\\n                            var re = new RegExp(reParts.join('|'), 'i');\\n                            return re.test(n) || n.indexOf('S' + pad) >= 0;\\n                        }\\n                        function isPureName(n) {\\n                            var stripped = n.replace(/S\\\\d+/gi, '').replace(/第[一二三四五六七八九十百千\\\\d]+[季部]/g, '').replace(/[一二三四五六七八九十百千\\\\d]+[季部]/g, '');\\n                            return stripped.replace(/\\\\s+/g, '') === obj.baseName;\\n                        }\\n                        var matched = null;\\n                        for (var j = 0; j < json.list.length; j++) {\\n                            if (nameOf(json.list[j]) === obj.cleanMovieName) { matched = json.list[j]; break; }\\n                        }\\n                        if (!matched && seasonNum >= 2) {\\n                            for (var j2 = 0; j2 < json.list.length; j2++) {\\n                                var n = nameOf(json.list[j2]);\\n                                if (hasBase(n) && seasonMark(n, seasonNum)) { matched = json.list[j2]; break; }\\n                            }\\n                        } else if (!matched && seasonNum === 1) {\\n                            for (var jS = 0; jS < json.list.length; jS++) {\\n                                var nS = nameOf(json.list[jS]);\\n                                if (hasBase(nS) && seasonMark(nS, 1)) { matched = json.list[jS]; break; }\\n                            }\\n                            if (!matched) {\\n                                for (var jP = 0; jP < json.list.length; jP++) {\\n                                    var nP = nameOf(json.list[jP]);\\n                                    if (hasBase(nP) && isPureName(nP)) { matched = json.list[jP]; break; }\\n                                }\\n                            }\\n                            if (!matched) {\\n                                for (var jL = 0; jL < json.list.length; jL++) {\\n                                    var nL = nameOf(json.list[jL]);\\n                                    if (hasBase(nL) || obj.baseName.indexOf(nL) >= 0) { matched = json.list[jL]; break; }\\n                                }\\n                            }\\n                            if (!matched) matched = json.list[0];\\n                        } else if (!matched && seasonNum === 0) {\\n                            for (var j3 = 0; j3 < json.list.length; j3++) {\\n                                var n2 = nameOf(json.list[j3]);\\n                                if (hasBase(n2) || obj.baseName.indexOf(n2) >= 0) { matched = json.list[j3]; break; }\\n                            }\\n                            if (!matched) matched = json.list[0];\\n                        }\\n                        if (matched && matched.vod_play_url) {\\n                            var playFroms = matched.vod_play_from ? matched.vod_play_from.split('$$$') : ['默认'];\\n                            var playUrls = matched.vod_play_url.split('$$$');\\n                            var results = [];\\n                            for (var f = 0; f < playUrls.length; f++) {\\n                                var sourceName = obj.name;\\n                                if (playFroms.length > 1) sourceName += '-' + (playFroms[f] || '线路' + (f + 1));\\n                                var epList = playUrls[f].split('#').filter(function(e) { return e; });\\n                                if (epList.length > 0) {\\n                                    results.push({\\n                                        name: sourceName, key: 'bc_' + obj.key + '_' + f, type: 'bocai',\\n                                        epCount: epList.length, playFrom: playFroms[f] || '默认',\\n                                        playUrl: playUrls[f], siteKey: obj.key\\n                                    });\\n                                }\\n                            }\\n                            return results;\\n                        }\\n                    }\\n                } catch (e) {}\\n                return [];\\n            },\\n            param: { api: site.api, name: site.name, key: key, movieName: movieName, searchName: searchName, cleanMovieName: cleanMovieName, baseName: norm.baseName, seasonInfo: norm.seasonInfo },\\n            id: 'bc_' + key\\n        });\\n    }\\n    return tasks;\\n}\\n\\nfunction buildRuleTasks(movieName) {\\n    var tasks = [];\\n    try {\\n        var cr = $.require(\\\"customRule\\\");\\n        var norm = normalizeTitle(movieName);\\n        var searchKeys = norm.searchKeys;\\n        var searchRules = cr.getSearchCapableRules();\\n        for (var ci = 0; ci < searchRules.length; ci++) {\\n            var rule = searchRules[ci];\\n            tasks.push({\\n                func: function(obj) {\\n                    var results = [];\\n                    try {\\n                        var cr2 = $.require(\\\"customRule\\\");\\n                        var customResults = null;\\n                        for (var si = 0; si < obj.searchKeys.length; si++) {\\n                            try {\\n                                var sr = cr2.executeSearch(obj.rule, obj.searchKeys[si]);\\n                                if (sr && sr.length > 0) { customResults = sr; break; }\\n                            } catch(e) {}\\n                        }\\n                        if (!customResults || customResults.length === 0) return results;\\n                        for (var vi = 0; vi < customResults.length; vi++) {\\n                            var vItem = customResults[vi] || {};\\n                            var vTitle = vItem.title || vItem.desc || '';\\n                            if (vItem.col_type === 'text_center_1' && /验证|人机|captcha|verify|楠岃瘉|浜烘満/i.test(vTitle)) {\\n                                return [{ _needVerify: true, ruleName: obj.ruleName, title: vTitle, url: vItem.url || '' }];\\n                            }\\n                        }\\n                        var hasPanUrl = false;\\n                        for (var hp = 0; hp < customResults.length; hp++) {\\n                            if (getPanType(customResults[hp].url || '')) { hasPanUrl = true; break; }\\n                        }\\n                        if (hasPanUrl) {\\n                            var panTypeGroups = {};\\n                            var matchedPanItems = [];\\n                            for (var cj = 0; cj < customResults.length; cj++) {\\n                                var crItem = customResults[cj];\\n                                var crUrl = crItem.url || '';\\n                                var crPwd = crItem.password || '';\\n                                var crTitle = crItem.title || '';\\n                                if (isPanBlocked(crTitle)) continue;\\n                                var pt = getPanType(crUrl);\\n                                if (!pt) continue;\\n                                if (obj.ruleName && obj.ruleName.indexOf('[盘]') !== -1 && ['baidu','quark','xunlei','uc','123','magnet'].indexOf(pt.type) === -1) continue;\\n                                var item = { title: crTitle, url: crUrl, pwd: crPwd, type: pt.type };\\n                                if (isTargetTitle(obj.movieName, crTitle)) matchedPanItems.push(item);\\n                            }\\n                            var finalPanItems = matchedPanItems;\\n                            for (var ci2 = 0; ci2 < finalPanItems.length; ci2++) {\\n                                var fi = finalPanItems[ci2];\\n                                if (!panTypeGroups[fi.type]) panTypeGroups[fi.type] = [];\\n                                var crData = base64Encode(JSON.stringify({url: fi.url, password: fi.pwd, type: fi.type}));\\n                                panTypeGroups[fi.type].push(fi.title + '$' + crData);\\n                            }\\n                            var ptKeys = Object.keys(panTypeGroups);\\n                            for (var ptk = 0; ptk < ptKeys.length; ptk++) {\\n                                var ptUrls = panTypeGroups[ptKeys[ptk]];\\n                                if (ptUrls.length > 0) {\\n                                    results.push({\\n                                        name: \\\"\\\\uD83D\\\\uDD0D\\\" + obj.ruleName,\\n                                        key: \\\"custom_\\\" + obj.ruleId + \\\"_\\\" + ptKeys[ptk],\\n                                        type: \\\"pan\\\",\\n                                        panType: ptKeys[ptk],\\n                                        epCount: ptUrls.length,\\n                                        playFrom: panTypeNames[ptKeys[ptk]] || ptKeys[ptk],\\n                                        playUrl: ptUrls.join(\\\"#\\\"),\\n                                        siteKey: \\\"custom_\\\" + obj.ruleId,\\n                                        ruleName: obj.ruleName\\n                                    });\\n                                }\\n                            }\\n                        } else {\\n                            var hasSeasonInSearch2 = obj.seasonInfo !== null;\\n                            for (var cj = 0; cj < customResults.length; cj++) {\\n                                var vr = customResults[cj];\\n                                if (vr && vr.playUrl) {\\n                                    var vrTitle = (vr.title || vr.name || '').replace(/\\\\s+/g, '');\\n                                    if (hasSeasonInSearch2 && vrTitle && !matchSeasonInfo(obj.movieName, vrTitle)) continue;\\n                                    results.push({\\n                                        name: \\\"\\\\uD83C\\\\uDFAC\\\" + obj.ruleName + (vr.name ? '-' + vr.name : ''),\\n                                        key: vr.key || (\\\"custom_\\\" + obj.ruleId + \\\"_\\\" + cj),\\n                                        type: \\\"custom\\\",\\n                                        epCount: vr.epCount || 0,\\n                                        playFrom: vr.playFrom || obj.ruleName,\\n                                        playUrl: vr.playUrl,\\n                                        siteKey: vr.siteKey || (\\\"custom_\\\" + obj.ruleId),\\n                                        ruleName: obj.ruleName\\n                                    });\\n                                }\\n                            }\\n                            var urlResults = [];\\n                            for (var cj = 0; cj < customResults.length; cj++) {\\n                                var vr = customResults[cj];\\n                                if (vr && vr.url && !vr.playUrl) urlResults.push(vr);\\n                            }\\n                            if (urlResults.length > 0) {\\n                                var matched = null;\\n                                for (var mj = 0; mj < urlResults.length; mj++) {\\n                                    var vrTitle = (urlResults[mj].title || urlResults[mj].name || '').replace(/\\\\s+/g, '');\\n                                    if (vrTitle === obj.cleanName || vrTitle === obj.baseName) {\\n                                        matched = urlResults[mj];\\n                                        break;\\n                                    }\\n                                }\\n                                if (!matched) {\\n                                    for (var mj2 = 0; mj2 < urlResults.length; mj2++) {\\n                                        var vrTitle2 = (urlResults[mj2].title || urlResults[mj2].name || '').replace(/\\\\s+/g, '');\\n                                        var normT = vrTitle2.replace(/第[一二三四五六七八九十百千\\\\d]+[季部集期]/gi, '').replace(/年番\\\\d*/g, '').replace(/\\\\bS\\\\d+\\\\b/gi, '');\\n                                        if (normT === obj.baseName && matchSeasonInfo(obj.movieName, vrTitle2)) {\\n                                            matched = urlResults[mj2];\\n                                            break;\\n                                        }\\n                                    }\\n                                }\\n                                if (!matched) {\\n                                    var hasSeasonInSearch = obj.seasonInfo !== null;\\n                                    for (var mj3 = 0; mj3 < urlResults.length; mj3++) {\\n                                        var vrTitle3 = (urlResults[mj3].title || urlResults[mj3].name || '').replace(/\\\\s+/g, '');\\n                                        var normT2 = vrTitle3.replace(/第[一二三四五六七八九十百千\\\\d]+[季部集期]/gi, '').replace(/年番\\\\d*/g, '').replace(/\\\\bS\\\\d+\\\\b/gi, '');\\n                                        if (normT2 === obj.baseName || obj.baseName.indexOf(normT2) !== -1 || normT2.indexOf(obj.baseName) !== -1) {\\n                                            if (hasSeasonInSearch && !matchSeasonInfo(obj.movieName, vrTitle3)) continue;\\n                                            matched = urlResults[mj3];\\n                                            break;\\n                                        }\\n                                    }\\n                                }\\n                                if (!matched && urlResults.length === 1) {\\n                                    var singleTitle = (urlResults[0].title || urlResults[0].name || '').replace(/\\\\s+/g, '');\\n                                    var hasSeasonInSingle = obj.seasonInfo !== null;\\n                                    if (!hasSeasonInSingle || matchSeasonInfo(obj.movieName, singleTitle)) {\\n                                        matched = urlResults[0];\\n                                    }\\n                                }\\n                                if (matched && matched.url) {\\n                                    try {\\n                                        var detail2 = cr2.executeDetail(obj.rule, matched.url);\\n                                        if (detail2 && detail2.line && detail2.list) {\\n                                            var sources = cr2.detailToSources(obj.rule, detail2, '');\\n                                            for (var si = 0; si < sources.length; si++) {\\n                                                var src = sources[si];\\n                                                if (src.type === 'pan') {\\n                                                    var filteredPlayUrl = filterPanPlayUrlByTitle(src.playUrl, obj.movieName);\\n                                                    if (!filteredPlayUrl) continue;\\n                                                    var filteredEpCount = filteredPlayUrl.split('#').filter(function(e) { return e; }).length;\\n                                                    results.push({\\n                                                        name: src.name,\\n                                                        key: \\\"custom_\\\" + obj.ruleId + \\\"_pan_\\\" + si,\\n                                                        type: \\\"pan\\\",\\n                                                        panType: 'custom_pan',\\n                                                        epCount: filteredEpCount,\\n                                                        playFrom: src.playFrom,\\n                                                        playUrl: filteredPlayUrl,\\n                                                        siteKey: \\\"custom_\\\" + obj.ruleId,\\n                                                        ruleName: obj.ruleName\\n                                                    });\\n                                                } else {\\n                                                    results.push({\\n                                                        name: src.name,\\n                                                        key: \\\"custom_\\\" + obj.ruleId + \\\"_\\\" + si,\\n                                                        type: \\\"custom\\\",\\n                                                        epCount: src.epCount,\\n                                                        playFrom: src.playFrom,\\n                                                        playUrl: src.playUrl,\\n                                                        siteKey: \\\"custom_\\\" + obj.ruleId,\\n                                                        ruleName: obj.ruleName,\\n                                                        _ruleId: src._ruleId,\\n                                                        _sourceApi: src._sourceApi\\n                                                    });\\n                                                }\\n                                            }\\n                                        }\\n                                    } catch(e4) {}\\n                                }\\n                            }\\n                        }\\n                    } catch(e2) {}\\n                    return results;\\n                },\\n                param: { rule: rule, ruleId: rule.id, ruleName: rule.name, searchKeys: (rule.name && rule.name.indexOf('[盘]') !== -1 && norm.baseName && norm.baseName !== norm.cleanName) ? [norm.baseName, norm.cleanName] : searchKeys, cleanName: norm.cleanName, baseName: norm.baseName, seasonInfo: norm.seasonInfo },\\n                id: 'rule_' + rule.id\\n            });\\n        }\\n    } catch(e3) {}\\n    return tasks;\\n}\\n\\nfunction isYoukuDirectLink(url) {\\n    if (!url) return false;\\n    return url.includes('valipl.cp31.ott.cibntv.net') ||\\n           url.includes('youku.com') ||\\n           url.includes('ykimg.com') ||\\n           url.includes('cibntv.net');\\n}\\n\\nvar SOURCE_PRIORITY = { '腾讯视频': 1, '爱奇艺视频': 2, '优酷视频': 3, '芒果TV': 4, '哔哩哔哩': 5 };\\n\\nfunction getEpisodes(doubanId) {\\n    try {\\n        var cacheKey = 'ep_cache_' + doubanId;\\n        var cached = getMyVar(cacheKey, '');\\n        if (cached) {\\n            try {\\n                var data = JSON.parse(cached);\\n                if (data.ts && (Date.now() - data.ts < 2 * 60 * 60 * 1000)) {\\n                    return data.data;\\n                }\\n            } catch (e) {}\\n        }\\n        var cookieCache = 'hiker://files/cache/doubancookie.txt';\\n        var headers = { \\\"User-Agent\\\": \\\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\\\" };\\n        if (fileExist(cookieCache)) {\\n            headers[\\\"Cookie\\\"] = fetch(cookieCache);\\n        }\\n        var html = fetch('https://movie.douban.com/subject/' + doubanId + '/', { headers: headers });\\n        if (!html) return { update: '获取失败', playList: null };\\n        var sources_list = html.match(/sources\\\\[(1|3|7|8|9|17)\\\\][\\\\s\\\\S]*?\\\\]/g);\\n        if (!sources_list) {\\n            var script_list = parseDomForArray(html, 'body&&script[src]');\\n            var sources_url = '';\\n            for (var i in script_list) {\\n                var url = parseDomForHtml(script_list[i], 'script&&src');\\n                if (url.indexOf('mixed_static') !== -1) sources_url = url;\\n            }\\n            if (sources_url) {\\n                sources_list = request(sources_url).match(/sources\\\\[(1|3|7|8|9|17)\\\\][\\\\s\\\\S]*?\\\\]/g);\\n            }\\n        }\\n        var sources_title = ['', '腾讯视频', '', '优酷视频', '', '', '', '芒果TV', '哔哩哔哩', '爱奇艺视频', '', '', '', '', '', '', '', '西瓜视频'];\\n        if (!sources_list) return { update: '暂时未获取到更新情况', playList: null };\\n        var sources = {};\\n        sources_list.map(function(item) { eval(unescape(item)); });\\n        var playList = [];\\n        for (var i in sources) {\\n            if (sources[i] != null) {\\n                playList.push({\\n                    title: sources_title[i],\\n                    list: sources[i].map(function(item) {\\n                        return {\\n                            play_link: parseQueryString(item.play_link).url,\\n                            ep: '第' + item.ep + '集',\\n                            epNum: Number(item.ep)\\n                        };\\n                    })\\n                });\\n            }\\n        }\\n        playList.sort(function(a, b) {\\n            var pa = SOURCE_PRIORITY[a.title] || 99;\\n            var pb = SOURCE_PRIORITY[b.title] || 99;\\n            return pa - pb;\\n        });\\n        var update = playList.map(function(item) {\\n            return item.title + '更新至' + item.list[item.list.length - 1].ep;\\n        }).join('｜');\\n        var result = { update: update, playList: playList };\\n        putMyVar(cacheKey, JSON.stringify({ ts: Date.now(), data: result }));\\n        return result;\\n    } catch (e) {\\n        log('getEpisodes失败: ' + e.message);\\n        return { update: '获取失败', playList: null };\\n    }\\n}\\n\\nfunction getExternalDanmuConfig() {\\n    var config = { mode: 'box', sources: [], platform: '', timeout: 5000 };\\n    try {\\n        var raw = readFile(\\\"hiker://files/rules/青豆剧场/qd_configs\\\") || '{}';\\n        var saved = JSON.parse(raw);\\n        config.mode = saved.danmu_mode === 'external' ? 'external' : saved.danmu_mode === 'off' ? 'off' : saved.danmu_mode === 'local' ? 'local' : 'box';\\n        config.platform = String(saved.danmu_platform || '').trim();\\n        config.timeout = (parseInt(saved.danmu_timeout, 10) || 3) * 1000;\\n        config.sources = (saved.danmu_sources || []).filter(function(item) { return item && item.url && item.enabled === true; });\\n    } catch (e) {}\\n    return config;\\n}\\n\\nfunction saveExternalDanmuJson(url, config, key) {\\n    var _dmLbl = (config && config.mode === 'local') ? '本地弹幕' : '外接弹幕';\\n    try {\\n        var raw = fetch(url, { timeout: config.timeout }) || '';\\n        if (!raw) { try { log('【' + _dmLbl + '内容超时】url=' + url); } catch (e) {} return ''; }\\n        var data = JSON.parse(raw);\\n        var comments = Array.isArray(data) ? data : (data.comments || []);\\n        var list = comments.map(function(item) {\\n            return { text: String(item.m || item.text || ''), time: Number(item.t != null ? item.t : item.time) || 0 };\\n        }).filter(function(item) { return item.text; });\\n        if (!list.length) return '';\\n        var file = 'hiker://files/rules/青豆剧场/external_danmu_' + String(key).replace(/[^a-zA-Z0-9_-]/g, '_') + '.json';\\n        saveFile(file, JSON.stringify(list));\\n        try { log('【' + _dmLbl + '加载】url=' + file + ' count=' + list.length); } catch (e) {}\\n        return file;\\n    } catch (e) {\\n        try { log('【' + _dmLbl + '内容异常】' + e.message); } catch (ignore) {}\\n        return '';\\n    }\\n}\\n\\nfunction cleanDanmuKeyword(title) {\\n    var s = String(title || '');\\n    if (!s) return '';\\n    // 括号内清晰度/年份/标签\\n    s = s.replace(/[【\\\\[\\\\(（][^】\\\\]\\\\)）]*(?:4K|8K|1080P?|2160P?|720P?|HDR|HDR10|杜比|臻彩|高码|国语|粤语|日语|英语|中字|双语|港版|台版|抢先|未删减|导演剪辑|加长|无删减|Remastered|重制|修复|BluRay|WEB[- ]?DL|WEBRip|HDTV|BDRip|DVDRip)[^】\\\\]\\\\)）]*[】\\\\]\\\\)）]/gi, '');\\n    s = s.replace(/[【\\\\[\\\\(（]\\\\s*(19|20)\\\\d{2}\\\\s*[】\\\\]\\\\)）]/g, '');\\n    // 副标题\\n    s = s.replace(/\\\\s*[:：\\\\-–—]\\\\s*.+$/, '');\\n    // 季号 / Season / 第X季 / X季 / X部\\n    s = s.replace(/\\\\bSeason\\\\s*\\\\d+\\\\b/gi, '');\\n    s = s.replace(/\\\\bS0*\\\\d+(?:E0*\\\\d+)?\\\\b/gi, '');\\n    s = s.replace(/第\\\\s*[一二三四五六七八九十百千0-9]+\\\\s*[季部]/g, '');\\n    s = s.replace(/[一二三四五六七八九十0-9]+\\\\s*[季部]/g, '');\\n    // 尾部年份\\n    s = s.replace(/\\\\s*[\\\\(（\\\\[【]?\\\\s*(19|20)\\\\d{2}\\\\s*[\\\\)）\\\\]】]?\\\\s*$/, '');\\n    // 常见清晰度/语言尾标（未在括号里）\\n    s = s.replace(/\\\\b(4K|8K|1080P?|2160P?|720P?|HDR|HDR10|杜比|臻彩|高码|国语|粤语|日语|英语|中字|双语|港版|台版|抢先|未删减|导演剪辑|加长|无删减|Remastered|重制|修复|BluRay|WEB[- ]?DL|WEBRip|HDTV|BDRip|DVDRip)\\\\b/gi, '');\\n    // 全角空格 & 多空白\\n    s = s.replace(/\\\\s+/g, ' ').trim();\\n    // 去掉首尾多余标点\\n    s = s.replace(/^[\\\\s\\\\-·•_,.。、]+|[\\\\s\\\\-·•_,.。、]+$/g, '');\\n    return s || String(title || '');\\n}\\n\\nfunction getExternalDanmuUrl(playLink, title, fileName, episodeTitle) {\\n    var config = getExternalDanmuConfig();\\n    var dmLabel = config.mode === 'local' ? '本地弹幕' : '外接弹幕';\\n    try { log('【' + dmLabel + '调试】mode=' + config.mode + ' sources=' + config.sources.length + ' title=' + (title || '') + ' fileName=' + (fileName || '') + ' episode=' + (episodeTitle || '')); } catch (e) {}\\n    if (config.mode !== 'external' && config.mode !== 'local') return '';\\n    var base;\\n    if (config.mode === 'local') {\\n        base = 'http://localhost:9321';\\n        try {\\n            var test = JSON.parse(fetch(base + '/api/config', {timeout: 2000}) || '{}');\\n            if (!test || !test.repository || test.repository.indexOf('danmu_api') < 0) return '';\\n        } catch(e) { return ''; }\\n    } else {\\n        if (config.sources.length === 0) return '';\\n        base = config.sources[0].url.replace(/\\\\/$/, '');\\n    }\\n    if (fileName) {\\n        var matchText = fileName + (config.platform ? ' @' + config.platform : '');\\n        try {\\n            var matchedRaw = fetch(base + '/api/v2/match', { method: 'POST', body: JSON.stringify({ fileName: matchText }), headers: { 'Content-Type': 'application/json' }, timeout: config.timeout }) || '';\\n            var matched = JSON.parse(matchedRaw || '{}');\\n            try { log('【' + dmLabel + '文件匹配】keyword=' + matchText + ' matches=' + ((matched.matches || []).length)); } catch (e) {}\\n            if (matched.matches && matched.matches[0] && matched.matches[0].episodeId) return saveExternalDanmuJson(base + '/api/v2/comment/' + matched.matches[0].episodeId + '?format=json', config, matched.matches[0].episodeId);\\n        } catch (e) { try { log('【' + dmLabel + '文件匹配异常】' + e.message); } catch (ignore) {} }\\n    } else if (/^https?:\\\\/\\\\/(?:[^/]+\\\\.)?(?:iqiyi\\\\.com|v\\\\.qq\\\\.com|youku\\\\.com|mgtv\\\\.com|bilibili\\\\.com|miguvideo\\\\.com|sohu\\\\.com|le\\\\.com|pptv\\\\.com)\\\\//i.test(playLink || '')) {\\n        try { log('【' + dmLabel + '官方链接】' + playLink); } catch (e) {}\\n        return saveExternalDanmuJson(base + '/api/v2/comment?url=' + encodeURIComponent(playLink) + '&format=json', config, encodeURIComponent(playLink));\\n    } else if (title) {\\n        var episodeMatch = String(episodeTitle || '').match(/(?:第\\\\s*)?(\\\\d+)(?:\\\\s*[集话期章])?/);\\n        var episode = episodeMatch ? String(parseInt(episodeMatch[1], 10)) : (episodeTitle || '');\\n        var searchAnime = cleanDanmuKeyword(title);\\n        try {\\n            var searchUrl = base + '/api/v2/search/episodes?anime=' + encodeURIComponent(searchAnime) + (episode ? '&episode=' + encodeURIComponent(episode) : '');\\n            var searchRaw = fetch(searchUrl, { timeout: config.timeout }) || '';\\n            try { log('【' + dmLabel + '搜索响应】url=' + searchUrl + ' length=' + searchRaw.length + ' body=' + searchRaw.substring(0, 200)); } catch (e) {}\\n            var searchData = JSON.parse(searchRaw || '{}');\\n            var candidates = [];\\n            (searchData.animes || []).forEach(function(anime) { (anime.episodes || []).forEach(function(ep) { candidates.push(ep); }); });\\n            if (config.platform) {\\n                var preferred = candidates.filter(function(ep) { return String(ep.episodeTitle || '').toLowerCase().indexOf(config.platform.toLowerCase()) >= 0; });\\n                if (preferred.length) candidates = preferred;\\n            }\\n            try { log('【' + dmLabel + '剧集搜索】title=' + title + ' anime=' + searchAnime + ' episode=' + episode + ' matches=' + candidates.length); } catch (e) {}\\n            if (candidates[0] && candidates[0].episodeId) return saveExternalDanmuJson(base + '/api/v2/comment/' + candidates[0].episodeId + '?format=json', config, candidates[0].episodeId);\\n        } catch (e) { try { log('【' + dmLabel + '剧集搜索异常】' + e.message); } catch (ignore) {} }\\n    }\\n    try { log('【' + dmLabel + '结果】未匹配到弹幕'); } catch (e) {}\\n    return '';\\n}\\n\\nfunction parseWithConfig(playLink, danmaku, title, episodeTitle) {\\n    log('【解析调用】来源: ' + (danmaku ? '官方源' : '嗅探/其他') + ' | 链接: ' + playLink.substring(0, 60));\\n    var CONFIG_FILE = \\\"hiker://files/rules/青豆剧场/qd_configs\\\";\\n    var parses = [];\\n    try {\\n        if (fileExist(CONFIG_FILE)) {\\n            var fullConfig = JSON.parse(readFile(CONFIG_FILE) || '{}');\\n            parses = fullConfig.parses || [];\\n        }\\n    } catch (e) {\\n        parses = [];\\n    }\\n    var enabledParse = parses.filter(function(p) { return p.enabled !== false; });\\n    var defaultHeaders = { \\\"Referer\\\": playLink, \\\"User-Agent\\\": \\\"Mozilla/5.0\\\" };\\n    var dmMode = getExternalDanmuConfig().mode;\\n    if (/\\\\[画\\\\]/.test(title) || /\\\\[音\\\\]/.test(title)) dmMode = 'off';\\n    var externalDm = (dmMode === 'external' || dmMode === 'local') ? getExternalDanmuUrl(playLink, title, '', episodeTitle) : '';\\n    var dmPath = dmMode === 'off' ? '' : externalDm;\\n    var dmSource = externalDm ? (dmMode === 'local' ? '本地弹幕' : '外接弹幕') : '';\\n    if (!dmPath && dmMode === 'box') {\\n        try {\\n            var dmFun = $.require('hiker://page/dmFun?rule=dm盒子');\\n            dmPath = dmFun.dmRoute(playLink);\\n            if (dmPath === false) dmPath = getVar('dm_share') || \\\"\\\";\\n            if (dmPath) dmSource = '弹幕盒子';\\n        } catch (e) {\\n            dmPath = getVar('dm_share') || \\\"\\\";\\n            if (dmPath) dmSource = '弹幕盒子';\\n        }\\n    }\\n    if (dmPath) log('弹幕获取完毕[' + (dmSource || '弹幕盒子') + ']');\\n\\n    if (enabledParse.length === 0) {\\n        if (parses.length === 0) {\\n            return 'toast://⚠️ 未配置解析接口，请先在解析管理页面添加解析';\\n        }\\n        return JSON.stringify({\\n            names: [\\\"默认嗅探\\\"],\\n            urls: [\\\"video://\\\" + playLink + \\\"#isVideo=true#\\\"],\\n            danmu: dmPath,\\n            headers: [defaultHeaders]\\n        });\\n    }\\n\\n    function extractUserJs(jsCode) {\\n        if (!jsCode || !jsCode.trim()) return \\\"\\\";\\n        try {\\n            var parsed = JSON.parse(jsCode);\\n            if (parsed.js) return parsed.js;\\n        } catch (e) {}\\n        return jsCode;\\n    }\\n\\n    var names = [];\\n    var urls = [];\\n    var headers = [];\\n    var extras = [];\\n\\n    for (var i = 0; i < enabledParse.length; i++) {\\n        var p = enabledParse[i];\\n\\n        if (p.type === \\\"X\\\") {\\n            names.push(p.name + \\\" [W]\\\");\\n            urls.push(\\\"video://\\\" + p.url + playLink + \\\"#isVideo=true#\\\");\\n            headers.push(defaultHeaders);\\n            extras.push({\\n                blockRules: ['*.png', '*.jpg', '*.gif', '*.css', '*ads*'],\\n                cacheM3u8: true\\n            });\\n            continue;\\n        }\\n\\n        if (p.type === \\\"J\\\") {\\n            var userJs = extractUserJs(p.jsCode || \\\"\\\");\\n            if (!userJs) continue;\\n            names.push(p.name + \\\" [JS]\\\");\\n            urls.push(\\\"webRule://\\\" + p.url + playLink + \\\"#isVideo=true#@\\\" + userJs);\\n            headers.push(defaultHeaders);\\n            extras.push({\\n                blockRules: ['*.png', '*.jpg', '*.gif', '*.css', '*ads*'],\\n                cacheM3u8: true\\n            });\\n            continue;\\n        }\\n\\n        if (p.type === \\\"Z\\\") {\\n            try {\\n                var res = fetch(p.url + playLink);\\n                if (!res || res.trim() === '') continue;\\n                var json = JSON.parse(res);\\n                var val = null;\\n                if (p.Names && p.Names.trim()) {\\n                    val = p.Names.split('.').reduce(function(obj, key) {\\n                        return (obj && obj[key] ? obj[key] : null);\\n                    }, json);\\n                }\\n                if (!val) val = json.url;\\n                if (typeof val !== 'string' || !val.trim()) continue;\\n                var directUrl = val.trim().startsWith('//') ? 'https:' + val.trim() : val.trim();\\n                if (!directUrl.startsWith('http')) continue;\\n\\n                var isYouku = (json.msg && json.msg.includes('优酷直连')) || isYoukuDirectLink(directUrl);\\n                var isM3u8 = directUrl.includes('m3u8');\\n                var finalUrlToPlay = directUrl;\\n                var finalHeaders = defaultHeaders;\\n\\n                if (isYouku && isM3u8) {\\n                    var youkuHeaders = {\\n                        'User-Agent': 'Mozilla/5.0 (Linux; Android 12; SM-G998B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/116.0.5845.92 Mobile Safari/537.36 YKApp/9.8.0 (Youku)',\\n                        'Referer': playLink\\n                    };\\n                    try {\\n                        var randomFileName = 'm3u8_' + Date.now() + '_' + Math.random().toString(36).substring(2) + '.m3u8';\\n                        var cachedPath = cacheM3u8(directUrl, youkuHeaders, randomFileName);\\n                        if (cachedPath && cachedPath.startsWith('file://')) {\\n                            finalUrlToPlay = cachedPath.split('##')[0];\\n                            finalHeaders = {};\\n                        } else {\\n                            finalHeaders = youkuHeaders;\\n                        }\\n                    } catch (e) {\\n                        finalHeaders = youkuHeaders;\\n                    }\\n                }\\n\\n                var playerUrl;\\n                if (finalUrlToPlay.startsWith('file://') && isM3u8) {\\n                    playerUrl = \\\"video://\\\" + finalUrlToPlay + \\\"#isVideo=true#\\\";\\n                } else {\\n                    playerUrl = finalUrlToPlay + '#original=' + encodeURIComponent(playLink) + \\\"&url=\\\" + playLink;\\n                }\\n\\n                names.push(p.name + \\\" [解]\\\");\\n                urls.push(playerUrl);\\n                headers.push(finalHeaders);\\n                extras.push({});\\n            } catch (e) {\\n                log('【JSON直链】解析失败: ' + e.message);\\n                continue;\\n            }\\n            continue;\\n        }\\n    }\\n\\n    if (names.length === 0) {\\n        return JSON.stringify({\\n            names: [\\\"默认嗅探\\\"],\\n            urls: [\\\"video://\\\" + playLink + \\\"#isVideo=true#\\\"],\\n            danmu: dmPath,\\n            headers: [defaultHeaders],\\n            extras: [{}]\\n        });\\n    }\\n\\n    return JSON.stringify({\\n        names: names,\\n        urls: urls,\\n        danmu: dmPath,\\n        headers: headers,\\n        extras: extras\\n    });\\n}\\n\\nfunction buildPlayUrl(playLink, sourceName, sourceKey, playFlag, title, episodeTitle) {\\n    if (!playLink || playLink === 'undefined' || playLink === 'null' || playLink === 'hiker://empty') {\\n        return 'toast://播放地址无效';\\n    }\\n    if (!title) { try { title = MY_PARAMS && MY_PARAMS.vodName ? MY_PARAMS.vodName : ''; } catch (e) { title = ''; } }\\n    var platformKeywords = [\\\"哔哩\\\", \\\"腾讯\\\", \\\"芒果\\\", \\\"奇艺\\\", \\\"优酷\\\"];\\n    var isPlatformSource = false;\\n    if (sourceName) {\\n        for (var i = 0; i < platformKeywords.length; i++) {\\n            if (sourceName.indexOf(platformKeywords[i]) !== -1) {\\n                isPlatformSource = true;\\n                break;\\n            }\\n        }\\n    }\\n    if (!isPlatformSource) {\\n        try {\\n            var DrpyManage = GM.defineModule(\\\"DrpyManage\\\");\\n            var drpy = DrpyManage.get(sourceKey);\\n            if (drpy) {\\n                var playRes = drpy.play(playFlag || '', playLink, []);\\n                var playObj = JSON.parse(playRes);\\n                var playUrl = playObj.url || playLink;\\n                if (playObj.parse === 0) {\\n                    var result = { urls: [playUrl + \\\"#isVideo=true#\\\"] };\\n                    if (playObj.header) result.headers = [playObj.header];\\n                    var dmMode = getExternalDanmuConfig().mode;\\n                    if (/\\\\[画\\\\]/.test(sourceName) || /\\\\[音\\\\]/.test(sourceName)) dmMode = 'off';\\n                    result.danmu = (dmMode === 'external' || dmMode === 'local') ? getExternalDanmuUrl(playUrl, title || sourceName, '', episodeTitle) : '';\\n                    if (playObj.lyric) result.lyric = playObj.lyric;\\n                    return JSON.stringify(result);\\n                } else if (playObj.jx === 1) {\\n                    return parseWithConfig(playUrl, '', title || sourceName, episodeTitle);\\n                } else {\\n                    return \\\"video://\\\" + playUrl;\\n                }\\n            }\\n        } catch (e) {\\n            log('【drpy播放】解析失败: ' + e.message);\\n        }\\n        return \\\"video://\\\" + playLink;\\n    }\\n    return parseWithConfig(playLink, '', title || sourceName, episodeTitle);\\n}\\n\\nvar panTypeNames = {\\\"baidu\\\": \\\"百度网盘\\\",  \\\"quark\\\": \\\"夸克网盘\\\", \\\"xunlei\\\": \\\"迅雷网盘\\\", \\\"uc\\\": \\\"UC网盘\\\", \\\"123\\\": \\\"123云盘\\\", \\\"magnet\\\": \\\"磁力链接\\\"};\\nvar panTypeIcons = {\\\"baidu\\\": \\\"🔵\\\",  \\\"quark\\\": \\\"🟠\\\", \\\"xunlei\\\": \\\"🟤\\\", \\\"uc\\\": \\\"🟣\\\", \\\"123\\\": \\\"🟢\\\", \\\"magnet\\\": \\\"🧲\\\"};\\nvar panPatterns = [\\n    { re: /pan\\\\.baidu\\\\.com\\\\/s\\\\//i, type: 'baidu', name: '百度网盘', icon: '🔵' },\\n    { re: /pan\\\\.quark\\\\.cn\\\\/s\\\\//i, type: 'quark', name: '夸克网盘', icon: '🟠' },\\n    { re: /drive\\\\.uc\\\\.cn\\\\/s\\\\//i, type: 'uc', name: 'UC网盘', icon: '🟣' },\\n    { re: /pan\\\\.xunlei\\\\.com\\\\/s\\\\//i, type: 'xunlei', name: '迅雷网盘', icon: '🟤' },\\n    { re: /123[\\\\w]*\\\\.(?:com|cn)\\\\/(?:s\\\\/|123pan\\\\/|share\\\\/)/i, type: '123', name: '123云盘', icon: '🟢' },\\n    { re: /magnet:\\\\?xt=/i, type: 'magnet', name: '磁力链接', icon: '🧲' }\\n];\\nvar panBlockWords = ['软件', '安卓', '合集', '汇总'];\\n\\nfunction getPanType(url) {\\n    if (!url) return null;\\n    for (var i = 0; i < panPatterns.length; i++) {\\n        if (panPatterns[i].re.test(url)) return panPatterns[i];\\n    }\\n    return null;\\n}\\n\\nvar panLoosePatterns = [\\n    { re: /pan\\\\.baidu\\\\.com/i, type: 'baidu' },\\n    { re: /pan\\\\.quark\\\\.cn/i, type: 'quark' },\\n    { re: /drive\\\\.uc\\\\.cn/i, type: 'uc' },\\n    { re: /pan\\\\.xunlei\\\\.com/i, type: 'xunlei' },\\n    { re: /123[\\\\w]*\\\\.(?:com|cn)/i, type: '123' },\\n    { re: /(?:aliyundrive\\\\.com|alipan\\\\.com)/i, type: 'quark' },\\n    { re: /magnet:\\\\?xt=/i, type: 'magnet' }\\n];\\nfunction getPanTypeLoose(url) {\\n    if (!url || typeof url !== 'string') return null;\\n    for (var i = 0; i < panLoosePatterns.length; i++) {\\n        if (panLoosePatterns[i].re.test(url)) return panLoosePatterns[i].type;\\n    }\\n    return null;\\n}\\n\\nfunction isPanBlocked(title) {\\n    if (!title) return false;\\n    for (var i = 0; i < panBlockWords.length; i++) {\\n        if (title.indexOf(panBlockWords[i]) >= 0) return true;\\n    }\\n    return false;\\n}\\n\\nfunction resolvePanJump(url) {\\n    if (typeof url !== 'string' || url.indexOf('pan://') !== 0) return url;\\n    var m = url.match(/^pan:\\\\/\\\\/([\\\\s\\\\S]+)#panType#(.+)$/);\\n    if (!m) return url;\\n    try {\\n        var panUrl = decodeURIComponent(m[1]);\\n    } catch (e) { panUrl = m[1]; }\\n    return openPanUrl(panUrl, m[2]);\\n}\\n\\nfunction openPanUrl(url, type, password) {\\n    var pwd = password || '';\\n    if (type === 'baidu') return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"baiduPan\\\").openShare(u, p); }, url, pwd);\\n    else if (type === 'quark') return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"quarkPan\\\").openShare(u, p); }, url, pwd);\\n    else if (type === 'uc') return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"ucPan\\\").openShare(u, p); }, url, pwd);\\n    else if (type === 'xunlei') return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"xunleiPan\\\").openShare(u, p); }, url, pwd);\\n    else if (type === '123') return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"pan123\\\").openShare(u, p); }, url, pwd);\\n    else if (type === 'magnet') return url;\\n    else return \\\"toast://暂不支持该网盘类型\\\";\\n}\\n\\nfunction openPanUrlWithContext(url, type, doubanId, sourceTitle, epIndex, epTitle) {\\n    var pwd = '';\\n    if (type === 'baidu') { var m=$.require(\\\"baiduPan\\\"); m._setMovieContext(doubanId,sourceTitle,epIndex,epTitle); return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"baiduPan\\\").openShare(u, p); }, url, pwd); }\\n    else if (type === 'quark') { var m=$.require(\\\"quarkPan\\\"); m._setMovieContext(doubanId,sourceTitle,epIndex,epTitle); return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"quarkPan\\\").openShare(u, p); }, url, pwd); }\\n    else if (type === 'uc') { var m=$.require(\\\"ucPan\\\"); m._setMovieContext(doubanId,sourceTitle,epIndex,epTitle); return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"ucPan\\\").openShare(u, p); }, url, pwd); }\\n    else if (type === 'xunlei') { var m=$.require(\\\"xunleiPan\\\"); m._setMovieContext(doubanId,sourceTitle,epIndex,epTitle); return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"xunleiPan\\\").openShare(u, p); }, url, pwd); }\\n    else if (type === '123') { var m=$.require(\\\"pan123\\\"); m._setMovieContext(doubanId,sourceTitle,epIndex,epTitle); return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function(u, p) { $.require(\\\"pan123\\\").openShare(u, p); }, url, pwd); }\\n    else if (type === 'magnet') return url;\\n    else return \\\"toast://暂不支持该网盘类型浏览\\\";\\n}\\n\\nfunction getPageSize() {\\n    var n = parseInt(getItem('qd_page_size', '40'));\\n    if (isNaN(n) || n < 1) n = 40;\\n    if (n > 200) n = 200;\\n    return n;\\n}\\n\\nfunction renderPagination(d, objId, markerPrefix, totalPages, currentPage, sortOrder, totalItems) {\\n    if (totalPages <= 1) return;\\n    var epOrderKey = markerPrefix + '_order_' + objId;\\n    var epPageKey = markerPrefix + '_ep_page_' + objId;\\n    var orderLabel = sortOrder === 'desc' ? '倒序' : '正序';\\n    var pageSize = getPageSize();\\n    var hasPrev = currentPage > 0;\\n    var hasNext = currentPage < totalPages - 1;\\n    d.push({ title: hasPrev ? '上一页' : '.', col_type: 'text_4', url: hasPrev ? $('#noLoading#').lazyRule(function(key, cur) { putMyVar(key, String(cur - 1)); refreshPage(false); return 'hiker://empty'; }, epPageKey, currentPage) : 'hiker://empty', extra: { cls: markerPrefix + '_ep', id: markerPrefix + '_pagination' } });\\n    d.push({ title: '第' + (currentPage + 1) + '/' + totalPages + '页 [\\\\u2018\\\\u2018' + orderLabel + '\\\\u2019\\\\u2019]', col_type: 'text_2', url: 'hiker://empty', extra: { cls: markerPrefix + '_ep' } });\\n    d.push({ title: hasNext ? '下一页' : '.', col_type: 'text_4', url: hasNext ? $('#noLoading#').lazyRule(function(key, cur) { putMyVar(key, String(cur + 1)); refreshPage(false); return 'hiker://empty'; }, epPageKey, currentPage) : 'hiker://empty', extra: { cls: markerPrefix + '_ep' } });\\n    if (totalPages > 1) {\\n        for (var pi = 0; pi < totalPages; pi++) {\\n            var rangeStart = pi * pageSize + 1;\\n            var rangeEnd = Math.min((pi + 1) * pageSize, totalItems || totalPages * pageSize);\\n            var isCurrentRange = (pi === currentPage);\\n            d.push({\\n                title: isCurrentRange ? '\\\\u2018\\\\u2018\\\\u2019\\\\u2019<b><font color=\\\"#FF5D50\\\">' + rangeStart + '-' + rangeEnd + '</font></b>' : '\\\\u2018\\\\u2018\\\\u2019\\\\u2019' + rangeStart + '-' + rangeEnd,\\n                col_type: 'scroll_button',\\n                url: $('#noLoading#').lazyRule(function(key, page) { putMyVar(key, String(page)); refreshPage(false); return 'hiker://empty'; }, epPageKey, pi),\\n                extra: { cls: markerPrefix + '_ep' }\\n            });\\n        }\\n    }\\n}\\n\\nfunction normalizeTitle(title) {\\n    var cleanName = (title || '').replace(/\\\\s+/g, '').trim();\\n    var baseName = cleanName;\\n    baseName = baseName.replace(/第[一二三四五六七八九十百千\\\\d]+[季部集期]/gi, '');\\n    baseName = baseName.replace(/[季部集期]\\\\d+/g, '');\\n    baseName = baseName.replace(/年番\\\\d*/g, '');\\n    baseName = baseName.replace(/\\\\bS\\\\d+\\\\s*(E\\\\d+)?\\\\b/gi, '');\\n    baseName = baseName.replace(/剧场版/g, '');\\n    baseName = baseName.replace(/OVA|OAD|SP/gi, '');\\n    baseName = baseName.replace(/特别[篇编]/g, '');\\n    baseName = baseName.replace(/番外[篇编]?/g, '');\\n    baseName = baseName.replace(/之.+/g, '');\\n    baseName = baseName.replace(/\\\\s+/g, '').trim();\\n    var searchKeys = [cleanName];\\n    if (baseName && baseName !== cleanName) searchKeys.push(baseName);\\n    var seasonInfo = extractSeasonInfo(cleanName);\\n    return { searchKeys: searchKeys, baseName: baseName, cleanName: cleanName, seasonInfo: seasonInfo };\\n}\\n\\nfunction filterByEpCount(results, officialEpCount) {\\n    if (!results || results.length === 0) return results;\\n    if (!officialEpCount || officialEpCount <= 0) return results;\\n    var filtered = [];\\n    for (var i = 0; i < results.length; i++) {\\n        var r = results[i];\\n        if (r.type === 'official' || r.type === 'pan' || r.type === 'pan_sub') {\\n            filtered.push(r);\\n            continue;\\n        }\\n        if (r.epCount > officialEpCount * 2) {\\n            log('集数过滤: 剔除 ' + (r.name || r.playFrom || r.key) + ' epCount=' + r.epCount + ' > 官方' + officialEpCount + '*2');\\n            continue;\\n        }\\n        filtered.push(r);\\n    }\\n    return filtered;\\n}\\n\\nfunction reviseEpTitle(str, vodName) {\\n    if (!str) return '';\\n    return str.replace(vodName || '', '').replace(/'|\\\"|<[^>]+>| |-|_|第|集|话|章|</g, '').replace(/（/g, '(').replace(/）/g, ')').trim() || str.trim();\\n}\\n\\nfunction autoEpColType(epNames) {\\n    var sampleNames = epNames.slice(0, 10).concat(epNames.slice(-10));\\n    var maxLen = 0;\\n    for (var i = 0; i < sampleNames.length; i++) {\\n        var len = (sampleNames[i] || '').length;\\n        if (len > maxLen) maxLen = len;\\n    }\\n    if (epNames.length > 4 && maxLen < 5) return 'text_4';\\n    if (maxLen > 10) return 'text_1';\\n    if (maxLen > 4 && maxLen < 7) return 'text_3';\\n    return 'text_2';\\n}\\n\\nfunction detectContentType(name) {\\n    var n = String(name || '');\\n    if (n.indexOf('[画]') >= 0) return 'comic';\\n    if (n.indexOf('[音]') >= 0) return 'audio';\\n    return 'video';\\n}\\n\\nfunction normalizeSearchText(text) {\\n    return (text || '')\\n        .replace(/^[^\\\\w\\\\u4e00-\\\\u9fa5]+|[^\\\\w\\\\u4e00-\\\\u9fa5]+$/g, '')\\n        .replace(/[^\\\\w\\\\u4e00-\\\\u9fa5]/g, '')\\n        .toLowerCase();\\n}\\n\\nfunction fuzzyMatch(searchText, targetText) {\\n    return normalizeSearchText(targetText).indexOf(normalizeSearchText(searchText)) >= 0;\\n}\\n\\nfunction searchAgg(kw) {\\n    var results = [];\\n    try {\\n        var cr = $.require(\\\"customRule\\\");\\n        var norm = normalizeTitle(kw);\\n        var searchKeys = norm.searchKeys;\\n        var searchRules = cr.getSearchCapableRules();\\n        for (var ci = 0; ci < searchRules.length; ci++) {\\n            var rule = searchRules[ci];\\n            var customResults = null;\\n            for (var si = 0; si < searchKeys.length; si++) {\\n                try {\\n                    var sr = cr.executeSearch(rule, searchKeys[si]);\\n                    if (sr && sr.length > 0) { customResults = sr; break; }\\n                } catch(e) { log(\\\"搜索规则[\\\" + rule.name + \\\"]关键词[\\\" + searchKeys[si] + \\\"]失败: \\\" + e.message); }\\n            }\\n            if (!customResults || customResults.length === 0) continue;\\n            try {\\n                var hasPanUrl = false;\\n                for (var hp = 0; hp < customResults.length; hp++) {\\n                    if (getPanType(customResults[hp].url || '')) { hasPanUrl = true; break; }\\n                }\\n                if (hasPanUrl) {\\n                    var panTypeGroups = {};\\n                    var matchedPanItems = [];\\n                    for (var cj = 0; cj < customResults.length; cj++) {\\n                        var cr2 = customResults[cj];\\n                        var crUrl = cr2.url || '';\\n                        var crPwd = cr2.password || '';\\n                        var crTitle = cr2.title || '';\\n                        if (isPanBlocked(crTitle)) continue;\\n                        var pt = getPanType(crUrl);\\n                        if (!pt) continue;\\n                        if (rule.name && rule.name.indexOf('[盘]') !== -1 && ['baidu','quark','xunlei','uc','123','magnet'].indexOf(pt.type) === -1) continue;\\n                        var item = { title: crTitle, url: crUrl, pwd: crPwd, type: pt.type };\\n                        if (isTargetTitle(kw, crTitle)) matchedPanItems.push(item);\\n                    }\\n                    var finalPanItems = matchedPanItems;\\n                    for (var ci2 = 0; ci2 < finalPanItems.length; ci2++) {\\n                        var fi = finalPanItems[ci2];\\n                        if (!panTypeGroups[fi.type]) panTypeGroups[fi.type] = [];\\n                        var crData = base64Encode(JSON.stringify({url: fi.url, password: fi.pwd, type: fi.type}));\\n                        panTypeGroups[fi.type].push(fi.title + '$' + crData);\\n                    }\\n                    var ptKeys = Object.keys(panTypeGroups);\\n                    for (var ptk = 0; ptk < ptKeys.length; ptk++) {\\n                        var ptUrls = panTypeGroups[ptKeys[ptk]];\\n                        if (ptUrls.length > 0) {\\n                            results.push({\\n                                name: \\\"🔍\\\" + rule.name,\\n                                key: \\\"custom_\\\" + rule.id + \\\"_\\\" + ptKeys[ptk],\\n                                type: \\\"pan\\\",\\n                                panType: ptKeys[ptk],\\n                                epCount: ptUrls.length,\\n                                playFrom: panTypeNames[ptKeys[ptk]] || ptKeys[ptk],\\n                                playUrl: ptUrls.join(\\\"#\\\"),\\n                                siteKey: \\\"custom_\\\" + rule.id,\\n                                ruleName: rule.name\\n                            });\\n                        }\\n                    }\\n                } else {\\n                    var hasSeasonInSearchAgg = norm.seasonInfo !== null;\\n                    for (var cj = 0; cj < customResults.length; cj++) {\\n                        var vr = customResults[cj];\\n                        if (vr && vr.playUrl) {\\n                            var vrTitleAgg = (vr.title || vr.name || '').replace(/\\\\s+/g, '');\\n                            if (hasSeasonInSearchAgg && vrTitleAgg && !matchSeasonInfo(kw, vrTitleAgg)) continue;\\n                            results.push({\\n                                name: \\\"🎬\\\" + rule.name + (vr.name ? '-' + vr.name : ''),\\n                                key: vr.key || (\\\"custom_\\\" + rule.id + \\\"_\\\" + cj),\\n                                type: \\\"custom\\\",\\n                                epCount: vr.epCount || 0,\\n                                playFrom: vr.playFrom || rule.name,\\n                                playUrl: vr.playUrl,\\n                                siteKey: vr.siteKey || (\\\"custom_\\\" + rule.id),\\n                                ruleName: rule.name\\n                            });\\n                        }\\n                    }\\n                    var urlResults = [];\\n                    for (var cj = 0; cj < customResults.length; cj++) {\\n                        var vr = customResults[cj];\\n                        if (vr && vr.url && !vr.playUrl) urlResults.push(vr);\\n                    }\\n                    if (urlResults.length > 0) {\\n                        var matched = null;\\n                        for (var mj = 0; mj < urlResults.length; mj++) {\\n                            var vrTitle = (urlResults[mj].title || urlResults[mj].name || '').replace(/\\\\s+/g, '');\\n                            if (vrTitle === norm.cleanName || vrTitle === norm.baseName) {\\n                                matched = urlResults[mj];\\n                                break;\\n                            }\\n                        }\\n                        if (!matched) {\\n                            for (var mj2 = 0; mj2 < urlResults.length; mj2++) {\\n                                var vrTitle2 = (urlResults[mj2].title || urlResults[mj2].name || '').replace(/\\\\s+/g, '');\\n                                var normT = vrTitle2.replace(/第[一二三四五六七八九十百千\\\\d]+[季部集期]/gi, '').replace(/年番\\\\d*/g, '').replace(/\\\\bS\\\\d+\\\\b/gi, '');\\n                                if (normT === norm.baseName && matchSeasonInfo(kw, vrTitle2)) {\\n                                    matched = urlResults[mj2];\\n                                    break;\\n                                }\\n                            }\\n                        }\\n                        if (!matched) {\\n                            for (var mj3 = 0; mj3 < urlResults.length; mj3++) {\\n                                var vrTitle3 = (urlResults[mj3].title || urlResults[mj3].name || '').replace(/\\\\s+/g, '');\\n                                var normT2 = vrTitle3.replace(/第[一二三四五六七八九十百千\\\\d]+[季部集期]/gi, '').replace(/年番\\\\d*/g, '').replace(/\\\\bS\\\\d+\\\\b/gi, '');\\n                                if (normT2 === norm.baseName || norm.baseName.indexOf(normT2) !== -1 || normT2.indexOf(norm.baseName) !== -1) {\\n                                    if (hasSeasonInSearchAgg && !matchSeasonInfo(kw, vrTitle3)) continue;\\n                                    matched = urlResults[mj3];\\n                                    break;\\n                                }\\n                            }\\n                        }\\n                        if (!matched && urlResults.length === 1) {\\n                            var singleTitleAgg = (urlResults[0].title || urlResults[0].name || '').replace(/\\\\s+/g, '');\\n                            if (!hasSeasonInSearchAgg || matchSeasonInfo(kw, singleTitleAgg)) {\\n                                matched = urlResults[0];\\n                            }\\n                        }\\n                        if (matched && matched.url) {\\n                            try {\\n                                var detail2 = cr.executeDetail(rule, matched.url);\\n                                log('[searchAgg] 规则[' + rule.name + ']详情结果 line=' + (detail2 ? detail2.line.length : 0) + ' list=' + (detail2 ? detail2.list.length : 0));\\n                                if (detail2 && detail2.line && detail2.list) {\\n                                    var adKw = [\\\"广告\\\", \\\"666\\\", \\\"mymv\\\", \\\"常规线路\\\"];\\n                                    for (var li = 0; li < detail2.line.length; li++) {\\n                                        var sName2 = (detail2.line[li] || '').trim();\\n                                        var isAd2 = false;\\n                                        for (var ai = 0; ai < adKw.length; ai++) {\\n                                            if (sName2.indexOf(adKw[ai]) >= 0) { isAd2 = true; break; }\\n                                        }\\n                                        if (isAd2) continue;\\n                                        var epList2 = detail2.list[li] || [];\\n                                        var playParts2 = [];\\n                                        for (var ei = 0; ei < epList2.length; ei++) {\\n                                            var ep2 = epList2[ei];\\n                                            playParts2.push((ep2.title || ep2.name || ('第' + (ei+1) + '集')) + '$' + (ep2.url || ep2.play_url || ''));\\n                                        }\\n                                            if (playParts2.length > 0) {\\n                                                var isPanLine2 = false;\\n                                                for (var pi2 = 0; pi2 < epList2.length; pi2++) {\\n                                                    if (getPanType(epList2[pi2].url || epList2[pi2].play_url || '')) { isPanLine2 = true; break; }\\n                                                }\\n                                                var finalPlayUrl2 = playParts2.join(\\\"#\\\");\\n                                                if (isPanLine2) {\\n                                                    finalPlayUrl2 = filterPanPlayUrlByTitle(finalPlayUrl2, kw);\\n                                                    if (!finalPlayUrl2) continue;\\n                                                }\\n                                                var finalEpCount2 = finalPlayUrl2.split('#').filter(function(e) { return e; }).length;\\n                                                results.push({\\n                                                    name: (isPanLine2 ? \\\"🔍\\\" : \\\"🎬\\\") + rule.name + (sName2 ? '-' + sName2 : ''),\\n                                                    key: \\\"custom_\\\" + rule.id + \\\"_\\\" + li,\\n                                                    type: isPanLine2 ? \\\"pan\\\" : \\\"custom\\\",\\n                                                    epCount: finalEpCount2,\\n                                                    playFrom: sName2 || rule.name,\\n                                                    playUrl: finalPlayUrl2,\\n                                                    siteKey: \\\"custom_\\\" + rule.id,\\n                                                    ruleName: rule.name\\n                                                });\\n                                        }\\n                                    }\\n                                }\\n                            } catch(e4) { log(\\\"规则[\\\" + rule.name + \\\"]详情解析失败: \\\" + e4.message); }\\n                        }\\n                    }\\n                }\\n            } catch(e2) { log(\\\"规则[\\\" + rule.name + \\\"]结果处理失败: \\\" + e2.message); }\\n        }\\n    } catch(e3) { log(\\\"searchAgg异常: \\\" + e3.message); }\\n    return results;\\n}\\n\\nfunction getM3u8AdRules() {\\n    var adHosts = [\\\"mimg.0c1q0l.cn\\\", \\\"www.googletagmanager.com\\\", \\\"www.google-analytics.com\\\", \\\"mc.usihnbcq.cn\\\", \\\"mg.g1mm3d.cn\\\", \\\"mscs.svaeuzh.cn\\\", \\\"cnzz.hhttm.top\\\", \\\"tp.vinuxhome.com\\\", \\\"cnzz.mmstat.com\\\", \\\"www.baihuillq.com\\\", \\\"s23.cnzz.com\\\", \\\"z3.