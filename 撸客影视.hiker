Content.text + '</font>',\n            desc: '<font color=\"' + FontColor + '\">' + _infoContent.desc + '</font>',\n            pic_url: _infoContent.dot, col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                var lines = [];\n                var TabCfg = $.require(\"Tab配置\");\n                var allPages = TabCfg.tabPages || {};\n                var allNames = TabCfg.tabNames || {};\n                var pkToName = {};\n                for (var id in allPages) {\n                    if (!allPages.hasOwnProperty(id)) continue;\n                    var pk0 = allPages[id];\n                    if (pk0) pkToName[pk0] = allNames[id] || pk0;\n                }\n                var done = {};\n                var readStatus = function(pk) {\n                    var s = getItem(\"status_tab_content_\" + pk, \"\");\n                    if (s) return s;\n                    for (var k in allPages) {\n                        if (!allPages.hasOwnProperty(k)) continue;\n                        var pk2 = allPages[k];\n                        if (pk2 && pk2.toLowerCase() === pk.toLowerCase()) {\n                            return getItem(\"status_tab_content_\" + pk2, \"\");\n                        }\n                    }\n                    return \"\";\n                };\n                for (var id2 in allPages) {\n                    if (!allPages.hasOwnProperty(id2)) continue;\n                    var pk1 = allPages[id2];\n                    if (!pk1 || done[pk1]) continue;\n                    done[pk1] = true;\n                    var stStr = readStatus(pk1);\n                    var displayName = pkToName[pk1] + \"（\" + pk1 + \"）\";\n                    if (!stStr) {\n                        lines.push(\"⚪ \" + displayName + \"\\n  未上传过\");\n                        continue;\n                    }\n                    var st;\n                    try { st = JSON.parse(stStr); } catch(e) {\n                        lines.push(\"⚪ \" + displayName + \"\\n  数据异常\");\n                        continue;\n                    }\n                    var t2 = new Date(st.time);\n                    var ts = (t2.getMonth()+1) + \"/\" + t2.getDate() + \" \" + t2.getHours() + \":\" + (t2.getMinutes() < 10 ? \"0\" : \"\") + t2.getMinutes() + \":\" + (t2.getSeconds() < 10 ? \"0\" : \"\") + t2.getSeconds();\n                    var sz = st.size ? (st.size + \" 字节\") : \"未知大小\";\n                    if (st.ok === true) {\n                        lines.push(\"✅ \" + displayName + \"\\n  \" + ts + \"  ·  \" + sz);\n                    } else {\n                        lines.push(\"❌ \" + displayName + \"\\n  \" + ts + \"  ·  \" + sz + \"\\n  \" + (st.msg || \"失败\"));\n                    }\n                }\n                var body = lines.length ? lines.join(\"\\n\\n\") : \"没有任何源的上传记录\";\n                var _pop = $.require('弹窗工具');\n                _pop.show(\"📋 坚果云内容 上传记录\", [\n                    { title: \"说明\", records: [\"每个源的上传状态、时间、文件大小\"] },\n                    { title: \"记录\", records: [body] }\n                ]);\n                return \"hiker://empty\";\n            }),\n            extra: { lineVisible: true }\n        });\n\n        // ===== 用户反馈入口：加未回复统计 =====\n        var _fbDoneCnt = 0, _fbTotal = 0, _fbOk = true, _fbUnrepliedCnt = 0;\n        try {\n            var _fbAuth2 = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n            var _fbRaw2 = request('https://dav.jianguoyun.com/dav/luke/feedback.json', { headers: { 'Authorization': _fbAuth2 }, timeout: 5000 });\n            if (_fbRaw2 && _fbRaw2.trim()) {\n                var _fbTmpList = JSON.parse(_fbRaw2);\n                if (_fbTmpList && _fbTmpList.length >= 0) {\n                    _fbTotal = _fbTmpList.length;\n                    for (var _fbi = 0; _fbi < _fbTmpList.length; _fbi++) {\n                        var _fbItem = _fbTmpList[_fbi];\n                        if (_fbItem.done === true) _fbDoneCnt++;\n\n                        // 判定未回复：chatList 最后一条不是 author\n                        var _fbChat = _fbItem.chatList || [];\n                        if (!_fbChat.length) {\n                            if (_fbItem.reply) _fbChat.push({ by: 'author' });\n                            if (_fbItem.userReply) _fbChat.push({ by: 'user' });\n                        }\n                        var _fbLastBy = _fbChat.length > 0 ? _fbChat[_fbChat.length - 1].by : '';\n                        if (_fbLastBy !== 'author') _fbUnrepliedCnt++;\n                    }\n                }\n            }\n        } catch(e) { _fbOk = false; }\n\n        var _fbEntryDot, _fbEntryDesc;\n        if (!_fbOk) {\n            _fbEntryDot = _dotRed;\n            _fbEntryDesc = '拉取失败';\n        } else if (_fbTotal === 0) {\n            _fbEntryDot = _dotGray;\n            _fbEntryDesc = '暂无反馈';\n        } else {\n            var _fbPending = _fbTotal - _fbDoneCnt;\n            var _fbParts = ['共 ' + _fbTotal + ' 条'];\n            if (_fbUnrepliedCnt > 0) _fbParts.push('未回复 ' + _fbUnrepliedCnt);\n            if (_fbPending > 0) _fbParts.push('待处理 ' + _fbPending);\n\n            if (_fbUnrepliedCnt === 0 && _fbPending === 0) {\n                _fbEntryDot = _dotGreen;\n                _fbEntryDesc = '共 ' + _fbTotal + ' 条（全部已处理）';\n            } else {\n                _fbEntryDot = _dotRed;\n                _fbEntryDesc = _fbParts.join('  ·  ');\n            }\n        }\n\n        d.push({\n            title: '<font color=\"' + FontColor + '\">用户反馈</font>',\n            desc: '<font color=\"' + FontColor + '\">' + _fbEntryDesc + '</font>',\n            pic_url: _fbEntryDot, col_type: \"avatar\",\n            url: 'hiker://page/反馈管理#noHistory#',\n            extra: { lineVisible: true }\n        });\n\n        d.push({ col_type: \"line\" });\n\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">账号设置</font></b>',\n            desc: '<font color=\"' + FontColor + '\">Token / 坚果云</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/307.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('manage_view', 'account'); putMyVar('manage_stay', '1'); refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">上传管理</font></b>',\n            desc: '<font color=\"' + FontColor + '\">数据 / 配置 / 清缓存</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/36.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('manage_view', 'upload'); putMyVar('manage_stay', '1'); refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">Tab 源码</font></b>',\n            desc: '<font color=\"' + FontColor + '\">导出 / 上传源码</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/311.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('manage_view', 'tabcode'); putMyVar('manage_stay', '1'); refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">Tab配置管理</font></b>',\n            desc: '<font color=\"' + FontColor + '\">增删Tab、改名、换图标</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/269.png\",\n            col_type: \"avatar\",\n            url: \"hiker://page/Tab配置管理#noHistory#\",\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">内容设置</font></b>',\n            desc: '<font color=\"' + FontColor + '\">标题 / 公告 / 口令</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/305.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('manage_view', 'content'); putMyVar('manage_stay', '1'); refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">系统工具</font></b>',\n            desc: '<font color=\"' + FontColor + '\">诊断</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/234.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('manage_view', 'tools'); putMyVar('manage_stay', '1'); refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n\n        d.push({ col_type: \"blank_block\" });\n        d.push({ col_type: \"line\" });\n        d.push({ col_type: \"blank_block\" });\n\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">退出管理</font></b>',\n            desc: '<font color=\"' + FontColor + '\">清除登录</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/20.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar(\"manage_passed\", \"\");\n                toast(\"已退出管理\");\n                return \"hiker://reload\";\n            })\n        });\n\n        setResult(d);\n    }\n}"},{"col_type":"movie_3","name":"内容","path":"内容","rule":"var 内容 = {\n    loadCode: function(name) {\n        var filePath = 'hiker://files/Jm/tabs/' + name + '.js';\n        var code = '';\n        var _pullOk = false;\n        var _pullMsg = '';\n        var _rtMode = getItem('tab_runtime_mode', 'cloud');\n\n        if (_rtMode === 'local') {\n            try {\n                if (fileExist(filePath)) {\n                    code = readFile(filePath);\n                    _pullOk = true;\n                    _pullMsg = '本地读取：' + name;\n                } else {\n                    _pullMsg = '本地无缓存：' + name;\n                }\n            } catch(e) {\n                _pullMsg = '本地读取失败：' + e.message;\n            }\n        } else {\n            try {\n                var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n                var resp = request('https://dav.jianguoyun.com/dav/luke/tabs/' + name + '.js', {\n                    headers: { 'Authorization': auth },\n                    timeout: 8000\n                });\n                if (resp && resp.length > 200) {\n                    try { writeFile(filePath, resp); } catch(e) {}\n                    code = resp;\n                    _pullOk = true;\n                    _pullMsg = '拉取成功：' + name + '（' + resp.length + ' 字节）';\n                } else {\n                    _pullMsg = '响应异常：' + name;\n                }\n            } catch(e) {\n                _pullMsg = '拉取异常：' + name + '（' + e.message + '）';\n            }\n            if (!code) {\n                try {\n                    if (fileExist(filePath)) {\n                        code = readFile(filePath);\n                        _pullOk = true;\n                        _pullMsg += '（已回退本地）';\n                    }\n                } catch(e) {}\n            }\n        }\n\n        try { setItem(\"pull_status_jianguo\", JSON.stringify({ ok: _pullOk, msg: _pullMsg, time: Date.now() })); } catch(e) {}\n        try { setItem(\"pull_status_tab_\" + name, JSON.stringify({ ok: _pullOk, msg: _pullMsg, time: Date.now() })); } catch(e) {}\n\n        return code;\n    },\n\n    render: function(d, pageKey) {\n        if (!pageKey) return;\n        var code = 内容.loadCode(pageKey);\n        if (!code) {\n            var _errMsg = getItem('tab_runtime_mode', 'cloud') === 'local'\n                ? '❌ ' + pageKey + ' 本地无缓存，请切到云端模式拉一次'\n                : '❌ ' + pageKey + ' 加载失败（云端+本地都没有）';\n            d.push({ title: _errMsg, col_type: 'text_center_1', url: 'hiker://empty' });\n            return;\n        }\n        var mod;\n        try {\n            eval(code);\n            mod = eval(pageKey);\n        } catch(e) {\n            d.push({ title: '❌ ' + pageKey + ' 执行失败：' + e.message, col_type: 'text_center_1', url: 'hiker://empty' });\n            return;\n        }\n        var _origSR = setResult;\n        var _tmp = [];\n        setResult = function(data) { _tmp = data; };\n        try {\n            if (mod && mod.main) {\n                mod.main();\n            } else if (mod && mod.shouye) {              // ★ 新增\n                mod.shouye();\n            } else if (mod && mod.renderHome) {\n                mod.renderHome(_tmp);\n            } else if (mod && mod.主页) {\n                var _page = parseInt(MY_PAGE || 1);\n                var _result = (_page > 1 && mod.分类) ? mod.分类() : mod.主页();\n                if (Array.isArray(_result)) _tmp = _result;\n            } else {\n                _tmp.push({ title: '❌ ' + pageKey + ' 缺少 main / shouye 方法', col_type: 'text_center_1', url: 'hiker://empty' });\n            }\n        } catch(e) {\n            _tmp.push({ title: '❌ 渲染出错：' + e.message, col_type: 'text_center_1', url: 'hiker://empty' });\n        }\n        setResult = _origSR;\n        for (var i = 0; i < _tmp.length; i++) d.push(_tmp[i]);\n    },\n\n    renderDetail: function(d, pageKey, detailId, detailTitle, detailExtra) {\n        if (!pageKey || !detailId) return;\n        var code = 内容.loadCode(pageKey);\n        if (!code) {\n            d.push({ title: '❌ ' + pageKey + ' 代码加载失败', col_type: 'text_center_1', url: 'hiker://empty' });\n            return;\n        }\n        var mod;\n        try {\n            eval(code);\n            mod = eval(pageKey);\n        } catch(e) {\n            d.push({ title: '❌ ' + pageKey + ' 执行失败：' + e.message, col_type: 'text_center_1', url: 'hiker://empty' });\n            return;\n        }\n        // ★ 兼容 renderDetail 和 erji1\n        if (!mod || (!mod.renderDetail && !mod.erji1)) {\n            d.push({ title: '❌ ' + pageKey + ' 缺少 renderDetail / erji1 方法', col_type: 'text_center_1', url: 'hiker://empty' });\n            return;\n        }\n        var _origSR = setResult;\n        var _tmp = [];\n        setResult = function(data) { _tmp = data; };\n        try {\n            if (pageKey === 'JHYS') {\n                mod.renderDetail(detailId, detailTitle, detailExtra);\n            } else if (pageKey === 'HK') {\n                mod.renderDetail(detailId, detailExtra, detailTitle);\n            } else if (pageKey === 'DZ') {\n                mod.renderDetail(detailExtra, detailTitle);\n            } else if (mod.renderDetail) {\n                mod.renderDetail(detailId, detailTitle);\n            } else if (mod.erji1) {                       // ★ 新增\n                mod.erji1(detailId, detailTitle);\n            }\n        } catch(e) {\n            _tmp.push({ title: '❌ 详情渲染失败：' + e.message, col_type: 'text_center_1', url: 'hiker://empty' });\n        }\n        setResult = _origSR;\n        for (var i = 0; i < _tmp.length; i++) d.push(_tmp[i]);\n    }\n};\n\n$.exports = 内容;"},{"col_type":"movie_3","name":"详情","path":"详情","rule":"js:\nvar d = [];\nvar _url = String(MY_URL || '');\nvar _cleanUrl = _url.replace(/#[^#]*#/g, '');\n\nvar tab = '', id = '', title = '', extra = '';\nvar _mTab = _cleanUrl.match(/[?&]tab=([^&]*)/);\nvar _mId = _cleanUrl.match(/[?&]id=([^&]*)/);\nvar _mTitle = _cleanUrl.match(/[?&]title=([^&]*)/);\nvar _mExtra = _cleanUrl.match(/[?&]extra=([^&]*)/);\nif (_mTab) tab = decodeURIComponent(_mTab[1]);\nif (_mId) id = decodeURIComponent(_mId[1]);\nif (_mTitle) title = decodeURIComponent(_mTitle[1]);\nif (_mExtra) extra = decodeURIComponent(_mExtra[1]);\n\nsetPageTitle(title || '详情');\n\nif (!tab || !id) {\n    d.push({ title: '❌ 参数缺失', col_type: 'text_center_1', url: 'hiker://empty' });\n    setResult(d);\n} else {\n    try {\n        var 内容 = $.require('内容');\n        内容.renderDetail(d, tab, id, title, extra);\n    } catch(e) {\n        d.push({ title: '❌ 渲染失败：' + e.message, col_type: 'text_center_1', url: 'hiker://empty' });\n    }\n    setResult(d);\n}"},{"col_type":"movie_3","name":"帮助反馈","path":"帮助反馈","rule":"js:\nvar d = [];\nsetPageTitle('帮助与反馈');\n\nvar MC = getItem('manage_font_color', '#333333');\nvar Color = getItem('主题颜色', '#F5F5F5');\nvar bgTint = '#15' + Color.replace('#', '');\n\nvar 设备ID = getMyVar('device_id', '');\nif (!设备ID) {\n    设备ID = 'D' + Date.now() + '_' + Math.floor(Math.random() * 100000);\n    putMyVar('device_id', 设备ID);\n}\n\nvar view = getMyVar('help_view', 'home');\nvar _stay = getMyVar('help_stay', '');\nif (_stay === '1') {\n    putMyVar('help_stay', '');\n} else {\n    view = 'home';\n    putMyVar('help_view', 'home');\n}\n\nif (view === 'myfeedback') {\n\n    d.push({\n        title: '← 返回',\n        col_type: 'flex_button',\n        url: $('#noLoading#').lazyRule(function() {\n            putMyVar('help_view', 'home');\n            putMyVar('help_stay', '1');\n            refreshPage();\n            return 'hiker://empty';\n        }),\n        extra: { text_color: MC }\n    });\n\n    d.push({ col_type: 'blank_block' });\n\n    var _lastUserMsg = getMyVar('user_last_msg', '');\n    if (_lastUserMsg) {\n        var _lastUserOk = getMyVar('user_last_ok', '') === '1';\n        d.push({\n            title: _lastUserMsg,\n            col_type: 'text_center_1',\n            url: 'hiker://empty',\n            extra: { text_color: _lastUserOk ? '#4CAF50' : '#E53935', text_size: '14' }\n        });\n        d.push({ col_type: 'line' });\n        putMyVar('user_last_msg', '');\n        putMyVar('user_last_ok', '');\n    }\n\n    var _userEditingTs = getMyVar('user_reply_ts', '');\n    if (_userEditingTs) {\n        d.push({\n            title: '✍️ 回复作者，输入内容后点确定',\n            col_type: 'text_center_1',\n            url: 'hiker://empty',\n            extra: { text_color: '#1565c0', text_size: '14' }\n        });\n        d.push({\n            title: '请输入回复内容',\n            col_type: 'input',\n            extra: { defaultValue: '' },\n            url: $.toString(function() {\n                var content = (input || '').trim();\n                if (!content) { toast('❌ 内容不能为空'); return 'hiker://empty'; }\n                var ts = getMyVar('user_reply_ts', '');\n                if (!ts) { toast('❌ 目标丢失'); return 'hiker://empty'; }\n\n                var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n                var url2 = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n                var list2 = [];\n                try {\n                    var r = request(url2, { headers: { 'Authorization': auth }, timeout: 8000 });\n                    if (r && r.trim()) { var p = JSON.parse(r); if (p && p.length >= 0) list2 = p; }\n                } catch(e) {}\n\n                var found = false;\n                for (var _i = 0; _i < list2.length; _i++) {\n                    if (String(list2[_i].t) === String(ts)) {\n                        var chat = list2[_i].chatList || [];\n                        if (!chat.length) {\n                            if (list2[_i].reply) chat.push({ by: 'author', content: list2[_i].reply, t: list2[_i].replyT || 0 });\n                            if (list2[_i].userReply) chat.push({ by: 'user', content: list2[_i].userReply, t: list2[_i].userReplyT || 0 });\n                        }\n                        chat.push({ by: 'user', content: content, t: Date.now() });\n                        list2[_i].chatList = chat;\n                        delete list2[_i].reply;\n                        delete list2[_i].replyT;\n                        delete list2[_i].userReply;\n                        delete list2[_i].userReplyT;\n                        found = true;\n                        break;\n                    }\n                }\n                if (!found) {\n                    putMyVar('user_last_msg', '❌ 回复失败：未找到');\n                    putMyVar('user_last_ok', '0');\n                } else {\n                    try {\n                        request(url2, {\n                            method: 'PUT',\n                            headers: { 'Authorization': auth, 'Content-Type': 'application/json; charset=utf-8' },\n                            body: JSON.stringify(list2),\n                            timeout: 15000\n                        });\n                        putMyVar('user_last_msg', '✅ 已发送给作者');\n                        putMyVar('user_last_ok', '1');\n                        toast('✅ 已发送');\n                    } catch(e) {\n                        putMyVar('user_last_msg', '❌ 发送失败：' + e.message);\n                        putMyVar('user_last_ok', '0');\n                        toast('❌ ' + e.message);\n                    }\n                }\n                putMyVar('user_reply_ts', '');\n                putMyVar('help_view', 'myfeedback');\n                putMyVar('help_stay', '1');\n                refreshPage();\n                return 'hiker://empty';\n            })\n        });\n        d.push({\n            title: '❌ 取消',\n            col_type: 'flex_button',\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('user_reply_ts', '');\n                putMyVar('help_view', 'myfeedback');\n                putMyVar('help_stay', '1');\n                refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { text_color: '#E53935' }\n        });\n        d.push({ col_type: 'line' });\n    }\n\n    var _auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n    var _fbUrl = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n\n    var allList = [];\n    var _pullOk = true;\n    try {\n        var raw = request(_fbUrl, { headers: { 'Authorization': _auth }, timeout: 8000 });\n        if (raw && raw.trim()) {\n            var parsed = JSON.parse(raw);\n            if (parsed && parsed.length >= 0) allList = parsed;\n        }\n    } catch(e) {\n        _pullOk = false;\n    }\n\n    if (!_pullOk) {\n        d.push({ col_type: 'big_blank_block' });\n        d.push({\n            title: '❌ 拉取失败',\n            desc: '请检查网络后重新进入',\n            col_type: 'text_center_1',\n            url: 'hiker://empty',\n            extra: { text_color: MC, text_size: '16' }\n        });\n        setResult(d);\n    } else {\n        var mine = allList.filter(function(item) { return item.d === 设备ID; });\n        mine.sort(function(a, b) { return (b.t || 0) - (a.t || 0); });\n\n        if (mine.length === 0) {\n            d.push({ col_type: 'big_blank_block' });\n            d.push({\n                title: '你还没有提交过反馈',\n                col_type: 'text_center_1',\n                url: 'hiker://empty',\n                extra: { text_color: MC, text_size: '16' }\n            });\n            setResult(d);\n        } else {\n            d.push({\n                title: '共 ' + mine.length + ' 条',\n                col_type: 'text_center_1',\n                url: 'hiker://empty',\n                extra: { text_color: MC, text_size: '13' }\n            });\n            d.push({ col_type: 'line' });\n\n            mine.forEach(function(item) {\n                var t = new Date(item.t || 0);\n                var pad = function(n) { return n < 10 ? '0' + n : String(n); };\n                var timeStr = (t.getMonth()+1) + '/' + t.getDate() + ' ' + pad(t.getHours()) + ':' + pad(t.getMinutes());\n\n                var _t = item.t || 0;\n                var _did = item.d || '';\n                var _id = item.id || '----';\n                var _done = (item.done === true);\n\n                d.push({\n                    title: '编号：' + _id + '  ' + (_done ? '✅ 已处理' : '⏳ 待处理'),\n                    col_type: 'text_1',\n                    url: 'hiker://empty',\n                    extra: { text_color: _done ? '#4CAF50' : '#FF9800', text_size: '14' }\n                });\n                d.push({\n                    title: timeStr + '  |  ' + (item.m || '') + '  |  v' + (item.v || ''),\n                    col_type: 'text_1',\n                    url: 'hiker://empty',\n                    extra: { text_color: MC, text_size: '13' }\n                });\n                if (item.dev) d.push({ title: '📱 ' + item.dev, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n                if (item.pos) d.push({ title: '📍 ' + item.pos, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n                if (item.net) d.push({ title: '📶 ' + item.net, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n                d.push({\n                    title: '💬 ' + (item.msg || ''),\n                    col_type: 'text_1',\n                    url: 'hiker://empty',\n                    extra: { text_color: MC, text_size: '13' }\n                });\n\n                var _chat = item.chatList || [];\n                if (!_chat.length) {\n                    if (item.reply) _chat.push({ by: 'author', content: item.reply, t: item.replyT || 0 });\n                    if (item.userReply) _chat.push({ by: 'user', content: item.userReply, t: item.userReplyT || 0 });\n                }\n\n                var _lastBy = _chat.length > 0 ? _chat[_chat.length - 1].by : '';\n                var _hasAuthorReply = false;\n                for (var _ai = 0; _ai < _chat.length; _ai++) {\n                    if (_chat[_ai].by === 'author') { _hasAuthorReply = true; break; }\n                }\n\n                if (_chat.length > 0) {\n                    d.push({ col_type: 'blank_block' });\n                    d.push({\n                        title: '— 对话记录 —',\n                        col_type: 'text_center_1',\n                        url: 'hiker://empty',\n                        extra: { text_color: '#999999', text_size: '12' }\n                    });\n                    for (var _ci = 0; _ci < _chat.length; _ci++) {\n                        var _c = _chat[_ci];\n                        if (_c.by === 'author') {\n                            d.push({ title: '👤 作者：' + _c.content, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: '#1565c0', text_size: '13' } });\n                        } else {\n                            d.push({ title: '🙋 我：' + _c.content, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: '#7B5EA7', text_size: '13' } });\n                        }\n                    }\n                    d.push({ col_type: 'blank_block' });\n                }\n\n                if (_hasAuthorReply && _lastBy === 'author') {\n                    d.push({\n                        title: '💬 回复作者',\n                        col_type: 'flex_button',\n                        url: $('#noLoading#').lazyRule(function(ts) {\n                            putMyVar('user_reply_ts', String(ts));\n                            putMyVar('help_view', 'myfeedback');\n                            putMyVar('help_stay', '1');\n                            refreshPage();\n                            return 'hiker://empty';\n                        }, _t),\n                        extra: { text_color: '#1565c0' }\n                    });\n                }\n\n                d.push({\n                    title: '🗑️ 删除这条',\n                    col_type: 'flex_button',\n                    url: $('#noLoading#').lazyRule(function(ts, myDid) {\n                        confirm({\n                            title: '⚠️ 删除这条反馈？',\n                            content: '删除后不可恢复',\n                            confirm: $.toString(function(ts2, myDid2) {\n                                try {\n                                    var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n                                    var url2 = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n                                    var list2 = [];\n                                    try {\n                                        var r = request(url2, { headers: { 'Authorization': auth }, timeout: 8000 });\n                                        if (r && r.trim()) {\n                                            var p = JSON.parse(r);\n                                            if (p && p.length >= 0) list2 = p;\n                                        }\n                                    } catch(e) {}\n                                    var newList = list2.filter(function(x) {\n                                        return !(String(x.t) === String(ts2) && x.d === myDid2);\n                                    });\n                                    request(url2, {\n                                        method: 'PUT',\n                                        headers: { 'Authorization': auth, 'Content-Type': 'application/json; charset=utf-8' },\n                                        body: JSON.stringify(newList),\n                                        timeout: 15000\n                                    });\n                                    putMyVar('help_view', 'myfeedback');\n                                    putMyVar('help_stay', '1');\n                                    toast('🗑️ 已删除');\n                                    refreshPage();\n                                } catch(e) {\n                                    toast('❌ 删除失败：' + e.message);\n                                }\n                                return 'hiker://empty';\n                            }, ts, myDid),\n                            cancel: $.toString(function() {})\n                        });\n                        return 'hiker://empty';\n                    }, _t, _did),\n                    extra: { text_color: '#E53935' }\n                });\n\n                d.push({ col_type: 'line' });\n            });\n        }\n\n        setResult(d);\n    }\n\n} else {\n\n    var FAQ = [\n        { q: '视频点不开 / 一直缓冲怎么办？', a: '① 换一个线路试试（详情页 🔄 按钮）\\n② 退出重进\\n③ 源站临时抽风，等一会儿再试\\n④ 检查网络是否正常' },\n        { q: '详情页的线路按钮怎么用？', a: '点一下带「🔄」的按钮，会弹出线路列表，选一条就切换过去了。\\n不同线路来自不同的采集站，集数、速度都可能不一样。' },\n        { q: '为什么有的剧只有一条线路？', a: '该剧目前在源站只有一个采集站有资源，所以没得切。\\n属正常情况，不影响观看。' },\n        { q: '切换线路后集数变少了？', a: '不同线路的集数可能不一样，选集数最全的那条即可。\\n通常详情页会显示\"共 N 集\"，对比一下。' },\n        { q: '提示\"解析失败\"是什么原因？', a: '① 该集可能是 VIP 付费内容\\n② 源站接口临时故障\\n③ 换个线路或换一集试试' },\n        { q: '怎么切换影视 / 短剧 / 直播 / 成人模式？', a: '设置页 →「模式切换」→ 选择你要的模式。\\n模式切换后首页的 Tab 会自动变化。' },\n        { q: '怎么屏蔽不看的 Tab？', a: '设置页 →「Tab屏蔽管理」→ 点击要屏蔽的 Tab 名称，切换屏蔽状态。\\n\"重置屏蔽\"按钮可以一键恢复。' },\n        { q: '怎么更换主题颜色 / 字体颜色？', a: '设置页 →「主题颜色」或「字体颜色」→ 选择或自定义。\\n也有一键切换整套配色的「预设主题包」，共 20 套。' },\n        { q: '首页轮播图怎么关掉？', a: '设置页 →「轮播图开关」→ 点一下即可切换显示 / 隐藏。' },\n        { q: '更新失败 / 检测不到新版本？', a: '① 检查网络\\n② 设置页 →「检测更新」→ 复制云口令\\n③ 去对应平台粘贴口令安装\\n④ 如果云端暂无数据，等一会儿再点' },\n        { q: '小说 / 漫画怎么用？', a: '在成人模式 →「一起草」里，顶部菜单有\"吃瓜\"和\"漫画\"分类。\\n（小说分类因反爬已下线）' },\n        { q: '怎么看版本更新日志？', a: '设置页 →「更新日志」→ 点开查看历史版本记录。' },\n        { q: '数据 / 设置怎么备份？', a: '大部分设置存在本地，卸载重装会丢失。\\n建议开启云端拉取模式，配置会自动同步。' },\n        { q: '反馈提交后多久能处理？', a: '提交后会自动生成编号（格式：YYYYMMDD+两位序号）。\\n作者会统一查看，处理完会标成\"已处理\"。\\n你在\"我的反馈\"里可以随时看到状态。' },\n        { q: '为什么有的反馈提交了却看不到？', a: '常见原因：\\n① 提交时网络中断，云端写入失败。\\n② 卸载重装后设备标识变了，旧反馈归到旧设备下。\\n建议：记下提交时的编号，必要时凭编号找作者查。' },\n        { q: '反馈里显示\"拉取失败\"是什么意思？', a: '说明当前设备没能从云端读取到反馈数据。\\n① 先检查网络是否正常。\\n② 如果是云端临时限流，等几分钟再试。\\n③ 若长期失败，请在群里反馈给作者。' },\n        { q: '为什么有些 Tab 突然打不开了？', a: '云端源变化快，以下情况都很常见：\\n① 源站接口临时维护或关停。\\n② 源站反爬策略升级，需要更新规则。\\n③ 该 Tab 线路本身被作者下线。\\n解决：等一会儿再试、切换其他 Tab，或者提交反馈附上 Tab 名称。' },\n        { q: '为什么首页轮播图不显示？', a: '① 检查设置页里\"轮播图开关\"是否被关掉了。\\n② 检查网络是否正常，图片源可能被临时拦截。\\n③ 若一直\"加载失败\"，换网络或等一会儿再试。' },\n        { q: '怎么查看当前使用的版本号？', a: '设置页 →「更新日志」里可以看当前版本；\\n首页\"检查更新\"弹窗里也会带当前版本号。' },\n        { q: '为什么有的设备信息显示不全？', a: '设备信息是自动读取的，部分冷门机型可能匹配不到中文名，会显示原始型号代码。\\n这属于正常现象，不影响反馈提交。' },\n        { q: '提示\"当前版本过低\"是什么意思？', a: '说明作者在云端设置了强制更新的最低版本号。\\n你需要：\\n① 点\"立即更新\"，复制云口令。\\n② 去对应的更新平台粘贴口令，安装新版本。\\n如果不更新，部分功能可能会受限。' },\n        { q: '怎么切换正式版和 Beta 版？', a: '设置页 →「模式切换」里可以选。\\n① 检测更新会按对应通道读取版本。\\n② 云口令也会自动区分正式/Beta。\\n③ 普通用户建议留在正式版，喜欢尝鲜再切 Beta。' },\n        { q: '为什么反馈的编号会重复？', a: '编号由\"当天日期 + 当天已有最大序号\"生成，理论上不会重复。\\n如果出现重复，说明同一秒有并发写入，建议稍等再提交，或在反馈里告知作者手动修正。' }\n    ];\n\n    var kw = getMyVar('help_kw', '');\n    putMyVar('help_kw', '');\n\n    var filtered = FAQ;\n    if (kw) {\n        filtered = FAQ.filter(function(item) {\n            return item.q.indexOf(kw) > -1 || item.a.indexOf(kw) > -1;\n        });\n    }\n\n    d.push({\n        title: '新增反馈',\n        desc: '遇到问题？告诉作者',\n        pic_url: 'https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/35.png',\n        col_type: 'icon_2',\n        url: $('', '请描述你遇到的问题或建议\\n（至少 3 个字，最多 500 字）').input(function() {\n            var msg = (input || '').trim();\n            if (!msg) { toast('❌ 内容不能为空'); return 'hiker://empty'; }\n            if (msg.length < 3) { toast('❌ 至少写 3 个字'); return 'hiker://empty'; }\n            if (msg.length > 500) msg = msg.substring(0, 500);\n\n            var _did = getMyVar('device_id', '');\n            var _mode = getItem('content_mode', '');\n            var _modeName = ({ normal: '影视', live: '直播', short_drama: '短剧', adult: '成人' })[_mode] || _mode || '未选';\n            var _useBeta = getItem('use_beta_mode', '0') === '1';\n            var _ver = '';\n            try {\n                var _m = _useBeta ? $.require('更新日志Beta版') : $.require('更新日志正式版');\n                _ver = _useBeta ? (_m.CURRENT_BETA_VERSION || '') : (_m.CURRENT_VERSION || '');\n            } catch(e) {}\n\n            var _dev = '';\n            try {\n                var _b = String(android.os.Build.BRAND || '');\n                var _m2 = String(android.os.Build.MODEL || '');\n                var _brandMap = {\n                    'Xiaomi': '小米', 'Redmi': '红米', 'POCO': 'POCO',\n                    'HUAWEI': '华为', 'HONOR': '荣耀', 'OPPO': 'OPPO',\n                    'vivo': 'vivo', 'iQOO': 'iQOO', 'OnePlus': '一加',\n                    'realme': '真我', 'samsung': '三星', 'google': '谷歌',\n                    'Meizu': '魅族', 'nubia': '努比亚', 'ZTE': '中兴',\n                    'Lenovo': '联想', 'motorola': '摩托罗拉', 'Sony': '索尼',\n                    'Nokia': '诺基亚', 'HTC': 'HTC', 'ASUS': '华硕',\n                    'blackshark': '黑鲨', 'smartisan': '锤子'\n                };\n                var _modelMap = {\n                    '2107119DC': '小米11', 'M2011K2C': '小米11',\n                    '2106118C': '小米11 Pro', '21051182C': '小米11 Ultra',\n                    '2201123C': '小米12', '2207122MC': '小米12 Pro',\n                    '2112123AC': '小米12X',\n                    '23013RK75C': '小米13', '2211133C': '小米13 Pro',\n                    '2304FPN6DC': '小米13 Ultra',\n                    '23127PN0CC': '小米14', '23116PN5BC': '小米14 Pro',\n                    '24053PY09C': '小米15', '24129PN74C': '小米15 Pro',\n                    '23078RKD5C': '红米K60 至尊版',\n                    '23049RAD8C': '红米K60 Ultra',\n                    '2312DRA50C': '红米K70 Pro', '24069RA21C': '红米K70',\n                    '23077RABDC': '红米K70 至尊版',\n                    '2209129SC': '红米Note 12', '22101316C': '红米Note 12 Turbo',\n                    '23021RAAEG': '红米Note 13', '2312DRAABC': '红米Note 13 Pro',\n                    'ALN-AL00': '华为Mate 60', 'ALN-AL80': '华为Mate 60 Pro',\n                    'MNA-AL00': '华为P60',\n                    'PHY110': 'OPPO Find X6',\n                    'V2227A': 'vivo X90'\n                };\n                var _bCN = _brandMap[_b] || _b;\n                var _mCN = _modelMap[_m2] || _m2;\n                if (_bCN && _mCN) _dev = _bCN + ' ' + _mCN;\n                else if (_mCN) _dev = _mCN;\n                else if (_bCN) _dev = _bCN;\n                if (_dev.length > 40) _dev = _dev.substring(0, 40);\n            } catch(e) {}\n\n            var _pos = '';\n            try {\n                var _tk = $.require('Tab配置');\n                var _curTab = parseInt(getMyVar('current_tab', '0')) || 0;\n                var _curTabName = (_tk.tabNames && _tk.tabNames[_curTab]) || '';\n                if (_curTabName) _pos = _curTabName;\n            } catch(e) {}\n\n            var _net = '';\n            try {\n                var _cm = getActiveNetworkType ? getActiveNetworkType() : '';\n                if (_cm === 'WIFI') _net = 'WiFi';\n                else if (_cm === 'MOBILE') _net = '移动网络';\n                else if (_cm) _net = _cm;\n            } catch(e) {}\n\n            var _now = new Date();\n            var _dateStr = String(_now.getFullYear()) +\n                           String(_now.getMonth()+1).padStart(2, '0') +\n                           String(_now.getDate()).padStart(2, '0');\n\n            try {\n                var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n                var fbUrl = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n\n                var list = [];\n                try {\n                    var raw = request(fbUrl, { headers: { 'Authorization': auth }, timeout: 8000 });\n                    if (raw && raw.trim()) {\n                        var parsed = JSON.parse(raw);\n                        if (parsed && parsed.length >= 0) list = parsed;\n                    }\n                } catch(e) {}\n\n                var _maxNum = 0;\n                for (var _ii = 0; _ii < list.length; _ii++) {\n                    var _oid = list[_ii].id || '';\n                    if (_oid.indexOf(_dateStr) === 0 && _oid.length === 10) {\n                        var _n = parseInt(_oid.substring(8), 10);\n                        if (!isNaN(_n) && _n > _maxNum) _maxNum = _n;\n                    }\n                }\n                var _newId = _dateStr + String(_maxNum + 1).padStart(2, '0');\n\n                var item = {\n                    t: Date.now(),\n                    id: _newId,\n                    v: String(_ver),\n                    m: _modeName,\n                    d: _did,\n                    dev: _dev,\n                    pos: _pos,\n                    net: _net,\n                    msg: msg,\n                    done: false,\n                    doneT: 0\n                };\n\n                list.push(item);\n                if (list.length > 300) list = list.slice(list.length - 300);\n\n                request(fbUrl, {\n                    method: 'PUT',\n                    headers: { 'Authorization': auth, 'Content-Type': 'application/json; charset=utf-8' },\n                    body: JSON.stringify(list),\n                    timeout: 15000\n                });\n\n                putMyVar('help_view', 'home');\n                putMyVar('help_stay', '1');\n                toast('✅ 提交成功，编号：' + _newId);\n                refreshPage();\n            } catch(e) {\n                toast('❌ 提交失败：' + e.message);\n            }\n            return 'hiker://empty';\n        })\n    });\n\n    d.push({\n        title: '我的反馈',\n        desc: '查看 / 删除你提交过的反馈',\n        pic_url: 'https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/122.png',\n        col_type: 'icon_2',\n        url: $('#noLoading#').lazyRule(function() {\n            putMyVar('help_view', 'myfeedback');\n            putMyVar('help_stay', '1');\n            refreshPage();\n            return 'hiker://empty';\n        })\n    });\n\n    d.push({ col_type: 'blank_block' });\n\n    d.push({\n        title: '🔍 搜索常见问题',\n        desc: '输入关键词查找问题',\n        col_type: 'input',\n        extra: { defaultValue: '' },\n        url: $.toString(function() {\n            var v = (input || '').trim();\n            putMyVar('help_kw', v);\n            putMyVar('help_view', 'home');\n            putMyVar('help_stay', '1');\n            refreshPage();\n            return 'hiker://empty';\n        })\n    });\n\n    d.push({ col_type: 'blank_block' });\n    d.push({ col_type: 'line' });\n\n    d.push({\n        title: '常见问题',\n        col_type: 'text_center_1',\n        url: 'hiker://empty',\n        extra: { text_color: MC, text_size: '16' }\n    });\n\n    d.push({ col_type: 'blank_block' });\n\n    if (filtered.length === 0) {\n        d.push({\n            title: '没找到相关帮助',\n            desc: '试试其他关键词，或点上面的\"新增反馈\"',\n            col_type: 'text_center_1',\n            url: 'hiker://empty'\n        });\n    } else {\n        filtered.forEach(function(item) {\n            d.push({\n                title: '<b><font color=\"' + MC + '\">' + item.q + '</font></b>',\n                desc: '<font color=\"' + MC + '\">点击查看详细解答</font>',\n                pic_url: 'https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/17.png',\n                col_type: 'avatar',\n                url: $('#noLoading#').lazyRule(function(q, a) {\n                    var _pop = $.require('弹窗工具');\n                    _pop.show('❓ ' + q, [{ title: '解答', records: [a] }]);\n                    return 'hiker://empty';\n                }, item.q, item.a),\n                extra: { backgroundColor: bgTint, lineVisible: true }\n            });\n        });\n    }\n\n    setResult(d);\n}"},{"col_type":"movie_3","name":"反馈管理","path":"反馈管理","rule":"js:\nvar d = [];\nsetPageTitle('反馈管理');\n\nvar MC = getItem('manage_font_color', '#333333');\nvar Color = getItem('主题颜色', '#F5F5F5');\nvar bgTint = '#15' + Color.replace('#', '');\nvar _auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\nvar _fbUrl = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n\nvar _lastMsg = getItem('fb_last_msg', '');\nif (_lastMsg) {\n    var _lastOk = getItem('fb_last_ok', '0') === '1';\n    d.push({\n        title: _lastMsg,\n        col_type: 'text_center_1',\n        url: 'hiker://empty',\n        extra: { text_color: _lastOk ? '#4CAF50' : '#E53935', text_size: '14' }\n    });\n    d.push({ col_type: 'line' });\n    setItem('fb_last_msg', '');\n    setItem('fb_last_ok', '');\n}\n\nvar _editingTs = getMyVar('reply_target_ts', '');\nif (_editingTs) {\n    d.push({\n        title: '✍️ 正在回复，编号：' + _editingTs,\n        col_type: 'text_center_1',\n        url: 'hiker://empty',\n        extra: { text_color: '#1565c0', text_size: '14' }\n    });\n    d.push({\n        title: '请输入回复内容',\n        col_type: 'input',\n        extra: { defaultValue: '' },\n        url: $.toString(function() {\n            var content = (input || '').trim();\n            if (!content) { toast('❌ 内容不能为空'); return 'hiker://empty'; }\n            var ts = getMyVar('reply_target_ts', '');\n            if (!ts) { toast('❌ 目标丢失'); return 'hiker://empty'; }\n\n            var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n            var url2 = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n            var list2 = [];\n            try {\n                var r = request(url2, { headers: { 'Authorization': auth }, timeout: 8000 });\n                if (r && r.trim()) { var p = JSON.parse(r); if (p && p.length >= 0) list2 = p; }\n            } catch(e) {}\n\n            var found = false;\n            for (var _i = 0; _i < list2.length; _i++) {\n                if (String(list2[_i].t) === String(ts)) {\n                    var chat = list2[_i].chatList || [];\n                    if (!chat.length) {\n                        if (list2[_i].reply) chat.push({ by: 'author', content: list2[_i].reply, t: list2[_i].replyT || 0 });\n                        if (list2[_i].userReply) chat.push({ by: 'user', content: list2[_i].userReply, t: list2[_i].userReplyT || 0 });\n                    }\n                    chat.push({ by: 'author', content: content, t: Date.now() });\n                    list2[_i].chatList = chat;\n                    delete list2[_i].reply;\n                    delete list2[_i].replyT;\n                    delete list2[_i].userReply;\n                    delete list2[_i].userReplyT;\n                    found = true;\n                    break;\n                }\n            }\n            if (!found) {\n                setItem('fb_last_msg', '❌ 回复失败：未找到');\n                setItem('fb_last_ok', '0');\n                putMyVar('reply_target_ts', '');\n                refreshPage();\n                return 'hiker://empty';\n            }\n            try {\n                request(url2, {\n                    method: 'PUT',\n                    headers: { 'Authorization': auth, 'Content-Type': 'application/json; charset=utf-8' },\n                    body: JSON.stringify(list2),\n                    timeout: 15000\n                });\n                setItem('fb_last_msg', '✅ 回复成功');\n                setItem('fb_last_ok', '1');\n                toast('✅ 回复成功');\n            } catch(e) {\n                setItem('fb_last_msg', '❌ 回复失败：' + e.message);\n                setItem('fb_last_ok', '0');\n                toast('❌ ' + e.message);\n            }\n            putMyVar('reply_target_ts', '');\n            refreshPage();\n            return 'hiker://empty';\n        })\n    });\n    d.push({\n        title: '❌ 取消回复',\n        col_type: 'flex_button',\n        url: $('#noLoading#').lazyRule(function() {\n            putMyVar('reply_target_ts', '');\n            refreshPage();\n            return 'hiker://empty';\n        }),\n        extra: { text_color: '#E53935' }\n    });\n    d.push({ col_type: 'line' });\n}\n\nvar allList = [];\nvar _pullOk = true;\ntry {\n    var raw = request(_fbUrl, { headers: { 'Authorization': _auth }, timeout: 8000 });\n    if (raw && raw.trim()) {\n        var parsed = JSON.parse(raw);\n        if (parsed && parsed.length >= 0) allList = parsed;\n    }\n} catch(e) {\n    _pullOk = false;\n}\n\nif (!_pullOk) {\n    d.push({ title: '❌ 拉取失败，请检查网络', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '16' } });\n    setResult(d);\n} else {\n    allList.sort(function(a, b) { return (b.t || 0) - (a.t || 0); });\n    var _doneCount = 0;\n    allList.forEach(function(x) { if (x.done === true) _doneCount++; });\n\n    d.push({\n        title: '共 ' + allList.length + ' 条  ·  已处理 ' + _doneCount + '  ·  待处理 ' + (allList.length - _doneCount),\n        col_type: 'text_center_1',\n        url: 'hiker://empty',\n        extra: { text_color: MC, text_size: '13' }\n    });\n    d.push({ col_type: 'line' });\n\n    if (allList.length === 0) {\n        d.push({ col_type: 'big_blank_block' });\n        d.push({ title: '暂无反馈', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '16' } });\n        setResult(d);\n    } else {\n        allList.forEach(function(item) {\n            var t = new Date(item.t || 0);\n            var pad = function(n) { return n < 10 ? '0' + n : String(n); };\n            var timeStr = (t.getMonth()+1) + '/' + t.getDate() + ' ' + pad(t.getHours()) + ':' + pad(t.getMinutes());\n            var _t = item.t || 0;\n            var _id = item.id || '----';\n            var _done = (item.done === true);\n\n            d.push({ title: '编号：' + _id + '  ' + (_done ? '✅ 已处理' : '⏳ 待处理'), col_type: 'text_1', url: 'hiker://empty', extra: { text_color: _done ? '#4CAF50' : '#FF9800', text_size: '14' } });\n            d.push({ title: timeStr + '  |  ' + (item.m || '') + '  |  v' + (item.v || ''), col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n            if (item.dev) d.push({ title: '📱 ' + item.dev, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n            if (item.pos) d.push({ title: '📍 ' + item.pos, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n            if (item.net) d.push({ title: '📶 ' + item.net, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n            d.push({ title: '💬 ' + (item.msg || ''), col_type: 'text_1', url: 'hiker://empty', extra: { text_color: MC, text_size: '13' } });\n\n            var _chat = item.chatList || [];\n            if (!_chat.length) {\n                if (item.reply) _chat.push({ by: 'author', content: item.reply, t: item.replyT || 0 });\n                if (item.userReply) _chat.push({ by: 'user', content: item.userReply, t: item.userReplyT || 0 });\n            }\n\n            if (_chat.length > 0) {\n                d.push({ col_type: 'blank_block' });\n                d.push({ title: '— 对话记录 —', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: '#999999', text_size: '12' } });\n                for (var _ci = 0; _ci < _chat.length; _ci++) {\n                    var _c = _chat[_ci];\n                    if (_c.by === 'author') {\n                        d.push({ title: '👤 作者：' + _c.content, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: '#1565c0', text_size: '13' } });\n                    } else {\n                        d.push({ title: '🙋 用户：' + _c.content, col_type: 'text_1', url: 'hiker://empty', extra: { text_color: '#7B5EA7', text_size: '13' } });\n                    }\n                }\n                d.push({ col_type: 'blank_block' });\n            }\n\n            d.push({\n                title: _chat.length > 0 ? '💬 继续回复' : '💬 回复',\n                col_type: 'flex_button',\n                url: $('#noLoading#').lazyRule(function(ts) {\n                    putMyVar('reply_target_ts', String(ts));\n                    refreshPage();\n                    return 'hiker://empty';\n                }, _t),\n                extra: { text_color: '#1565c0' }\n            });\n\n            d.push({\n                title: _done ? '↩️ 标记未处理' : '✅ 标记已处理',\n                col_type: 'flex_button',\n                url: $('#noLoading#').lazyRule(function(ts, toDone) {\n                    try {\n                        var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n                        var url2 = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\n                        var list2 = [];\n                        try {\n                            var r = request(url2, { headers: { 'Authorization': auth }, timeout: 8000 });\n                            if (r && r.trim()) { var p = JSON.parse(r); if (p && p.length >= 0) list2 = p; }\n                        } catch(e) {}\n                        for (var _i = 0; _i < list2.length; _i++) {\n                            if (String(list2[_i].t) === String(ts)) {\n                                list2[_i].done = (toDone === '1');\n                                list2[_i].doneT = (toDone === '1') ? Date.now() : 0;\n                                break;\n                            }\n                        }\n                        request(url2, {\n                            method: 'PUT',\n                            headers: { 'Authorization': auth, 'Content-Type': 'application/json; charset=utf-8' },\n                            body: JSON.stringify(list2),\n                            timeout: 15000\n                        });\n                        toast(toDone === '1' ? '✅ 已标记处理' : '↩️ 已改回待处理');\n                        refreshPage();\n                    } catch(e) { toast('❌ 失败：' + e.message); }\n                    return 'hiker://empty';\n                }, _t, _done ? '0' : '1'),\n                extra: { text_color: _done ? '#FF9800' : '#4CAF50' }\n            });\n\n            var _deleteConfirmStr = \"(function(){\" +\n                \"var ts2 = \" + JSON.stringify(String(_t)) + \";\" +\n                \"try {\" +\n                \"  var auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\" +\n                \"  var url2 = 'https://dav.jianguoyun.com/dav/luke/feedback.json';\" +\n                \"  var list2 = [];\" +\n                \"  try { var r = request(url2, { headers: { 'Authorization': auth }, timeout: 8000 });\" +\n                \"    if (r && r.trim()) { var p = JSON.parse(r); if (p && p.length >= 0) list2 = p; }\" +\n                \"  } catch(e) {}\" +\n                \"  var newList = list2.filter(function(x) { return String(x.t) !== String(ts2); });\" +\n                \"  request(url2, { method: 'PUT', headers: { 'Authorization': auth, 'Content-Type': 'application/json; charset=utf-8' }, body: JSON.stringify(newList), timeout: 15000 });\" +\n                \"  toast('🗑️ 已删除'); refreshPage();\" +\n                \"} catch(e) { toast('❌ 删除失败：' + e.message); }\" +\n                \"return 'hiker://empty';\" +\n                \"})()\";\n\n            d.push({\n                title: '🗑️ 删除',\n                col_type: 'flex_button',\n                url: $('#noLoading#').lazyRule(function(confirmStr) {\n                    confirm({\n                        title: '⚠️ 删除这条反馈？',\n                        content: '删除后不可恢复',\n                        confirm: confirmStr,\n                        cancel: $.toString(function() {})\n                    });\n                    return 'hiker://empty';\n                }, _deleteConfirmStr),\n                extra: { text_color: '#E53935' }\n            });\n\n            d.push({ col_type: 'line' });\n        });\n\n        setResult(d);\n    }\n}"},{"col_type":"movie_3","name":"聚合搜索","path":"聚合搜索","rule":"js:\nvar d = [];\nsetPageTitle('聚合搜索');\n\n// 关键词\nvar kw = '';\ntry {\n    var _m = String(MY_URL || '').match(/[?&]kw=([^&]*)/);\n    if (_m) { kw = decodeURIComponent(_m[1]); putMyVar('agg_search_kw', kw); }\n} catch(e) {}\nif (!kw) kw = getMyVar('agg_search_kw', '');\n\n// 当前模式\nvar curMode = getItem('content_mode', '');\n\n// 主题色\nvar themeColor = '#F5F5F5', fontColor = '#333333';\ntry {\n    var 主页助手 = $.require('主页助手');\n    themeColor = 主页助手.getThemeColor() || themeColor;\n    fontColor = 主页助手.getHomeFontColor() || fontColor;\n} catch(e) {}\n\nif (!kw) {\n    d.push({ title: '❌ 未输入关键词', col_type: 'text_center_1', url: 'hiker://empty' });\n    setResult(d);\n} else {\n\n    // 1. 只找当前模式下、有 search 方法的源\n    var allSources = [];\n    var srcNames = {};\n    try {\n        var cfg = $.require('Tab配置');\n        var pages = cfg.tabPages || {};\n        var names = cfg.tabNames || {};\n        var modeTabs = cfg.modeTabs || {};\n        var modeIds = modeTabs[curMode] || [];\n        if (!modeIds || modeIds.length === 0) {\n            modeIds = Object.keys(pages).map(Number);\n        }\n        for (var ii = 0; ii < modeIds.length; ii++) {\n            var tid = modeIds[ii];\n            var pk = pages[tid];\n            if (!pk) continue;\n            var code = null;\n            try { code = $.require('内容').loadCode(pk); } catch(e) { continue; }\n            if (!code) continue;\n            var mod = null;\n            try { eval(code); mod = eval(pk); } catch(e) { continue; }\n            if (mod && (mod.search || mod.搜索)) {\n                allSources.push(pk);\n                srcNames[pk] = names[tid] || pk;\n            }\n        }\n    } catch(e) {}\n\n    // 2. 逐个搜，收集有效结果\n    var resultMap = {};\n    for (var si = 0; si < allSources.length; si++) {\n        var src = allSources[si];\n        var _origSR = setResult;\n        var _tmp = [];\n        try {\n            setResult = function(x) { _tmp = x; };\n            var mod2 = eval(src);\n            if (mod2 && mod2.search) mod2.search(kw);\n            else if (mod2 && mod2.搜索) mod2.搜索(kw);\n        } catch(e) {}\n        setResult = _origSR;\n\n        var valid = [];\n        for (var ci = 0; ci < _tmp.length; ci++) {\n            var c = _tmp[ci];\n            if (!c || !c.title) continue;\n            if (String(c.title).indexOf('❌') === 0) continue;\n            var u = String(c.url || '');\n            if (!u || u === 'hiker://empty') continue;\n            valid.push(c);\n        }\n        if (valid.length > 0) resultMap[src] = valid;\n    }\n\n    var validSrcs = Object.keys(resultMap);\n\n    if (validSrcs.length === 0) {\n        var modeName = ({ normal: '影视', short_drama: '短剧', live: '直播', adult: '成人' })[curMode] || '当前';\n        d.push({ col_type: 'big_blank_block' });\n        d.push({ title: '共 0 个结果', desc: modeName + '模式下没有找到相关内容', col_type: 'text_center_1', url: 'hiker://empty' });\n        setResult(d);\n    } else {\n        // 3. 提前计算\"全部\"去重后的总数\n        var seenAll = {}, mergedAll = [];\n        for (var ai = 0; ai < validSrcs.length; ai++) {\n            var arrAll = resultMap[validSrcs[ai]];\n            for (var bi = 0; bi < arrAll.length; bi++) {\n                var cardAll = arrAll[bi];\n                var tAll = String(cardAll.title || '').trim();\n                if (!tAll) continue;\n                if (!seenAll[tAll]) { seenAll[tAll] = true; mergedAll.push(cardAll); }\n            }\n        }\n\n        // 4. 选中源处理\n        var sel = getMyVar('agg_search_src', 'ALL');\n        if (sel !== 'ALL' && validSrcs.indexOf(sel) < 0) { sel = 'ALL'; putMyVar('agg_search_src', 'ALL'); }\n\n        // 5. 顶部标签（\"全部\"带总数，其他带各自数量）\n        var tabs = ['ALL'].concat(validSrcs);\n        for (var ti = 0; ti < tabs.length; ti++) {\n            var sc = tabs[ti];\n            var nm = (sc === 'ALL') ? '全部' : (srcNames[sc] || sc);\n            var cnt = (sc === 'ALL') ? mergedAll.length : resultMap[sc].length;\n            var label = nm + '(' + cnt + ')';\n            var on = (sel === sc);\n            d.push({\n                title: