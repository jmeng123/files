        url: $([\\\"确定导入\\\", \\\"删除\\\"]).select(function(idx, it2) {\\n                if (input === \\\"确定导入\\\") {\\n                    $.require(\\\"function\\\").qdDoImport([it2], 1);\\n                    deleteItem('qd_import_' + idx);\\n                    return \\\"toast://已导入: \\\" + it2.name;\\n                } else {\\n                    deleteItem('qd_import_' + idx);\\n                    return \\\"toast://已删除\\\";\\n                }\\n            }, i, it),\\n            pic_url: typeIcon,\\n            col_type: 'avatar',\\n            extra: {id: 'qd_import_' + i, backgroundColor: bgColor, lineVisible: true}\\n        });\\n    }\\n    if (importdatas.length === 0) {\\n        d.push({title: '\\\\u2018\\\\u2018\\\\u2019\\\\u2019<font color=\\\"#868E96\\\">暂无导入数据</font>', col_type: \\\"text_center_1\\\"});\\n    }\\n    return d;\\n}\\n\\nfunction qdShowImport(importStr) {\\n    var importfile = \\\"hiker://files/_cache/qd_cloudimport.txt\\\";\\n    if (importStr) saveFile(importfile, importStr);\\n    return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function() {\\n        var fn = $.require(\\\"function\\\");\\n        setPageTitle(\\\"青豆导入\\\");\\n        var importfile = \\\"hiker://files/_cache/qd_cloudimport.txt\\\";\\n        addListener(\\\"onClose\\\", $.toString(function(f) { deleteFile(f); }, importfile));\\n        var input = fetch(importfile);\\n        var importdatas = [];\\n        if (!input) {\\n            toast('未获取到云口令');\\n        } else {\\n            importdatas = fn.qdExtractImport(input);\\n            if (importdatas.length === 0) toast('未获取到源数据，检查网络或口令');\\n        }\\n        setResult(fn.qdBuildImportUI(importdatas, importfile));\\n    });\\n}\\n\\nfunction qdDoImport(importdatas, mode) {\\n    var CONFIG_FILE = \\\"hiker://files/rules/青豆剧场/qd_configs\\\";\\n    for (var i = 0; i < importdatas.length; i++) {\\n        var it = importdatas[i];\\n        if (it._qd_type === 'parse') {\\n            var cfg = JSON.parse(readFile(CONFIG_FILE) || '{}');\\n            if (!cfg.parses) cfg.parses = [];\\n            var exists = -1;\\n            for (var j = 0; j < cfg.parses.length; j++) {\\n                if (cfg.parses[j].name === it.name && cfg.parses[j].url === it.url) { exists = j; break; }\\n            }\\n            if (mode === 1 && exists >= 0) {\\n                var newItem = JSON.parse(JSON.stringify(it));\\n                delete newItem._qd_type;\\n                cfg.parses[exists] = newItem;\\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\\n            } else if (exists < 0) {\\n                var newItem = JSON.parse(JSON.stringify(it));\\n                delete newItem._qd_type;\\n                cfg.parses.push(newItem);\\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\\n            }\\n        } else if (it._qd_type === 'bocai') {\\n            var cfg = JSON.parse(readFile(CONFIG_FILE) || '{}');\\n            if (!cfg.bocai_sites) cfg.bocai_sites = [];\\n            var exists = -1;\\n            for (var j = 0; j < cfg.bocai_sites.length; j++) {\\n                if (cfg.bocai_sites[j].key === it.key || cfg.bocai_sites[j].name === it.name) { exists = j; break; }\\n            }\\n            if (mode === 1 && exists >= 0) {\\n                var newItem = JSON.parse(JSON.stringify(it));\\n                delete newItem._qd_type;\\n                cfg.bocai_sites[exists] = newItem;\\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\\n            } else if (exists < 0) {\\n                var newItem = JSON.parse(JSON.stringify(it));\\n                delete newItem._qd_type;\\n                cfg.bocai_sites.push(newItem);\\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\\n            }\\n        } else if (it._qd_type === 'rule') {\\n            var cr = $.require(\\\"customRule\\\");\\n            var rules = cr.getRuleList();\\n            var exists = -1;\\n            var hm = (it.code || '').match(/[\\\"']?host[\\\"']?\\\\s*[:=]\\\\s*['\\\"]([^'\\\"]+)['\\\"]/);\\n            var importHost = hm ? hm[1] : '';\\n            for (var j = 0; j < rules.length; j++) {\\n                if (rules[j].name === it.name || (importHost && rules[j].host === importHost)) { exists = j; break; }\\n            }\\n            var ruleType = it['类型'] || it['\\\\u7c7b\\\\u578b'] || '搜索源';\\n            var ruleData = {name: it.name, '类型': ruleType, host: it.host || importHost, enabled: it.enabled !== false, code: it.code || ''};\\n            if (it.liveImportMode) ruleData.liveImportMode = it.liveImportMode;\\n            if (it.subscriptionUrl) ruleData.subscriptionUrl = it.subscriptionUrl;\\n            if (mode === 1 && exists >= 0) {\\n                ruleData.id = rules[exists].id;\\n                cr.saveRule(ruleData);\\n            } else if (exists < 0) {\\n                cr.saveRule(ruleData);\\n            }\\n        } else if (it._qd_type === 'jar_rule') {\\n            var cr = $.require(\\\"customRule\\\");\\n            var rules = cr.getRuleList();\\n            var exists = -1;\\n            for (var j = 0; j < rules.length; j++) {\\n                if (rules[j].name === it.name || (rules[j].api && rules[j].api === it.api)) { exists = j; break; }\\n            }\\n            var ruleData;\\n            if (it.isDrpy) {\\n                ruleData = {\\n                    name: it.name,\\n                    '类型': '影视',\\n                    host: '',\\n                    code: '',\\n                    api: it.api,\\n                    ext: it.ext || '',\\n                    jar: it.jar || '',\\n                    configKey: it.configKey || '',\\n                    enabled: it.enabled !== false\\n                };\\n                if (it.key) {\\n                    ruleData.key = it.key;\\n                    ruleData.id = 'catvod_' + it.key;\\n                }\\n            } else if (it.isCatVod) {\\n                var catvodCode = it.code || '';\\n                if (!catvodCode && it.api) {\\n                    try { catvodCode = qdFetchTvboxContent(it.api); } catch (eCv) {}\\n                }\\n                ruleData = {\\n                    name: it.name,\\n                    '类型': '影视',\\n                    host: '',\\n                    code: catvodCode,\\n                    api: it.api,\\n                    ext: it.ext || '',\\n                    configKey: it.configKey || '',\\n                    enabled: it.enabled !== false\\n                };\\n                if (it.key) {\\n                    ruleData.key = it.key;\\n                    ruleData.id = 'catvod_' + it.key;\\n                }\\n            } else {\\n                ruleData = {\\n                    name: it.name,\\n                    '类型': '本地包',\\n                    host: it.jar || '',\\n                    api: it.api,\\n                    jar: it.jar || '',\\n                    ext: it.ext || '',\\n                    configKey: it.configKey || '',\\n                    enabled: it.enabled !== false\\n                };\\n                if (it.key) {\\n                    ruleData.key = it.key;\\n                    ruleData.id = 'jar_' + it.key;\\n                }\\n            }\\n            if (mode === 1 && exists >= 0) {\\n                ruleData.id = rules[exists].id;\\n                cr.saveRule(ruleData);\\n            } else if (exists < 0) {\\n                cr.saveRule(ruleData);\\n            }\\n        }\\n    }\\n}\\n\\nfunction qdGetImportPlan(importdatas) {\\n    importdatas = importdatas || [];\\n    var CONFIG_FILE = \\\"hiker://files/rules/青豆剧场/qd_configs\\\";\\n    var cfg = {};\\n    try { cfg = JSON.parse(readFile(CONFIG_FILE) || '{}'); } catch (e) { cfg = {}; }\\n    var parses = cfg.parses || [];\\n    var sites = cfg.bocai_sites || [];\\n    var rules = [];\\n    try { rules = $.require(\\\"customRule\\\").getRuleList(); } catch(e2) {}\\n    var plan = { total: importdatas.length, add: 0, overwrite: 0, skip: 0, items: [] };\\n    for (var i = 0; i < importdatas.length; i++) {\\n        var it = importdatas[i] || {};\\n        var exists = -1;\\n        var typeLabel = it._qd_type === 'parse' ? '解析' : (it._qd_type === 'bocai' ? '菠菜' : (it._qd_type === 'jar_rule' ? '本地包' : '规则'));\\n        if (it._qd_type === 'parse') {\\n            for (var p = 0; p < parses.length; p++) {\\n                if (parses[p].name === it.name && parses[p].url === it.url) { exists = p; break; }\\n            }\\n        } else if (it._qd_type === 'bocai') {\\n            for (var b = 0; b < sites.length; b++) {\\n                if (sites[b].key === it.key || sites[b].name === it.name) { exists = b; break; }\\n            }\\n        } else if (it._qd_type === 'rule') {\\n            var hm = (it.code || '').match(/[\\\"']?host[\\\"']?\\\\s*[:=]\\\\s*['\\\"]([^'\\\"]+)['\\\"]/);\\n            var importHost = it.host || (hm ? hm[1] : '');\\n            for (var r = 0; r < rules.length; r++) {\\n                if (rules[r].name === it.name || (importHost && rules[r].host === importHost)) { exists = r; break; }\\n            }\\n        } else if (it._qd_type === 'jar_rule') {\\n            for (var r = 0; r < rules.length; r++) {\\n                if (rules[r].name === it.name || (rules[r].api && rules[r].api === it.api)) { exists = r; break; }\\n            }\\n        }\\n        var action = exists >= 0 ? 'overwrite' : 'add';\\n        if (action === 'add') plan.add++;\\n        else plan.overwrite++;\\n        plan.items.push({ index: i, data: it, typeLabel: typeLabel, action: action, exists: exists });\\n    }\\n    plan.skip = plan.overwrite;\\n    return plan;\\n}\\n\\nfunction qdShowRuleImportConfirm(ruleData) {\\n    if (!ruleData) return \\\"toast://导入数据为空\\\";\\n    saveFile(\\\"hiker://files/_cache/qd_rule_import_confirm.json\\\", JSON.stringify(ruleData));\\n    return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function() {\\n        var fn = $.require(\\\"function\\\");\\n        setPageTitle(\\\"规则导入确认\\\");\\n        var data = {};\\n        try { data = JSON.parse(fetch(\\\"hiker://files/_cache/qd_rule_import_confirm.json\\\") || '{}'); } catch(e) {}\\n        var plan = fn.qdGetImportPlan([data]);\\n        var item = plan.items[0] || { action: 'add', data: data, typeLabel: '规则' };\\n        var d = [];\\n        d.push({\\n            title: '\\\\u2018\\\\u2018\\\\u2019\\\\u2019<b><font color=\\\"#339AF0\\\">导入确认</font></b>',\\n            desc: '名称: ' + (data.name || '') + '\\\\n类型: ' + (data['类型'] || '主页源') + '\\\\n状态: ' + (item.action === 'overwrite' ? '将覆盖已存在规则' : '将新增规则'),\\n            col_type: 'text_1'\\n        });\\n        d.push({\\n            title: item.action === 'overwrite' ? '覆盖导入' : '新增导入',\\n            pic_url: item.action === 'overwrite' ? 'hiker://images/icon_download6' : 'hiker://images/icon_add2',\\n            url: $(\\\"确认导入「\\\" + (data.name || '') + \\\"」？\\\").confirm(function(data) {\\n                $.require(\\\"function\\\").qdDoImport([data], 1);\\n                back(true);\\n                return \\\"toast://导入完成: \\\" + data.name;\\n            }, data),\\n            col_type: 'icon_2'\\n        });\\n        d.push({\\n            title: '取消',\\n            pic_url: 'hiker://images/icon_close_2',\\n            url: $(\\\"取消本次导入？\\\").confirm(function() { back(false); return \\\"hiker://empty\\\"; }),\\n            col_type: 'icon_2'\\n        });\\n        d.push({col_type: 'line'});\\n        d.push({\\n            title: data.name || '导入规则',\\n            desc: '<font color=\\\"#868E96\\\">[' + (data['类型'] || '主页源') + '] ' + (data.host || '') + '</font>',\\n            pic_url: 'hiker://images/icon_edit6',\\n            url: 'hiker://empty',\\n            col_type: 'avatar',\\n            extra: { backgroundColor: item.action === 'overwrite' ? '#20FFA94D' : '#2051CF66', lineVisible: true }\\n        });\\n        setResult(d);\\n    });\\n}\\n\\nfunction qdShowJarImportConfirm(jarRules) {\\n    if (!jarRules || !Array.isArray(jarRules) || jarRules.length === 0) return \\\"toast://无jar规则可导入\\\";\\n    saveFile(\\\"hiker://files/_cache/qd_jar_import_confirm.json\\\", JSON.stringify(jarRules));\\n    return $(\\\"hiker://empty#noRecordHistory##noHistory#\\\").rule(function() {\\n        var fn = $.require(\\\"function\\\");\\n        setPageTitle(\\\"本地包导入确认\\\");\\n        var datas = [];\\n        try { datas = JSON.parse(fetch(\\\"hiker://files/_cache/qd_jar_import_confirm.json\\\") || '[]'); } catch(e) {}\\n        var plan = fn.qdGetImportPlan(datas);\\n        var d = [];\\n        d.push({\\n            title: '\\\\u2018\\\\u2018\\\\u2019\\\\u2019<b><font color=\\\"#339AF0\\\">本地包导入</font></b>',\\n            desc: '共 ' + datas.length + ' 条，新增 ' + plan.add + ' 条，覆盖 ' + plan.overwrite + ' 条',\\n            col_type: 'text_1'\\n        });\\n        d.push({\\n            title: '全部导入',\\n            pic_url: 'hiker://images/icon_add2',\\n            url: $(\\\"确认导入全部\\\" + datas.length + \\\"条本地包？\\\").confirm(function(datas) {\\n                $.require(\\\"function\\\").qdDoImport(datas, 1);\\n                back(true);\\n                return \\\"toast://导入完成: \\\" + datas.length + \\\" 条\\\";\\n            }, datas),\\n            col_type: 'icon_2'\\n        });\\n        d.push({col_type: 'line'});\\n        for (var i = 0; i < datas.length; i++) {\\n            var it = datas[i];\\n            var itemPlan = plan.items[i] || { action: 'add' };\\n            d.push({\\n                title: it.name + ' <font color=\\\"#868E96\\\">[' + it.api + ']</font>',\\n                desc: '<font color=\\\"#868E96\\\">' + (it.jar || '').substring(0, 80) + (it.jar && it.jar.length > 80 ? '...' : '') + '</font>',\\n                pic_url: itemPlan.action === 'overwrite' ? 'hiker://images/icon_download6' : 'hiker://images/icon_add2',\\n                url: $(\\\"确认导入「\\\" + it.name + \\\"」？\\\").confirm(function(idx) {\\n                    var datas2 = JSON.parse(fetch(\\\"hiker://files/_cache/qd_jar_import_confirm.json\\\") || '[]');\\n                    $.require(\\\"function\\\").qdDoImport([datas2[idx]], 1);\\n                    refreshPage(false);\\n                    return \\\"toast://导入完成: \\\" + datas2[idx].name;\\n                }, i),\\n                col_type: 'avatar',\\n                extra: { backgroundColor: itemPlan.action === 'overwrite' ? '#20FFA94D' : '#2051CF66', lineVisible: true }\\n            });\\n        }\\n        setResult(d);\\n    });\\n}\\n\\nfunction SourceStateManager(sourceId) {\\n    this.sourceId = sourceId || '';\\n}\\nSourceStateManager.prototype._read = function() {\\n    if (!this.sourceId) return {};\\n    try {\\n        var cr = $.require(\\\"customRule\\\");\\n        if (cr.getSourceState) return cr.getSourceState(this.sourceId) || {};\\n    } catch(e) {}\\n    return {};\\n};\\nSourceStateManager.prototype._write = function(state) {\\n    if (!this.sourceId) return state || {};\\n    try {\\n        var cr = $.require(\\\"customRule\\\");\\n        if (cr.setSourceState) return cr.setSourceState(this.sourceId, state || {});\\n    } catch(e) {}\\n    return state || {};\\n};\\nSourceStateManager.prototype.get = function(key, defValue) {\\n    var st = this._read();\\n    return st[key] !== undefined ? st[key] : defValue;\\n};\\nSourceStateManager.prototype.set = function(key, value) {\\n    var st = this._read();\\n    st[key] = value;\\n    st.updatedAt = Date.now();\\n    this._write(st);\\n};\\nSourceStateManager.prototype.merge = function(patch) {\\n    var st = this._read();\\n    patch = patch || {};\\n    for (var k in patch) {\\n        if (patch.hasOwnProperty(k)) st[k] = patch[k];\\n    }\\n    st.updatedAt = Date.now();\\n    this._write(st);\\n    return st;\\n};\\nSourceStateManager.prototype.clear = function(key) {\\n    var st = this._read();\\n    if (key) delete st[key];\\n    else st = {};\\n    this._write(st);\\n};\\n\\nfunction PlayerStateManager(pageId) {\\n    this.pageId = pageId;\\n    this.sourceState = new SourceStateManager('detail_' + pageId);\\n}\\nPlayerStateManager.prototype.getLine = function() { return this.sourceState.get('line', getItem('bc_agg_line_' + this.pageId, '')); };\\nPlayerStateManager.prototype.setLine = function(line) { var limit = getPageSize(); setItem('bc_agg_line_' + this.pageId, line); setItem('bc_agg_page_' + this.pageId, '0'); setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.merge({line: line, page: 0, limit: limit}); };\\nPlayerStateManager.prototype.getPage = function() { return Number(this.sourceState.get('page', getItem('bc_agg_page_' + this.pageId, '0'))) || 0; };\\nPlayerStateManager.prototype.setPage = function(page) { setItem('bc_agg_page_' + this.pageId, String(page)); this.sourceState.set('page', Number(page) || 0); };\\nPlayerStateManager.prototype.getSort = function() { return this.sourceState.get('sort', getItem('bc_agg_order_' + this.pageId, 'asc')); };\\nPlayerStateManager.prototype.setSort = function(sort) { setItem('bc_agg_order_' + this.pageId, sort); setItem('bc_agg_page_' + this.pageId, '0'); this.sourceState.merge({sort: sort, page: 0}); };\\nPlayerStateManager.prototype.getMode = function() { return this.sourceState.get('mode', getItem('bc_agg_mode_' + this.pageId, 'auto')); };\\nPlayerStateManager.prototype.setMode = function(mode) { var limit = getPageSize(); setItem('bc_agg_mode_' + this.pageId, mode); setItem('bc_agg_page_' + this.pageId, '0'); setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.merge({mode: mode, page: 0, limit: limit}); };\\nPlayerStateManager.prototype.getLimit = function() { return Number(this.sourceState.get('limit', getItem('bc_agg_limit_' + this.pageId, String(getPageSize())))) || getPageSize(); };\\nPlayerStateManager.prototype.setLimit = function(limit) { setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.set('limit', Number(limit) || getPageSize()); };\\nPlayerStateManager.prototype.reset = function() { var limit = getPageSize(); setItem('bc_agg_page_' + this.pageId, '0'); setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.merge({page: 0, limit: limit}); };\\n\\nfunction _cacheLayerPrefix(layer) {\\n    layer = layer || 'detail';\\n    if (layer === 'parse') return 'qd_parse_';\\n    if (layer === 'searchAgg') return 'qd_search_agg_';\\n    if (layer === 'detail') return 'qd_detail_';\\n    return 'qd_' + String(layer).replace(/[^\\\\w-]/g, '_') + '_';\\n}\\nfunction gzipCompress(text) {\\n    try {\\n        var baos = new java.io.ByteArrayOutputStream();\\n        var gzos = new java.util.zip.GZIPOutputStream(baos);\\n        gzos.write(new java.lang.String(text).getBytes(\\\"UTF-8\\\"));\\n        gzos.close();\\n        var compressed = baos.toByteArray();\\n        baos.close();\\n        return String(java.util.Base64.getEncoder().encodeToString(compressed));\\n    } catch (e) { return null; }\\n}\\nfunction gzipDecompress(b64) {\\n    try {\\n        var compressed = java.util.Base64.getDecoder().decode(b64);\\n        var bais = new java.io.ByteArrayInputStream(compressed);\\n        var gis = new java.util.zip.GZIPInputStream(bais);\\n        var baos = new java.io.ByteArrayOutputStream();\\n        var buffer = java.lang.reflect.Array.newInstance(java.lang.Byte.TYPE, 1024);\\n        var len;\\n        while ((len = gis.read(buffer)) != -1) { baos.write(buffer, 0, len); }\\n        gis.close();\\n        bais.close();\\n        baos.close();\\n        return String(new java.lang.String(baos.toByteArray(), \\\"UTF-8\\\"));\\n    } catch (e) { return null; }\\n}\\nfunction getLayerCache(layer, cacheKey, ttl) {\\n    ttl = ttl || 30 * 60 * 1000;\\n    var cacheFile = 'hiker://files/cache/' + _cacheLayerPrefix(layer) + cacheKey + '.json';\\n    if (fileExist(cacheFile)) {\\n        try {\\n            var raw = fetch(cacheFile);\\n            if (!raw) return null;\\n            var jsonStr = raw;\\n            if (raw.length > 0 && raw.charAt(0) !== '{' && raw.charAt(0) !== '[') {\\n                var decompressed = gzipDecompress(raw);\\n                if (decompressed) jsonStr = decompressed;\\n            }\\n            var data = JSON.parse(jsonStr);\\n            if (data && data.ts && (Date.now() - data.ts < ttl)) return data.data;\\n        } catch (e) {}\\n    }\\n    return null;\\n}\\nfunction setLayerCache(layer, cacheKey, data) {\\n    try {\\n        var jsonStr = JSON.stringify({ ts: Date.now(), data: data });\\n        var toSave = jsonStr;\\n        if (jsonStr.length > 512) {\\n            var compressed = gzipCompress(jsonStr);\\n            if (compressed) toSave = compressed;\\n        }\\n        saveFile('hiker://files/cache/' + _cacheLayerPrefix(layer) + cacheKey + '.json', toSave);\\n    } catch (e) {}\\n}\\nfunction clearLayerCache(layer, cacheKey) {\\n    try { saveFile('hiker://files/cache/' + _cacheLayerPrefix(layer) + cacheKey + '.json', '{}'); } catch (e) {}\\n}\\nfunction getSecondaryCache(cacheKey, ttl) {\\n    return getLayerCache('detail', cacheKey, ttl);\\n}\\nfunction setSecondaryCache(cacheKey, data) {\\n    return setLayerCache('detail', cacheKey, data);\\n}\\nfunction clearSecondaryCache(cacheKey) {\\n    return clearLayerCache('detail', cacheKey);\\n}\\n\\nvar _lastAggPageId = '';\\nfunction AggCacheManager(pageId) {\\n    this.pageId = pageId || '';\\n    this.resultKey = 'bc_agg_results_' + this.pageId;\\n    this.mergedKey = 'bc_agg_merged_' + this.pageId;\\n    if (pageId && _lastAggPageId && pageId !== _lastAggPageId) {\\n        try {\\n            var oldResultKey = 'bc_agg_results_' + _lastAggPageId;\\n            var oldMergedKey = 'bc_agg_merged_' + _lastAggPageId;\\n            clearLayerCache('searchAgg', oldResultKey);\\n            clearLayerCache('detail', oldMergedKey);\\n            clearSecondaryCache(oldResultKey);\\n            clearSecondaryCache(oldMergedKey);\\n            putMyVar('bc_agg_merged_cache_' + _lastAggPageId, '');\\n            putMyVar('bc_agg_merged_ts_' + _lastAggPageId, '0');\\n            putMyVar('bc_agg_force_' + _lastAggPageId, '');\\n        } catch(e) {}\\n    }\\n    _lastAggPageId = this.pageId;\\n}\\nAggCacheManager.prototype.getResults = function(ttl) {\\n    return getLayerCache('searchAgg', this.resultKey, ttl) || getSecondaryCache(this.resultKey, ttl);\\n};\\nAggCacheManager.prototype.setResults = function(data) {\\n    setLayerCache('searchAgg', this.resultKey, data || []);\\n    setSecondaryCache(this.resultKey, data || []);\\n};\\nAggCacheManager.prototype.getMerged = function(ttl) {\\n    return getLayerCache('detail', this.mergedKey, ttl) || getSecondaryCache(this.mergedKey, ttl);\\n};\\nAggCacheManager.prototype.setMerged = function(data) {\\n    setLayerCache('detail', this.mergedKey, data || []);\\n    setSecondaryCache(this.mergedKey, data || []);\\n};\\nAggCacheManager.prototype.clear = function() {\\n    clearLayerCache('searchAgg', this.resultKey);\\n    clearLayerCache('detail', this.mergedKey);\\n    clearSecondaryCache(this.resultKey);\\n    clearSecondaryCache(this.mergedKey);\\n    if (_lastAggPageId === this.pageId) _lastAggPageId = '';\\n};\\n\\nfunction isPageRefreshing() {\\n    try {\\n        var activity = getCurrentActivity();\\n        if (!activity) return false;\\n        var smartRefresh;\\n        var className = activity.getClass().getName();\\n        if (className == \\\"com.example.hikerview.ui.home.RuleWindowActivity\\\" ||\\n            className == \\\"com.example.hikerview.ui.home.FilmListActivity\\\") {\\n            var fragmentField = activity.getClass().getDeclaredField(\\\"articleListFragment\\\");\\n            fragmentField.setAccessible(true);\\n            var fragment = fragmentField.get(activity);\\n            var smartField = fragment.getClass().getDeclaredField(\\\"smartRefreshLayout\\\");\\n            smartField.setAccessible(true);\\n            smartRefresh = smartField.get(fragment);\\n        }\\n        if (smartRefresh) {\\n            var state = smartRefresh.getState();\\n            return state.toString() == \\\"Refreshing\\\";\\n        }\\n        return false;\\n    } catch (e) {\\n        return false;\\n    }\\n}\\n\\nfunction forceRefreshAgg(pageId, opts) {\\n    pageId = pageId === undefined || pageId === null ? '' : String(pageId);\\n    opts = opts || {};\\n    if (pageId) {\\n        putMyVar('bc_agg_force_' + pageId, '1');\\n        try { new AggCacheManager(pageId).clear(); } catch (e) {}\\n    }\\n    putMyVar('bc_agg_current_id', '');\\n    putMyVar('bc_agg_current_data', '');\\n    putMyVar('bc_agg_current_ts', '0');\\n    putMyVar('bc_agg_merged_cache', '');\\n    putMyVar('bc_agg_merged_ts', '0');\\n    if (opts.tmdbId) putMyVar('tmdb_force_' + opts.tmdbId, '1');\\n    if (opts.tmdbIds && opts.tmdbIds.length) {\\n        for (var i = 0; i < opts.tmdbIds.length; i++) {\\n            if (opts.tmdbIds[i]) putMyVar('tmdb_force_' + opts.tmdbIds[i], '1');\\n        }\\n    }\\n}\\n\\nfunction aggMergeBocaiResults(allResults) {\\n    function getEpNames(r) {\\n        var epList = r.playUrl.split('#').filter(function(e) { return e; });\\n        var names = [];\\n        for (var j = 0; j < epList.length; j++) names.push(epList[j].split('$')[0] || '');\\n        return names;\\n    }\\n    function normEpName(name) {\\n        var s = (name || '').replace(/\\\\s+/g, '').replace(/^(第|ep|EP|e|E)/, '').replace(/[集期话話]$/, '');\\n        var cnMap = {'零':0,'一':1,'二':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9,'十':10,'百':100,'千':1000,'万':10000};\\n        s = s.replace(/[零一二三四五六七八九十百千万]+/g, function(m) {\\n            if (m.length === 1 && cnMap[m] !== undefined) return cnMap[m];\\n            var r = 0, cur = 0;\\n            for (var i = 0; i < m.length; i++) {\\n                var v = cnMap[m[i]];\\n                if (v >= 10) { cur = cur === 0 ? v : cur * v; r += cur; cur = 0; }\\n                else cur = v;\\n            }\\n            r += cur;\\n            return r || m;\\n        });\\n        if (/^\\\\d+$/.test(s)) return String(Number(s));\\n        return s;\\n    }\\n    function groupByEp(results) {\\n        var used = {};\\n        var groups = [];\\n        for (var i = 0; i < results.length; i++) {\\n            if (used[i]) continue;\\n            var group = [results[i]];\\n            used[i] = true;\\n            var baseNames = getEpNames(results[i]);\\n            var baseNorm = [];\\n            for (var k = 0; k < baseNames.length; k++) baseNorm.push(normEpName(baseNames[k]));\\n            var changed = true;\\n            while (changed) {\\n                changed = false;\\n                for (var j = 0; j < results.length; j++) {\\n                    if (used[j]) continue;\\n                    var curNames = getEpNames(results[j]);\\n                    var minLen = Math.min(baseNames.length, curNames.length);\\n                    var match = 0;\\n                    for (var k = 0; k < minLen; k++) {\\n                        if (baseNorm[k] === normEpName(curNames[k])) match++;\\n                    }\\n                    if (match === minLen) {\\n                        group.push(results[j]);\\n                        used[j] = true;\\n                        changed = true;\\n                    }\\n                }\\n            }\\n            if (group.length >= 1) groups.push(group);\\n        }\\n        return groups;\\n    }\\n    function addAdFreeForSingleGroups(groups, origType) {\\n        for (var i = 0; i < groups.length; i++) {\\n            if (groups[i].length === 1) {\\n                var orig = groups[i][0];\\n                groups[i].push({\\n                    name: '🛡️去广告',\\n                    key: orig.key + '_adfree',\\n                    type: origType,\\n                    ruleName: orig.ruleName,\\n                    _ruleId: orig._ruleId,\\n                    _sourceApi: orig._sourceApi,\\n                    siteKey: orig.siteKey,\\n                    epCount: orig.epCount,\\n                    playFrom: '去广告',\\n                    playUrl: orig.playUrl\\n                });\\n            }\\n        }\\n        return groups;\\n    }\\n    function buildMerged(sourceGroups, mergedType, mergedName) {\\n        var mergedList = [];\\n        var mergedKeys = {};\\n        for (var i = 0; i < sourceGroups.length; i++) {\\n            var group = sourceGroups[i];\\n            var hasOfficial = false;\\n            for (var oi = 0; oi < group.length; oi++) {\\n                if (group[oi].type === 'official') { hasOfficial = true; break; }\\n            }\\n            var actualType = hasOfficial ? 'merged_official' : mergedType;\\n            group.sort(function(a, b) {\\n                var ha = a.playFrom.indexOf('蓝光') !== -1 || a.name.indexOf('蓝光') !== -1 ? 0 : 1;\\n                var hb = b.playFrom.indexOf('蓝光') !== -1 || b.name.indexOf('蓝光') !== -1 ? 0 : 1;\\n                return ha - hb;\\n            });\\n            var srcNames = [];\\n            for (var k = 0; k < group.length; k++) {\\n                srcNames.push(group[k].playFrom || group[k].name.replace(/^🍎\\\\s*主页源-?/, '').replace(/^🎬/, ''));\\n            }\\n            var allEpNames = [];\\n            var normToRaw = {};\\n            var nameSet = {};\\n            var normMaps = [];\\n            for (var k = 0; k < group.length; k++) {\\n                var nm = {};\\n                var nList = getEpNames(group[k]);\\n                for (var j = 0; j < nList.length; j++) {\\n                    var nn = normEpName(nList[j]);\\n                    nm[nn] = group[k].playUrl.split('#').filter(function(e){return e;})[j].split('$')[1] || group[k].playUrl.split('#').filter(function(e){return e;})[j].split('$')[0] || '';\\n                    if (!nameSet[nn]) { nameSet[nn] = true; allEpNames.push(nList[j]); normToRaw[nn] = nList[j]; }\\n                }\\n                normMaps.push(nm);\\n            }\\n            var mergedUrls = [];\\n            var episodeRuleIds = [];\\n            var episodeSourceApis = [];\\n            var episodeSourceNames = [];\\n            var maxCount = 0;\\n            for (var j = 0; j < allEpNames.length; j++) {\\n                var epName = allEpNames[j];\\n                var nn = normEpName(epName);\\n                var urls = [];\\n                var ruleIds = [];\\n                var sourceApis = [];\\n                var epSrcNames = [];\\n                for (var k = 0; k < normMaps.length; k++) {\\n                    if (normMaps[k][nn] !== undefined) {\\n                        urls.push(normMaps[k][nn]);\\n                        ruleIds.push(group[k]._ruleId || '');\\n                        sourceApis.push(group[k]._sourceApi || '');\\n                        epSrcNames.push(srcNames[k] || ('线路' + (k + 1)));\\n                    }\\n                }\\n                mergedUrls.push(epName + '$' + urls.join('||'));\\n                episodeRuleIds.push(ruleIds);\\n                episodeSourceApis.push(sourceApis);\\n                episodeSourceNames.push(epSrcNames);\\n                if (urls.length > maxCount) maxCount = urls.length;\\n            }\\n            mergedList.push({\\n                name: mergedName,\\n                key: actualType + '_' + i,\\n                type: actualType,\\n                epCount: mergedUrls.length,\\n                playFrom: mergedName,\\n                playUrl: mergedUrls.join('#'),\\n                sources: group,\\n                sourceNames: srcNames,\\n                episodeRuleIds: episodeRuleIds,\\n                episodeSourceApis: episodeSourceApis,\\n                episodeSourceNames: episodeSourceNames,\\n                maxSourceCount: maxCount\\n            });\\n            for (var k = 0; k < group.length; k++) mergedKeys[group[k].key] = true;\\n        }\\n        return { merged: mergedList, keys: mergedKeys };\\n    }\\n\\n    var bocaiOnly = [];\\n    var officialOnly = [];\\n    var ruleItems = [];\\n    for (var i = 0; i < allResults.length; i++) {\\n        if (allResults[i].type === 'bocai') bocaiOnly.push(allResults[i]);\\n        else if (allResults[i].type === 'official') officialOnly.push(allResults[i]);\\n        else if (!isPanAggResult(allResults[i])) ruleItems.push(allResults[i]);\\n    }\\n\\n    var bocaiRes = buildMerged(addAdFreeForSingleGroups(groupByEp(bocaiOnly), 'bocai'), 'merged_bocai', '菠菜聚合');\\n    var officialRes = { merged: [], keys: {} };\\n\\n    var ruleGroups = {};\\n    for (var ri = 0; ri < ruleItems.length; ri++) {\\n        var rn = ruleItems[ri].ruleName || ruleItems[ri].name || '其他';\\n        rn = rn.replace(/^[🎬🔍🌿]/, '').trim();\\n        if (!ruleGroups[rn]) ruleGroups[rn] = [];\\n        ruleGroups[rn].push(ruleItems[ri]);\\n    }\\n\\n    var ruleMergedAll = [];\\n    var ruleKeys = {};\\n    for (var rgn in ruleGroups) {\\n        var rgItems = ruleGroups[rgn];\\n        var rgRes = buildMerged(addAdFreeForSingleGroups(groupByEp(rgItems), 'rule'), 'merged_rule', rgn);\\n        for (var rmi = 0; rmi < rgRes.merged.length; rmi++) {\\n            rgRes.merged[rmi].ruleName = rgn;\\n            ruleMergedAll.push(rgRes.merged[rmi]);\\n        }\\n        for (var rk in rgRes.keys) ruleKeys[rk] = true;\\n    }\\n\\n    var final = [];\\n    for (var i = 0; i < allResults.length; i++) {\\n        var r = allResults[i];\\n        if (r.type === 'official' && !officialRes.keys[r.key]) final.push(r);\\n        else if (r.type === 'bocai' && !bocaiRes.keys[r.key]) final.push(r);\\n        else if (r.type !== 'official' && r.type !== 'bocai' && !ruleKeys[r.key]) final.push(r);\\n    }\\n    final = final.concat(officialRes.merged).concat(ruleMergedAll).concat(bocaiRes.merged);\\n    final.sort(function(a, b) {\\n        var oa = (a.type === 'official' || a.type === 'merged_official' ? 0 : 1);\\n        var ob = (b.type === 'official' || b.type === 'merged_official' ? 0 : 1);\\n        if (oa !== ob) return oa - ob;\\n        return 0;\\n    });\\n    return final;\\n}\\n\\nfunction aggBuildCategories(results) {\\n    var officialGroup = [];\\n    var ruleGroups = {};\\n    var bocaiGroup = [];\\n    for (var i = 0; i < results.length; i++) {\\n        var r = results[i];\\n        if (r.type === 'official' || r.type === 'merged_official') officialGroup.push(r);\\n        else if (r.type === 'bocai' || r.type === 'merged_bocai') bocaiGroup.push(r);\\n        else {\\n            var gName = r.ruleName || r.name || '其他';\\n            gName = gName.replace(/^[🎬🔍🌿]/, '').trim();\\n            if (!ruleGroups[gName]) ruleGroups[gName] = [];\\n            ruleGroups[gName].push(r);\\n        }\\n    }\\n    var categories = [];\\n    if (officialGroup.length > 0) categories.push({ name: '官方源', results: officialGroup });\\n    var gKeys = Object.keys(ruleGroups);\\n    for (var gi = 0; gi < gKeys.length; gi++) categories.push({ name: gKeys[gi], results: ruleGroups[gKeys[gi]] });\\n    if (bocaiGroup.length > 0) categories.push({ name: '菠菜源', results: bocaiGroup });\\n    return categories;\\n}\\n\\nfunction aggDefaultEpUrl(ctx) {\\n    var line = ctx.line, obj = ctx.obj, epName = ctx.epName, playLink = ctx.playLink, originalIndex = ctx.index;\\n    if (line.type === 'merged_bocai' || line.type === 'merged_rule' || line.type === 'merged_official') {\\n        var epUrls = ctx.epUrls;\\n        var srcNames = (line.episodeSourceNames && line.episodeSourceNames[originalIndex]) || ctx.srcNames;\\n        var ruleIds = (line.episodeRuleIds && line.episodeRuleIds[originalIndex]) || [];\\n        var sourceApis = (line.episodeSourceApis && line.episodeSourceApis[originalIndex]) || [];\\n        return $(playLink).lazyRule(function(dId, sTitle, eIdx, eTitle, eUrls, sNames, rIds, sApis, pLink, mergedType, movieTitle) {\\n            try {\\n            $.require('function').setProgress(dId, { sourceTitle: sTitle, episodeIndex: eIdx, episodeTitle: eTitle, playLink: pLink, playType: 'merged' });\\n            $.require('function').fpUpdate(dId, sTitle, eIdx, eTitle, pLink, 'merged');\\n            var dmMode = $.require('function').getExternalDanmuConfig().mode;\\n            if (/\\\\[画\\\\]/.test(sTitle) || /\\\\[音\\\\]/.test(sTitle)) dmMode = 'off';\\n            var dmPath = (dmMode === 'external' || dmMode === 'local') ? $.require('function').getExternalDanmuUrl(pLink, movieTitle || '', '', eTitle) : '';\\n            var dmCacheKey = 'dm_url_' + dId + '_' + eIdx;\\n            var dmCached = dmMode === 'box' ? getMyVar(dmCacheKey, '') : '';\\n            if (dmCached) {\\n                try {\\n                    var dmData = JSON.parse(dmCached);\\n                    if (dmData.ts && (Date.now() - dmData.ts < 2 * 60 * 60 * 1000) && dmData.url) dmPath = dmData.url;\\n                } catch (e) {}\\n            }\\n            if (!dmPath && dmMode === 'box') {\\n                try {\\n                    var eps = $.require('function').getEpisodes(dId);\\n                    if (eps && eps.playList && eps.playList.length > 0) {\\n                        var matchedUrl = '';\\n                        for (var i = 0; i < eps.playList.length; i++) {\\n                            if (eIdx < eps.playList[i].list.length) { matchedUrl = eps.playList[i].list[eIdx].play_link; break; }\\n                        }\\n                        if (!matchedUrl) { var last = eps.playList[eps.playList.length - 1]; matchedUrl = last.list[last.list.length - 1].play_link; }\\n                        if (matchedUrl) {\\n                            try {\\n                                var dmFun = $.require('hiker://page/dmFun?rule=dm盒子');\\n                                var dm = dmFun.dmRoute(matchedUrl);\\n                                if (dm && dm !== false) { dmPath = dm; putVar('dm_share', dm); putMyVar(dmCacheKey, JSON.stringify({ url: dm, ts: Date.now() })); }\\n                            } catch (e) {}\\n                        }\\n                    }\\n                } catch (e) {}\\n            }\\n            var vUrls = [];\\n            var vNames = [];\\n            var vHeaders = [];\\n            var panUrls = [];\\n            for (var si = 0; si < eUrls.length; si++) {\\n                var resolvedUrl = eUrls[si];\\n                if (mergedType === 'merged_rule' && (rIds[si] || sApis[si])) {\\n                    try {\\n                        var cr = $.require('customRule');\\n                        var rules = cr.getRuleList ? cr.getRuleList() : cr.getRuleIndex();\\n                        var ruleObj = null;\\n                        for (var ri = 0; ri < rules.length; ri++) {\\n                            if ((rIds[si] && rules[ri].id === rIds[si]) || (sApis[si] && (rules[ri].url === sApis[si] || rules[ri].host === sApis[si]))) { ruleObj = rules[ri]; break; }\\n                        }\\n                        if (ruleObj) {\\n                            var parsed = cr.executeLazy(ruleObj, resolvedUrl);\\n                            if (parsed) resolvedUrl = parsed;\\n                        }\\n                    } catch (e) {}\\n                }\\n                if (typeof resolvedUrl === 'string' && resolvedUrl.indexOf('pan://') === 0) {\\n                    return $.require('function').resolvePanJump(resolvedUrl);\\n                }\\n                if (typeof resolvedUrl === 'string' && /^\\\\s*[\\\\{\\\\[]/.test(resolvedUrl)) {\\n                    try { resolvedUrl = JSON.parse(resolvedUrl); } catch (e) {}\\n                }\\n                var rNeedSniff = (resolvedUrl && typeof resolvedUrl === 'object' && (resolvedUrl.parse === 1 || resolvedUrl.parse === '1' || resolvedUrl.jx === 1 || resolvedUrl.jx === '1'));\\n                var resolvedUrls = resolvedUrl && typeof resolvedUrl === 'object' && resolvedUrl.url