lse {\\n                                setItem('img', '/storage/emulated/0/Pictures/');\\n                                toast('不是有效地址,默认海阔图片保存目录');\\n                            }\\n                        });\\n                    })\\n                },\\n                {\\n                    title: '删除',\\n                    js: $.toString(function() {\\n                        if (!input.startsWith('/')) {\\n                            toast('~~网络图片无法删除~~');\\n                        } else {\\n                            if (imgPath.startsWith('/')) {\\n                                var File = java.io.File;\\n                                var file = new File(input);\\n                                if (file.delete()) {\\n                                    toast('~~已删除该图片~~');\\n                                } else {\\n                                    toast('~~删除图片失败~~');\\n                                }\\n                            }\\n                            back(true);\\n                        }\\n                    })\\n                }\\n            ]\\n        }\\n    });\\n    registerTask(id, time, $.toString(function(blist, id) {\\n        var idx = parseInt(getMyVar('banner_idx_' + id, '0'));\\n        if (idx >= blist.length) idx = 0;\\n        try {\\n            updateItem(id, { img: blist[idx], desc: '0', url: 'pics://' + blist.slice(idx).join('&&') });\\n        } catch (e) {\\n            log(\\\"轮播任务异常：\\\" + e.message);\\n            unRegisterTask(id);\\n        }\\n        idx++;\\n        putMyVar('banner_idx_' + id, idx + '');\\n    }, blist, id));\\n    if (getItem('轮播', '1') == '0') unRegisterTask(id);\\n    return result;\\n}\\n\\n// 获取轮播图片数组\\nfunction getImageArray() {\\n    var arr = [];\\n    var imgPath = getItem('img', '/storage/emulated/0/Pictures/');\\n    var cacheKey = 'banner_cache_' + imgPath.replace(/[^a-zA-Z0-9]/g, '_');\\n    var cached = getItem(cacheKey);\\n    var cacheTime = parseInt(getItem(cacheKey + '_time', '0'));\\n    var now = Date.now();\\n    if (cached && (now - cacheTime < 10 * 60 * 1000)) {\\n        try { arr = JSON.parse(cached); } catch (e) { arr = []; }\\n    } else {\\n        if (imgPath.startsWith('/')) {\\n            var File = java.io.File;\\n            var file = new File(imgPath);\\n            try {\\n                var fileList = file.listFiles();\\n                if (fileList != null && fileList.length != 0) {\\n                    var pics = fileList.filter(function(h) { return h.isFile() && /\\\\.(jpg|jpeg|png|gif|webp)/i.test(h.getName()); });\\n                }\\n                if (!fileList || fileList.length == 0 || !pics || pics.length == 0) {\\n                    toast('此目录下无图片,切换到网络图片');\\n                    var html = fetchPC('https://bizihu.com/AIMN.html');\\n                    var list = pdfa(html, 'body&&.box');\\n                    for (var i = 1; i < list.length; i++) {\\n                        arr.push(pdfh(list[i], 'img&&data-original'));\\n                    }\\n                } else {\\n                    for (var i in pics) {\\n                        arr.push(pics[i].getAbsolutePath());\\n                    }\\n                }\\n            } catch (e) {\\n                toast('目录不存在,切换到网络图片');\\n                var html = fetchPC('https://bizihu.com/AIMN.html');\\n                var list = pdfa(html, 'body&&.box');\\n                for (var i = 1; i < list.length; i++) {\\n                    arr.push(pdfh(list[i], 'img&&data-original'));\\n                }\\n            }\\n        } else if (/hefollo/.test(imgPath)) {\\n            var pics = fetchPC(imgPath).split('\\\\n');\\n            for (var i in pics) {\\n                arr.push(pics[i]);\\n            }\\n        } else if (/random|mwm|\\\\.php|api/.test(imgPath)) {\\n            for (var i = 0; i < 10; i++) {\\n                arr.push(getItem('img', 'https://www.dmoe.cc/random.php') + '#' + Math.random());\\n            }\\n        } else if (/netbian/.test(imgPath)) {\\n            var html = request('http://www.netbian.com/index_2.htm', {});\\n            var list = pdfa(html, '.list&&li');\\n            for (var i = 1; i < list.length; i++) {\\n                arr.push(pdfh(list[i], 'img&&src'));\\n            }\\n        } else if (/bizihu/.test(imgPath)) {\\n            var html = fetchPC('https://bizihu.com/AIMN.html');\\n            var list = pdfa(html, 'body&&.box');\\n            for (var i = 1; i < list.length; i++) {\\n                arr.push(pdfh(list[i], 'img&&data-original'));\\n            }\\n        }\\n        if (arr.length > 0) {\\n            setItem(cacheKey, JSON.stringify(arr));\\n            setItem(cacheKey + '_time', now + '');\\n        }\\n    }\\n    return arr;\\n}\\n\\n// 导出主函数：获取轮播图卡片数组\\nconst 轮播图 = {\\n    getBanner: function() {\\n        var arr = getImageArray();\\n        try {\\n            return banner(arr, 5000, 'zhuye');\\n        } catch (e) {\\n            log('轮播生成失败：' + e.message);\\n            return [];\\n        }\\n    }\\n};\\n\\n\\n$.exports = 轮播图;\"},{\"col_type\":\"movie_3\",\"name\":\"主页助手\",\"path\":\"主页助手\",\"rule\":\"var 主页助手 = {\\n\\n    getThemeColor: function() {\\n        var Color = getItem('主题颜色', '#F5F5F5');\\n        var randomTheme = getItem('random_theme', '0');\\n        if (randomTheme == '1') {\\n            var letters = '0123456789ABCDEF';\\n            var randomColor = '#';\\n            for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\\n            setItem('主题颜色', randomColor);\\n            Color = randomColor;\\n        }\\n        return Color;\\n    },\\n\\n    getHomeFontColor: function() {\\n        var color = getItem('home_font_color', '#333333');\\n        if (getItem('home_font_random_mode', '0') == '1') {\\n            var letters = '0123456789ABCDEF';\\n            var randomColor = '';\\n            while (true) {\\n                randomColor = '#';\\n                for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\\n                if (randomColor.toLowerCase() !== '#000000' && randomColor.toLowerCase() !== '#ffffff') break;\\n            }\\n            setItem('home_font_color', randomColor);\\n            color = randomColor;\\n        }\\n        return color;\\n    },\\n\\n    registerRepairTask: function() {\\n        registerTask('repair_delay', 300, $.toString(function() {\\n            try {\\n                var repairData = request('hiker://page/repair');\\n                if (repairData && repairData.trim() !== '' && repairData !== 'null' && repairData !== 'undefined') {\\n                    var repairJson = JSON.parse(repairData);\\n                    if (repairJson && repairJson.rule) eval(repairJson.rule);\\n                }\\n            } catch (e) { log('repair模块错误：' + e.message); }\\n            unRegisterTask('repair_delay');\\n        }));\\n    },\\n\\n    buildTitleCard: function(themeColor, fontColor) {\\n        var descList = [\\n            \\\"汇聚万千影视，有这一个就够了\\\",\\n            \\\"每天一部好电影，品味百态人生\\\",\\n            \\\"海量资源，畅享无限观影体验\\\",\\n            \\\"好剧不断，精彩不停歇\\\",\\n            \\\"你的私人影视库，随时想看就看\\\",\\n            \\\"追剧不等待，好片即刻看\\\",\\n            \\\"万千好片，一网打尽\\\",\\n            \\\"极致观影体验，从这里开始\\\",\\n            \\\"精彩内容，每日更新\\\",\\n            \\\"影视爱好者的聚集地\\\"\\n        ];\\n        var randomDesc = descList[Math.floor(Math.random() * descList.length)];\\n\\n        return {\\n            title: '<font color=\\\"' + fontColor + '\\\">' + (getItem(\\\"home_title\\\", \\\"\\\") || \\\"撸客影视\\\") + '</font>',\\n            desc: '<font color=\\\"' + fontColor + '\\\">' + (getItem(\\\"home_desc\\\", \\\"\\\") || randomDesc) + '</font>',\\n            pic_url: 'https://zhengxin-pub.cdn.bcebos.com/logopic/0676f279652ad8999d0be18d74e8d209_fullsize.jpg',\\n            url: $('#noLoading#').lazyRule(function() {\\n                var _statU = getI