)\\n            });\\n        } else {\\n            confirm({\\n                title: \\\"重新安装\\\",\\n                content: \\\"当前已是最新版本 \\\" + localVer + \\\"\\\\n\\\\n是否需要重新安装？（修复异常问题）\\\",\\n                confirm: $.toString(function(cmd) {\\n                    if (!cmd) { toast(\\\"❌ 未设置云口令\\\"); return \\\"hiker://empty\\\"; }\\n                    var ok = false;\\n                    try { if (typeof setClipboard === \\\"function\\\") { setClipboard(cmd); ok = true; } } catch(e) {}\\n                    if (!ok) { try { if (typeof copy === \\\"function\\\") { copy(cmd); ok = true; } } catch(e) {} }\\n                    if (ok) toast(\\\"✅ 口令已复制\\\"); else toast(\\\"口令：\\\" + cmd);\\n                    return \\\"hiker://empty\\\";\\n                }, cloudCmd),\\n                cancel: $.toString(function() {})\\n            });\\n        }\\n        return \\\"hiker://empty\\\";\\n    }, _isNew, _cloudVer, _cloudLog, _cloudCmd, _localVer),\\n    pic_url: \\\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/279.png\\\",\\n    col_type: \\\"avatar\\\",\\n    extra: { backgroundColor: bgTint, lineVisible: true }\\n});\\n\\nd.push({ col_type: 'blank_block' });\\nd.push({col_type: 'line'});\\n\\nd.push(更新日志模块.buildItem(FontColor, bgTint));\\n\\nd.push({ col_type: 'blank_block' });\\nd.push({col_type: 'line'});\\n\\nd.push({\\n    title: '<b><font color=\\\"' + FontColor + '\\\">帮助反馈</font></b>',\\n    desc: '<font color=\\\"' + FontColor + '\\\">查看常见问题或提交反馈</font>',\\n    pic_url: \\\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/122.png\\\",\\n    col_type: \\\"avatar\\\",\\n    url: 'hiker://page/帮助反馈#noHistory#',\\n    extra: { backgroundColor: bgTint, lineVisible: true }\\n});\\n\\nd.push({ col_type: 'blank_block' });\\nd.push({col_type: 'line'});\\n\\nd.push({\\n    title: '<b><font color=\\\"' + FontColor + '\\\">关于撸客影视</font></b>',\\n    desc: '<font color=\\\"' + FontColor + '\\\">点击查看详情</font>',\\n    pic_url: \\\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/173.png\\\",\\n    url: $('#noLoading#').lazyRule(function() {\\n        var mode = getItem('use_beta_mode', '0');\\n        var version;\\n        try {\\n            if (mode === '1') version = $.require('更新日志Beta版').CURRENT_BETA_VERSION || '2026083003';\\n            else version = $.require('更新日志正式版').CURRENT_VERSION || '20260830';\\n        } catch(e) { version = (mode === '1') ? '2026083003' : '20260830'; }\\n        var channel = (mode === '1') ? 'Beta版（尝鲜通道）' : '正式版（稳定通道）';\\n        var bannerStatus = getItem('show_banner', '1') === '1' ? '✅ 已开启' : '⛔ 已关闭';\\n        var hiddenTabs = getItem('hidden_tabs', '');\\n        var hiddenList = hiddenTabs ? hiddenTabs.split(',') : [];\\n        var tabNames = { '1': '一起草', '2': '爱情岛', '3': '麻豆', '4': '影片&小说', '5': '直播' };\\n        var hiddenStatus = '无';\\n        if (hiddenList.length > 0) {\\n            var names = [];\\n            for (var i = 0; i < hiddenList.length; i++) {\\n                if (tabNames[hiddenList[i]]) names.push(tabNames[hiddenList[i]]);\\n            }\\n            hiddenStatus = names.join('、');\\n        }\\n        var cardStyle = getItem('card_style', 'scroll_button');\\n        var styleMap = { 'scroll_button': '滚动按钮', 'icon_4': '四图标', 'icon_5': '五图标', 'icon_2': '双图标' };\\n        var styleDisplay = styleMap[cardStyle] || cardStyle;\\n        var presetTheme = getItem('current_preset_theme', '');\\n        var themeColor = getItem('主题颜色', '#F5F5F5');\\n        var homeFontColor = getItem('home_font_color', '#333333');\\n        var manageFontColor = getItem('manage_font_color', '#333333');\\n        var colorMap2 = {\\n            '#F5F5F5': '默认', '#333333': '默认', '#3399cc': '蓝色',\\n            '#FF6B6B': '红色', '#51CF66': '绿色', '#9B59B6': '紫色',\\n            '#FFA94D': '橙色', '#FF85A1': '粉色', '#00D2D3': '青色',\\n            '#636E72': '灰色', '#FECA57': '黄色', '#1A1A1A': '黑色',\\n            '#FFFFFF': '白色', '#222222': '深灰', '#444444': '中灰', '#E0E0E0': '浅灰'\\n        };\\n        var isPreset = presetTheme && presetTheme.length > 0;\\n        var themeDisplay, homeFontDisplay, manageFontDisplay;\\n        if (isPreset) {\\n            themeDisplay = '预设主题包（' + presetTheme + '）';\\n            homeFontDisplay = '预设主题包（' + presetTheme + '）';\\n            manageFontDisplay = '预设主题包（' + presetTheme + '）';\\n        } else {\\n            themeDisplay = (colorMap2[themeColor] || themeColor) + '（' + themeColor + '）';\\n            homeFontDisplay = (colorMap2[homeFontColor] || homeFontColor) + '（' + homeFontColor + '）';\\n            manageFontDisplay = (colorMap2[manageFontColor] || manageFontColor) + '（' + manageFontColor + '）';\\n        }\\n        var 弹窗工具 = $.require('弹窗工具');\\n        var aboutData = [\\n            { title: \\\"📱 应用信息\\\", records: [\\n                \\\"应用名称：撸客影视\\\",\\n                \\\"当前版本：\\\" + version,\\n                \\\"更新通道：\\\" + channel,\\n                \\\"显示模式：\\\" + (function(){\\n                    var _c = getItem('content_mode', '');\\n                    if (_c === 'adult') return '成人模式';\\n                    if (_c === 'short_drama') return '短剧模式';\\n                    if (_c === 'live') return '直播模式';\\n                    if (_c === 'normal') return '影视模式';\\n                    return '未选择';\\n                })(),\\n                \\\"卡片样式：\\\" + styleDisplay,\\n                \\\"轮播图状态：\\\" + bannerStatus,\\n                \\\"Tab屏蔽状态：\\\" + (hiddenStatus === '无' ? '✅ 全部显示' : '🔴 已屏蔽：' + hiddenStatus),\\n                \\\"主题颜色：\\\" + themeDisplay,\\n                \\\"主页字体色：\\\" + homeFontDisplay,\\n                \\\"管理页字体色：\\\" + manageFontDisplay\\n            ]},\\n            { title: \\\"👨‍💻 关于作者\\\", records: [\\n                \\\"本应用由个人开发者独立维护，仅供学习交流使用。\\\",\\n                \\\"所有功能设计与开发均为技术研究目的，不涉及任何商业盈利行为。\\\",\\n                \\\"开发者热爱影视文化，致力于为用户提