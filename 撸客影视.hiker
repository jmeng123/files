'', enabled: item.enabled !== false});\\n            } else if (item.type === 'bocai' || item._type === 'bocai') {\\n                sharelist.push({_qd_type: 'bocai', key: item.key, name: item.name, api: item.api, detail: item.detail || '', enabled: item.enabled !== false});\\n            } else if (item.type === 'rule' || item._type === 'rule') {\\n                var ruleCode = '';\\n                try { ruleCode = readFile(item.url) || item.code || ''; } catch(e) { ruleCode = item.code || ''; }\\n                sharelist.push({_qd_type: 'rule', name: item.name, '类型': item['类型'] || '', code: ruleCode, enabled: item.enabled !== false});\\n            }\\n        }\\n    } else if (type === 'parse') {\\n        sharelist.push({_qd_type: 'parse', name: data.name, type: data.type, url: data.url, Names: data.Names || '', enabled: data.enabled !== false});\\n    } else if (type === 'bocai') {\\n        sharelist.push({_qd_type: 'bocai', key: data.key, name: data.name, api: data.api, detail: data.detail || '', enabled: data.enabled !== false});\\n    } else if (type === 'rule') {\\n        var ruleCode = '';\\n        try { ruleCode = readFile(data.url) || ''; } catch(e) {}\\n        sharelist.push({_qd_type: 'rule', name: data.name, '类型': data['类型'] || '', code: ruleCode, enabled: data.enabled !== false});\\n    }\\n    if (sharelist.length === 0) return \\\"toast://无有效数据可分享\\\";\\n    var gzip = $.require(\\\"gzip.js\\\");\\n    var sharetxt = gzip.zip(JSON.stringify(sharelist));\\n    var sm = sharelist.length > 1 ? '青豆接口' : (type === 'parse' ? '青豆解析' : (type === 'bocai' ? '青豆采集' : '青豆规则'));\\n    var sm2 = sharelist.length > 1 ? ('共' + sharelist.length + '条') : sharelist[0].name;\\n    var importJs = '@import=js:writeFile(\\\"hiker://files/_cache/qd_cloudimport.txt\\\",input);\\\"hiker://page/parse#noRecordHistory##noHistory#?rule=青豆剧场\\\";';\\n    putMyVar('qd_share_txt', sharetxt);\\n    putMyVar('qd_share_sm', sm);\\n    putMyVar('qd_share_sm2', sm2);\\n    putMyVar('qd_share_importJs', importJs);\\n    var pastes = typeof getPastes === 'function' ? getPastes() : [];\\n    pastes = pastes.filter(function(v) { return !/云剪贴板[59]|云剪贴板10/.test(v); });\\n    pastes.push('云口令文件');\\n    if (pastes.length > 1) {\\n        return $(pastes, 2, '选择分享方式').select(function() {\\n            var sharetxt = getMyVar('qd_share_txt');\\n            var sm = getMyVar('qd_share_sm');\\n            var sm2 = getMyVar('qd_share_sm2');\\n            var importJs = getMyVar('qd_share_importJs');\\n            if (input === '云口令文件') {\\n                var code = sm + '￥' + aesEncode('Qingdou', sharetxt) + '￥云口令文件';\\n                var sharefile = 'hiker://files/_cache/【青豆源】_' + sm2 + '_' + Date.now() + '.hiker';\\n                saveFile(sharefile, '云口令：' + code + importJs);\\n                if (fileExist(sharefile)) return 'share://' + sharefile;\\n                return \\\"toast://分享生成失败\\\";\\n            } else {\\n                showLoading('分享生成中...');\\n                var pasteurl = sharePaste(sharetxt, input);\\n                hideLoading();\\n                if (/^http|^云/.test(pasteurl) && pasteurl.includes('/')) {\\n                    var code = sm + '￥' + aesEncode('Qingdou', pasteurl) + '￥' + sm2 + '(' + input.replace('剪贴板', '') + ')';\\n                    copy('云口令：' + code + importJs);\\n                    return \\\"toast://分享口令已复制到剪贴板\\\";\\n                } else {\\n                    return \\\"toast://分享失败，剪粘板或网络异常>\\\" + pasteurl;\\n                }\\n            }\\n        });\\n    }\\n    try {\\n        if (pastes.length > 0 && pastes[0] !== '云口令文件') {\\n            showLoading('分享生成中...');\\n            var pasteurl = sharePaste(sharetxt, pastes[0]);\\n            hideLoading();\\n            if (/^http|^云/.test(pasteurl) && pasteurl.includes('/')) {\\n                var code = sm + '￥' + aesEncode('Qingdou', pasteurl) + '￥' + sm2;\\n                copy('云口令：' + code + importJs);\\n                return \\\"toast://分享口令已复制到剪贴板\\\";\\n            }\\n        }\\n    } catch(e) {}\\n    var code = sm + '￥' + aesEncode('Qingdou', sharetxt) + '￥云口令文件';\\n    var sharefile = 'hiker://files/_cache/【青豆源】_' + sm2 + '_' + Date.now() + '.hiker';\\n    saveFile(sharefile, '云口令：' + code + importJs);\\n    if (fileExist(sharefile)) return 'share://' + sharefile;\\n    return \\\"toast://分享生成失败\\\";\\n}\\n\\nfunction qdExtractImport(str) {\\n    showLoading('获取数据中...');\\n    var strs = str.replace(/\\\\\\\\n|云口令：/g, '').split('@import=');\\n    strs = strs.filter(function(v) { return v && /青豆(解析|采集|规则|接口)￥/.test(v); });\\n    var datas = [];\\n    for (var i = 0; i < strs.length; i++) {\\n        try {\\n            var code = aesDecode('Qingdou', strs[i].split('￥')[1]);\\n            var text;\\n            if (/^http|^云/.test(code)) {\\n                text = parsePaste(code);\\n            } else {\\n                text = code;\\n            }\\n            if (text && !/^error/.test(text)) {\\n                var gzip = $.require(\\\"gzip.js\\\");\\n                var sharetxt = gzip.unzip(text);\\n                var imports = JSON.parse(sharetxt);\\n                for (var j = 0; j < imports.length; j++) {\\n                    if (!datas.some(function(v) { return v._qd_type === imports[j]._qd_type && v.name === imports[j].name; })) {\\n                        datas.unshift(imports[j]);\\n                    }\\n                }\\n            }\\n        } catch(e) {\\n            log('青豆：获取口令数据出错>' + e.message);\\n        }\\n    }\\n    hideLoading();\\n    return datas;\\n}\\n\\nfunction qdBuildImportUI(importdatas, importfile) {\\n    putMyVar('qd_import_datas', JSON.stringify(importdatas));\\n    var plan = qdGetImportPlan(importdatas);\\n    var d = [];\\n    d.push({title: '\\\\u2018\\\\u2018\\\\u2019\\\\u2019<b><font color=\\\"#339AF0\\\">📱 云口令导入</font></b>', desc: '共计' + plan.total + '条 / 新增' + plan.add + ' / 覆盖' + plan.overwrite + ' / 增量跳过' + plan.skip, u