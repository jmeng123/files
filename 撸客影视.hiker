    code: catvodCode,\n                    api: jr.api,\n                    ext: jr.ext || '',\n                    configKey: configKey,\n                    enabled: jr.enabled !== false\n                };\n                if (jr.key) {\n                    ruleData.key = jr.key;\n                    ruleData.id = 'catvod_' + jr.key;\n                }\n            } else {\n                ruleData = {\n                    name: jr.name,\n                    '类型': '本地包',\n                    host: jr.jar || '',\n                    api: jr.api,\n                    jar: jr.jar || '',\n                    ext: jr.ext || '',\n                    configKey: configKey,\n                    enabled: jr.enabled !== false\n                };\n                if (jr.key) {\n                    ruleData.key = jr.key;\n                    ruleData.id = 'jar_' + jr.key;\n                }\n            }\n            cr.saveRule(ruleData);\n            imported++;\n        }\n    } catch (eImp) {\n        log('qdImportTvboxSites: jar导入失败: ' + eImp.message);\n    }\n\n    var bocaiImported = 0;\n    if (bocaiRules.length > 0) {\n        try {\n            var cfgBocai = JSON.parse(readFile(CONFIG_FILE) || '{}');\n            if (!cfgBocai.bocai_sites) cfgBocai.bocai_sites = [];\n            var existKeys = {};\n            for (var ek = 0; ek < cfgBocai.bocai_sites.length; ek++) {\n                existKeys[cfgBocai.bocai_sites[ek].key] = true;\n            }\n            var maxEnabled = parseInt(getItem('qd_bocai_max_enabled', '5'));\n            if (isNaN(maxEnabled) || maxEnabled < 1) maxEnabled = 5;\n            var existEnabledCount = 0;\n            for (var ek2 = 0; ek2 < cfgBocai.bocai_sites.length; ek2++) {\n                if (cfgBocai.bocai_sites[ek2].enabled !== false) existEnabledCount++;\n            }\n            for (var bi = 0; bi < bocaiRules.length; bi++) {\n                var br = bocaiRules[bi];\n                if (existKeys[br.key]) continue;\n                var newEnabled = existEnabledCount < maxEnabled;\n                cfgBocai.bocai_sites.push({\n                    key: br.key,\n                    name: br.name,\n                    api: br.api,\n                    detail: br.detail,\n                    enabled: newEnabled\n                });\n                existKeys[br.key] = true;\n                if (newEnabled) existEnabledCount++;\n                bocaiImported++;\n            }\n            saveFile(CONFIG_FILE, JSON.stringify(cfgBocai));\n            _bocaiSitesCache = null;\n            _bocai_api_cache = null;\n        } catch (eBocai) {\n            log('qdImportTvboxSites: 采集源导入失败: ' + eBocai.message);\n        }\n    }\n\n    if (clearOld) {\n        try {\n            var cr2 = $.require(\"customRule\");\n            var jarStatesPath2 = \"hiker://files/rules/青豆剧场/qd_jar_rule_states.json\";\n            var savedStates2 = {};\n            try { savedStates2 = JSON.parse(readFile(jarStatesPath2) || '{}'); } catch (e) {}\n            if (savedStates2 && Object.keys(savedStates2).length > 0) {\n                var newRules2 = cr2.getRuleList();\n                for (var nri = 0; nri < newRules2.length; nri++) {\n                    var nr = newRules2[nri];\n                    var nrKey = nr.key || '';\n                    if (((nr['类型'] || '') === '本地包' || (nr.id || '').indexOf('catvod_') === 0) && nrKey && savedStates2[nrKey]) {\n                        var sst = savedStates2[nrKey];\n                        var nrChanged = false;\n                        if (sst.enabled === false && nr.enabled !== false) { nr.enabled = false; nrChanged = true; }\n                        if (sst.searchEnabled === true && nr.searchEnabled !== true) { nr.searchEnabled = true; nrChanged = true; }\n                        if (nrChanged) { cr2.saveRule(nr); }\n                    }\n                }\n            }\n        } catch (eRestore) {}\n    }\n\n    return {\n        jarCount: imported,\n        