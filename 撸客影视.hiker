 {}\ntry {\n    if (fileExist(\"hiker://files/Jm/ver_beta.txt\") && !getItem(\"ver_beta\", \"\")) {\n        var _fs2 = readFile(\"hiker://files/Jm/ver_beta.txt\");\n        if (_fs2 && _fs2.trim()) setItem(\"ver_beta\", _fs2.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/log_stable.txt\") && !getItem(\"log_stable\", \"\")) {\n        var _fs3 = readFile(\"hiker://files/Jm/log_stable.txt\");\n        if (_fs3 && _fs3.trim()) setItem(\"log_stable\", _fs3.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/log_beta.txt\") && !getItem(\"log_beta\", \"\")) {\n        var _fs4 = readFile(\"hiker://files/Jm/log_beta.txt\");\n        if (_fs4 && _fs4.trim()) setItem(\"log_beta\", _fs4.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/cmd_stable.txt\") && !getItem(\"cmd_stable\", \"\")) {\n        var _fs5 = readFile(\"hiker://files/Jm/cmd_stable.txt\");\n        if (_fs5 && _fs5.trim()) setItem(\"cmd_stable\", _fs5.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/cmd_beta.txt\") && !getItem(\"cmd_beta\", \"\")) {\n        var _fs6 = readFile(\"hiker://files/Jm/cmd_beta.txt\");\n        if (_fs6 && _fs6.trim()) setItem(\"cmd_beta\", _fs6.trim());\n    }\n} catch(e) {}\n\nvar DEFAULT_THEME = '#F5F5F5';\nvar randomTheme = getItem('random_theme', '0');\nif (randomTheme == '1') {\n    var letters = '0123456789ABCDEF';\n    var randomColor = '';\n    while (true) {\n        randomColor = '#';\n        for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\n        if (randomColor.toLowerCase() !== '#000000' && randomColor.toLowerCase() !== '#ffffff') break;\n    }\n    setItem('主题颜色', randomColor);\n}\n\nvar Color = getItem('主题颜色', DEFAULT_THEME);\nvar bgTint = '#15' + Color.replace('#', '');\n\nvar FontColor = getItem('manage_font_color', '#333333');\nvar manageRandomMode = getItem('manage_font_random_mode', '0');\nif (manageRandomMode == '1') {\n    var letters = '0123456789ABCDEF';\n    var randomColor = '';\n    while (true) {\n        randomColor = '#';\n        for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\n        if (randomColor.toLowerCase() !== '#000000' && randomColor.toLowerCase() !== '#ffffff') break;\n    }\n    setItem('manage_font_color', randomColor);\n    FontColor = randomColor;\n}\n\nvar HomeFontColor = getItem('home_font_color', '#333333');\nvar homeRandomMode = getItem('home_font_random_mode', '0');\nif (homeRandomMode == '1') {\n    var letters = '0123456789ABCDEF';\n    var randomColor = '';\n    while (true) {\n        randomColor = '#';\n        for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\n        if (randomColor.toLowerCase() !== '#000000' && randomColor.toLowerCase() !== '#ffffff') break;\n    }\n    setItem('home_font_color', randomColor);\n    HomeFontColor = randomColor;\n}\n\nvar colorMap = {\n    '#F5F5F5': '默认', '#333333': '默认', '#3399cc': '蓝色',\n    '#FF6B6B': '红色', '#51CF66': '绿色', '#9B59B6': '紫色',\n    '#FFA94D': '橙色', '#FF85A1': '粉色', '#00D2D3': '青色',\n    '#636E72': '灰色', '#FECA57': '黄色', '#1A1A1A': '黑色',\n    '#FFFFFF': '白色', '#222222': '深灰', '#444444': '中灰', '#E0E0E0': '浅灰',\n    '#0F2A1F': '暗夜绿(背景)', '#B8E6B8': '暗夜绿(主页字)', '#D4F0D4': '暗夜绿(管理字)',\n    '#1A1025': '星空紫(背景)', '#D9B3FF': '星空紫(主页字)', '#E8CCFF': '星空紫(管理字)',\n    '#F5F0E6': '轻奢金(背景)', '#8B7A5A': '轻奢金(主页字)', '#A6957A': '轻奢金(管理字)',\n    '#0B1E33': '深海蓝(背景)', '#99CCFF': '深海蓝(主页字)', '#B3D9FF': '深海蓝(管理字)',\n    '#FFF0F5': '樱花粉(背景)', '#E06080': '樱花粉(主页字)', '#F080A0': '樱花粉(管理字)',\n    '#1A1A2E': '深空黑(背景)', '#3A0A0A': '烈焰红(背景)', '#FFCCCC': '烈焰红(主页字)', '#FFAAAA': '烈焰红(管理字)',\n    '#0A1A0A': '翡翠绿(背景)', '#AAFFAA': '翡翠绿(主页字)', '#88DD88': '翡翠绿(管理字)',\n    '#3A1A00': '秋日橙(背景)', '#FFDDBB': '秋日橙(主页字)', '#FFCC99': '秋日橙(管理字)',\n    '#0A0A2A': '极光蓝(背景)', '#AAEFFF': '极光蓝(主页字)', '#88DDFF': '极光蓝(管理字)',\n    '#1A0A1A': '葡萄紫(背景)', '#FFCCFF': '葡萄紫(主页字)', '#DDAAFF': '葡萄紫(管理字)',\n    '#1A0A0A': '玫瑰红(背景)', '#FF99AA': '玫瑰红(主页字)', '#FF7799': '玫瑰红(管理字)',\n    '#F0FFF4': '薄荷清(背景)', '#2E7D5E': '薄荷清(主页字)', '#3D9A7A': '薄荷清(管理字)',\n    '#FFF8E7': '暖阳黄(背景)', '#8B6914': '暖阳黄(主页字)', '#A8842A': '暖阳黄(管理字)',\n    '#F5F0FF': '淡紫雾(背景)', '#7B5EA7': '淡紫雾(主页字)', '#9B7EC7': '淡紫雾(管理字)',\n    '#FFF5EE': '蜜桃橙(背景)', '#CC6B3E': '蜜桃橙(主页字)', '#DD8A5E': '蜜桃橙(管理字)',\n    '#F0F8FF': '天空蓝(背景)', '#2A6B8A': '天空蓝(主页字)', '#4A8BAA': '天空蓝(管理字)',\n    '#FFF5F7': '粉玫瑰(背景)', '#C94A6A': '粉玫瑰(主页字)', '#D96A8A': '粉玫瑰(管理字)',\n    '#FFFFF0': '柠檬黄(背景)', '#8A7A2A': '柠檬黄(主页字)', '#AA9A4A': '柠檬黄(管理字)',\n    '#1A0E00': '南瓜橙(背景)', '#FFCC88': '南瓜橙(主页字)', '#FFAA66': '南瓜橙(管理字)',\n    '#0A1A20': '冰晶蓝(背景)', '#88DDFF': '冰晶蓝(主页字)', '#66BBDD': '冰晶蓝(管理字)'\n};\n\nvar presetTheme = getItem('current_preset_theme', '');\nif (presetTheme) {\n    var themeDisplayName = '预设主题：' + presetTheme;\n} else {\n    var themeDisplayName = (randomTheme == '1') ? '随机' : (colorMap[Color] || Color);\n}\n\nvar currentFontName = colorMap[FontColor] || '自定义颜色';\nvar currentHomeFontName = colorMap[HomeFontColor] || '自定义颜色';\n\nif (presetTheme) {\n    var fontDesc = '预设主题：' + presetTheme;\n} else {\n    var homeDesc = (homeRandomMode == '1') ? '随机' : currentHomeFontName.replace(/\\(.*\\)/, '').trim();\n    var manageDesc = (manageRandomMode == '1') ? '随机' : currentFontName.replace(/\\(.*\\)/, '').trim();\n    var fontDesc = '主页：' + homeDesc + ' | 管理页：' + manageDesc;\n}\n\nsetPageTitle(\"撸客影视设置\");\n\nd.push({ col_type: 'blank_block' });\nd.push({col_type: 'line'});\n\nvar _pullTabCfg = JSON.parse(getItem(\"pull_status_tabconfig\", \"{}\"));\nvar _pullTabContent = JSON.parse(getItem(\"pull_status_jianguo\", \"{}\"));\nvar _pullGC = JSON.parse(getItem(\"pull_status_gitcode\", \"{}\"));\n\nvar _dotGreen = \"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48Y2lyY2xlIGN4PSI1MCIgY3k9IjUwIiByPSI0MCIgZmlsbD0iIzRDQUY1MCIvPjwvc3ZnPg==\";\nvar _dotRed = \"