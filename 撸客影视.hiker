, {\n        name: 'bdys',\n        hosts: ['bytetos.com', 'byteimg.com', 'bytednsdoc.com', 'pstatp.com'],\n        exclude: ['.m3u8'],\n        regex: ['/tos-cn']\n    }, {\n        name: 'bdys10',\n        hosts: ['bdys10.com'],\n        exclude: ['.m3u8'],\n        regex: ['/obj/']\n    }, {\n        name: 'global_ads',\n        hosts: adHosts,\n        regex: ['(?:^|[\\\\/_.-])(ad|ads|adv|advert|advertisement|promo|preroll|midroll|postroll|commercial)(?:[\\\\/_.-]|$)', '(?:^|[\\\\/_.-])(gg|guanggao)(?:[\\\\/_.-]|$)', 'doubleclick\\\\.net', 'googlesyndication\\\\.com', 'googleadservices\\\\.com', 'cnzz\\\\.com', 'mmstat\\\\.com', 'hm\\\\.baidu\\\\.com', 'baidu\\\\.com\\\\/hm\\\\.js', 'bootcss\\\\.com']\n    }, {\n        name: '全局合并去广告',\n        hosts: ['155', '525627', 'yhzybf', 'askzycdn', 'atukjhesk', 'aws.ulivetv.net', 'ckzy', 'didiv', 'bbf', 'erlgnf', 'bfaskcdn', 'bfengbf.com', 'bfikuncdn', 'bfzy', 'bobolj', 'bofang', 'cdn-vipvideo', 'cdn2025', '2605', 'ddbbffcdn', 'ddoucdn', 'ddyunbo', 'didinew', 'didivod11', 'erlgnf', 'ffzy', 'fhu3hh', 'fqm3u8', 'haiwaikan', 'hd.ffzy', 'hd.lz', 'hwzcfz', 'jkhabkrqjbj', 'jkun', 'jpxm3u8', 'kjbwhcnao', 'krevonix.com', 'kuaikan', 'lajiao', 'lbv', 'lj20250710new', 'ljbfbf', 'lsbbf8', 'mysqldata3202s4l', 'rrcdnbf', 'sekihfde', 'sl3split.com', 'slbfsl', 'suonizy', 'sybf', 'thm3u8', 'v.cdnlz', 'vip.lz', 'voddadaizi', 'vostrely', 'wgslsw', 'xibao'],\n        regex: ['', '#EXTINF.*?\\\\s+.*?pre_.*?\\\\.', '#EXTINF.*?\\\\s+.*?X7WdqELx.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*headers.*?\\\\header\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?69d684adffdda26c0218ed54/d21dgf.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?07dlJWU1.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?xjand.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?KWZehyir.*?\\\\.(jpg|ts|png)', '#EXTINF.*?\\\\s+.*?/video/m3u8/and.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?/and/ad\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?n5f8B8Mn.*?\\\\.(jpg|ts|png)', '#EXTINF.*?\\\\s+.*?cRuclysU.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?jhCV5hdb.*?\\\\s+', '#EXTINF.*?\\\\s+.*?yhzybf.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?PymmgUpX.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?VmnacVi8.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?2dLBhtbi.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?Bkg9vnI9.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?oLIZXGpG.*?\\\\.(ts|jpg|png)', '#EXTINF.*?\\\\s+.*?1o.*?\\\\.(ts|jpg|png)\\\\s+']\n    }];\n    return { adHosts: adHosts, m3u8AdRules: m3u8AdRules };\n}\n\nfunction qdShare(type, data) {\n    var sharelist = [];\n    if (Array.isArray(data)) {\n        for (var i = 0; i < data.length; i++) {\n            var item = data[i];\n            if (item._qd_type) {\n                sharelist.push(item);\n            } else if (item.type === 'parse' || item._type === 'parse') {\n                sharelist.push({_qd_type: 'parse', name: item.name, type: item.type === 'parse' ? (item.parseType || '') : item.type, url: item.url, Names: item.Names || '', enabled: item.enabled !== false});\n            } else if (item.type === 'bocai' || item._type === 'bocai') {\n                sharelist.push({_qd_type: 'bocai', key: item.key, name: item.name, api: item.api, detail: item.detail || '', enabled: item.enabled !== false});\n            } else if (item.type === 'rule' || item._type === 'rule') {\n                var ruleCode = '';\n                try { ruleCode = readFile(item.url) || item.code || ''; } catch(e) { ruleCode = item.code || ''; }\n                sharelist.push({_qd_type: 'rule', name: item.name, '类型': item['类型'] || '', code: ruleCode, enabled: item.enabled !== false});\n            }\n        }\n    } else if (type === 'parse') {\n        sharelist.push({_qd_type: 'parse', name: data.name, type: data.type, url: data.url, Names: data.Names || '', enabled: data.enabled !== false});\n    } else if (type === 'bocai') {\n        sharelist.push({_qd_type: 'bocai', key: data.key, name: data.name, api: data.api, detail: data.detail || '', enabled: data.enabled !== false});\n    } else if (type === 'rule') {\n        var ruleCode = '';\n        try { ruleCode = readFile(data.url) || ''; } catch(e) {}\n        sharelist.push({_qd_type: 'rule', name: data.name, '类型': data['类型'] || '', code: ruleCode, enabled: data.enabled !== false});\n    }\n    if (sharelist.length === 0) return \"toast://无有效数据可分享\";\n    var gzip = $.require(\"gzip.js\");\n    var sharetxt = gzip.zip(JSON.stringify(sharelist));\n    var sm = sharelist.length > 1 ? '青豆接口' : (type === 'parse' ? '青豆解析' : (type === 'bocai' ? '青豆采集' : '青豆规则'));\n    var sm2 = sharelist.length > 1 ? ('共' + sharelist.length + '条') : sharelist[0].name;\n    var importJs = '@import=js:writeFile(\"hiker://files/_cache/qd_cloudimport.txt\",input);\"hiker://page/parse#noRecordHistory##noHistory#?rule=青豆剧场\";';\n    putMyVar('qd_share_txt', sharetxt);\n    putMyVar('qd_share_sm', sm);\n    putMyVar('qd_share_sm2', sm2);\n    putMyVar('qd_share_importJs', importJs);\n    var pastes = typeof getPastes === 'function' ? getPastes() : [];\n    pastes = pastes.filter(function(v) { return !/云剪贴板[59]|云剪贴板10/.test(v); });\n    pastes.push('云口令文件');\n    if (pastes.length > 1) {\n        return $(pastes, 2, '选择分享方式').select(function() {\n            var sharetxt = getMyVar('qd_share_txt');\n            var sm = getMyVar('qd_share_sm');\n            var sm2 = getMyVar('qd_share_sm2');\n            var importJs = getMyVar('qd_share_importJs');\n            if (input === '云口令文件') {\n                var code = sm + '￥' + aesEncode('Qingdou', sharetxt) + '￥云口令文件';\n                var sharefile = 'hiker://files/_cache/【青豆源】_' + sm2 + '_' + Date.now() + '.hiker';\n                saveFile(sharefile, '云口令：' + code + importJs);\n                if (fileExist(sharefile)) return 'share://' + sharefile;\n                return \"toast://分享生成失败\";\n            } else {\n                showLoading('分享生成中...');\n                var pasteurl = sharePaste(sharetxt, input);\n                hideLoading();\n                if (/^http|^云/.test(pasteurl) && pasteurl.includes('/')) {\n                    var code = sm + '￥' + aesEncode('Qingdou', pasteurl) + '￥' + sm2 + '(' + input.replace('剪贴板', '') + ')';\n                    copy('云口令：' + code + importJs);\n                    return \"toast://分享口令已复制到剪贴板\";\n                } else {\n                    return \"toast://分享失败，剪粘板或网络异常>\" + pasteurl;\n                }\n            }\n        });\n    }\n    try {\n        if (pastes.length > 0 && pastes[0] !== '云口令文件') {\n            showLoading('分享生成中...');\n            var pasteurl = sharePaste(sharetxt, pastes[0]);\n            hideLoading();\n            if (/^http|^云/.test(pasteurl) && pasteurl.includes('/')) {\n                var code = sm + '￥' + aesEncode('Qingdou', pasteurl) + '￥' + sm2;\n                copy('云口令：' + code + importJs);\n                return \"toast://分享口令已复制到剪贴板\";\n            }\n        }\n    } catch(e) {}\n    var code = sm + '￥' + aesEncode('Qingdou', sharetxt) + '￥云口令文件';\n    var sharefile = 'hiker://files/_cache/【青豆源】_' + sm2 + '_' + Date.now() + '.hiker';\n    saveFile(sharefile, '云口令：' + code + importJs);\n    if (fileExist(sharefile)) return 'share://' + sharefile;\n    return \"toast://分享生成失败\";\n}\n\nfunction qdExtractImport(str) {\n    showLoading('获取数据中...');\n    var strs = str.replace(/\\\\n|云口令：/g, '').split('@import=');\n    strs = strs.filter(function(v) { return v && /青豆(解析|采集|规则|接口)￥/.test(v); });\n    var datas = [];\n    for (var i = 0; i < strs.length; i++) {\n        try {\n            var code = aesDecode('Qingdou', strs[i].split('￥')[1]);\n            var text;\n            if (/^http|^云/.test(code)) {\n                text = parsePaste(code);\n            } else {\n                text = code;\n            }\n            if (text && !/^error/.test(text)) {\n                var gzip = $.require(\"gzip.js\");\n                var sharetxt = gzip.unzip(text);\n                var imports = JSON.parse(sharetxt);\n                for (var j = 0; j < imports.length; j++) {\n                    if (!datas.some(function(v) { return v._qd_type === imports[j]._qd_type && v.name === imports[j].name; })) {\n                        datas.unshift(imports[j]);\n                    }\n                }\n            }\n        } catch(e) {\n            log('青豆：获取口令数据出错>' + e.message);\n        }\n    }\n    hideLoading();\n    return datas;\n}\n\nfunction qdBuildImportUI(importdatas, importfile) {\n    putMyVar('qd_import_datas', JSON.stringify(importdatas));\n    var plan = qdGetImportPlan(importdatas);\n    var d = [];\n    d.push({title: '\\u2018\\u2018\\u2019\\u2019<b><font color=\"#339AF0\">📱 云口令导入</font></b>', desc: '共计' + plan.total + '条 / 新增' + plan.add + ' / 覆盖' + plan.overwrite + ' / 增量跳过' + plan.skip, url: $('', '支持多口令').input(function(ef) { if (!input) { toast('未获取到云口令'); } else { var id = $.require(\"function\").qdExtractImport(input); if (id.length === 0) { toast('未获取到源数据'); } else { putMyVar('qd_import_datas', JSON.stringify(id)); refreshPage(); } } return 'hiker://empty'; }, importfile), col_type: 'text_center_1'});\n    d.push({title: \"增量导入\", pic_url: 'hiker://images/icon_bottom', url: importdatas.length === 0 ? \"hiker://empty\" : $(\"将新增\" + plan.add + \"条，跳过已存在\" + plan.skip + \"条，确认？\").confirm(function() { var datas = JSON.parse(getMyVar('qd_import_datas', '[]')); $.require(\"function\").qdDoImport(datas, 0); back(true); return \"toast://增量导入完成\"; }), col_type: \"icon_2\"});\n    d.push({title: \"覆盖导入\", pic_url: 'hiker://images/icon_download6', url: importdatas.length === 0 ? \"hiker://empty\" : $(\"将新增\" + plan.add + \"条，覆盖\" + plan.overwrite + \"条，确认？\").confirm(function() { var datas = JSON.parse(getMyVar('qd_import_datas', '[]')); $.require(\"function\").qdDoImport(datas, 1); back(true); return \"toast://覆盖导入完成\"; }), col_type: \"icon_2\"});\n    d.push({col_type: 'line'});\n    for (var i = 0; i < importdatas.length; i++) {\n        var it = importdatas[i];\n        var planItem = plan.items[i] || {};\n        var typeLabel = it._qd_type === 'parse' ? '解析' : (it._qd_type === 'bocai' ? '菠菜' : '规则');\n        var typeIcon = it._qd_type === 'parse' ? 'hiker://images/icon_ai_big' : (it._qd_type === 'bocai' ? 'hiker://images/video' : 'hiker://images/icon_edit6');\n        var bgColor = planItem.action === 'overwrite' ? '#20FFA94D' : (it._qd_type === 'parse' ? '#1051CF66' : (it._qd_type === 'bocai' ? '#1051CF66' : '#15' + '3399cc'.replace('#', '')));\n        var actionText = planItem.action === 'overwrite' ? '覆盖已存在' : '新增';\n        d.push({\n            title: it.name,\n            desc: '<font color=\"#868E96\">(' + typeLabel + ') ' + actionText + '</font>',\n            url: $([\"确定导入\", \"删除\"]).select(function(idx, it2) {\n                if (input === \"确定导入\") {\n                    $.require(\"function\").qdDoImport([it2], 1);\n                    deleteItem('qd_import_' + idx);\n                    return \"toast://已导入: \" + it2.name;\n                } else {\n                    deleteItem('qd_import_' + idx);\n                    return \"toast://已删除\";\n                }\n            }, i, it),\n            pic_url: typeIcon,\n            col_type: 'avatar',\n            extra: {id: 'qd_import_' + i, backgroundColor: bgColor, lineVisible: true}\n        });\n    }\n    if (importdatas.length === 0) {\n        d.push({title: '\\u2018\\u2018\\u2019\\u2019<font color=\"#868E96\">暂无导入数据</font>', col_type: \"text_center_1\"});\n    }\n    return d;\n}\n\nfunction qdShowImport(importStr) {\n    var importfile = \"hiker://files/_cache/qd_cloudimport.txt\";\n    if (importStr) saveFile(importfile, importStr);\n    return $(\"hiker://empty#noRecordHistory##noHistory#\").rule(function() {\n        var fn = $.require(\"function\");\n        setPageTitle(\"青豆导入\");\n        var importfile = \"hiker://files/_cache/qd_cloudimport.txt\";\n        addListener(\"onClose\", $.toString(function(f) { deleteFile(f); }, importfile));\n        var input = fetch(importfile);\n        var importdatas = [];\n        if (!input) {\n            toast('未获取到云口令');\n        } else {\n            importdatas = fn.qdExtractImport(input);\n            if (importdatas.length === 0) toast('未获取到源数据，检查网络或口令');\n        }\n        setResult(fn.qdBuildImportUI(importdatas, importfile));\n    });\n}\n\nfunction qdDoImport(importdatas, mode) {\n    var CONFIG_FILE = \"hiker://files/rules/青豆剧场/qd_configs\";\n    for (var i = 0; i < importdatas.length; i++) {\n        var it = importdatas[i];\n        if (it._qd_type === 'parse') {\n            var cfg = JSON.parse(readFile(CONFIG_FILE) || '{}');\n            if (!cfg.parses) cfg.parses = [];\n            var exists = -1;\n            for (var j = 0; j < cfg.parses.length; j++) {\n                if (cfg.parses[j].name === it.name && cfg.parses[j].url === it.url) { exists = j; break; }\n            }\n            if (mode === 1 && exists >= 0) {\n                var newItem = JSON.parse(JSON.stringify(it));\n                delete newItem._qd_type;\n                cfg.parses[exists] = newItem;\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\n            } else if (exists < 0) {\n                var newItem = JSON.parse(JSON.stringify(it));\n                delete newItem._qd_type;\n                cfg.parses.push(newItem);\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\n            }\n        } else if (it._qd_type === 'bocai') {\n            var cfg = JSON.parse(readFile(CONFIG_FILE) || '{}');\n            if (!cfg.bocai_sites) cfg.bocai_sites = [];\n            var exists = -1;\n            for (var j = 0; j < cfg.bocai_sites.length; j++) {\n                if (cfg.bocai_sites[j].key === it.key || cfg.bocai_sites[j].name === it.name) { exists = j; break; }\n            }\n            if (mode === 1 && exists >= 0) {\n                var newItem = JSON.parse(JSON.stringify(it));\n                delete newItem._qd_type;\n                cfg.bocai_sites[exists] = newItem;\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\n            } else if (exists < 0) {\n                var newItem = JSON.parse(JSON.stringify(it));\n                delete newItem._qd_type;\n                cfg.bocai_sites.push(newItem);\n                saveFile(CONFIG_FILE, JSON.stringify(cfg));\n            }\n        } else if (it._qd_type === 'rule') {\n            var cr = $.require(\"customRule\");\n            var rules = cr.getRuleList();\n            var exists = -1;\n            var hm = (it.code || '').match(/[\"']?host[\"']?\\s*[:=]\\s*['\"]([^'\"]+)['\"]/);\n            var importHost = hm ? hm[1] : '';\n            for (var j = 0; j < rules.length; j++) {\n                if (rules[j].name === it.name || (importHost && rules[j].host === importHost)) { exists = j; break; }\n            }\n            var ruleType = it['类型'] || it['\\u7c7b\\u578b'] || '搜索源';\n            var ruleData = {name: it.name, '类型': ruleType, host: it.host || importHost, enabled: it.enabled !== false, code: it.code || ''};\n            if (it.liveImportMode) ruleData.liveImportMode = it.liveImportMode;\n            if (it.subscriptionUrl) ruleData.subscriptionUrl = it.subscriptionUrl;\n            if (mode === 1 && exists >= 0) {\n                ruleData.id = rules[exists].id;\n                cr.saveRule(ruleData);\n            } else if (exists < 0) {\n                cr.saveRule(ruleData);\n            }\n        } else if (it._qd_type === 'jar_rule') {\n            var cr = $.require(\"customRule\");\n            var rules = cr.getRuleList();\n            var exists = -1;\n            for (var j = 0; j < rules.length; j++) {\n                if (rules[j].name === it.name || (rules[j].api && rules[j].api === it.api)) { exists = j; break; }\n            }\n            var ruleData;\n            if (it.isDrpy) {\n                ruleData = {\n                    name: it.name,\n                    '类型': '影视',\n                    host: '',\n                    code: '',\n                    api: it.api,\n                    ext: it.ext || '',\n                    jar: it.jar || '',\n                    configKey: it.configKey || '',\n                    enabled: it.enabled !== false\n                };\n                if (it.key) {\n                    ruleData.key = it.key;\n                    ruleData.id = 'catvod_' + it.key;\n                }\n            } else if (it.isCatVod) {\n                var catvodCode = it.code || '';\n                if (!catvodCode && it.api) {\n                    try { catvodCode = qdFetchTvboxContent(it.api); } catch (eCv) {}\n                }\n                ruleData = {\n                    name: it.name,\n                    '类型': '影视',\n                    host: '',\n                    code: catvodCode,\n                    api: it.api,\n                    ext: it.ext || '',\n                    configKey: it.configKey || '',\n                    enabled: it.enabled !== false\n                };\n                if (it.key) {\n                    ruleData.key = it.key;\n                    ruleData.id = 'catvod_' + it.key;\n                }\n            } else {\n                ruleData = {\n                    name: it.name,\n                    '类型': '本地包',\n                    host: it.jar || '',\n                    api: it.api,\n                    jar: it.jar || '',\n                    ext: it.ext || '',\n                    configKey: it.configKey || '',\n                    enabled: it.enabled !== false\n                };\n                if (it.key) {\n                    ruleData.key = it.key;\n                    ruleData.id = 'jar_' + it.key;\n                }\n            }\n            if (mode === 1 && exists >= 0) {\n                ruleData.id = rules[exists].id;\n                cr.saveRule(ruleData);\n            } else if (exists < 0) {\n                cr.saveRule(ruleData);\n            }\n        }\n    }\n}\n\nfunction qdGetImportPlan(importdatas) {\n    importdatas = importdatas || [];\n    var CONFIG_FILE = \"hiker://files/rules/青豆剧场/qd_configs\";\n    var cfg = {};\n    try { cfg = JSON.parse(readFile(CONFIG_FILE) || '{}'); } catch (e) { cfg = {}; }\n    var parses = cfg.parses || [];\n    var sites = cfg.bocai_sites || [];\n    var rules = [];\n    try { rules = $.require(\"customRule\").getRuleList(); } catch(e2) {}\n    var plan = { total: importdatas.length, add: 0, overwrite: 0, skip: 0, items: [] };\n    for (var i = 0; i < importdatas.length; i++) {\n        var it = importdatas[i] || {};\n        var exists = -1;\n        var typeLabel = it._qd_type === 'parse' ? '解析' : (it._qd_type === 'bocai' ? '菠菜' : (it._qd_type === 'jar_rule' ? '本地包' : '规则'));\n        if (it._qd_type === 'parse') {\n            for (var p = 0; p < parses.length; p++) {\n                if (parses[p].name === it.name && parses[p].url === it.url) { exists = p; break; }\n            }\n        } else if (it._qd_type === 'bocai') {\n            for (var b = 0; b < sites.length; b++) {\n                if (sites[b].key === it.key || sites[b].name === it.name) { exists = b; break; }\n            }\n        } else if (it._qd_type === 'rule') {\n            var hm = (it.code || '').match(/[\"']?host[\"']?\\s*[:=]\\s*['\"]([^'\"]+)['\"]/);\n            var importHost = it.host || (hm ? hm[1] : '');\n            for (var r = 0; r < rules.length; r++) {\n                if (rules[r].name === it.name || (importHost && rules[r].host === importHost)) { exists = r; break; }\n            }\n        } else if (it._qd_type === 'jar_rule') {\n            for (var r = 0; r < rules.length; r++) {\n                if (rules[r].name === it.name || (rules[r].api && rules[r].api === it.api)) { exists = r; break; }\n            }\n        }\n        var action = exists >= 0 ? 'overwrite' : 'add';\n        if (action === 'add') plan.add++;\n        else plan.overwrite++;\n        plan.items.push({ index: i, data: it, typeLabel: typeLabel, action: action, exists: exists });\n    }\n    plan.skip = plan.overwrite;\n    return plan;\n}\n\nfunction qdShowRuleImportConfirm(ruleData) {\n    if (!ruleData) return \"toast://导入数据为空\";\n    saveFile(\"hiker://files/_cache/qd_rule_import_confirm.json\", JSON.stringify(ruleData));\n    return $(\"hiker://empty#noRecordHistory##noHistory#\").rule(function() {\n        var fn = $.require(\"function\");\n        setPageTitle(\"规则导入确认\");\n        var data = {};\n        try { data = JSON.parse(fetch(\"hiker://files/_cache/qd_rule_import_confirm.json\") || '{}'); } catch(e) {}\n        var plan = fn.qdGetImportPlan([data]);\n        var item = plan.items[0] || { action: 'add', data: data, typeLabel: '规则' };\n        var d = [];\n        d.push({\n            title: '\\u2018\\u2018\\u2019\\u2019<b><font color=\"#339AF0\">导入确认</font></b>',\n            desc: '名称: ' + (data.name || '') + '\\n类型: ' + (data['类型'] || '主页源') + '\\n状态: ' + (item.action === 'overwrite' ? '将覆盖已存在规则' : '将新增规则'),\n            col_type: 'text_1'\n        });\n        d.push({\n            title: item.action === 'overwrite' ? '覆盖导入' : '新增导入',\n            pic_url: item.action === 'overwrite' ? 'hiker://images/icon_download6' : 'hiker://images/icon_add2',\n            url: $(\"确认导入「\" + (data.name || '') + \"」？\").confirm(function(data) {\n                $.require(\"function\").qdDoImport([data], 1);\n                back(true);\n                return \"toast://导入完成: \" + data.name;\n            }, data),\n            col_type: 'icon_2'\n        });\n        d.push({\n            title: '取消',\n            pic_url: 'hiker://images/icon_close_2',\n            url: $(\"取消本次导入？\").confirm(function() { back(false); return \"hiker://empty\"; }),\n            col_type: 'icon_2'\n        });\n        d.push({col_type: 'line'});\n        d.push({\n            title: data.name || '导入规则',\n            desc: '<font color=\"#868E96\">[' + (data['类型'] || '主页源') + '] ' + (data.host || '') + '</font>',\n            pic_url: 'hiker://images/icon_edit6',\n            url: 'hiker://empty',\n            col_type: 'avatar',\n            extra: { backgroundColor: item.action === 'overwrite' ? '#20FFA94D' : '#2051CF66', lineVisible: true }\n        });\n        setResult(d);\n    });\n}\n\nfunction qdShowJarImportConfirm(jarRules) {\n    if (!jarRules || !Array.isArray(jarRules) || jarRules.length === 0) return \"toast://无jar规则可导入\";\n    saveFile(\"hiker://files/_cache/qd_jar_import_confirm.json\", JSON.stringify(jarRules));\n    return $(\"hiker://empty#noRecordHistory##noHistory#\").rule(function() {\n        var fn = $.require(\"function\");\n        setPageTitle(\"本地包导入确认\");\n        var datas = [];\n        try { datas = JSON.parse(fetch(\"hiker://files/_cache/qd_jar_import_confirm.json\") || '[]'); } catch(e) {}\n        var plan = fn.qdGetImportPlan(datas);\n        var d = [];\n        d.push({\n            title: '\\u2018\\u2018\\u2019\\u2019<b><font color=\"#339AF0\">本地包导入</font></b>',\n            desc: '共 ' + datas.length + ' 条，新增 ' + plan.add + ' 条，覆盖 ' + plan.overwrite + ' 条',\n            col_type: 'text_1'\n        });\n        d.push({\n            title: '全部导入',\n            pic_url: 'hiker://images/icon_add2',\n            url: $(\"确认导入全部\" + datas.length + \"条本地包？\").confirm(function(datas) {\n                $.require(\"function\").qdDoImport(datas, 1);\n                back(true);\n                return \"toast://导入完成: \" + datas.length + \" 条\";\n            }, datas),\n            col_type: 'icon_2'\n        });\n        d.push({col_type: 'line'});\n        for (var i = 0; i < datas.length; i++) {\n            var it = datas[i];\n            var itemPlan = plan.items[i] || { action: 'add' };\n            d.push({\n                title: it.name + ' <font color=\"#868E96\">[' + it.api + ']</font>',\n                desc: '<font color=\"#868E96\">' + (it.jar || '').substring(0, 80) + (it.jar && it.jar.length > 80 ? '...' : '') + '</font>',\n                pic_url: itemPlan.action === 'overwrite' ? 'hiker://images/icon_download6' : 'hiker://images/icon_add2',\n                url: $(\"确认导入「\" + it.name + \"」？\").confirm(function(idx) {\n                    var datas2 = JSON.parse(fetch(\"hiker://files/_cache/qd_jar_import_confirm.json\") || '[]');\n                    $.require(\"function\").qdDoImport([datas2[idx]], 1);\n                    refreshPage(false);\n                    return \"toast://导入完成: \" + datas2[idx].name;\n                }, i),\n                col_type: 'avatar',\n                extra: { backgroundColor: itemPlan.action === 'overwrite' ? '#20FFA94D' : '#2051CF66', lineVisible: true }\n            });\n        }\n        setResult(d);\n    });\n}\n\nfunction SourceStateManager(sourceId) {\n    this.sourceId = sourceId || '';\n}\nSourceStateManager.prototype._read = function() {\n    if (!this.sourceId) return {};\n    try {\n        var cr = $.require(\"customRule\");\n        if (cr.getSourceState) return cr.getSourceState(this.sourceId) || {};\n    } catch(e) {}\n    return {};\n};\nSourceStateManager.prototype._write = function(state) {\n    if (!this.sourceId) return state || {};\n    try {\n        var cr = $.require(\"customRule\");\n        if (cr.setSourceState) return cr.setSourceState(this.sourceId, state || {});\n    } catch(e) {}\n    return state || {};\n};\nSourceStateManager.prototype.get = function(key, defValue) {\n    var st = this._read();\n    return st[key] !== undefined ? st[key] : defValue;\n};\nSourceStateManager.prototype.set = function(key, value) {\n    var st = this._read();\n    st[key] = value;\n    st.updatedAt = Date.now();\n    this._write(st);\n};\nSourceStateManager.prototype.merge = function(patch) {\n    var st = this._read();\n    patch = patch || {};\n    for (var k in patch) {\n        if (patch.hasOwnProperty(k)) st[k] = patch[k];\n    }\n    st.updatedAt = Date.now();\n    this._write(st);\n    return st;\n};\nSourceStateManager.prototype.clear = function(key) {\n    var st = this._read();\n    if (key) delete st[key];\n    else st = {};\n    this._write(st);\n};\n\nfunction PlayerStateManager(pageId) {\n    this.pageId = pageId;\n    this.sourceState = new SourceStateManager('detail_' + pageId);\n}\nPlayerStateManager.prototype.getLine = function() { return this.sourceState.get('line', getItem('bc_agg_line_' + this.pageId, '')); };\nPlayerStateManager.prototype.setLine = function(line) { var limit = getPageSize(); setItem('bc_agg_line_' + this.pageId, line); setItem('bc_agg_page_' + this.pageId, '0'); setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.merge({line: line, page: 0, limit: limit}); };\nPlayerStateManager.prototype.getPage = function() { return Number(this.sourceState.get('page', getItem('bc_agg_page_' + this.pageId, '0'))) || 0; };\nPlayerStateManager.prototype.setPage = function(page) { setItem('bc_agg_page_' + this.pageId, String(page)); this.sourceState.set('page', Number(page) || 0); };\nPlayerStateManager.prototype.getSort = function() { return this.sourceState.get('sort', getItem('bc_agg_order_' + this.pageId, 'asc')); };\nPlayerStateManager.prototype.setSort = function(sort) { setItem('bc_agg_order_' + this.pageId, sort); setItem('bc_agg_page_' + this.pageId, '0'); this.sourceState.merge({sort: sort, page: 0}); };\nPlayerStateManager.prototype.getMode = function() { return this.sourceState.get('mode', getItem('bc_agg_mode_' + this.pageId, 'auto')); };\nPlayerStateManager.prototype.setMode = function(mode) { var limit = getPageSize(); setItem('bc_agg_mode_' + this.pageId, mode); setItem('bc_agg_page_' + this.pageId, '0'); setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.merge({mode: mode, page: 0, limit: limit}); };\nPlayerStateManager.prototype.getLimit = function() { return Number(this.sourceState.get('limit', getItem('bc_agg_limit_' + this.pageId, String(getPageSize())))) || getPageSize(); };\nPlayerStateManager.prototype.setLimit = function(limit) { setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.set('limit', Number(limit) || getPageSize()); };\nPlayerStateManager.prototype.reset = function() { var limit = getPageSize(); setItem('bc_agg_page_' + this.pageId, '0'); setItem('bc_agg_limit_' + this.pageId, String(limit)); this.sourceState.merge({page: 0, limit: limit}); };\n\nfunction _cacheLayerPrefix(layer) {\n    layer = layer || 'detail';\n    if (layer === 'parse') return 'qd_parse_';\n    if (layer === 'searchAgg') return 'qd_search_agg_';\n    if (layer === 'detail') return 'qd_detail_';\n    return 'qd_' + String(layer).replace(/[^\\w-]/g, '_') + '_';\n}\nfunction gzipCompress(text) {\n    try {\n        var baos = new java.io.ByteArrayOutputStream();\n        var gzos = new java.util.zip.GZIPOutputStream(baos);\n        gzos.write(new java.lang.String(text).getBytes(\"UTF-8\"));\n        gzos.close();\n        var compressed = baos.toByteArray();\n        baos.close();\n        return String(java.util.Base64.getEncoder().encodeToString(compressed));\n    } catch (e) { return null; }\n}\nfunction gzipDecompress(b64) {\n    try {\n        var compressed = java.util.Base64.getDecoder().decode(b64);\n        var bais = new java.io.ByteArrayInputStream(compressed);\n        var gis = new java.util.zip.GZIPInputStream(bais);\n        var baos = new java.io.ByteArrayOutputStream();\n        var buffer = java.lang.reflect.Array.newInstance(java.lang.Byte.TYPE, 1024);\n        var len;\n        while ((len = gis.read(buffer)) != -1) { baos.write(buffer, 0, len); }\n        gis.close();\n        bais.close();\n        baos.close();\n        return String(new java.lang.String(baos.toByteArray(), \"UTF-8\"));\n    } catch (e) { return null; }\n}\nfunction getLayerCache(layer, cacheKey, ttl) {\n    ttl = ttl || 30 * 60 * 1000;\n    var cacheFile = 'hiker://files/cache/' + _cacheLayerPrefix(layer) + cacheKey + '.json';\n    if (fileExist(cacheFile)) {\n        try {\n            var raw = fetch(cacheFile);\n            if (!raw) return null;\n            var jsonStr = raw;\n            if (raw.length > 0 && raw.charAt(0) !== '{' && raw.charAt(0) !== '[') {\n                var decompressed = gzipDecompress(raw);\n                if (decompressed) jsonStr = decompressed;\n            }\n            var data = JSON.parse(jsonStr);\n            if (data && data.ts && (Date.now() - data.ts < ttl)) return data.data;\n        } catch (e) {}\n    }\n    return null;\n}\nfunction setLayerCache(layer, cacheKey, data) {\n    try {\n        var jsonStr = JSON.stringify({ ts: Date.now(), data: data });\n        var toSave = jsonStr;\n        if (jsonStr.length > 512) {\n            var compressed = gzipCompress(jsonStr);\n            if (compressed) toSave = compressed;\n        }\n        saveFile('hiker://files/cache/' + _cacheLayerPrefix(layer) + cacheKey + '.json', toSave);\n    } catch (e) {}\n}\nfunction clearLayerCache(layer, cacheKey) {\n    try { saveFile('hiker://files/cache/' + _cacheLayerPrefix(layer) + cacheKey + '.json', '{}'); } catch (e) {}\n}\nfunction getSecondaryCache(cacheKey, ttl) {\n    return getLayerCache('detail', cacheKey, ttl);\n}\nfunction setSecondaryCache(cacheKey, data) {\n    return setLayerCache('detail', cacheKey, data);\n}\nfunction clearSecondaryCache(cacheKey) {\n    return clearLayerCache('detail', cacheKey);\n}\n\nvar _lastAggPageId = '';\nfunction AggCacheManager(pageId) {\n    this.pageId = pageId || '';\n    this.resultKey = 'bc_agg_results_' + this.pageId;\n    this.mergedKey = 'bc_agg_merged_' + this.pageId;\n    if (pageId && _lastAggPageId && pageId !== _lastAggPageId) {\n        try {\n            var oldResultKey = 'bc_agg_results_' + _lastAggPageId;\n            var oldMergedKey = 'bc_agg_merged_' + _lastAggPageId;\n            clearLayerCache('searchAgg', oldResultKey);\n            clearLayerCache('detail', oldMergedKey);\n            clearSecondaryCache(oldResultKey);\n            clearSecondaryCache(oldMergedKey);\n            putMyVar('bc_agg_merged_cache_' + _lastAggPageId, '');\n            putMyVar('bc_agg_merged_ts_' + _lastAggPageId, '0');\n            putMyVar('bc_agg_force_' + _lastAggPageId, '');\n        } catch(e) {}\n    }\n    _lastAggPageId = this.pageId;\n}\nAggCacheManager.prototype.getResults = function(ttl) {\n    return getLayerCache('searchAgg', this.resultKey, ttl) || getSecondaryCache(this.resultKey, ttl);\n};\nAggCacheManager.prototype.setResults = function(data) {\n    setLayerCache('searchAgg', this.resultKey, data || []);\n    setSecondaryCache(this.resultKey, data || []);\n};\nAggCacheManager.prototype.getMerged = function(ttl) {\n    return getLayerCache('detail', this.mergedKey, ttl) || getSecondaryCache(this.mergedKey, ttl);\n};\nAggCacheManager.prototype.setMerged = function(data) {\n    setLayerCache('detail', this.mergedKey, data || []);\n    setSecondaryCache(this.mergedKey, data || []);\n};\nAggCacheManager.prototype.clear = function() {\n    clearLayerCache('searchAgg', this.resultKey);\n    clearLayerCache('detail', this.mergedKey);\n    clearSecondaryCache(this.resultKey);\n    clearSecondaryCache(this.mergedKey);\n    if (_lastAggPageId === this.pageId) _lastAggPageId = '';\n};\n\nfunction isPageRefreshing() {\n    try {\n        var activity = getCurrentActivity();\n        if (!activity) return false;\n        var smartRefresh;\n        var className = activity.getClass().getName();\n        if (className == \"com.example.hikerview.ui.home.RuleWindowActivity\" ||\n            className == \"com.example.hikerview.ui.home.FilmListActivity\") {\n            var fragmentField = activity.getClass().getDeclaredField(\"articleListFragment\");\n            fragmentField.setAccessible(true);\n            var fragment = fragmentField.get(activity);\n            var smartField = fragment.getClass().getDeclaredField(\"smartRefreshLayout\");\n            smartField.setAccessible(true);\n            smartRefresh = smartField.get(fragment);\n        }\n        if (smartRefresh) {\n            var state = smartRefresh.getState();\n            return state.toString() == \"Refreshing\";\n        }\n        return false;\n    } catch (e) {\n        return false;\n    }\n}\n\nfunction forceRefreshAgg(pageId, opts) {\n    pageId = pageId === undefined || pageId === null ? '' : String(pageId);\n    opts = opts || {};\n    if (pageId) {\n        putMyVar('bc_agg_force_' + pageId, '1');\n        try { new AggCacheManager(pageId).clear(); } catch (e) {}\n    }\n    putMyVar('bc_agg_current_id', '');\n    putMyVar('bc_agg_current_data', '');\n    putMyVar('bc_agg_current_ts', '0');\n    putMyVar('bc_agg_merged_cache', '');\n    putMyVar('bc_agg_merged_ts', '0');\n    if (opts.tmdbId) putMyVar('tmdb_force_' + opts.tmdbId, '1');\n    if (opts.tmdbIds && opts.tmdbIds.length) {\n        for (var i = 0; i < opts.tmdbIds.length; i++) {\n            if (opts.tmdbIds[i]) putMyVar('tmdb_force_' + opts.tmdbIds[i], '1');\n        }\n    }\n}\n\nfunction aggMergeBocaiResults(allResults) {\n    function getEpNames(r) {\n        var epList = r.playUrl.split('#').filter(function(e) { return e; });\n        var names = [];\n        for (var j = 0; j < epList.length; j++) names.push(epList[j].split('$')[0] || '');\n        return names;\n    }\n    function normEpName(name) {\n        var s = (name || '').replace(/\\s+/g, '').replace(/^(第|ep|EP|e|E)/, '').replace(/[集期话話]$/, '');\n        var cnMap = {'零':0,'一':1,'二':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9,'十':10,'百':100,'千':1000,'万':10000};\n        s = s.replace(/[零一二三四五六七八九十百千万]+/g, function(m) {\n            if (m.length === 1 && cnMap[m] !== undefined) return cnMap[m];\n            var r = 0, cur = 0;\n            for (var i = 0; i < m.length; i++) {\n                var v = cnMap[m[i]];\n                if (v >= 10) { cur = cur === 0 ? v : cur * v; r += cur; cur = 0; }\n                else cur = v;\n            }\n            r += cur;\n            return r || m;\n        });\n        if (/^\\d+$/.test(s)) return String(Number(s));\n        return s;\n    }\n    function groupByEp(results) {\n        var used = {};\n        var groups = [];\n        for (var i = 0; i < results.length; i++) {\n            if (used[i]) continue;\n            var group = [results[i]];\n            used[i] = true;\n            var baseNames = getEpNames(results[i]);\n            var baseNorm = [];\n            for (var k = 0; k < baseNames.length; k++) baseNorm.push(normEpName(baseNames[k]));\n            var changed = true;\n            while (changed) {\n                changed = false;\n                for (var j = 0; j < results.length; j++) {\n                    if (used[j]) continue;\n                    var curNames = getEpNames(results[j]);\n                    var minLen = Math.min(baseNames.length, curNames.length);\n                    var match = 0;\n                    for (var k = 0; k < minLen; k++) {\n                        if (baseNorm[k] === normEpName(curNames[k])) match++;\n                    }\n                    if (match === minLen) {\n                        group.push(results[j]);\n                        used[j] = true;\n                        changed = true;\n                    }\n                }\n            }\n            if (group.length >= 1) groups.push(group);\n        }\n        return groups;\n    }\n    function addAdFreeForSingleGroups(groups, origType) {\n        for (var i = 0; i < groups.length; i++) {\n            if (groups[i].length === 1) {\n                var orig = groups[i][0];\n                groups[i].push({\n                    name: '🛡️去广告',\n                    key: orig.key + '_adfree',\n                    type: origType,\n                    ruleName: orig.ruleName,\n                    _ruleId: orig._ruleId,\n                    _sourceApi: orig._sourceApi,\n                    siteKey: orig.siteKey,\n                    epCount: orig.epCount,\n                    playFrom: '去广告',\n                    playUrl: orig.playUrl\n                });\n            }\n        }\n        return groups;\n    }\n    function buildMerged(sourceGroups, mergedType, mergedName) {\n        var mergedList = [];\n        var mergedKeys = {};\n        for (var i = 0; i < sourceGroups.length; i++) {\n            var group = sourceGroups[i];\n            var hasOfficial = false;\n            for (var oi = 0; oi < group.length; oi++) {\n                if (group[oi].type === 'official') { hasOfficial = true; break; }\n            }\n            var actualType = hasOfficial ? 'merged_official' : mergedType;\n            group.sort(function(a, b) {\n                var ha = a.playFrom.indexOf('蓝光') !== -1 || a.name.indexOf('蓝光') !== -1 ? 0 : 1;\n                var hb = b.playFrom.indexOf('蓝光') !== -1 || b.name.indexOf('蓝光') !== -1 ? 0 : 1;\n                return ha - hb;\n            });\n            var srcNames = [];\n            for (var k = 0; k < group.length; k++) {\n                srcNames.push(group[k].playFrom || group[k].name.replace(/^🍎\\s*主页源-?/, '').replace(/^🎬/, ''));\n            }\n            var allEpNames = [];\n            var normToRaw = {};\n            var nameSet = {};\n            var normMaps = [];\n            for (var k = 0; k < group.length; k++) {\n                var nm = {};\n                var nList = getEpNames(group[k]);\n                for (var j = 0; j < nList.length; j++) {\n                    var nn = normEpName(nList[j]);\n                    nm[nn] = group[k].playUrl.split('#').filter(function(e){return e;})[j].split('$')[1] || group[k].playUrl.split('#').filter(function(e){return e;})[j].split('$')[0] || '';\n                    if (!nameSet[nn]) { nameSet[nn] = true; allEpNames.push(nList[j]); normToRaw[nn] = nList[j]; }\n                }\n                normMaps.push(nm);\n            }\n            var mergedUrls = [];\n            var episodeRuleIds = [];\n            var episodeSourceApis = [];\n            var episodeSourceNames = [];\n            var maxCount = 0;\n            for (var j = 0; j < allEpNames.length; j++) {\n                var epName = allEpNames[j];\n                var nn = normEpName(epName);\n                var urls = [];\n                var ruleIds = [];\n                var sourceApis = [];\n                var epSrcNames = [];\n                for (var k = 0; k < normMaps.length; k++) {\n                    if (normMaps[k][nn] !== undefined) {\n                        urls.push(normMaps[k][nn]);\n                        ruleIds.push(group[k]._ruleId || '');\n                        sourceApis.push(group[k]._sourceApi || '');\n                        epSrcNames.push(srcNames[k] || ('线路' + (k + 1)));\n                    }\n                }\n                mergedUrls.push(epName + '$' + urls.join('||'));\n                episodeRuleIds.push(ruleIds);\n                episodeSourceApis.push(sourceApis);\n                episodeSourceNames.push(epSrcNames);\n                if (urls.length > maxCount) maxCount = urls.length;\n            }\n            mergedList.push({\n                name: mergedName,\n                key: actualType + '_' + i,\n                type: actualType,\n                epCount: mergedUrls.length,\n                playFrom: mergedName,\n                playUrl: mergedUrls.join('#'),\n                sources: group,\n                sourceNames: srcNames,\n                episodeRuleIds: episodeRuleIds,\n                episodeSourceApis: episodeSourceApis,\n                episodeSourceNames: episodeSourceNames,\n                maxSourceCount: maxCount\n            });\n            for (var k = 0; k < group.length; k++) mergedKeys[group[k].key] = true;\n        }\n        return { merged: mergedList, keys: mergedKeys };\n    }\n\n    var bocaiOnly = [];\n    var officialOnly = [];\n    var ruleItems = [];\n    for (var i = 0; i < allResults.length; i++) {\n        if (allResults[i].type === 'bocai') bocaiOnly.push(allResults[i]);\n        else if (allResults[i].type === 'official') officialOnly.push(allResults[i]);\n        else if (!isPanAggResult(allResults[i])) ruleItems.push(allResults[i]);\n    }\n\n    var bocaiRes = buildMerged(addAdFreeForSingleGroups(groupByEp(bocaiOnly), 'bocai'), 'merged_bocai', '菠菜聚合');\n    var officialRes = { merged: [], keys: {} };\n\n    var ruleGroups = {};\n    for (var ri = 0; ri < ruleItems.length; ri++) {\n        var rn = ruleItems[ri].ruleName || ruleItems[ri].name || '其他';\n        rn = rn.replace(/^[🎬🔍🌿]/, '').trim();\n        if (!ruleGroups[rn]) ruleGroups[rn] = [];\n        ruleGroups[rn].push(ruleItems[ri]);\n    }\n\n    var ruleMergedAll = [];\n    var ruleKeys = {};\n    for (var rgn in ruleGroups) {\n        var rgItems = ruleGroups[rgn];\n        var rgRes = buildMerged(addAdFreeForSingleGroups(groupByEp(rgItems), 'rule'), 'merged_rule', rgn);\n        for (var rmi = 0; rmi < rgRes.merged.length; rmi++) {\n            rgRes.merged[rmi].ruleName = rgn;\n            ruleMergedAll.push(rgRes.merged[rmi]);\n        }\n        for (var rk in rgRes.keys) ruleKeys[rk] = true;\n    }\n\n    var final = [];\n    for (var i = 0; i < allResults.length; i++) {\n        var r = allResults[i];\n        if (r.type === 'official' && !officialRes.keys[r.key]) final.push(r);\n        else if (r.type === 'bocai' && !bocaiRes.keys[r.key]) final.push(r);\n        else if (r.type !== 'official' && r.type !== 'bocai' && !ruleKeys[r.key]) final.push(r);\n    }\n    final = final.concat(officialRes.merged).concat(ruleMergedAll).concat(bocaiRes.merged);\n    final.sort(function(a, b) {\n        var oa = (a.type === 'official' || a.type === 'merged_official' ? 0 : 1);\n        var ob = (b.type === 'official' || b.type === 'merged_official' ? 0 : 1);\n        if (oa !== ob) return oa - ob;\n        return 0;\n    });\n    return final;\n}\n\nfunction aggBuildCategories(results) {\n    var officialGroup = [];\n    var ruleGroups = {};\n    var bocaiGroup = [];\n    for (var i = 0; i < results.length; i++) {\n        var r = results[i];\n        if (r.type === 'official' || r.type === 'merged_official') officialGroup.push(r);\n        else if (r.type === 'bocai' || r.type === 'merged_bocai') bocaiGroup.push(r);\n        else {\n            var gName = r.ruleName || r.name || '其他';\n            gName = gName.replace(/^[🎬🔍🌿]/, '').trim();\n            if (!ruleGroups[gName]) ruleGroups[gName] = [];\n            ruleGroups[gName].push(r);\n        }\n    }\n    var categories = [];\n    if (officialGroup.length > 0) categories.push({ name: '官方源', results: officialGroup });\n    var gKeys = Object.keys(ruleGroups);\n    for (var gi = 0; gi < gKeys.length; gi++) categories.push({ name: gKeys[gi], results: ruleGroups[gKeys[gi]] });\n    if (bocaiGroup.length > 0) categories.push({ name: '菠菜源', results: bocaiGroup });\n    return categories;\n}\n\nfunction aggDefaultEpUrl(ctx) {\n    var line = ctx.line, obj = ctx.obj, epName = ctx.epName, playLink = ctx.playLink, originalIndex = ctx.index;\n    if (line.type === 'merged_bocai' || line.type === 'merged_rule' || line.type === 'merged_official') {\n        var epUrls = ctx.epUrls;\n        var srcNames = (line.episodeSourceNames && line.episodeSourceNames[originalIndex]) || ctx.srcNames;\n        var ruleIds = (line.episodeRuleIds && line.episodeRuleIds[originalIndex]) || [];\n        var sourceApis = (line.episodeSourceApis && line.episodeSourceApis[originalIndex]) || [];\n        return $(playLink).lazyRule(function(dId, sTitle, eIdx, eTitle, eUrls, sNames, rIds, sApis, pLink, mergedType, movieTitle) {\n            try {\n            $.require('function').setProgress(dId, { sourceTitle: sTitle, episodeIndex: eIdx, episodeTitle: eTitle, playLink: pLink, playType: 'merged' });\n            $.require('function').fpUpdate(dId, sTitle, eIdx, eTitle, pLink, 'merged');\n            var dmMode = $.require('function').getExternalDanmuConfig().mode;\n            if (/\\[画\\]/.test(sTitle) || /\\[音\\]/.test(sTitle)) dmMode = 'off';\n            var dmPath = (dmMode === 'external' || dmMode === 'local') ? $.require('function').getExternalDanmuUrl(pLink, movieTitle || '', '', eTitle) : '';\n            var dmCacheKey = 'dm_url_' + dId + '_' + eIdx;\n            var dmCached = dmMode === 'box' ? getMyVar(dmCacheKey, '') : '';\n            if (dmCached) {\n                try {\n                    var dmData = JSON.parse(dmCached);\n                    if (dmData.ts && (Date.now() - dmData.ts < 2 * 60 * 60 * 1000) && dmData.url) dmPath = dmData.url;\n                } catch (e) {}\n            }\n            if (!dmPath && dmMode === 'box') {\n                try {\n                    var eps = $.require('function').getEpisodes(dId);\n                    if (eps && eps.playList && eps.playList.length > 0) {\n                        var matchedUrl = '';\n                        for (var i = 0; i < eps.playList.length; i++) {\n                            if (eIdx < eps.playList[i].list.length) { matchedUrl = eps.playList[i].list[eIdx].play_link; break; }\n                        }\n                        if (!matchedUrl) { var last = eps.playList[eps.playList.length - 1]; matchedUrl = last.list[last.list.length - 1].play_link; }\n                        if (matchedUrl) {\n                            try {\n                                var dmFun = $.require('hiker://page/dmFun?rule=dm盒子');\n                                var dm = dmFun.dmRoute(matchedUrl);\n                                if (dm && dm !== false) { dmPath = dm; putVar('dm_share', dm); putMyVar(dmCacheKey, JSON.stringify({ url: dm, ts: Date.now() })); }\n                            } catch (e) {}\n                        }\n                    }\n                } catch (e) {}\n            }\n            var vUrls = [];\n            var vNames = [];\n            var vHeaders = [];\n            var panUrls = [];\n            for (var si = 0; si < eUrls.length; si++) {\n                var resolvedUrl = eUrls[si];\n                if (mergedType === 'merged_rule' && (rIds[si] || sApis[si])) {\n                    try {\n                        var cr = $.require('customRule');\n                        var rules = cr.getRuleList ? cr.getRuleList() : cr.getRuleIndex();\n                        var ruleObj = null;\n                        for (var ri = 0; ri < rules.length; ri++) {\n                            if ((rIds[si] && rules[ri].id === rIds[si]) || (sApis[si] && (rules[ri].url === sApis[si] || rules[ri].host === sApis[si]))) { ruleObj = rules[ri]; break; }\n                        }\n                        if (ruleObj) {\n                            var parsed = cr.executeLazy(ruleObj, resolvedUrl);\n                            if (parsed) resolvedUrl = parsed;\n                        }\n                    } catch (e) {}\n                }\n                if (typeof resolvedUrl === 'string' && resolvedUrl.indexOf('pan://') === 0) {\n                    return $.require('function').resolvePanJump(resolvedUrl);\n                }\n                if (typeof resolvedUrl === 'string' && /^\\s*[\\{\\[]/.test(resolvedUrl)) {\n                    try { resolvedUrl = JSON.parse(resolvedUrl); } catch (e) {}\n                }\n                var rNeedSniff = (resolvedUrl && typeof resolvedUrl === 'object' && (resolvedUrl.parse === 1 || resolvedUrl.parse === '1' || resolvedUrl.jx === 1 || resolvedUrl.jx === '1'));\n                var resolvedUrls = resolvedUrl && typeof resolvedUrl === 'object' && resolvedUrl.urls ? resolvedUrl.urls : [resolvedUrl && typeof resolvedUrl === 'object' && resolvedUrl.url !== undefined ? resolvedUrl.url : resolvedUrl];\n                if (!Array.isArray(resolvedUrls)) resolvedUrls = [resolvedUrls];\n                var resolvedNames = resolvedUrl && typeof resolvedUrl === 'object' ? resolvedUrl.names : null;\n                var resolvedHeaders = resolvedUrl && typeof resolvedUrl === 'object' ? (resolvedUrl.headers || resolvedUrl.header) : null;\n                for (var ui = 0; ui < resolvedUrls.length; ui++) {\n                    var finalUrl = resolvedUrls[ui];\n                    var panInfo = $.require('function').getPanType(finalUrl);\n                    if (panInfo) {\n                        panUrls.push({ url: finalUrl, type: panInfo.type || panInfo });\n                        continue;\n                    }\n                    if (typeof finalUrl === 'string' && !/^video:\\/\\//i.test(finalUrl) && !/^x5Rule:\\/\\//i.test(finalUrl) && !/^webRule:\\/\\//i.test(finalUrl) && /^https?:\\/\\//i.test(finalUrl)) {\n                        if (/\\.m3u8(\\?|$)/i.test(finalUrl)) {\n                            try {\n                                var adRulesM = $.require('function').getM3u8AdRules();\n                                var m3u8RefM = (sApis && sApis[si]) || finalUrl.match(/^https?:\\/\\/[^\\/]+/i);\n                                if (m3u8RefM && typeof m3u8RefM === 'object') m3u8RefM = m3u8RefM[0];\n                                finalUrl = clearM3u8Ad(finalUrl, { headers: { 'User-Agent': 'Mozilla/5.0 (Linux; Android 11; Mobile)', 'Referer': m3u8RefM || '' }, timeout: 12000 }, adRulesM.m3u8AdRules);\n                            } catch(e) {\n                                finalUrl = rNeedSniff ? ('video://' + finalUrl + '#isVideo=true#') : (finalUrl + '#isVideo=true#');\n                            }\n                        } else {\n                            finalUrl = rNeedSniff ? ('video://' + finalUrl + '#isVideo=true#') : (finalUrl + '#isVideo=true#');\n                        }\n                    }\n                    vUrls.push(finalUrl);\n                    vNames.push(resolvedNames && resolvedNames[ui] ? resolvedNames[ui] : (sNames[si] || ('线路' + (si + 1))));\n                    if (resolvedHeaders) vHeaders.push(Array.isArray(resolvedHeaders) ? (resolvedHeaders[ui] || {}) : resolvedHeaders);\n                    else vHeaders.push({});\n                }\n            }\n            if (vUrls.length === 0 && panUrls.length > 0) {\n                var onlyPan = panUrls[0];\n                return $.require('function').openPanUrlWithContext(onlyPan.url, onlyPan.type, dId, movieTitle, eIdx, eTitle);\n            }\n            var result = { urls: vUrls, names: vNames };\n            if (vHeaders.length) result.headers = vHeaders;\n            if (dmPath) { result.danmu = dmPath; putVar('dm_share', dmPath); }\n            return JSON.stringify(result);\n            } finally { hideLoading(); }\n        }, obj.id, line.name, originalIndex, epName, epUrls, srcNames, ruleIds, sourceApis, playLink, line.type, obj.title || '');\n    } else if (line.type === 'official') {\n        var oKey = line.siteKey || '';\n        var oFlag = line.playFrom || line.name || '';\n        return $(playLink).lazyRule(function(dId, sTitle, eIdx, eTitle, pLink, sKey, pFlag, movieTitle) {\n            $.require('function').setProgress(dId, { sourceTitle: sTitle, episodeIndex: eIdx, episodeTitle: eTitle, playLink: pLink, playType: 'official' });\n            $.require('function').fpUpdate(dId, sTitle, eIdx, eTitle, pLink, 'official');\n            return $.require('function').buildPlayUrl(pLink, sTitle, sKey, pFlag, movieTitle || '', eTitle);\n        }, obj.id, line.name, originalIndex, epName, playLink, oKey, oFlag, obj.title || '');\n    } else if (line.type === 'rule' || line.type === 'custom') {\n        var rId = line._ruleId || '';\n        var rApi = line._sourceApi || '';\n        var rFlag = line.playFrom || line.name || '';\n        var sKey = line.siteKey || '';\n        return $(playLink).lazyRule(function(dId, sTitle, eIdx, eTitle, pLink, rId, rApi, rFlag, sKey, movieTitle) {\n            try {\n            var fn2 = $.require('function');\n            fn2.setProgress(dId, { sourceTitle: sTitle, episodeIndex: eIdx, episodeTitle: eTitle, playLink: pLink, playType: 'rule' });\n            fn2.fpUpdate(dId, sTitle, eIdx, eTitle, pLink, 'rule');\n            var panInfo = fn2.getPanType(pLink);\n            if (panInfo) return fn2.openPanUrlWithContext(pLink, panInfo.type || panInfo, dId, movieTitle, eIdx, eTitle);\n            var playUrl = pLink;\n            log('[aggEpDebug] pLink=' + String(pLink).substring(0, 100) + ' _ruleId=' + rId + ' _sourceApi=' + rApi + ' playFrom=' + rFlag + ' siteKey=' + sKey);\n            if (rId || rApi) {\n                try {\n                    var cr = $.require('customRule');\n                    var ruleIdx = cr.getRuleList ? cr.getRuleList() : cr.getRuleIndex();\n                    var ruleObj = null;\n                    for (var ri = 0; ri < ruleIdx.length; ri++) {\n                        if ((rId && ruleIdx[ri].id === rId) || (rApi && (ruleIdx[ri].url === rApi || ruleIdx[ri].host === rApi))) { ruleObj = ruleIdx[ri]; break; }\n                    }\n                    if (!ruleObj && sKey) {\n                        var rawKey = String(sKey).replace(/^custom_/, '');\n                        for (var ri2 = 0; ri2 < ruleIdx.length; ri2++) {\n                            if (ruleIdx[ri2].id === rawKey || ruleIdx[ri2].id === 'jar_' + rawKey || ruleIdx[ri2].id === 'catvod_' + rawKey) { ruleObj = ruleIdx[ri2]; break; }\n                        }\n                        if (ruleObj) log('[aggEpDebug] 通过siteKey回退匹配 ruleObj=' + ruleObj.id);\n                    }\n                    log('[aggEpDebug] ruleObj=' + (ruleObj ? ruleObj.id + ' 类型=' + ruleObj['类型'] + ' _qd_type=' + ruleObj._qd_type + ' jar=' + (ruleObj.jar ? '有' : '空') : '未找到'));\n                    if (ruleObj) {\n                        var resolved = cr.executeLazy(ruleObj, pLink, rFlag);\n                        log('[aggEpDebug] resolved=' + String(resolved).substring(0, 150) + ' unchanged=' + (resolved === pLink));\n                        if (resolved && resolved !== pLink) playUrl = resolved;\n                    }\n                } catch (e) { log('[aggEpDebug] 异常=' + e); }\n            } else {\n                log('[aggEpDebug] _ruleId和_sourceApi均为空，跳过executeLazy');\n            }\n            if (typeof playUrl === 'string' && playUrl.indexOf('pan://') === 0) {\n                return fn2.resolvePanJump(playUrl);\n            }\n            if (typeof playUrl === 'string' && /^\\s*\\{/.test(playUrl)) {\n                try { playUrl = JSON.parse(playUrl); } catch (e) {}\n            }\n            var dmMode = fn2.getExternalDanmuConfig().mode;\n            if (/\\[画\\]/.test(sTitle) || /\\[音\\]/.test(sTitle)) dmMode = 'off';\n            var dmPath = (dmMode === 'external' || dmMode === 'local') ? fn2.getExternalDanmuUrl(pLink, movieTitle || '', '', eTitle) : '';\n            if (playUrl && typeof playUrl === 'object' && Array.isArray(playUrl.urls)) {\n                var vUrls = [];\n                var pNeedSniff = (playUrl.parse === 1 || playUrl.parse === '1' || playUrl.jx === 1 || playUrl.jx === '1');\n                for (var vi = 0; vi < playUrl.urls.length; vi++) {\n                    var pu = playUrl.urls[vi];\n                    if (/^video:\\/\\//i.test(pu) || /#isVideo=true#/.test(pu)) {\n                        vUrls.push(pu);\n                    } else if (fn2.getPanTypeLoose(pu)) {\n                        vUrls.push(pu);\n                    } else if (/\\.m3u8|\\.mp4|\\.flv/i.test(pu)) {\n                        vUrls.push(pu + '#isVideo=true#');\n                    } else if (/^https?:\\/\\//i.test(pu)) {\n                        vUrls.push(pNeedSniff ? ('video://' + pu + '#isVideo=true#') : (pu + '#isVideo=true#'));\n                    } else {\n                        vUrls.push(pu);\n                    }\n                }\n                var r = { urls: vUrls, names: playUrl.names || [] };\n                if (playUrl.headers || playUrl.header) r.headers = playUrl.headers || playUrl.header;\n                if (dmPath) { r.danmu = dmPath; putVar('dm_share', dmPath); }\n                else if (playUrl.danmu) { r.danmu = playUrl.danmu; putVar('dm_share', playUrl.danmu); }\n                return JSON.stringify(r);\n            }\n            if (playUrl && typeof playUrl === 'object' && playUrl.url !== undefined) {\n                playUrl = playUrl.url;\n            }\n            var panInfo2 = fn2.getPanType(playUrl);\n            if (panInfo2) return fn2.openPanUrlWithContext(playUrl, panInfo2.type || panInfo2, dId, movieTitle, eIdx, eTitle);\n            if (typeof playUrl === 'string') {\n                playUrl = playUrl.replace(/#isVideo=true#|#isMusic=true#|#ignoreImg=true#|#ignoreVideo=true#|#ignoreMusic=true#/g, '');\n            }\n            function withDanmu(urls, names, headers) {\n                var result = { urls: urls, names: names || [eTitle] };\n                if (headers) result.headers = headers;\n                if (dmPath) { result.danmu = dmPath; putVar('dm_share', dmPath); log('弹幕获取完毕[' + (fn2.getExternalDanmuConfig().mode === 'local' ? '本地弹幕' : '外接弹幕') + ']'); }\n                return JSON.stringify(result);\n            }\n            if (typeof playUrl !== 'string') return JSON.stringify({ urls: [String(playUrl)], names: [eTitle] });\n            if (/^video:\\/\\//i.test(playUrl)) return withDanmu([playUrl], [eTitle]);\n            if (/^x5Rule:\\/\\//i.test(playUrl) || /^webRule:\\/\\//i.test(playUrl)) return withDanmu([playUrl], [eTitle]);\n            if (/\\.m3u8(\\?|$)/i.test(playUrl)) {\n                var adRules = fn2.getM3u8AdRules();\n                var m3u8Referer = rApi || playUrl.match(/^https?:\\/\\/[^\\/]+/i);\n                if (m3u8Referer && typeof m3u8Referer === 'object') m3u8Referer = m3u8Referer[0];\n                try { return withDanmu([clearM3u8Ad(playUrl, { headers: { 'User-Agent': 'Mozilla/5.0 (Linux; Android 11; Mobile)', 'Referer': m3u8Referer || rApi }, timeout: 12000 }, adRules.m3u8AdRules)], [eTitle]); } catch(e) { return withDanmu([playUrl + '#isVideo=true#'], [eTitle]); }\n            }\n            if (/\\.(mp4|m4v|webm|mov)(\\?|$)/i.test(playUrl)) return withDanmu([playUrl + '#isVideo=true#'], [eTitle]);\n            if (/^https?:\\/\\//i.test(playUrl)) return withDanmu([playUrl + '#isVideo=true#'], [eTitle]);\n            return playUrl;\n            } finally { hideLoading(); }\n        }, obj.id, line.name, originalIndex, epName, playLink, rId, rApi, rFlag, sKey, obj.title || '');\n    } else {\n        return $(playLink).lazyRule(function(dId, sTitle, eIdx, eTitle, pLink, movieTitle) {\n            try {\n            $.require('function').setProgress(dId, { sourceTitle: sTitle, episodeIndex: eIdx, episodeTitle: eTitle, playLink: pLink, playType: 'bocai' });\n            $.require('function').fpUpdate(dId, sTitle, eIdx, eTitle, pLink, 'bocai');\n            return $.require('function').playBocaiEpisode(dId, sTitle, eIdx, eTitle, pLink, movieTitle);\n            } finally { hideLoading(); }\n        }, obj.id, line.name, originalIndex, epName, playLink, obj.title || '');\n    }\n}\n\nvar _aggOptsCache = {};\nvar _customAggRenderers = {};\nfunction registerAggRenderer(pageId, renderFn) {\n    if (pageId) _customAggRenderers[pageId] = renderFn;\n}\nfunction createAggRenderer(opts) {\n    opts = opts || {};\n    var anchorId = opts.anchorId || 'bocai_agg';\n    var makeEpUrl = opts.makeEpUrl || aggDefaultEpUrl;\n    var customTypes = opts.customTypes || [];\n    var epExtraFn = opts.epExtra || function() { return {}; };\n    var epClsExtraFn = opts.epClsExtra || function() { return ''; };\n\n    function renderHeader(obj, categories) {\n        deleteItem('bocai_agg_header');\n        deleteItemByCls('agg_cat_btn');\n        if (!categories || categories.length === 0) return;\n\n        var singleCategory = categories.length <= 1;\n\n        var aggState = new SourceStateManager('agg_' + obj.id);\n        var selectedCat = aggState.get('category', getItem('bc_agg_cat_' + obj.id, categories[0].name));\n        var catFound = false;\n        for (var i = 0; i < categories.length; i++) {\n            if (categories[i].name === selectedCat) { catFound = true; break; }\n        }\n        if (!catFound) selectedCat = categories[0].name;\n\n        var headerExtra = { lineVisible: false, id: 'bocai_agg_header' };\n        if (opts.headerLongClick) headerExtra.longClick = opts.headerLongClick;\n        var headerItems = [];\n        headerItems.push({\n            title: '‘‘’’<big>🎍 聚合源</big> 请勿相信剧中任何广告!!!',\n            url: 'hiker://empty',\n            col_type: 'text_center_1',\n            extra: headerExtra\n        });\n\n        var catColorMap = { '官方源': '#339AF0', '菠菜源': '#FF6B6B' };\n        var catColors = ['#FFA94D', '#845EF7', '#51CF66', '#20C997', '#339AF0', '#F06595', '#FCC419'];\n        if (!singleCategory) {\n        for (var i = 0; i < categories.length; i++) {\n            var cat = categories[i];\n            var isSelected = (cat.name === selectedCat);\n            var maxEpCount = 0;\n            for (var j = 0; j < cat.results.length; j++) {\n                if (cat.results[j].epCount > maxEpCount) maxEpCount = cat.results[j].epCount;\n            }\n            var isPanCat = cat.results[0] && cat.results[0].type === 'pan';\n            var unitLabel = isPanCat ? '条' : '集';\n            var label = cat.name + '(' + maxEpCount + unitLabel + ')';\n            var catColor = catColorMap[cat.name] || catColors[i % catColors.length] || (isPanCat ? '#845EF7' : '#51CF66');\n            headerItems.push({\n                title: isSelected ? '‘‘’’<b><font color=\"' + catColor + '\">' + label + '</font></b>' : '‘‘’’' + label,\n                col_type: 'scroll_button',\n                url: $('#noLoading#').lazyRule(function(id, c) {\n                    var st = $.require('function').SourceStateManager('agg_' + id);\n                    var limit = $.require('function').getPageSize();\n                    st.merge({category: c, line: '', page: 0, limit: limit});\n                    setItem('bc_agg_cat_' + id, c);\n                    setItem('bc_agg_line_' + id, '');\n                    setItem('bc_agg_page_' + id, '0');\n                    setItem('bc_agg_limit_' + id, String(limit));\n                    $.require('function').switchAggView(id);\n                    return 'hiker://empty';\n                }, obj.id, cat.name),\n                extra: { cls: 'agg_cat_btn' }\n            });\n        }\n        }\n        addItemBefore(anchorId, headerItems);\n    }\n\n    function renderLines(obj, catLines, selectedLineKey) {\n        deleteItemByCls('agg_line_btn');\n        if (!catLines || catLines.length <= 1) return;\n\n        var items = [];\n        items.push({ col_type: 'big_blank_block' });\n        items.push({ title: '‘‘’’<small>线路选择:</small>', col_type: 'scroll_button', url: 'hiker://empty', extra: { cls: 'agg_line_btn' } });\n        for (var i = 0; i < catLines.length; i++) {\n            var r = catLines[i];\n            var isSelected = (r.key === selectedLineKey);\n            var lineUnit = (r.type === 'pan' || r.type === 'pan_sub') ? '条' : '集';\n            var label = r.playFrom + '(' + r.epCount + lineUnit + ')';\n            items.push({\n                title: isSelected ? '‘‘’’<b><font color=\"#FF5D50\">' + label + '</font></b>' : '‘‘’’' + label,\n                col_type: 'scroll_button',\n                url: $('#noLoading#').lazyRule(function(id, k) {\n                    var st = $.require('function').SourceStateManager('agg_' + id);\n                    var limit = $.require('function').getPageSize();\n                    st.merge({line: k, page: 0, limit: limit});\n                    setItem('bc_agg_line_' + id, k);\n                    setItem('bc_agg_page_' + id, '0');\n                    setItem('bc_agg_limit_' + id, String(limit));\n                    $.require('function').switchAggView(id);\n                    return 'hiker://empty';\n                }, obj.id, r.key),\n                extra: { cls: 'agg_line_btn' }\n            });\n        }\n        items.push({ col_type: 'line', extra: { cls: 'agg_line_btn' } });\n        addItemBefore(anchorId, items);\n    }\n\n    function renderEpList(obj, activeLine, isCacheHit) {\n        var oldEps = findItemsByCls('agg_ep');\n        if (oldEps) { for (var oi = 0; oi < oldEps.length; oi++) { if (oldEps[oi] && oldEps[oi].extra && oldEps[oi].extra.id) { try { deleteItem(oldEps[oi].extra.id); } catch(e) {} } } }\n        deleteItemByCls('agg_ep');\n        deleteItemByCls('agg_ep_ctrl');\n        deleteItem('agg_ep_header');\n        deleteItem('agg_pagination');\n\n        if (!activeLine) {\n            addItemBefore(anchorId, { title: '该源无可用线路', col_type: 'text_center_1', extra: { cls: 'agg_ctrl' } });\n            return;\n        }\n\n        if (customTypes.indexOf(activeLine.type) >= 0 && opts.renderCustomLine) {\n            var customItems = opts.renderCustomLine(activeLine, obj, { anchorId: anchorId, cls: 'agg_ep', pageSize: (getPageSize ? getPageSize() : 40), isCacheHit: isCacheHit });\n            if (customItems && customItems.length) addItemBefore(anchorId, customItems);\n            return;\n        }\n\n        var epList = activeLine.playUrl.split('#').filter(function(e) { return e; });\n        var epUnit = (activeLine.type === 'pan' || activeLine.type === 'pan_sub') ? '条' : '集';\n        var lineLabel = (activeLine.type === 'merged_bocai' || activeLine.type === 'merged_rule' || activeLine.type === 'merged_official')\n            ? activeLine.playFrom + '(' + (activeLine.maxSourceCount || (activeLine.sources ? activeLine.sources.length : 1)) + '源 ' + epList.length + epUnit + ')'\n            : activeLine.playFrom + ' (' + epList.length + epUnit + ')';\n\n        if (epList.length === 0) {\n            addItemBefore(anchorId, { title: '该线路无可用剧集', col_type: 'text_center_1', extra: { cls: 'agg_ctrl' } });\n            return;\n        }\n\n        var psm = new PlayerStateManager(obj.id);\n        var AGG_PAGE_SIZE = getPageSize ? getPageSize() : 40;\n        var totalEps = epList.length;\n        var sortOrder = psm.getSort();\n        if (sortOrder === 'desc') epList = epList.slice().reverse();\n        var totalPages = Math.ceil(epList.length / AGG_PAGE_SIZE);\n        var currentPage = psm.getPage();\n        if (currentPage >= totalPages) currentPage = 0;\n        var startIdx = currentPage * AGG_PAGE_SIZE;\n        var endIdx = Math.min(startIdx + AGG_PAGE_SIZE, epList.length);\n        var pageEps = epList.slice(startIdx, endIdx);\n\n        var epItems = [];\n\n        if (totalPages > 1) {\n            var orderLabel = sortOrder === 'desc' ? '倒序' : '正序';\n            var hasPrev = currentPage > 0;\n            var hasNext = currentPage < totalPages - 1;\n            epItems.push({\n                title: hasPrev ? '上一页' : '.',\n                col_type: 'text_4',\n                url: hasPrev ? $('#noLoading#').lazyRule(function(id, cur) {\n                    $.require('function').PlayerStateManager(id).setPage(cur - 1);\n                    $.require('function').switchAggView(id);\n                    return 'hiker://empty';\n                }, obj.id, currentPage) : 'hiker://empty',\n                extra: { cls: 'agg_ep_ctrl', id: 'agg_pagination' }\n            });\n            epItems.push({\n                title: '第' + (currentPage + 1) + '/' + totalPages + '页 [‘‘' + orderLabel + '’’]',\n                col_type: 'text_2',\n                url: 'hiker://empty',\n                extra: { cls: 'agg_ep_ctrl' }\n            });\n            epItems.push({\n                title: hasNext ? '下一页' : '.',\n                col_type: 'text_4',\n                url: hasNext ? $('#noLoading#').lazyRule(function(id, cur) {\n                    $.require('function').PlayerStateManager(id).setPage(cur + 1);\n                    $.require('function').switchAggView(id);\n                    return 'hiker://empty';\n                }, obj.id, currentPage) : 'hiker://empty',\n                extra: { cls: 'agg_ep_ctrl' }\n            });\n            for (var pi = 0; pi < totalPages; pi++) {\n                var rangeStart = pi * AGG_PAGE_SIZE + 1;\n                var rangeEnd = Math.min((pi + 1) * AGG_PAGE_SIZE, epList.length);\n                var isCurrentRange = (pi === currentPage);\n                epItems.push({\n                    title: isCurrentRange ? '‘‘’’<b><font color=\"#FF5D50\">' + rangeStart + '-' + rangeEnd + '</font></b>' : '‘‘’’' + rangeStart + '-' + rangeEnd,\n                    col_type: 'scroll_button',\n                    url: $('#noLoading#').lazyRule(function(id, page) {\n                        $.require('function').PlayerStateManager(id).setPage(page);\n                        $.require('function').switchAggView(id);\n                        return 'hiker://empty';\n                    }, obj.id, pi),\n                    extra: { cls: 'agg_ep_ctrl' }\n                });\n            }\n        }\n\n        var styleKey = 'aggPlaylistCol_' + obj.id + '_' + activeLine.key;\n        var isPanLine = (activeLine.type === 'pan' || activeLine.type === 'pan_sub');\n        if (!isPanLine) {\n            for (var panIdx = 0; panIdx < epList.length; panIdx++) {\n                var panParts = epList[panIdx].split('$');\n                var panLink = panParts[1] || panParts[0] || '';\n                if (getPanType(panLink)) { isPanLine = true; break; }\n            }\n        }\n        var autoCol = autoEpColType(epList.map(function(e) { return (e.split('$')[0] || ''); }));\n        var cachedStyle = getItem(styleKey, '');\n        var epCol;\n        if (isPanLine) epCol = 'text_1';\n        else if (isCacheHit && cachedStyle) epCol = cachedStyle;\n        else { epCol = autoCol; if (!isPanLine) setItem(styleKey, autoCol); }\n\n        var defColValue = isPanLine ? 'text_1' : autoCol;\n        var aggStyleJs = $.toString(function(objId, lineKey, defCol) {\n            var styleKey = 'aggPlaylistCol_' + objId + '_' + lineKey;\n            var collist = ['默认', 'text_1', 'text_2', 'text_3', 'text_4', 'text_5', 'avatar', 'icon_2', 'icon_2_round', 'icon_3_round'];\n            var playlistCol = getItem(styleKey, '');\n            var currentIndex = collist.indexOf(playlistCol);\n            if (currentIndex === -1) currentIndex = 0;\n            var currentName = collist[currentIndex];\n            var titleText = '当前选集样式 [ ' + currentName + ' ]';\n            showSelectOptions({\n                'title': titleText,\n                'options': collist,\n                'selectedIndex': currentIndex,\n                'js': \"var s=input;var defCol='\" + defCol + \"';var sk='\" + styleKey + \"';s==='默认'||!s?setItem(sk,''):setItem(sk,s);var its=findItemsByCls('agg_ep');if(its){for(var i=0;i<its.length;i++){var it=its[i];if(it&&it.extra&&it.extra.id&&it.extra.id!=='agg_ep_header'){var nc=s==='默认'||!s?defCol:s;updateItem(it.extra.id,{col_type:nc});}}}'toast://已切换选集样式:'+s\"\n            });\n            return 'hiker://empty';\n        }, obj.id, activeLine.key, defColValue);\n\n        epItems.push({\n            title: lineLabel,\n            desc: sortOrder === 'desc' ? '↓ 倒序' : '↑ 正序',\n            col_type: 'avatar',\n            pic_url: 'hiker://images/tree4',\n            url: 'hiker://empty',\n            extra: { lineVisible: false, cls: 'agg_ep_header', id: 'agg_ep_header', longClick: [{ title: '🎨 选集样式', js: aggStyleJs }] }\n        });\n\n        var currentProgress = getProgress(obj.id);\n        var playlistCls = 'playlist agg_ep';\n        var needVideoExtra = !(activeLine.type === 'pan' || activeLine.type === 'pan_sub');\n        log('[aggPlaylistDebug] obj.id=' + obj.id + ' line.key=' + activeLine.key + ' line.type=' + activeLine.type + ' epCol=' + epCol + ' pageEps=' + pageEps.length + ' isPanLine=' + isPanLine + ' playlistCls=' + playlistCls);\n        for (var ei = 0; ei < pageEps.length; ei++) {\n            var parts = pageEps[ei].split('$');\n            var epName = parts[0] || '';\n            if (totalEps > 1 && obj.title && epName.indexOf(obj.title) === 0) {\n                var stripped = epName.substring(obj.title.length).replace(/^[\\s\\-_:：·]*/, '');\n                if (stripped) epName = stripped;\n            }\n            var playLink = parts[1] || parts[0] || '';\n            var originalIndex = sortOrder === 'desc' ? (totalEps - 1 - (startIdx + ei)) : (startIdx + ei);\n            if (isPanLine) {\n                var num = originalIndex + 1;\n                epName = (num < 10 ? '0' : '') + num + '. ' + epName;\n            }\n            var isCurrentEp = currentProgress && currentProgress.sourceTitle === activeLine.name && currentProgress.episodeIndex === originalIndex;\n            var displayTitle = isCurrentEp ? '‘‘’’<b><font color=\"#FF5D50\">' + epName + '</font></b>' : epName;\n\n            var epExtra = epExtraFn(activeLine, playLink) || {};\n            epExtra.id = playLink;\n            epExtra.cls = playlistCls;\n            if (needVideoExtra) {\n                epExtra.blockRules = ['.jpg', '.png', '.gif', '.webp', '.jpeg', '.bmp', '.svg', '.ico', '.css', '.woff', '.ttf'];\n                epExtra.cacheM3u8 = true;\n            }\n\n            if (isPanLine) {\n                epItems.push({ title: displayTitle, url: $(playLink).lazyRule(function(eTitle, pData, dId, sTitle, eIdx) {\n                    try {\n                        var data = null;\n                        try { data = JSON.parse(base64Decode(pData)); } catch(e) {}\n                        if (data && data.url) {\n                            return $.require('function').openPanUrlWithContext(data.url, data.type, dId, sTitle, eIdx, eTitle);\n                        } else {\n                            var pt = $.require('function').getPanType(pData);\n                            if (pt) return $.require('function').openPanUrlWithContext(pData, pt.type || pt, dId, sTitle, eIdx, eTitle);\n                            retur