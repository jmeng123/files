\\n                return null;\\n            }\\n        },\\n\\n        getSpider: function(key, api, ext, jar) {\\n            var jaKey = md5(jar || '');\\n            var spKey = jaKey + key;\\n            if (this.spiders.containsKey(spKey)) {\\n                var idx = this.spiderOrder.indexOf(spKey);\\n                if (idx >= 0) this.spiderOrder.splice(idx, 1);\\n                this.spiderOrder.push(spKey);\\n                this.setCurrentSpider(this.spiders.get(spKey), spKey);\\n                return this.spiders.get(spKey);\\n            }\\n            if (!this.loaders.containsKey(jaKey)) this.parseJar(jaKey, jar);\\n            this.setRecent(jaKey);\\n            var loader = this.loaders.get(jaKey);\\n            if (!loader) throw new Error(\\\"jar loader为空，jar文件加载失败\\\");\\n            var apiName = String(api || '').split(\\\"csp_\\\")[1];\\n            if (!apiName) throw new Error(\\\"api格式错误，缺少csp_前缀: \\\" + api);\\n            var spiderClass = loader.loadClass(\\\"com.github.catvod.spider.\\\" + apiName);\\n            var spider = spiderClass.newInstance();\\n            try {\\n                spider.init(getCurrentActivity(), ext);\\n            } catch (initErr) {\\n                var initErrMsg = '';\\n                try { initErrMsg = String(initErr && initErr.message ? initErr.message : initErr); } catch (e2) { initErrMsg = 'NPE'; }\\n                log(\\\"[jarLoad] spider.init失败 key=\\\" + key + \\\" api=\\\" + api + \\\" err=\\\" + initErrMsg);\\n                throw initErr;\\n            }\\n            while (this.spiderOrder.length >= SPIDER_MAX) {\\n                var oldKey = this.spiderOrder.shift();\\n                if (oldKey && this.spiders.containsKey(oldKey)) {\\n                    try { var oldSpider = this.spiders.get(oldKey); if (oldSpider && oldSpider.destroy) oldSpider.destroy(); } catch(e) {}\\n                    this.spiders.remove(oldKey);\\n                }\\n            }\\n            this.spide