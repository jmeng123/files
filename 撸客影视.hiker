               let dividerView = basePopupView.findViewById(R.id.xpopup_divider2);\n                if (dividerView) {\n                    dividerView.setVisibility(8);\n                }\n            }\n        }));\n    }\n    pop = pop.asInputConfirm(getDefaultValue(title, \"string\", null), getDefaultValue(content, \"string\", null), getDefaultValue(defaultValue, \"string\", null), getDefaultValue(hint, \"string\", null), (text) => {\n        tryCallBack(getDefaultValue(confirm, \"function\", null), [text]);\n    }, (text) => {\n        tryCallBack(getDefaultValue(cancel, \"function\", null), [text]);\n    }, maxTextarea ? R.layout.xpopup_confirm_input_max : (textarea ? R.layout.xpopup_confirm_input : 0));\n    showOnUI(pop);\n    return pop;\n}\n\nfunction confirm({\n    title,\n    content,\n    confirm,\n    cancel,\n    okTitle,\n    cancelTitle,\n    hideCancel\n}) {\n    let pop = builderXPopup()\n        .asConfirm(getDefaultValue(title, \"string\", null), getDefaultValue(content, \"string\", \"\"), getDefaultValue(cancelTitle, \"string\", \"取消\"), getDefaultValue(okTitle, \"string\", \"确认\"), () => {\n            tryCallBack(getDefaultValue(confirm, \"function\", null));\n        }, () => {\n            tryCallBack(getDefaultValue(cancel, \"function\", null));\n        }, !!hideCancel);\n    showOnUI(pop);\n    return pop;\n}\n\nfunction SettingItem(...arr) {\n    if (arr.length === 0) return new OfficeItem(\"\");\n    else if (arr.length === 1) return new OfficeItem(String(arr[0]));\n    else if (arr.length === 2 && typeof arr[1] === \"boolean\") return new OfficeItem(String(arr[0]), arr[1] ? 1 : -1);\n    else if (arr.length === 2) return new OfficeItem(String(arr[0]), String(arr[1]));\n    else if (arr.length === 3) return new OfficeItem(String(arr[0]), arr[1] ? 1 : -1, String(arr[2]));\n}\n\nfunction selectBottomSettingMenu({\n    click,\n    options,\n    onDismiss\n}) {\n    let onItemClickListener = new SettingMenuPopup.OnItemClickListener({\n        onClick(str, officeItem, consumer) {\n            tryCallBack(getDefaultValue(click, \"function\", null), [str, officeItem, () => consumer.accept(officeItem)]);\n        }\n    });\n    options = options.filter(v => v instanceof OfficeItem);\n    let arrayList = new ArrayList();\n    options.forEach(v => arrayList.add(v));\n\n    let custom = new SettingMenuPopup(getActivityContext(), \"设置\", arrayList, null, onItemClickListener);\n    let pop = builderXPopup()\n        .moveUpToKeyboard(false)\n        .setPopupCallback(newSimpleCallback({\n            onDismiss() {\n                tryCallBack(onDismiss);\n            }\n        }))\n        .asCustom(custom);\n    showOnUI(pop);\n    return pop;\n}\n\nselectBottomSettingMenu.SettingItem = SettingItem;\n\nfunction newSimpleItemTouchHelperCallback(adapter, options) {\n    return new JavaAdapter(ItemTouchHelper.Callback, {\n        isLongPressDragEnabled() {\n            return options.allowDrag; // 允许长按拖动\n        },\n        isItemViewSwipeEnabled() {\n            return false; // 禁用滑动删除\n        },\n        getMovementFlags(recyclerView, viewHolder) {\n            // 允许上下拖动\n            let dragFlags = options.dragFlags;\n            return this.makeMovementFlags(dragFlags, 0);\n        },\n        onMove(recyclerView, source, target) {\n            adapter.onItemMove(source.getAdapterPosition(), target.getAdapterPosition());\n            return true;\n        },\n        onSwiped(viewHolder, direction) {\n\n        }\n    });\n}\n\nfunction setItemTouchHelper(recyclerView, adapter, options) {\n    let itemTouchHelper = new ItemTouchHelper(newSimpleItemTouchHelperCallback(adapter, options));\n    itemTouchHelper.attachToRecyclerView(recyclerView);\n}\n\nfunction ResExtraInputBox({\n    hint,\n    click,\n    title,\n    onChange,\n    defaultValue,\n    titleVisible\n}) {\n    let search;\n    let edit;\n    this.create = function(parentView, args) {\n        args = Array.isArray(args) ? args : [];\n        let inputItem = android.view.LayoutInflater.from(getActivityContext()).inflate(R.layout.item_input, parentView, false);\n        search = inputItem.findViewById(R.id.search);\n        edit = inputItem.findViewById(R.id.edit);\n        let clearBtn = inputItem.findViewById(R.id.clearBtn);\n        let divider = inputItem.findViewById(R.id.divider);\n        let pop_input_edit_bg = inputItem.findViewById(R.id.pop_input_edit_bg);\n        let search_suggest = inputItem.findViewById(R.id.search_suggest);\n        if (typeof title === \"string\" && title) {\n            search.setText(title);\n        } else {\n            search.setText(\"确定\");\n        }\n        if (typeof titleVisible === \"boolean\" && !titleVisible) {\n            search.setText(\"\");\n            search.setPadding(0, 0, 0, 0);\n            search.setVisibility(4);\n            divider.setVisibility(4);\n        }\n        if (typeof click === \"function\") {\n            search.setOnClickListener(new android.view.View.OnClickListener({\n                onClick() {\n                    tryCallBack(click, [String(edit.getText())].concat(args));\n                }\n            }));\n        }\n\n        if (typeof hint === \"string\" && hint) {\n            edit.setHint(hint);\n        }\n\n        if (typeof onChange === \"function\") {\n            edit.addTextChangedListener(new android.text.TextWatcher({\n                onTextChanged() {},\n                beforeTextChanged() {},\n                afterTextChanged(s) {\n                    let text;\n                    if (s) {\n                        text = String(s.toString());\n                        tryCallBack(onChange, [text].concat(args), true);\n                    }\n                }\n            }));\n        }\n        if (typeof defaultValue === \"string\") {\n            edit.setText(defaultValue);\n            let len = defaultValue.length;\n            edit.setSelection(len, len);\n        }\n        return inputItem;\n    }\n    this.setTitle = (title) => {\n        if (search && typeof title === \"string\") {\n            search.setText(title);\n        }\n    }\n    this.setDefaultValue = (defaultValue) => {\n        if (edit && typeof defaultValue === \"string\") {\n            edit.setText(defaultValue);\n            let len = defaultValue.length;\n            edit.setSelection(len, len);\n        }\n    }\n    this.setHint = (hint) => {\n        if (edit && typeof hint === \"string\" && hint) {\n            edit.setHint(hint);\n        }\n    }\n}\n\nfunction selectBottomResIcon({\n    click,\n    longClick,\n    menuClick,\n    title,\n    iconList,\n    columns,\n    height,\n    noAutoDismiss,\n    extraInputBox,\n    position,\n    toPosition,\n    beforeShow,\n    dragFlags,\n    allowDrag,\n    drag\n}) {\n    let clickListener = new CustomCenterRecyclerViewPopup.ClickListener({\n        onLongClick(value, index) {},\n        click(value, index) {}\n    });\n    iconList = getDefaultValue(iconList, \"array\", []);\n    let booksList = getBookList(iconList);\n    let rv = null,\n        tv = null;\n\n    let scrollToPosition = (pos, isScroll) => {\n        if (typeof pos === \"number\" && rv && pos < booksList.length && pos >= -1) {\n            if (isScroll) {\n                rv.smoothScrollToPosition(pos);\n            } else {\n                rv.scrollToPosition(pos);\n            }\n        }\n    };\n    let setTitle = title => {\n        if (tv) tv.setText(String(title));\n    };\n    let dragOptions = {\n        dragFlags: typeof dragFlags == \"undefined\" ? (ItemTouchHelper.UP | ItemTouchHelper.DOWN | ItemTouchHelper.LEFT | ItemTouchHelper.RIGHT) : dragFlags,\n        allowDrag: !!allowDrag,\n    }\n    let custom = new CustomBottomRecyclerViewPopup(getActivityContext())\n        .withTitle(getDefaultValue(title, \"string\", \"请选择\"))\n        .withHeight(getNumberValue(height, v => v <= 1 && v > 0, 0.75))\n        .dismissWhenClick(!noAutoDismiss)\n        .with([], getDefaultValue(columns, \"number\", 2), clickListener)\n        .withOnCreateCallback((basePopupView) => {\n            try {\n                let recyclerView = basePopupView.findViewById(R.id.recyclerView);\n                tv = custom.findViewById(R.id.title);\n                let linearLayout;\n                if (recyclerView) {\n                    rv = recyclerView;\n                    recyclerView.setAdapter(iconAdapter);\n                    setItemTouchHelper(recyclerView, iconAdapter, dragOptions);\n                    Packages.androidx.core.view.ViewCompat.setBackground(recyclerView, Packages.androidx.core.content.ContextCompat.getDrawable(getActivityContext(), R.drawable.bg_round_all_rice));\n                }\n                if (recyclerView && (linearLayout = recyclerView.getParent()) && extraInputBox instanceof ResExtraInputBox) {\n                    let inputItem = extraInputBox.create(linearLayout, [resOptionsManage]);\n                    let params = inputItem.getLayoutParams();\n                    params.setMargins(35, 0, 35, 0);\n                    inputItem.setLayoutParams(params);\n                    linearLayout.addView(inputItem, 1);\n                }\n                scrollToPosition(toPosition);\n            } catch (e) {\n                log(e.toString());\n            }\n        });\n    let clickOrLongClick = (click) => (v, i) => {\n        let item = booksList.get(i);\n        let items = {\n            icon: String(item.getIcon()),\n            title: String(item.getTitle()),\n            url: String(item.getUrl()),\n        };\n        let func = () => tryCallBack(getDefaultValue(click, \"function\", null), [items, Number(i), resOptionsManage]);\n        if (noAutoDismiss) {\n            func();\n        } else {\n            custom.dismissWith(func);\n        }\n    }\n    //let iconAdapter = new com.example.hikerview.ui.home.view.BookmarkFolderAdapter(getActivityContext(), booksList, clickOrLongClick(click), false);\n\n    let iconAdapter = new JavaAdapter(IconAdapter, {\n        onBindViewHolder(viewHolder, i) {\n            this.super$onBindViewHolder(viewHolder, i);\n\n\n            if (viewHolder instanceof IconAdapter.TitleHolder) {\n                //viewHolder.item_bg.setOnLongClickListener(clickOrLongClick(longClick));\n\n                //log(Object.keys(titleHolder))\n                let item_bg = viewHolder.itemView.findViewById(R.id.item_bg);\n                item_bg && item_bg.setOnLongClickListener((view) => clickOrLongClick(longClick)(view, viewHolder.getAdapterPosition()) || true);\n            }\n        },\n        onItemMove(fromPosition, toPosition) {\n            if (fromPosition == toPosition) return; // 位置相同无需操作\n            let item = booksList.remove(Number(fromPosition));\n            booksList.add(toPosition, item);\n            this.notifyItemMoved(fromPosition, toPosition);\n            tryCallBack(getDefaultValue(drag, \"function\", null), [Number(fromPosition), Number(toPosition), resOptionsManage]);\n        }\n    }, getActivityContext(), booksList, clickOrLongClick(click), false);\n    iconAdapter.setSelectedIndex(getNumberValue(position, v => v < iconList.length && v >= -1, -1));\n    let resOptionsManage = {\n        setTitle: setTitle,\n        scrollToPosition: scrollToPosition,\n        getSize: () => Number(booksList.length),\n        change(list, position) {\n            booksList.length = 0;\n            Object.assign(booksList, getBookList(list));\n            if (position !== void 0) {\n                iconAdapter.setSelectedIndex(getNumberValue(position, v => v < iconList.length && v >= -1, -1));\n            }\n            iconAdapter.notifyDataSetChanged();\n        },\n        setSelectedIndex(position) {\n            iconAdapter.setSelectedIndex(getNumberValue(position, v => v < iconList.length && v >= -1, -1));\n            iconAdapter.notifyDataSetChanged();\n        },\n        removed(pos) {\n            if (pos >= booksList.size()) {\n                throw new Error(\"pos大于列表长度\");\n            }\n            iconAdapter.notifyItemRemoved(pos);\n        },\n        changeColumns: custom.changeSpanCount.bind(custom),\n        setAllowDrag(allowDrag) {\n            dragOptions.allowDrag = !!allowDrag;\n        },\n    }\n    if (typeof menuClick === \"function\") {\n        custom.withMenu(new android.view.View.OnClickListener({\n            onClick() {\n                tryCallBack(getDefaultValue(menuClick, \"function\", null), [resOptionsManage]);\n            }\n        }));\n    }\n    let pop = builderXPopup();\n    pop.setPopupCallback(newSimpleCallback({\n        beforeShow(basePopupView) {\n            scrollToPosition(toPosition);\n            tryCallBack(getDefaultValue(beforeShow, \"function\", null), [pop, resOptionsManage]);\n        }\n    }));\n    pop = pop.moveUpToKeyboard(false).asCustom(custom);\n    showOnUI(pop);\n    return pop;\n}\n\nfunction selectBottomRes({\n    click,\n    longClick,\n    menuClick,\n    title,\n    options,\n    columns,\n    height,\n    noAutoDismiss,\n    extraInputBox,\n    toPosition,\n    beforeShow,\n    onDismiss\n}) {\n    let clickListener = new CustomCenterRecyclerViewPopup.ClickListener({\n        onLongClick(value, index) {\n            tryCallBack(getDefaultValue(longClick, \"function\", null), [value, index, resOptionsManage]);\n        },\n        click(value, index) {\n            tryCallBack(getDefaultValue(click, \"function\", null), [value, index, resOptionsManage]);\n        }\n    });\n    const list = getStringArray(options, []);\n    let rv = null,\n        tv = null;\n    let scrollToPosition = (pos, isScroll) => {\n        if (typeof pos === \"number\" && rv && pos < list.length && pos >= -1) {\n            if (isScroll) {\n                rv.smoothScrollToPosition(pos);\n            } else {\n                rv.scrollToPosition(pos);\n            }\n        }\n    };\n    let setTitle = title => {\n        if (tv) tv.setText(String(title));\n    }\n    let custom = new CustomBottomRecyclerViewPopup(getActivityContext())\n        .withTitle(getDefaultValue(title, \"string\", \"请选择\"))\n        .withHeight(getNumberValue(height, v => v <= 1 && v > 0, 0.75))\n        .dismissWhenClick(!noAutoDismiss)\n        .with(list, getDefaultValue(columns, \"number\", 2), clickListener)\n        .withOnCreateCallback((basePopupView) => {\n            let recyclerView = basePopupView.findViewById(R.id.recyclerView);\n            rv = recyclerView;\n            tv = custom.findViewById(R.id.title);\n            let linearLayout;\n            if (recyclerView && (linearLayout = recyclerView.getParent()) && extraInputBox instanceof ResExtraInputBox) {\n\n                let inputItem = extraInputBox.create(linearLayout, [resOptionsManage]);\n                let params = inputItem.getLayoutParams();\n                params.setMargins(35, 0, 35, 0);\n                inputItem.setLayoutParams(params);\n                linearLayout.addView(inputItem, 1);\n            }\n        });\n    let resOptionsManage = {\n        list: list,\n        setTitle: setTitle,\n        scrollToPosition: scrollToPosition,\n        change() {\n            checkStringArray(list);\n            custom.notifyDataChange();\n        },\n        removed(pos) {\n            checkStringArray(list);\n            if (pos >= list.length) {\n                throw new Error(\"pos大于列表长度\");\n            }\n            custom.notifyDataRemoved(pos);\n        },\n        changeColumns: custom.changeSpanCount.bind(custom)\n    }\n    if (typeof menuClick === \"function\") {\n        custom.withMenu(new android.view.View.OnClickListener({\n            onClick() {\n                tryCallBack(getDefaultValue(menuClick, \"function\", null), [resOptionsManage]);\n            }\n        }));\n    }\n    let pop = builderXPopup();\n    pop.setPopupCallback(newSimpleCallback({\n        beforeShow(basePopupView) {\n            scrollToPosition(toPosition);\n            tryCallBack(getDefaultValue(beforeShow, \"function\", null), [pop, resOptionsManage]);\n        },\n        onDismiss(basePopupView) {\n            tryCallBack(getDefaultValue(onDismiss, \"function\", null), []);\n        }\n    }));\n    pop = pop.moveUpToKeyboard(false).asCustom(custom);\n    showOnUI(pop);\n    return pop;\n}\n\nfunction infoBottom({\n    title,\n    options,\n    click,\n    longClick\n}) {\n    let clickListener = new com.example.hikerview.ui.setting.file.FileDetailAdapter.OnClickListener({\n        click(value) {\n            tryCallBack(getDefaultValue(click, \"function\", null), [value]);\n        },\n        longClick(view, value) {\n            tryCallBack(getDefaultValue(longClick, \"function\", null), [value]);\n        }\n    });\n\n    let custom = new FileDetailPopup(\n            getActivityContext(),\n            getDefaultValue(title, \"string\", null),\n            getStringArray(options, [])\n        )\n        .withClickListener(clickListener);\n    let pop = builderXPopup()\n        .moveUpToKeyboard(false)\n        .asCustom(custom);\n    showOnUI(pop);\n    return pop;\n}\n\nfunction copyBottom(title, content) {\n    if (cannotTouchUI) return null;\n    let custom = new CustomCopyPopup(getActivityContext())\n        .with(\n            getDefaultValue(title, \"string\", null),\n            getDefaultValue(content, \"string\", \"\"),\n        );\n    let pop = builderXPopup()\n        .moveUpToKeyboard(false)\n        .asCustom(custom);\n    showOnUI(pop);\n    return pop;\n}\n\nfunction selectCenterColor(colors, callBack) {\n    if (typeof colors === \"function\") {\n        callBack = colors;\n    }\n    colors = getStringArray(colors, []);\n    let custom = new CustomColorPopup(getActivityContext());\n    custom.setColorSelect(new CustomColorPopup.OnColorSelect({\n        select(value) {\n            tryCallBack(getDefaultValue(callBack, \"function\", null), [value]);\n        }\n    }));\n    let pop = builderXPopup()\n        .setPopupCallback(newSimpleCallback({\n            onCreated(basePopupView) {\n                const count = colors.length > 8 ? 8 : colors.length;\n                for (let i = 0; i < count; i++) {\n                    if (colors[i]) {\n                        let color = android.graphics.Color.parseColor(colors[i]);\n                        let relativeLayout = basePopupView.findViewById(R.id[\"color\" + (i + 1) + \"_bg\"]);\n                        relativeLayout.setTag(colors[i]);\n                        relativeLayout.getChildAt(0).setCardBackgroundColor(color);\n                        relativeLayout.getChildAt(1).setTextColor(color);\n                    }\n                }\n            }\n        }))\n        .asCustom(custom);\n    showOnUI(pop);\n    return pop;\n}\n\nfunction chefSnackbarMake({\n    content,\n    duration,\n    confirm,\n    cancel,\n    okTitle,\n    cancelTitle\n}) {\n    let decorView = getContext().getWindow().getDecorView();\n    ChefSnackbar.Companion.make(decorView)\n        .setText(getDefaultValue(content, \"string\", \"\"))\n        .setDuration(getDefaultValue(okTitle, \"number\", 0))\n        .setAction(getDefaultValue(okTitle, \"string\", \"确认\"), function() {\n            tryCallBack(getDefaultValue(confirm, \"function\", null));\n        })\n        .setCancelButton(getDefaultValue(cancelTitle, \"string\", \"取消\"), function() {\n            tryCallBack(getDefaultValue(cancel, \"function\", null));\n        })\n        .show();\n}\n\nfunction toastMeg(text, type) {\n    switch (type) {\n        case toastMeg.LC:\n            ToastMgr.longCenter(getContext(), String(text));\n            break;\n        case toastMeg.SC:\n            ToastMgr.shortCenter(getContext(), String(text));\n            break;\n        case toastMeg.LB:\n            ToastMgr.longBottomCenter(getContext(), String(text));\n            break;\n        case toastMeg.SC:\n        default:\n            ToastMgr.shortBottomCenter(getContext(), String(text));\n            break;\n    }\n}\ntoastMeg.LC = 1;\ntoastMeg.SC = 2;\ntoastMeg.LB = 3;\ntoastMeg.SB = 4;\n\nfunction getClipTopData() {\n    try {\n        const Context = android.content.Context;\n        const context = getContext();\n        let clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE);\n        let clipData = clipboard.getPrimaryClip();\n        if (clipData != null && clipData.getItemCount() > 0) {\n            let text = clipData.getItemAt(0).getText();\n            if (text != null) {\n                return String(text.toString());\n            }\n        }\n        return \"\";\n    } catch (e) {\n        log(e.toString());\n        return \"\";\n    }\n}\n\nfunction confirmSync({\n    title,\n    content,\n    okTitle,\n    cancelTitle,\n    hideCancel,\n    noDismissOnBack,\n    noDismissOnBlank\n}) {\n    let countDownLatch = new java.util.concurrent.CountDownLatch(1);\n    let result = false;\n    showOnUI(\n        builderXPopup()\n        .dismissOnTouchOutside(!noDismissOnBlank)\n        .dismissOnBackPressed(!noDismissOnBack)\n        .setPopupCallback(newSimpleCallback({\n            onDismiss(basePopupView) {\n                countDownLatch.countDown();\n            }\n        }))\n        .asConfirm(getDefaultValue(title, \"string\", null), getDefaultValue(content, \"string\", \"\"), getDefaultValue(cancelTitle, \"string\", \"取消\"), getDefaultValue(okTitle, \"string\", \"确认\"), () => {\n            result = true;\n        }, () => {\n            result = false;\n        }, !!hideCancel)\n    );\n    countDownLatch.await();\n    return result;\n}\n\nfunction inputConfirmSync({\n    title,\n    content,\n    defaultValue,\n    hint,\n    textarea,\n    maxTextarea,\n    hideCancel,\n    noAutoSoft,\n    noDismissOnBack,\n    noDismissOnBlank\n}) {\n    let countDownLatch = new java.util.concurrent.CountDownLatch(1);\n    let result = \"\";\n    showOnUI(\n        builderXPopup()\n        .autoOpenSoftInput(!noAutoSoft)\n        .autoFocusEditText(!noAutoSoft)\n        .dismissOnTouchOutside(!noDismissOnBlank)\n        .dismissOnBackPressed(!noDismissOnBack)\n        .setPopupCallback(newSimpleCallback({\n            onCreated(basePopupView) {\n                if (hideCancel) {\n                    let cancelTextView = basePopupView.findViewById(R.id.tv_cancel);\n                    if (cancelTextView) {\n                        cancelTextView.setVisibility(8);\n                    }\n                    let dividerView = basePopupView.findViewById(R.id.xpopup_divider2);\n                    if (dividerView) {\n                        dividerView.setVisibility(8);\n                    }\n                }\n            },\n            onDismiss(basePopupView) {\n                countDownLatch.countDown();\n            }\n        }))\n        .asInputConfirm(getDefaultValue(title, \"string\", null), getDefaultValue(content, \"string\", null), getDefaultValue(defaultValue, \"string\", null), getDefaultValue(hint, \"string\", null), (text) => {\n            result = text;\n        }, null, maxTextarea ? R.layout.xpopup_confirm_input_max : (textarea ? R.layout.xpopup_confirm_input : 0))\n    );\n    countDownLatch.await();\n    return result;\n}\n\nfunction dialogShowOnUI(dialogBuilder, callBack) {\n    runOnUI(() => {\n        let dialog = dialogBuilder.create();\n        DialogUtil.INSTANCE.showAsCard(getActivityContext(), dialog);\n        if (callBack) {\n            callBack(dialog);\n        }\n\n    });\n}\n\nfunction setAlertDialogButton({\n    rightTitle,\n    rightClick,\n    leftTitle,\n    leftClick,\n    centerTitle,\n    centerClick\n}, dialogBuilder, getParam) {\n    if (rightTitle || rightClick) {\n        rightClick = getDefaultValue(rightClick, \"function\", null);\n        dialogBuilder.setPositiveButton(getDefaultValue(rightTitle, \"string\", \"确认\"), (dialog) => {\n            tryCallBack(rightClick, getParam(dialog));\n        });\n    }\n    if (leftTitle || leftClick) {\n        leftClick = getDefaultValue(leftClick, \"function\", null);\n        dialogBuilder.setNeutralButton(getDefaultValue(leftTitle, \"string\", \"忽略\"), (dialog) => {\n            tryCallBack(leftClick, getParam(dialog));\n        });\n    }\n    if (centerTitle || centerClick) {\n        centerClick = getDefaultValue(centerClick, \"function\", null);\n        dialogBuilder.setNegativeButton(getDefaultValue(centerTitle, \"string\", \"取消\"), (dialog) => {\n            tryCallBack(centerClick, getParam(dialog));\n        });\n    }\n}\n\nfunction setAlertDialogButtonTitle({\n    rightTitle,\n    rightClick,\n    leftTitle,\n    leftClick,\n    centerTitle,\n    centerClick\n}, dialogBuilder) {\n    if (rightTitle || rightClick) {\n        dialogBuilder.setPositiveButton(getDefaultValue(rightTitle, \"string\", \"确认\"), null);\n    }\n    if (leftTitle || leftClick) {\n        dialogBuilder.setNeutralButton(getDefaultValue(leftTitle, \"string\", \"忽略\"), null);\n    }\n    if (centerTitle || centerClick) {\n        dialogBuilder.setNegativeButton(getDefaultValue(centerTitle, \"string\", \"取消\"), null);\n    }\n}\n\nfunction setAlertDialogButtonFunc({\n    rightTitle,\n    rightClick,\n    leftTitle,\n    leftClick,\n    centerTitle,\n    centerClick\n}, dialog, getParam) {\n    const DialogInterface = android.content.DialogInterface;\n    if (rightTitle || rightClick) {\n        rightClick = getDefaultValue(rightClick, \"function\", null);\n        dialog.getButton(DialogInterface.BUTTON_POSITIVE).setOnClickListener(() => {\n            tryCallBack(rightClick, getParam(dialog));\n        });\n    }\n    if (leftTitle || leftClick) {\n        leftClick = getDefaultValue(leftClick, \"function\", null);\n        dialog.getButton(DialogInterface.BUTTON_NEUTRAL).setOnClickListener(() => {\n            tryCallBack(leftClick, getParam(dialog));\n        });\n    }\n    if (centerTitle || centerClick) {\n        centerClick = getDefaultValue(centerClick, \"function\", null);\n        dialog.getButton(DialogInterface.BUTTON_NEGATIVE).setOnClickListener(() => {\n            tryCallBack(centerClick, getParam(dialog));\n        });\n    }\n}\n\nfunction multiChoice({\n    title,\n    options,\n    checkedIndexs,\n    noAutoDismiss,\n    onChoice,\n}) {\n    options = getStringArray(options, []);\n    checkedIndexs = getDefaultValue(checkedIndexs, \"array\", []);\n    let checkedItems = new Array(options.length).fill(false);\n    checkedIndexs.forEach(i => checkedItems[i] = true);\n    checkedItems.length = options.length;\n    onChoice = getDefaultValue(onChoice, \"function\", null);\n    let setItemChecked = (dialog, newcheckedIndexs) => {\n        if (!Array.isArray(newcheckedIndexs)) return;\n\n        checkedItems.fill(false);\n        newcheckedIndexs.forEach(i => checkedItems[i] = true);\n\n        let listView = dialog.getListView();\n\n        for (let i = 0; i < options.length; i++) {\n            listView.setItemChecked(i, checkedItems[i]);\n        }\n        listView.getAdapter().notifyDataSetChanged();\n    };\n    let dialogBuilder = new AlertDialog.Builder(getActivityContext())\n        .setTitle(getDefaultValue(title, \"string\", null))\n        .setMultiChoiceItems(options, checkedItems, (v, i, b) => {\n            checkedItems[i] = b;\n            tryCallBack(onChoice, [i, b]);\n        });\n\n    if (noAutoDismiss) {\n        setAlertDialogButtonTitle(arguments[0], dialogBuilder);\n        dialogShowOnUI(dialogBuilder, (dialog) => {\n            setAlertDialogButtonFunc(arguments[0], dialog, () => [options, checkedItems, setItemChecked.bind(null, dialog), dialog.dismiss.bind(dialog)]);\n        });\n    } else {\n        setAlertDialogButton(arguments[0], dialogBuilder, () => [options, checkedItems]);\n        dialogShowOnUI(dialogBuilder);\n    }\n}\n\nfunction getSeekAndLayout(max, pos, onChange) {\n    const Bundle = android.os.Bundle;\n    const LinearLayout = android.widget.LinearLayout;\n    const SeekBar = android.widget.SeekBar;\n    const TextView = android.widget.TextView;\n    const Gravity = android.view.Gravity;\n    const View = android.view.View;\n    const LayoutParams = android.view.ViewGroup.LayoutParams;\n    const RelativeLayout = android.widget.RelativeLayout;\n    const ImageView = android.widget.ImageView;\n    const Spanned = android.text.Spanned;\n    const Html = android.text.Html;\n    let linearLayout = new LinearLayout(getActivityContext());\n    linearLayout.setOrientation(LinearLayout.VERTICAL);\n    linearLayout.setLayoutParams(new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));\n    linearLayout.setPadding(65, 50, 60, 50);\n\n    let titleStart = new TextView(getActivityContext());\n    titleStart.setId(View.generateViewId());\n    titleStart.setLayoutParams(new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT));\n    titleStart.setTextSize(17);\n    titleStart.setPadding(0, 0, 0, 20);\n    let initText = tryCallBack(onChange, [pos, max, Html.fromHtml], true);\n    if (typeof initText === \"string\" || initText instanceof Spanned) {\n        titleStart.setText(initText);\n    }\n    let relativeLayout = new RelativeLayout(getActivityContext());\n    relativeLayout.setLayoutParams(new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));\n\n    let startImgStart = new ImageView(getActivityContext());\n    startImgStart.setId(View.generateViewId());\n    startImgStart.setLayoutParams(new LayoutParams(32, 32));\n    startImgStart.setPadding(4, 4, 4, 4);\n    startImgStart.setImageResource(R.drawable.ic_arrow_start);\n\n    let startImgEnd = new ImageView(getActivityContext());\n    startImgEnd.setId(View.generateViewId());\n    startImgEnd.setLayoutParams(new LayoutParams(32, 32));\n    startImgEnd.setPadding(4, 4, 4, 4);\n    startImgEnd.setImageResource(R.drawable.ic_arrow_end);\n\n    let seekBar = new SeekBar(getActivityContext());\n    seekBar.setLayoutParams(new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));\n    seekBar.setMax(max);\n    seekBar.setProgress(pos);\n\n    linearLayout.addView(titleStart);\n    linearLayout.addView(relativeLayout);\n\n    let layoutParams = new RelativeLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT);\n    layoutParams.addRule(RelativeLayout.CENTER_VERTICAL, RelativeLayout.TRUE);\n    startImgStart.setLayoutParams(layoutParams);\n    relativeLayout.addView(startImgStart);\n\n    layoutParams = new RelativeLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT);\n    layoutParams.addRule(RelativeLayout.ALIGN_PARENT_END, RelativeLayout.TRUE);\n    layoutParams.addRule(RelativeLayout.CENTER_VERTICAL, RelativeLayout.TRUE);\n    startImgEnd.setLayoutParams(layoutParams);\n    relativeLayout.addView(startImgEnd);\n\n    layoutParams = new RelativeLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);\n    layoutParams.addRule(RelativeLayout.END_OF, startImgStart.getId());\n    layoutParams.addRule(RelativeLayout.START_OF, startImgEnd.getId());\n    layoutParams.addRule(RelativeLayout.CENTER_VERTICAL, RelativeLayout.TRUE);\n    seekBar.setLayoutParams(layoutParams);\n    relativeLayout.addView(seekBar);\n\n    startImgStart.setOnClickListener(() => {\n        let progress = seekBar.getProgress();\n        if (progress <= 0 || progress > max) {\n            return;\n        }\n        seekBar.setProgress(progress - 1);\n    });\n    startImgEnd.setOnClickListener(() => {\n        let progress = seekBar.getProgress();\n        if (progress < 0 || progress >= max) {\n            return;\n        }\n        seekBar.setProgress(progress + 1);\n    });\n    seekBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener({\n        onProgressChanged(seekBar, progress, fromUser) {\n            let res = tryCallBack(onChange, [progress, max, Html.fromHtml], true);\n            if (typeof res === \"string\" || initText instanceof Spanned) {\n                titleStart.setText(res);\n            }\n        },\n        onStartTrackingTouch(seekBar) {},\n        onStopTrackingTouch(seekBar) {}\n    }));\n    return [seekBar, linearLayout];\n}\n\nfunction seekCenter({\n    title,\n    max,\n    pos,\n    onChange,\n}) {\n    max = parseInt(max), pos = parseInt(pos) || 0;\n    if (!max || max < pos || pos < 0) {\n        throw Error(\"max和pos必须为整数，且max>0,max>=pos>=0\");\n    }\n    let builder = new AlertDialog.Builder(getActivityContext());\n    builder.setTitle(getDefaultValue(title, \"string\", null));\n    let [seekBar, linearLayout] = getSeekAndLayout(max, pos, onChange);\n    setAlertDialogButton(arguments[0], builder, () => [Number(seekBar.getProgress()), max]);\n    builder.setView(linearLayout);\n    dialogShowOnUI(builder);\n}\n\nfunction canBiometric() {\n    return Number(BiometricManager.from(getActivityContext()).canAuthenticate())\n}\n\nfunction checkByBiometric(success) {\n    if (typeof success !== \"function\") return;\n    let can = canBiometric();\n    if (can !== 0) return can;\n    runOnUI(() => {\n        com.example.hikerview.ui.setting.office.MoreSettingOfficer.INSTANCE.checkByBiometric(getActivityContext(), () => {\n            tryCallBack(success, [], true);\n        });\n    });\n}\n\n\nfunction decodeQRCode(path) {\n    let result = null;\n    try {\n        let bitmap = android.graphics.BitmapFactory.decodeFile(path);\n        if (bitmap == null) return result;\n        let hints = new java.util.Hashtable();\n        let width = bitmap.getWidth();\n        let height = bitmap.getHeight();\n        let pixels = java.lang.reflect.Array.newInstance(java.lang.Class.forName(\"java.lang.Integer\"), width * height);\n        pixels = java.util.Arrays.stream(pixels).mapToInt(v => 0).toArray();\n        bitmap.getPixels(pixels, 0, width, 0, 0, width, height);\n        let source = new com.google.zxing.RGBLuminanceSource(width, height, pixels);\n        let binaryBitmap = new com.google.zxing.BinaryBitmap(new com.google.zxing.common.HybridBinarizer(source));\n        let decodedResult = new com.google.zxing.MultiFormatReader().decode(binaryBitmap, hints);\n        result = String(decodedResult.getText());\n    } catch (e) {}\n    return result;\n}\n\nfunction getDanmakuContext() {\n    let activityContext = getContext();\n    if (activityContext instanceof com.example.hikerview.ui.video.VideoPlayerActivity) {\n        let videoPlayerActivityClass = activityContext.getClass();\n        let videoPlayerViewField = videoPlayerActivityClass.getDeclaredField(\"videoPlayerView\");\n        videoPlayerViewField.setAccessible(true);\n        let videoPlayerView = videoPlayerViewField.get(activityContext);\n        let baseViewClass = videoPlayerView.getClass().getSuperclass();\n        let danmakuContextField = baseViewClass.getDeclaredField(\"danmakuContext\");\n        danmakuContextField.setAccessible(true);\n        let danmakuContext = danmakuContextField.get(videoPlayerView);\n\n        let danmakuViewField = baseViewClass.getDeclaredField(\"danmakuView\");\n        danmakuViewField.setAccessible(true);\n        let danmakuView = danmakuViewField.get(videoPlayerView);\n\n        let playField = videoPlayerActivityClass.getDeclaredField(\"player\");\n        playField.setAccessible(true);\n        let play = playField.get(activityContext);\n        return [danmakuContext, danmakuView, play];\n    }\n    return [null, null, null];\n\n}\n\nfunction sendDanmaku(danmu) {\n    let [danmakuContext, danmakuView, play] = getDanmakuContext();\n\n    if (danmakuView != null && danmakuContext != null) {\n        let newDanmu = danmakuContext.mDanmakuFactory.createDanmaku(danmu.type || 1, danmakuContext);\n        newDanmu.text = danmu.text;\n        newDanmu.textSize = danmu.size || 50;\n        newDanmu.textColor = danmu.color || 16777215;\n        //newDanmu.borderColor = 16777215; //边框貌似不生效\n        runOnUI(() => {\n            newDanmu.setTime(danmu.time || (play.getCurrentPosition() + 100));\n            danmakuView.addDanmaku(newDanmu);\n\n        });\n        return true;\n    } else {\n        return false\n    }\n}\n\nfunction scrollToPageTop() {\n    EventBus.getDefault().post(new com.example.hikerview.event.OnTopEvent());\n    return true;\n}\n\nfunction smoothScrollWithSpeed(context, recyclerView, position, speedMsPerPx) {\n    let manager = recyclerView.getLayoutManager();\n    if (manager == null) return;\n    speedMsPerPx = Number(speedMsPerPx);\n    speedMsPerPx = Number.isNaN(speedMsPerPx) ? 25 : speedMsPerPx;\n    let scroller = new JavaAdapter(Packages.androidx.recyclerview.widget.LinearSmoothScroller, {\n        calculateSpeedPerPixel(displayMetrics) {\n            return speedMsPerPx / displayMetrics.densityDpi;\n        }\n    }, context);\n    scroller.setTargetPosition(position);\n    manager.startSmoothScroll(scroller);\n}\n\nfunction scrollSmooth(idOrPos, isScroll, speedMsPerPx) {\n\n    if (!(typeof idOrPos == \"string\" || typeof idOrPos == \"number\")) return false;\n\n    let context = getActivityContext();\n    let recyclerView = getRulesRecyclerView();\n    if (recyclerView == null) return false;\n    if (typeof idOrPos === \"string\") {\n        let list = recyclerView.getAdapter().getList();\n        let i = 0;\n        let ii = -1\n        for (let it of list) {\n            if (idOrPos == it.getBaseExtra().getId()) {\n                ii = i;\n                break;\n            }\n            i++;\n        }\n        if (ii < 0) return false;\n        let gridManager = recyclerView.getLayoutManager();\n\n        if (gridManager instanceof GridLayoutManager) {\n            //let fvPos = gridManager.findFirstVisibleItemPosition();\n            let lvPos = gridManager.findLastVisibleItemPosition();\n\n            idOrPos = ii > lvPos ? ii + 1 : ii;\n\n        }\n    }\n    if (idOrPos < 0) {\n        idOrPos = Math.max(recyclerView.getAdapter().getItemCount() + idOrPos, 0);\n    }\n    idOrPos = Math.min(recyclerView.getAdapter().getItemCount() - 1, idOrPos);\n    if (isScroll) {\n        if (typeof speedMsPerPx === \"number\") {\n            smoothScrollWithSpeed(context, recyclerView, idOrPos, speedMsPerPx);\n        } else {\n            recyclerView.smoothScrollToPosition(idOrPos);\n        }\n    } else {\n        recyclerView.scrollToPosition(idOrPos);\n    }\n    return true;\n}\n\n\n\nfunction getCurrentPlayPosition() {\n    let [danmakuContext, danmakuView, play] = getDanmakuContext();\n    if (play != null) {\n        return Number(play.getCurrentPosition());\n    }\n    return null;\n}\n/**\n * 显示 RhinoUI 生成的布局弹窗\n * @param {Object} uiObj RhinoUI.render() 返回的对象 或 View 对象\n * @param {Object} options 配置项\n */\nfunction showRhinoUI(uiObj, options) {\n    options = options || {};\n    let type = options.type || \"center\";\n\n    // 1. 获取 View\n    let targetView = null;\n    if (uiObj && uiObj.view && typeof uiObj.view.raw === \"function\") {\n        targetView = uiObj.view.raw();\n    } else if (uiObj instanceof android.view.View) {\n        targetView = uiObj;\n    } else {\n        throw new Error(\"showRhinoUI: 参数必须是 RhinoUI 对象或 Android View\");\n    }\n\n    // 2. 构建 Builder\n    let builder = builderXPopup();\n\n    // === 基础配置 (Boolean) ===\n    const boolConfigs = [\n        \"hasShadowBg\", \"hasBlurBg\", \"isDestroyOnDismiss\", \"dismissOnBackPressed\",\n        \"dismissOnTouchOutside\", \"isClickThrough\", \"isTouchThrough\",\n        \"autoFocusEditText\", \"autoOpenSoftInput\", \"moveUpToKeyboard\",\n        \"hasStatusBarShadow\", \"positionByWindowCenter\", \"isLightStatusBar\",\n        \"hasStatusBar\", \"hasNavigationBar\", \"keepScreenOn\", \"isCenterHorizontal\",\n        \"isRequestFocus\", \"enableShowWhenAppBackground\", \"enableDrag\",\n        \"isThreeDrag\", \"isDarkTheme\", \"autoDismiss\", \"isViewMode\"\n    ];\n    boolConfigs.forEach(key => {\n        if (options[key] !== void 0) builder[key](!!options[key]);\n    });\n\n    // === 数值与样式配置 ===\n    if (options.shadowBgColor !== void 0) builder.shadowBgColor(options.shadowBgColor);\n    if (options.animationDuration !== void 0) builder.animationDuration(options.animationDuration);\n    if (options.borderRadius !== void 0) builder.borderRadius(dpToPx(options.borderRadius));\n    \n    // 偏移与尺寸 (自动转px)\n    if (options.offsetX !== void 0) builder.offsetX(dpToPx(options.offsetX));\n    if (options.offsetY !== void 0) builder.offsetY(dpToPx(options.offsetY));\n    if (options.maxWidth !== void 0) builder.maxWidth(dpToPx(options.maxWidth));\n    if (options.maxHeight !== void 0) builder.maxHeight(dpToPx(options.maxHeight));\n    if (options.popupWidth !== void 0) builder.popupWidth(dpToPx(options.popupWidth));\n    if (options.popupHeight !== void 0) builder.popupHeight(dpToPx(options.popupHeight));\n\n    // 动画枚举映射\n    if (options.popupAnimation) {\n        if (typeof options.popupAnimation === \"string\") {\n            try {\n                builder.popupAnimation(com.lxj.xpopup.enums.PopupAnimation[options.popupAnimation]);\n            } catch (e) {}\n        } else {\n            builder.popupAnimation(options.popupAnimation);\n        }\n    }\n    \n    // 依附点 (Attach类型用)\n    if (options.atView) builder.atView(options.atView);\n\n    // === 3. 完整的生命周期回调绑定 ===\n    // 将 options 中的函数提取出来传给 newSimpleCallback\n    builder.setPopupCallback(newSimpleCallback({\n        onCreated: options.onCreated,\n        beforeShow: options.beforeShow,\n        onShow: options.onShow,\n        beforeDismiss: options.beforeDismiss,\n        onDismiss: options.onDismiss,\n        onBackPressed: options.onBackPressed,\n        onKeyBoardStateChanged: options.onKeyBoardStateChanged,\n        onDrag: options.onDrag,\n        onClickOutside: options.onClickOutside\n    }));\n\n    // === 4. Adapter 实现 ===\n    let CustomPopup;\n    if (type === \"bottom\") {\n        CustomPopup = JavaAdapter(com.lxj.xpopup.core.BottomPopupView, {\n            getImplLayoutId: () => 0,\n            addInnerContent: function() {\n                let container = this.getChildAt(0); \n                if (targetView.getParent() != null) targetView.getParent().removeView(targetView);\n                \n                let w = options.width ? dpToPx(options.width) : -1; \n                let h = options.height ? dpToPx(options.height) : -2; \n                let lp = new android.widget.FrameLayout.LayoutParams(w, h);\n                lp.gravity = 81; // Bottom | CenterHorizontal\n                container.addView(targetView, lp);\n            },\n            getMaxHeight: function() {\n                return options.maxHeight ? dpToPx(options.maxHeight) : this.super$getMaxHeight();\n            }\n        }, getActivityContext());\n    } else {\n        CustomPopup = JavaAdapter(com.lxj.xpopup.core.CenterPopupView, {\n            getImplLayoutId: () => android.R.layout.simple_list_item_1, \n            onCreate: function() {\n                this.super$onCreate();\n                this.removeAllViews();\n                if (targetView.getParent() != null) targetView.getParent().removeView(targetView);\n                \n                let w = options.width ? dpToPx(options.width) : -2;\n                let h = options.height ? dpToPx(options.height) : -2;\n                let lp = new android.widget.FrameLayout.LayoutParams(w, h);\n                lp.gravity = 17; // Center\n                this.addView(targetView, lp);\n            },\n            getMaxWidth: function() {\n                 return options.maxWidth ? dpToPx(options.maxWidth) : this.super$getMaxWidth();\n            }\n        }, getActivityContext());\n    }\n\n    let popup = builder.asCustom(CustomPopup);\n    showOnUI(popup);\n    return popup;\n}\n\nlet popf = {\n    confirm,\n    inputAutoRow,\n    inputConfirm,\n    selectCenter,\n    selectCenterMark,\n    selectBottom,\n    selectBottomMark,\n    selectCenterIcon,\n    inputTwoRow,\n    selectBottomSettingMenu,\n    selectBottomRes,\n    infoBottom,\n    copyBottom,\n    selectCenterColor,\n    confirmSync,\n    inputConfirmSync,\n    chefSnackbarMake,\n    toastMeg,\n    multiChoice,\n    seekCenter,\n    checkByBiometric,\n    selectAttachList,\n    selectBottomResIcon,\n    updateRecordsBottom,\n    FlexMenuBottom\n};\nlet forcetHrottle = [\"hikerPop_FlexMenuBottom\"];\n\nfunction throttle(func, key) {\n    let funcc = function(...args) {\n        let time = throttleTime;\n        if (time == 0 && forcetHrottle.includes(key)) {\n            time = 200;\n        }\n        if (time > 0 && !canTouchUI(key, time)) return (throttleTime = 0);\n        return func.apply(null, args);\n    }\n    return Object.assign(funcc, func);\n}\nfor (let funcName in popf) {\n    popf[funcName] = throttle(popf[funcName], \"hikerPop_\" + funcName);\n}\n\n$.exports = {\n    IconExtraMenu,\n    isDarkMode,\n    ResExtraInputBox,\n    icon: R.drawable,\n    playVideos,\n    getClipTopData,\n    setUseStartActivity,\n    runOnNewThread,\n    runOnUIThread: runOnUI,\n    canBiometric,\n    decodeQRCode,\n    simpleRoute,\n    test,\n    setNextThrottle,\n    sendDanmaku,\n    getCurrentPlayPosition,\n    scrollToPageTop,\n    scrollSmooth,\n    DragFlags: ItemTouchHelper,\n    showTooltip,\n    showRhinoUI\n};\nObject.assign($.exports, popf);\n"},{"col_type":"movie_3","name":"轮播图","path":"轮播图","rule":"// ============================\n// 轮播图模块（独立）\n// ============================\n\nfunction banner(blist, time, id) {\n    var result = [];\n    if (!blist || blist.length === 0) return result;\n    var i = Math.floor(Math.random() * blist.length);\n    result.push({\n        img: blist[i],\n        desc: '0',\n        url: 'hiker://empty#noHistory##noRecordHistory#' + '@rule=js:eval(fetch(\"hiker://assets/home.js\",{}));HikerHome.load(\"setuppage\")',\n        col_type: 'card_pic_1',\n        extra: {\n            id: id,\n            longClick: [\n                {\n                    title: '轮播:' + '‘’' + (getItem('轮播', '1') == '1' ? '开' : '关') + '‘’',\n                    js: $.toString(function() {\n                        setItem('轮播', getItem('轮播', '1') == '1' ? '0' : '1');\n                        refreshPage();\n                        toast('轮播已' + (getItem('轮播', '1') == '1' ? '打开' : '停止'));\n                    })\n                },\n                {\n                    title: '网图',\n                    js: $.toString(function() {\n                        var imgUrls = ['本地图片@@/storage/emulated/0/Pictures/', '黑丝图片@@https://v2.xxapi.cn/api/heisi?return=302', '白丝图片@@https://v2.api-m.com/api/baisi?return=302', '淘宝买家秀@@https://api.uomg.com/api/rand.img3', '樱花二次元图片@@https://www.dmoe.cc/random.php', '彼岸桌面@@http://www.netbian.com/index_2.htm', '二次元随机图片-PC@@https://t.mwm.moe/pc', '二次元随机图片-风景@@https://t.mwm.moe/fj', '二次元随机图片-萌版@@https://t.mwm.moe/moe', '二次元随机图片-原神@@https://t.mwm.moe/ys', '东方Project@@https://img.paulzzh.tech/touhou/random', '98情缘API@@http://www.98qy.com/sjbz/api.php', '超级小兔的随机图@@https://imgapi.xl0408.top/index.php', '三次元COS随机图片@@https://api.vvhan.com/api/girl', '原神随机图@@https://api.dujin.org/pic/yuanshen/', 'unsplash随机图片@@https://source.unsplash.com/random', '樱道动漫综合1@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合1', '樱道动漫综合2@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合2', '樱道动漫综合3@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合3', '樱道动漫综合4@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合4', '樱道动漫综合5@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合5', '樱道动漫综合6@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合6', '樱道动漫综合7@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合7', '樱道动漫综合8@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合8', '樱道动漫综合9@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合9', '樱道动漫综合10@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合10', '樱道动漫综合11@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合11', '樱道动漫综合12@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合12', '樱道动漫综合13@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合13', '樱道动漫综合14@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合14', '樱道动漫综合15@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合15', '樱道动漫综合16@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合16', '樱道动漫综合17@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合17', '樱道动漫综合18@@https://api.r10086.com/樱道随机图片api接口.php?图片系列=动漫综合18', '惜染图库美女图片@@https://hefollo.com/URL/电脑端美女图片链接.txt', '惜染图库风景图片@@https://hefollo.com/URL/电脑端风景图片链接.txt', '惜染图库动漫PC图片@@https://hefollo.com/URL/动漫PC图片链接.txt', '惜染图库谷歌4K图片@@https://hefollo.com/URL/4K图片链接.txt', '壁纸湖@@https://bizihu.com/AIMN.html'];\n                        return $(imgUrls.map(function(h) { return h == getItem('id') ? '‘‘’’<span style=\"color:red\" title=\"' + h + '\">' + h + '</span>' : h; }), 1, '选择图片网址').select(function() {\n                            setItem('img', input.split('@@')[1]);\n                            setItem('id', input);\n                            refreshPage();\n                            toast('图片已更换');\n                        });\n                    })\n                },\n                {\n                    title: '本地',\n                    js: $.toString(function() {\n                        return $('hiker://empty').rule(function() {\n                            var fileSelect = $.require(\"http://hiker.nokia.press/hikerule/rulelist.json?id=5099\");\n                            fileSelect.fileSelection({\n                                callback: $.toString(function() {\n                                    toast('~~下拉刷新一下~~');\n                                    log(PATH);\n                                    setItem('img', PATH);\n                                    setItem('轮播', '1');\n                                    back(true);\n                                    back(true);\n                                    return 'hiker://empty';\n                                }),\n                                rootDirPath: '/storage/emulated/0/',\n                                initialPath: '/storage/emulated/0/',\n                                pattern: 1,\n                            });\n                        });\n                    })\n                },\n                {\n                    title: '输入',\n                    js: $.toString(function() {\n                        return $('/storage/emulated/0/Pictures/', \"请输入地址,支持网络地址,默认海阔图片保存目录\").input(function() {\n                            if (/http|storage|hiker/.test(input)) {\n                                setItem('img', input);\n                                refreshPage();\n                                return;\n                            } else {\n                                setItem('img', '/storage/emulated/0/Pictures/');\n                                toast('不是有效地址,默认海阔图片保存目录');\n                            }\n                        });\n                    })\n                },\n                {\n                    title: '删除',\n                    js: $.toString(function() {\n                        if (!input.startsWith('/')) {\n                            toast('~~网络图片无法删除~~');\n                        } else {\n                            if (imgPath.startsWith('/')) {\n                                var File = java.io.File;\n                                var file = new File(input);\n                                if (file.delete()) {\n                                    toast('~~已删除该图片~~');\n                                } else {\n                                    toast('~~删除图片失败~~');\n                                }\n                            }\n                            back(true);\n                        }\n                    })\n                }\n            ]\n        }\n    });\n    registerTask(id, time, $.toString(function(blist, id) {\n        var idx = parseInt(getMyVar('banner_idx_' + id, '0'));\n        if (idx >= blist.length) idx = 0;\n        try {\n            updateItem(id, { img: blist[idx], desc: '0', url: 'pics://' + blist.slice(idx).join('&&') });\n        } catch (e) {\n            log(\"轮播任务异常：\" + e.message);\n            unRegisterTask(id);\n        }\n        idx++;\n        putMyVar('banner_idx_' + id, idx + '');\n    }, blist, id));\n    if (getItem('轮播', '1') == '0') unRegisterTask(id);\n    return result;\n}\n\n// 获取轮播图片数组\nfunction getImageArray() {\n    var arr = [];\n    var imgPath = getItem('img', '/storage/emulated/0/Pictures/');\n    var cacheKey = 'banner_cache_' + imgPath.replace(/[^a-zA-Z0-9]/g, '_');\n    var cached = getItem(cacheKey);\n    var cacheTime = parseInt(getItem(cacheKey + '_time', '0'));\n    var now = Date.now();\n    if (cached && (now - cacheTime < 10 * 60 * 1000)) {\n        try { arr = JSON.parse(cached); } catch (e) { arr = []; }\n    } else {\n        if (imgPath.startsWith('/')) {\n            var File = java.io.File;\n            var file = new File(imgPath);\n            try {\n                var fileList = file.listFiles();\n                if (fileList != null && fileList.length != 0) {\n                    var pics = fileList.filter(function(h) { return h.isFile() && /\\.(jpg|jpeg|png|gif|webp)/i.test(h.getName()); });\n                }\n                if (!fileList || fileList.length == 0 || !pics || pics.length == 0) {\n                    toast('此目录下无图片,切换到网络图片');\n                    var html = fetchPC('https://bizihu.com/AIMN.html');\n                    var list = pdfa(html, 'body&&.box');\n                    for (var i = 1; i < list.length; i++) {\n                        arr.push(pdfh(list[i], 'img&&data-original'));\n                    }\n                } else {\n                    for (var i in pics) {\n                        arr.push(pics[i].getAbsolutePath());\n                    }\n                }\n            } catch (e) {\n                toast('目录不存在,切换到网络图片');\n                var html = fetchPC('https://bizihu.com/AIMN.html');\n                var list = pdfa(html, 'body&&.box');\n                for (var i = 1; i < list.length; i++) {\n                    arr.push(pdfh(list[i], 'img&&data-original'));\n                }\n            }\n        } else if (/hefollo/.test(imgPath)) {\n            var pics = fetchPC(imgPath).split('\\n');\n            for (var i in pics) {\n                arr.push(pics[i]);\n            }\n        } else if (/random|mwm|\\.php|api/.test(imgPath)) {\n            for (var i = 0; i < 10; i++) {\n                arr.push(getItem('img', 'https://www.dmoe.cc/random.php') + '#' + Math.random());\n            }\n        } else if (/netbian/.test(imgPath)) {\n            var html = request('http://www.netbian.com/index_2.htm', {});\n            var list = pdfa(html, '.list&&li');\n            for (var i = 1; i < list.length; i++) {\n                arr.push(pdfh(list[i], 'img&&src'));\n            }\n        } else if (/bizihu/.test(imgPath)) {\n            var html = fetchPC('https://bizihu.com/AIMN.html');\n            var list = pdfa(html, 'body&&.box');\n            for (var i = 1; i < list.length; i++) {\n                arr.push(pdfh(list[i], 'img&&data-original'));\n            }\n        }\n        if (arr.length > 0) {\n            setItem(cacheKey, JSON.stringify(arr));\n            setItem(cacheKey + '_time', now + '');\n        }\n    }\n    return arr;\n}\n\n// 导出主函数：获取轮播图卡片数组\nconst 轮播图 = {\n    getBanner: function() {\n        var arr = getImageArray();\n        try {\n            return banner(arr, 5000, 'zhuye');\n        } catch (e) {\n            log('轮播生成失败：' + e.message);\n            return [];\n        }\n    }\n};\n\n\n$.exports = 轮播图;"},{"col_type":"movie_3","name":"主页助手","path":"主页助手","rule":"var 主页助手 = {\n\n    getThemeColor: function() {\n        var Color = getItem('主题颜色', '#F5F5F5');\n        var randomTheme = getItem('random_theme', '0');\n        if (randomTheme == '1') {\n            var letters = '0123456789ABCDEF';\n            var randomColor = '#';\n            for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\n            setItem('主题颜色', randomColor);\n            Color = randomColor;\n        }\n        return Color;\n    },\n\n    getHomeFontColor: function() {\n        var color = getItem('home_font_color', '#333333');\n        if (getItem('home_font_random_mode', '0') == '1') {\n            var letters = '0123456789ABCDEF';\n            var randomColor = '';\n            while (true) {\n                randomColor = '#';\n                for (var i = 0; i < 6; i++) randomColor += letters[Math.floor(Math.random() * 16)];\n                if (randomColor.toLowerCase() !== '#000000' && randomColor.toLowerCase() !== '#ffffff') break;\n            }\n            setItem('home_font_color', randomColor);\n            color = randomColor;\n        }\n        return color;\n    },\n\n    registerRepairTask: function() {\n        registerTask('repair_delay', 300, $.toString(function() {\n            try {\n                var repairData = request('hiker://page/repair');\n                if (repairData && repairData.trim() !== '' && repairData !== 'null' && repairData !== 'undefined') {\n                    var repairJson = JSON.parse(repairData);\n                    if (repairJson && repairJson.rule) eval(repairJson.rule);\n                }\n            } catch (e) { log('repair模块错误：' + e.message); }\n            unRegisterTask('repair_delay');\n        }));\n    },\n\n    buildTitleCard: function(themeColor, fontColor) {\n        var descList = [\n            \"汇聚万千影视，有这一个就够了\",\n            \"每天一部好电影，品味百态人生\",\n            \"海量资源，畅享无限观影体验\",\n            \"好剧不断，精彩不停歇\",\n            \"你的私人影视库，随时想看就看\",\n            \"追剧不等待，好片即刻看\",\n            \"万千好片，一网打尽\",\n            \"极致观影体验，从这里开始\",\n            \"精彩内容，每日更新\",\n            \"影视爱好者的聚集地\"\n        ];\n        var randomDesc = descList[Math.floor(Math.random() * descList.length)];\n\n        return {\n            title: '<font color=\"' + fontColor + '\">' + (getItem(\"home_title\", \"\") || \"撸客影视\") + '</font>',\n            desc: '<font color=\"' + fontColor + '\">' + (getItem(\"home_desc\", \"\") || randomDesc) + '</font>',\n            pic_url: 'https://zhengxin-pub.cdn.bcebos.com/logopic/0676f279652ad8999d0be18d74e8d209_fullsize.jpg',\n            url: $('#noLoading#').lazyRule(function() {\n                var _statU = getItem(\"jianguo_user\", \"344009759@qq.com\");\n                var _statP = getItem(\"jianguo_pass\", \"a48q28fuzjp7qehc\");\n                var _statAuth = \"Basic \" + base64Encode(_statU + \":\" + _statP);\n                var _stRaw = \"\";\n                try {\n                    _stRaw = request(\"https://dav.jianguoyun.com/dav/luke/stats.json\", {\n                        headers: { \"Authorization\": _statAuth }, timeout: 8000\n                    });\n                } catch(e) {}\n\n                if (!_stRaw || !_stRaw.trim()) {\n                    var _pop0 = $.require('弹窗工具');\n                    _pop0.show(\"📊 使用统计\", [{ title: \"提示\", records: [\"暂无统计数据\"] }]);\n                    return \"hiker://empty\";\n                }\n\n                var _stObj;\n                try { _stObj = JSON.parse(_stRaw); } catch(e) { _stObj = { devices: {} }; }\n                var _stDevs = _stObj.devices || {};\n                var _stTotal = Object.keys(_stDevs).length;\n\n                var _stNow = new Date();\n                var _stDayList = [];\n                for (var _di = 0; _di < 7; _di++) {\n                    var _dd = new Date(_stNow.getTime() - _di * 86400000);\n                    var _ds = _dd.getFullYear() + \"-\" +\n                        (\"0\" + (_dd.getMonth() + 1)).slice(-2) + \"-\" +\n                        (\"0\" + _dd.getDate()).slice(-2);\n                    _stDayList.push(_ds);\n                }\n                var _stTodayStr = _stDayList[0];\n                var _stYestStr = _stDayList[1];\n\n                var _stDayCnt = {};\n                for (var _dj = 0; _dj < _stDayList.length; _dj++) _stDayCnt[_stDayList[_dj]] = 0;\n\n                var _stToday = 0, _stYest = 0, _st7 = 0;\n                var _stTodayNew = 0, _stYestNew = 0, _st7New = 0;\n                var _stAct30 = 0, _stAct30Start = new Date(_stNow.getTime() - 30 * 86400000);\n                var _st7Start = new Date(_stNow.getTime() - 7 * 86400000);\n\n                // 时段分布按「人」算：一个设备今天在某个时段出现过，该时段只加 1\n                var _stSegCnt = [0, 0, 0, 0];\n\n                for (var _sk in _stDevs) {\n                    if (!_stDevs.hasOwnProperty(_sk)) continue;\n                    var _d = _stDevs[_sk];\n                    var _days = _d.days || [];\n                    var _in7 = false;\n                    for (var _di2 = 0; _di2 < _days.length; _di2++) {\n                        if (_stDayCnt[_days[_di2]] !== undefined) {\n                            _stDayCnt[_days[_di2]]++;\n                            _in7 = true;\n                        }\n                    }\n                    if (_in7) _st7++;\n                    if (_days.indexOf(_stTodayStr) > -1) _stToday++;\n                    if (_days.indexOf(_stYestStr) > -1) _stYest++;\n\n                    if (_d.firstSeen === _stTodayStr) _stTodayNew++;\n                    if (_d.firstSeen === _stYestStr) _stYestNew++;\n                    var _fsDt = new Date(_d.firstSeen);\n                    if (_fsDt >= _st7Start) _st7New++;\n\n                    var _lsDt = new Date(_d.lastSeen);\n                    if (_lsDt >= _stAct30Start) _stAct30++;\n\n                    // 今日时段人数\n                    if (_d.hoursDate === _stTodayStr && _d.hours) {\n                        var _seenSeg = {};\n                        for (var _hi2 = 0; _hi2 < _d.hours.length; _hi2++) {\n                            var _hr = parseInt(_d.hours[_hi2], 10);\n                            if (_hr >= 0 && _hr < 24) {\n                                var _segIdx = Math.floor(_hr / 6);\n                                if (!_seenSeg[_segIdx]) {\n                                    _seenSeg[_segIdx] = true;\n                                    _stSegCnt[_segIdx]++;\n                                }\n                            }\n                        }\n                    }\n                }\n\n                var _txt = \"\";\n                _txt += \"👥 累计用户：\" + _stTotal + \" 人\\n\\n\";\n\n                _txt += \"━━━ 活跃统计 ━━━\\n\";\n                _txt += \"📅 今日活跃：\" + _stToday + \" 人\";\n                if (_stTodayNew > 0) _txt += \"（新增 \" + _stTodayNew + \"）\";\n                _txt += \"\\n\";\n                _txt += \"📅 昨日活跃：\" + _stYest + \" 人\";\n                if (_stYestNew > 0) _txt += \"（新增 \" + _stYestNew + \"）\";\n                _txt += \"\\n\";\n                _txt += \"📅 近 7 天活跃：\" + _st7 + \" 人\";\n                if (_st7New > 0) _txt += \"（新增 \" + _st7New + \"）\";\n                _txt += \"\\n\";\n                _txt += \"📅 近 30 天活跃：\" + _stAct30 + \" 人\\n\\n\";\n\n                _txt += \"━━━ 近 7 天趋势 ━━━\\n\";\n                var _dayNames = [\"今天\", \"昨天\"];\n                for (var _dk = 0; _dk < _stDayList.length; _dk++) {\n                    var _label = _dayNames[_dk] || _stDayList[_dk];\n                    var _cnt = _stDayCnt[_stDayList[_dk]] || 0;\n                    var _bar = \"\";\n                    for (var _bi = 0; _bi < Math.min(_cnt, 20); _bi++) _bar += \"█\";\n                    if (_cnt > 20) _bar += \"+\";\n                    _txt += \"  \" + _label + \"  \" + _cnt + \" 人 \" + _bar + \"\\n\";\n                }\n                _txt += \"\\n\";\n\n                _txt += \"━━━ 今日时段人数 ━━━\\n\";\n                var _segNames = [\"🌙 00-06\", \"🌅 06-12\", \"☀️ 12-18\", \"🌆 18-24\"];\n                for (var _si = 0; _si < 4; _si++) {\n                    _txt += \"  \" + _segNames[_si] + \"  \" + _stSegCnt[_si] + \" 人\\n\";\n                }\n\n                var _pop = $.require('弹窗工具');\n                _pop.show(\"📊 使用统计\", [\n                    { title: \"统计结果\", records: [_txt] }\n                ]);\n                return \"hiker://empty\";\n            }),\n            col_type: 'avatar',\n            extra: {\n                lineVisible: false,\n                backgroundColor: 'transparent',\n                longClick: [\n                    {\n                        title: '⚙️ 设置',\n                        js: $.toString(function() {\n                            return 'hiker://page/manage#noHistory##noRecordHistory#';\n                        })\n                    },\n                    {\n                        title: '🔄 恢复默认',\n                        js: $.toString(function() {\n                            confirm({\n                                title: \"确认重置\",\n                                content: \"此操作将重置样式、主题、字体颜色、Tab排序，确定操作吗？\",\n                                confirm: $.toString(function() {\n                                    setItem('card_style', 'scroll_button');\n                                    setItem('c1_style', 'scroll_button');\n                                    setItem('主题颜色', '#F5F5F5');\n                                    setItem('random_theme', '0');\n                                    setItem('home_font_color', '#333333');\n                                    setItem('home_font_random_mode', '0');\n                                    setItem('manage_font_color', '#333333');\n                                    setItem('manage_font_random_mode', '0');\n                                    setItem('current_preset_theme', '');\n                                    setItem('tab_sort_normal', '');\n                                    setItem('tab_sort_short_drama', '');\n                                    setItem('tab_sort_live', '');\n                                    setItem('tab_sort_adult', '');\n                                    toast('✅ 已恢复全部默认');\n                                    refreshPage();\n                                }),\n                                cancel: $.toString(function() {})\n                            });\n                            return 'hiker://empty';\n                        })\n                    },\n                    {\n                        title: '🎲 娱乐一下',\n                        js: $.toString(function() {\n                            return $('hiker://empty##fypage#noRecordHistory##gameTheme#').rule(function() {\n                                var d = [];\n                                var 本地 = getPath('hiker://files/Jm/file/xjjPro.html');\n                                if (!fileExist(本地)) {\n                                    confirm({\n                                        title: '导入',\n                                        content: '检测到你没有本地文件，是否导入',\n                                        confirm: $.toString(function(本地) {\n                                            writeFile(本地, fetch('https://gh-proxy.org/https://raw.githubusercontent.com/liuzaoyue/haikuo/master/xjj.html'));\n                                            refreshPage(false);\n                                        }, 本地),\n                                        cancel: $.toString(function() {})\n                                    });\n                                }\n                                d.push({\n                                    col_type: 'x5_webview_single',\n                                    url: 本地,\n                                    desc: 'float&&100%',\n                                    extra: { autoPlay: true, showProgress: false }\n                                });\n                                setResult(d);\n                            });\n                        })\n                    }\n                ]\n            }\n        };\n    },\n\n    getLongClickMenu: function() { return []; },\n\n    getTabInfo: function() {\n        var TabConfig = $.require('Tab配置');\n        var mode = getItem('content_mode', '');\n        if (!mode) return {};\n        return TabConfig.getTabInfo(mode);\n    },\n\n    getTabIcons: function() {\n        var TabConfig = $.require('Tab配置');\n        var mode = getItem('content_mode', '');\n        if (!mode) return {};\n        return TabConfig.getTabIcons(mode);\n    },\n\n    filterHiddenTabs: function(tabOrderArray, tabInfo) {\n        var hiddenTabs = getItem('hidden_tabs', '');\n        var hiddenList = hiddenTabs ? hiddenTabs.split(',') : [];\n        var totalTabs = tabOrderArray.length;\n        if (hiddenList.length >= totalTabs) {\n            hiddenList = [];\n            setItem('hidden_tabs', '');\n            toast('⚠️ 检测到全部Tab被屏蔽，已自动恢复显示');\n        }\n        var mainTabs = [];\n        for (var i = 0; i < tabOrderArray.length; i++) {\n            var id = tabOrderArray[i];\n            if (hiddenList.indexOf(String(id)) !== -1) continue;\n            if (tabInfo[id]) mainTabs.push({ id: id, title: tabInfo[id] });\n        }\n        return mainTabs;\n    }\n};\n\n$.exports = 主页助手;"},{"col_type":"movie_3","name":"更新日志正式版","path":"更新日志正式版","rule":"// 模块名：更新日志正式版\nvar 更新日志正式版 = {\n    // ★★★ 正式版版本号 ★★★\n    CURRENT_VERSION: \"20260918\",\n\n    getData: function() {\n        return [\n            {\n                title: \"2026/09/18\",\n                records: [\n                    \"““新增””:使用统计。\",\n                    \"““新增””:帮助反馈增加回复。\"\n                ]\n            },\n            {\n                title: \"2026/09/17\",\n                records: [\n                    \"““修复””:云端拉取。\"\n                ]\n            },\n            {\n                title: \"2026/09/16\",\n                records: [\n                    \"““新增””:星芽短剧。\",\n                    \"““新增””:好看短剧。\",\n                    \"““新增””:点众短剧。\",\n                    \"““新增””:牛牛短剧。\",\n                    \"““新增””:山海短剧。\",\n                    \"““新增””:稀饭短剧。\",\n                    \"““优化””:优化加载速度，提升播放体验。\",\n                    \"““修复””:修复部分已知问题。\"\n                ]\n            },\n            {\n                title: \"2026/09/12\",\n                records: [\n                    \"““更新””:检测更新云端\"\n                ]\n            },\n            {\n                title: \"2026/09/11\",\n                records: [\n                    \"““修复””:管理页报错问题\"\n                ]\n            },\n            {\n                title: \"2026/09/03\",\n                records: [\n                    \"““新增””:版本重装。\",\n                    \"““优化””:操作说明。\",\n                    \"““优化””:关于页面。\",\n                    \"““优化””:Tab按钮显示。\"\n                ]\n            },\n            {\n                title: \"2026/08/30\",\n                records: [\n                    \"““新增””:直播功能\",\n                    \"““新增””:操作说明\",\n                    \"““新增””:管理页新增自动检测版本有无更新，更新始终快人一步。\",\n                    \"““新增””:管理页增加tab屏蔽功能，不想用的可以临时屏蔽掉。\",\n                    \"““优化””:适配一起草主题颜色、字体颜色、预设主题包。\"\n                ]\n            },\n            {\n                title: \"2026/08/29\",\n                records: [\n                    \"““优化””:内测版正式版切换功能，根据自己选择合适的版本。\",\n                    \"““新增””:20套预设主题（10浅色+10深色），一键切换。\"\n                ]\n            },\n            {\n                title: \"2026/08/28\",\n                records: [\"““优化””:瓜子社区改为爱情岛。\"]\n            },\n            {\n                title: \"2026/08/27\",\n                records: [\"““修复””:管理页检测更新显示按钮。\"]\n            },\n            {\n                title: \"2026/08/26\",\n                records: [\"““新增””:影片&小说类目下字体颜色可在管理页更改，字体颜色同步管理页。\"]\n            },\n            {\n                title: \"2026/08/25\",\n                records: [\"““新增””:撸客影视初版本上线。\"]\n            }\n        ];\n    },\n\n    buildItem: function(fontColor, bgTint) {\n        var data = this.getData();\n        var version = this.CURRENT_VERSION;\n        return {\n            title: '<b><font color=\"' + fontColor + '\">更新日志</font></b>',\n            desc: '<font color=\"' + fontColor + '\">当前正式版本：' + version + '</font>',\n            url: $(\"#noLoading#\").lazyRule(function(logData) {\n                var hikerPop = $.require(\"hikerPop.js\");\n                hikerPop.updateRecordsBottom(logData);\n                return \"hiker://empty\";\n            }, data),\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/213.png\",\n            col_type: 'avatar',\n            extra: { backgroundColor: bgTint, lineVisible: false }\n        };\n    }\n};\n\n$.exports = 更新日志正式版;"},{"col_type":"movie_3","name":"更新日志Beta版","path":"更新日志Beta版","rule":"// 模块名：更新日志Beta版\nvar 更新日志Beta版 = {\n    // ★★★ Beta版版本号 ★★★\n    CURRENT_BETA_VERSION: \"2026091801\",\n\n    getData: function() {\n        return [\n            {\n                title: \"2026/09/18Beta1\",\n                records: [\n                    \"““新增””:帮助反馈新增回复功能。\"\n                ]\n            },\n            {\n                title: \"2026/09/17Beta4\",\n                records: [\n                    \"““修复””:检测更新。\"\n                ]\n            },\n            {\n                title: \"2026/09/17Beta3\",\n                records: [\n                    \"““新增””:使用统计功能，点击首页上方标题。\"\n                ]\n            },\n            {\n                title: \"2026/09/17Beta2\",\n                records: [\n                    \"““修复””:云端拉取。\"\n                ]\n            },\n            {\n                title: \"2026/09/17Beta1\",\n                records: [\n                    \"““新增””:聚合搜索。\",\n                    \"““优化””:云端拉取逻辑。\",\n                    \"““说明””:以后没有大问题没有新增功能会很少更新，所有配置和内容全部从云端拉取，偶尔更新一下兜底文件。\"\n                ]\n            },\n            {\n                title: \"2026/09/15Beta1\",\n                records: [\n                    \"““新增””:星芽短剧。\",\n                    \"““新增””:好看短剧。\",\n                    \"““新增””:点众短剧。\",\n                    \"““新增””:牛牛短剧。\",\n                    \"““新增””:山海短剧。\",\n                    \"““新增””:稀饭短剧。\",\n                    \"““优化””:优化加载速度，提升播放体验。\",\n                    \"““修复””:修复部分已知问题。\"\n                ]\n            },\n            {\n                title: \"2026/09/13Beta2\",\n                records: [\n                    \"““新增””:七猫短剧。\"\n                ]\n            },\n            {\n                title: \"2026/09/13Beta1\",\n                records: [\n                    \"““新增””:影视模式新增聚合影视，多源聚合，支持电影/电视剧/综艺/动漫。\",\n                    \"““修复””:Tab 配置数据过大导致的报错。\"\n                ]\n            },\n            {\n                title: \"2026/09/12Beta1\",\n                records: [\n                    \"““新增””:增加了很多东西，自己摸索吧。\"\n                ]\n            },\n            {\n                title: \"2026/09/11Beta1\",\n                records: [\n                    \"““新增””:娱乐一下（长按标题）。\",\n                    \"““新增””:首页新版本提醒。\",\n                    \"““新增””:首页模式切换。\",\n                    \"““新增””:公告。\"\n                ]\n            },\n            {\n                title: \"2026/09/10Beta1\",\n                records: [\n                    \"““新增””:模式切换。\",\n                    \"““新增””:直播频道Tab。\",\n                    \"““新增””:虎牙直播。\",\n                    \"““新增””:虎牙精选。\"\n                ]\n            },\n            {\n                title: \"2026/09/02Beta2\",\n                records: [\n                    \"““调整””:布局。\"\n                ]\n            },\n            {\n                title: \"2026/09/02Beta1\",\n                records: [\n                    \"““新增””:版本重装。\"\n                ]\n            },\n            {\n                title: \"2026/09/01Beta1\",\n                records: [\n                    \"““优化””:标题UI样式。\",\n                    \"““优化””:操作说明显示样式。\",\n                    \"““优化””:关于显示样式。\"\n                ]\n            },\n            {\n                title: \"2026/08/30/Beta3\",\n                records: [\n                    \"““新增””:管理页新增轮播图开关，可以随时打开关闭。\"\n                ]\n            },\n            {\n                title: \"2026/08/30/Beta2\",\n                records: [\n                    \"““优化””:屏蔽tab逻辑\"\n                ]\n            },\n            {\n                title: \"2026/08/30/Beta1\",\n                records: [\n                    \"““修复””:检测更新功能。\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta7\",\n                records: [\n                    \"““新增””:管理页新增自动检测版本有无更新，更新始终快人一步。\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta6\",\n                records: [\n                    \"““新增””:操作说明\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta5\",\n                records: [\n                    \"““优化””:适配一起草主题颜色、字体颜色、预设主题包。\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta4\",\n                records: [\n                    \"““新增””:直播功能\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta3\",\n                records: [\n                    \"““新增””:20套预设主题（10浅色+10深色），一键切换。\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta2\",\n                records: [\n                    \"““新增””:管理页增加内测版正式版切换，根据自己选择合适的版本。\"\n                ]\n            },\n            {\n                title: \"2026/08/29/Beta1\",\n                records: [\n                    \"““新增””:增加一起草。\"\n                ]\n            }\n        ];\n    },\n\n    buildItem: function(fontColor, bgTint) {\n        var data = this.getData();\n        var version = this.CURRENT_BETA_VERSION;\n        return {\n            title: '<b><font color=\"' + fontColor + '\">更新日志</font></b>',\n            desc: '<font color=\"' + fontColor + '\">当前beta版本：' + version + '</font>',\n            url: $(\"#noLoading#\").lazyRule(function(logData) {\n                var hikerPop = $.require(\"hikerPop.js\");\n                hikerPop.updateRecordsBottom(logData);\n                return \"hiker://empty\";\n            }, data),\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/213.png\",\n            col_type: 'avatar',\n            extra: { backgroundColor: bgTint, lineVisible: false }\n        };\n    }\n};\n\n$.exports = 更新日志Beta版;"},{"col_type":"movie_3","name":"弹窗工具","path":"弹窗工具","rule":"// 模块名：弹窗工具\n// 功能：通用底部卡片列表弹窗\nvar 弹窗工具 = {\n\n    show: function(title, data) {\n        try {\n            var activity = typeof getCurrentActivity === \"function\" ? getCurrentActivity() : ActivityManager.getInstance().getCurrentActivity();\n            if (!activity) {\n                this._fallback(title, data);\n                return;\n            }\n\n            var R = com.example.hikerview.R;\n            var DisplayUtil = com.example.hikerview.utils.DisplayUtil;\n            var MyStatusBarUtil = com.example.hikerview.utils.MyStatusBarUtil;\n            var GridLayoutManager = Packages.androidx.recyclerview.widget.GridLayoutManager;\n            var DefaultItemAnimator = Packages.androidx.recyclerview.widget.DefaultItemAnimator;\n            var UpdateRecordsAdapter = com.example.hikerview.ui.setting.updaterecords.UpdateRecordsAdapter;\n            var RecordDetail = com.example.hikerview.ui.setting.updaterecords.RecordDetail;\n            var XPopup = com.lxj.xpopup.XPopup;\n\n            var rules = [];\n            for (var i = 0; i < data.length; i++) {\n                var recordDetail = new RecordDetail();\n                recordDetail.setType(1);\n                recordDetail.setDetail(String(data[i].title || \"\"));\n                rules.push(recordDetail);\n                var items = data[i].records || [];\n                for (var j = 0; j < items.length; j++) {\n                    var recordDetail2 = new RecordDetail();\n                    recordDetail2.setType(2);\n                    recordDetail2.setDetail(String(items[j] || \"\"));\n                    rules.push(recordDetail2);\n                }\n            }\n\n            var myRecordDetail = new JavaAdapter(com.lxj.xpopup.core.BottomPopupView, {\n                getImplLayoutId: function() {\n                    return R.layout.activit_ad_list;\n                },\n                onCreate: function() {\n                    this.super$onCreate();\n                    var recyclerView = this.findViewById(R.id.ad_list_recycler_view);\n                    this.recyclerView = recyclerView;\n                    recyclerView.setItemAnimator(new DefaultItemAnimator());\n                    this.findViewById(R.id.ad_list_title_text).setText(title || \"📋 更新日志\");\n                    var button = this.findViewById(R.id.ad_list_add);\n                    button.setText(\"知道啦\");\n                    button.setOnClickListener(function() {\n                        this.dismiss();\n                    }.bind(this));\n\n                    var statusBarHeight = MyStatusBarUtil.getStatusBarHeight(activity) + DisplayUtil.dpToPx(activity, 86);\n                    var findView2 = this.findViewById(R.id.ad_list_bg);\n                    var layoutParams = findView2.getLayoutParams();\n                    layoutParams.topMargin = statusBarHeight;\n                    findView2.setLayoutParams(layoutParams);\n\n                    this.adapter = new UpdateRecordsAdapter(activity, rules);\n                    this.recyclerView.setLayoutManager(new GridLayoutManager(activity, 1));\n                    this.recyclerView.setAdapter(this.adapter);\n                }\n            }, activity);\n\n            var builder = new XPopup.Builder(activity)\n                .borderRadius(DisplayUtil.dpToPx(activity, 16));\n            var pop = builder.asCustom(myRecordDetail);\n\n            if (typeof runOnUI === \"function\") {\n                runOnUI(function() { pop.show(); });\n            } else {\n                pop.show();\n            }\n\n        } catch (e) {\n            log(\"弹窗工具异常：\" + e.message);\n            this._fallback(title, data);\n        }\n    },\n\n    _fallback: function(title, data) {\n        var msg = \"\";\n        for (var i = 0; i < data.length; i++) {\n            msg += \"【\" + (data[i].title || \"标题\") + \"】\\n\";\n            if (Array.isArray(data[i].records)) {\n                for (var j = 0; j < data[i].records.length; j++) {\n                    msg += \"  • \" + data[i].records[j] + \"\\n\";\n                }\n            }\n            msg += \"\\n\";\n        }\n        confirm({\n            title: title || \"📋 更新日志\",\n            content: msg,\n            confirm: function() {}\n        });\n    }\n};\n\n$.exports = 弹窗工具;"},{"col_type":"movie_3","name":"Tab屏蔽管理","path":"Tab屏蔽管理","rule":"js:\nvar d = [];\nsetPageTitle(\"Tab屏蔽管理\");\n\nvar Color = getItem('主题颜色', '#F5F5F5');\nvar bgTint = '#15' + Color.replace('#', '');\nvar FontColor = getItem('manage_font_color', '#333333');\n\nvar mode = getItem('content_mode', '');\nvar modeMap = {\n    'adult': '成人模式',\n    'short_drama': '短剧模式',\n    'live': '直播模式',\n    'normal': '影视模式'\n};\nvar displayMode = modeMap[mode] || '未选择';\n\nif (!mode) {\n    d.push({ col_type: \"big_blank_block\" });\n    d.push({\n        title: '<font color=\"' + FontColor + '\">请先选择模式</font>',\n        desc: '<font color=\"' + FontColor + '\">去首页选择内容模式后再来</font>',\n        col_type: 'text_center_1',\n        url: 'hiker://empty'\n    });\n    setResult(d);\n} else {\n    // ===== 从 Tab配置 模块拿当前模式的 Tab =====\n    var tabInfo = {};\n    var tabIcons = {};\n    try {\n        var Tab配置 = $.require('Tab配置');\n        tabInfo = Tab配置.getTabInfo(mode) || {};\n        tabIcons = Tab配置.getTabIcons(mode) || {};\n    } catch(e) {\n        log(\"加载 Tab配置 失败：\" + e.message);\n    }\n\n    // 组装成数组\n    var tabList = [];\n    var ids = Object.keys(tabInfo);\n    for (var i = 0; i < ids.length; i++) {\n        tabList.push({\n            id: ids[i],\n            title: tabInfo[ids[i]],\n            icon: tabIcons[ids[i]] || ''\n        });\n    }\n\n    // 拿已屏蔽列表（全局）\n    var hiddenTabs = getItem('hidden_tabs', '');\n    var hiddenList = hiddenTabs ? hiddenTabs.split(',').filter(function(s){return s;}) : [];\n\n    // 顶部提示\n    d.push({\n        title: '<font color=\"' + FontColor + '\">点击条目切换屏蔽状态</font>',\n        desc: '<font color=\"' + FontColor + '\">当前模式：' + displayMode + '（共 ' + tabList.length + ' 个）</font>',\n        pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/17.png\",\n        url: 'hiker://empty',\n        col_type: 'avatar',\n        extra: { backgroundColor: bgTint, lineVisible: true }\n    });\n\n    // 当前模式下的所有 ID\n    var allIds = [];\n    for (var k = 0; k < tabList.length; k++) {\n        allIds.push(String(tabList[k].id));\n    }\n\n    // 列出每个 Tab\n    if (tabList.length > 0) {\n        for (var i = 0; i < tabList.length; i++) {\n            var item = tabList[i];\n            var idStr = String(item.id);\n            var isHidden = hiddenList.indexOf(idStr) !== -1;\n            var statusText = isHidden ? '⛔ 已屏蔽' : '✅ 显示中';\n            var statusColor = isHidden ? '#FF6B6B' : '#51CF66';\n\n            d.push({\n                title: '<font color=\"' + FontColor + '\">' + item.title + '</font>',\n                desc: '<font color=\"' + statusColor + '\">' + statusText + '</font>',\n                pic_url: item.icon || \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/17.png\",\n                url: $(\"#noLoading#\").lazyRule(function(params) {\n                    var id = params.id;\n                    var allIds = params.allIds;\n                    var cur = getItem('hidden_tabs', '').split(',').filter(function(s) { return s; });\n                    var idx = cur.indexOf(id);\n\n                    if (idx !== -1) {\n                        cur.splice(idx, 1);\n                    } else {\n                        // 只统计当前模式下可见的数量\n                        var visibleCount = 0;\n                        for (var j = 0; j < allIds.length; j++) {\n                            if (cur.indexOf(allIds[j]) === -1) visibleCount++;\n                        }\n                        if (visibleCount <= 1) {\n                            toast(\"⚠️ 必须至少保留一个Tab显示！\");\n                            return 'hiker://empty';\n                        }\n                        cur.push(id);\n                    }\n\n                    setItem('hidden_tabs', cur.join(','));\n                    toast('状态已更新');\n                    refreshPage();\n                    return 'hiker://empty';\n                }, {id: idStr, allIds: allIds}),\n                col_type: 'avatar',\n                extra: { backgroundColor: bgTint, lineVisible: true }\n            });\n        }\n    } else {\n        d.push({\n            title: '<font color=\"red\">当前模式下无可用Tab</font>',\n            desc: '请检查 Tab配置 模块',\n            col_type: 'avatar'\n        });\n    }\n\n    // 重置\n    d.push({\n        title: '<font color=\"' + FontColor + '\">重置屏蔽</font>',\n        desc: '<font color=\"' + FontColor + '\">一键取消所有已屏蔽的Tab</font>',\n        pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/17.png\",\n        url: $(\"#noLoading#\").lazyRule(function() {\n            confirm({\n                title: \"重置Tab屏蔽\",\n                content: \"确认取消所有已屏蔽的Tab吗？\",\n                confirm: $.toString(function() {\n                    setItem('hidden_tabs', '');\n                    toast(\"✅ 已重置\");\n                    refreshPage();\n                    return 'hiker://empty';\n                }),\n                cancel: $.toString(function() { return 'hiker://empty'; })\n            });\n            return 'hiker://empty';\n        }),\n        col_type: 'avatar',\n        extra: { backgroundColor: bgTint, lineVisible: false }\n    });\n}\n\nsetResult(d);"},{"col_type":"movie_3","name":"Tab配置","path":"Tab配置","rule":"// ===== 读开关：cloud=拉云端，local=只读本地硬编码 =====\nvar _rtMode = getItem('tab_runtime_mode', 'cloud');\nvar _cloudCfg = null;\nif (_rtMode === 'cloud') {\n    try {\n        var _ct = parseInt(getItem('cloud_tab_cache_time', '0'), 10) || 0;\n        var _raw = '';\n        if (Date.now() - _ct < 5 * 60 * 1000) {\n            _raw = getItem('cloud_tab_cache', '');\n        } else {\n            try {\n                var _auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\n                var _resp = request('https://dav.jianguoyun.com/dav/luke/tab-config.json', { headers: { 'Authorization': _auth }, timeout: 8000 });\n                if (_resp && _resp.length > 500) {\n                    _raw = _resp;\n                    setItem('cloud_tab_cache', _resp);\n                    setItem('cloud_tab_cache_time', String(Date.now()));\n                }\n            } catch(e) {}\n        }\n        if (_raw) {\n            var _c = JSON.parse(_raw);\n            if (_c && _c.tabNames) {\n                _cloudCfg = _c;\n                setItem('pull_status_tabconfig', JSON.stringify({ ok: true, msg: '拉取成功', time: Date.now() }));\n            }\n        } else {\n            setItem('pull_status_tabconfig', JSON.stringify({ ok: false, msg: '响应为空', time: Date.now() }));\n        }\n    } catch(e) {\n        setItem('pull_status_tabconfig', JSON.stringify({ ok: false, msg: '异常：' + e.message, time: Date.now() }));\n    }\n}\n\nvar Tab配置 = {\n    tabNames: (_cloudCfg && _cloudCfg.tabNames) || {\"1\":\"一起草\",\"2\":\"爱情岛\",\"3\":\"麻豆\",\"4\":\"影片&小说\",\"5\":\"直播\",\"6\":\"直播频道\",\"7\":\"虎牙直播\",\"8\":\"虎牙精选\",\"9\":\"聚合影视\",\"10\":\"七猫短剧\",\"11\":\"星芽短剧\",\"12\":\"稀饭短剧\",\"13\":\"山海短剧\",\"14\":\"牛牛短剧\",\"15\":\"好看短剧\",\"16\":\"点众短剧\",\"17\":\"多多影视\",\"18\":\"网飞猫\"},\n    tabIcons: (_cloudCfg && _cloudCfg.tabIcons) || {\"1\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/1.png\",\"2\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/2.png\",\"3\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/3.png\",\"4\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/4.png\",\"5\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/5.png\",\"6\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/6.png\",\"7\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/7.png\",\"8\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/8.png\",\"9\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/9.png\",\"10\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/10.png\",\"11\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/11.png\",\"12\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/12.png\",\"13\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/13.png\",\"14\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/14.png\",\"15\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/15.png\",\"16\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/16.png\",\"17\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/17.png\",\"18\":\"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/q/18.png\"},\n    tabPages: (_cloudCfg && _cloudCfg.tabPages) || {\"1\":\"yiqicao\",\"2\":\"aiqingdao\",\"3\":\"madou\",\"4\":\"yingpian\",\"5\":\"zhibo\",\"6\":\"zhibopindao\",\"7\":\"huya\",\"8\":\"huya_jx\",\"9\":\"JHYS\",\"10\":\"QM\",\"11\":\"XY\",\"12\":\"XF\",\"13\":\"SH\",\"14\":\"NN\",\"15\":\"HK\",\"16\":\"DZ\",\"17\":\"DD\",\"18\":\"WFM\"},\n    modeTabs: (_cloudCfg && _cloudCfg.modeTabs) || {\"normal\":[\"9\",\"17\",\"18\"],\"live\":[\"7\",\"8\"],\"short_drama\":[\"10\",\"11\",\"12\",\"13\",\"14\",\"15\",\"16\"],\"adult\":[\"1\",\"2\",\"3\",\"5\",\"6\"]},\n\n    getTabInfo: function(mode) {\n        var ids = this.modeTabs[mode] || [];\n        var result = {};\n        for (var i = 0; i < ids.length; i++) {\n            var id = String(ids[i]);\n            if (this.tabNames[id] !== undefined) result[id] = this.tabNames[id];\n        }\n        return result;\n    },\n\n    getTabIcons: function(mode) {\n        var ids = this.modeTabs[mode] || [];\n        var result = {};\n        for (var i = 0; i < ids.length; i++) {\n            var id = String(ids[i]);\n            if (this.tabIcons[id] !== undefined) result[id] = this.tabIcons[id];\n        }\n        return result;\n    }\n};\n\n$.exports = Tab配置;\n"},{"col_type":"movie_3","name":"Tab配置管理","path":"Tab配置管理","rule":"js:\nvar d = [];\nvar bgColor = getItem('主题颜色', '#F5F5F5');\nvar bgTint = '#15' + bgColor.replace('#', '');\nvar MC = getItem(\"manage_font_color\", \"#333333\");\nvar Color = bgColor;\n\nsetPageTitle(\"Tab配置管理\");\n\nfunction saveBigItem(key, text) {\n    var chunkSize = 400000;\n    var total = Math.ceil(text.length / chunkSize);\n    var oldTotal = parseInt(getItem(key + \"_total\", \"0\"), 10) || 0;\n    for (var i = 0; i < total; i++) {\n        setItem(key + \"_\" + i, text.slice(i * chunkSize, (i + 1) * chunkSize));\n    }\n    for (var i = total; i < oldTotal; i++) {\n        setItem(key + \"_\" + i, \"\");\n    }\n    setItem(key + \"_total\", String(total));\n}\nfunction getBigItem(key) {\n    var total = parseInt(getItem(key + \"_total\", \"0\"), 10) || 0;\n    if (total <= 0) return getItem(key, \"\");\n    var res = \"\";\n    for (var i = 0; i < total; i++) {\n        res += getItem(key + \"_\" + i, \"\");\n    }\n    return res;\n}\n\nvar BIG_ITEM_SRC = \"function saveBigItem(k,t){var cs=400000;var tot=Math.ceil(t.length/cs);var ot=parseInt(getItem(k+'_total','0'),10)||0;for(var i=0;i<tot;i++){setItem(k+'_'+i,t.slice(i*cs,(i+1)*cs));}for(var i=tot;i<ot;i++){setItem(k+'_'+i,'');}setItem(k+'_total',String(tot));}\" +\n    \"function getBigItem(k){var tot=parseInt(getItem(k+'_total','0'),10)||0;if(tot<=0)return getItem(k,'');var r='';for(var i=0;i<tot;i++){r+=getItem(k+'_'+i,'');}return r;}\";\n\nvar modeNameMap = {\n    \"normal\": \"影视模式\",\n    \"short_drama\": \"短剧模式\",\n    \"live\": \"直播模式\",\n    \"adult\": \"成人模式\"\n};\nvar modeKeyList = [\"normal\", \"live\", \"short_drama\", \"adult\"];\n\nfunction loadConfig() {\n    var raw = getBigItem(\"TabConfigData\");\n    var cfg;\n    if (raw) {\n        try { cfg = JSON.parse(raw); } catch(e) {}\n    }\n    if (!cfg || !cfg.tabNames) {\n        var init = $.require(\"Tab配置\");\n        cfg = {\n            tabNames: init.tabNames || {},\n            tabIcons: init.tabIcons || {},\n            tabPages: init.tabPages || {},\n            modeTabs: init.modeTabs || {}\n        };\n    }\n    if (!cfg.tabIcons) cfg.tabIcons = {};\n    if (!cfg.tabPages) cfg.tabPages = {};\n    if (!cfg.modeTabs) cfg.modeTabs = {};\n\n    modeKeyList.forEach(function(m) {\n        var arr = cfg.modeTabs[m] || [];\n        var cleaned = [];\n        arr.forEach(function(id) {\n            var s = String(id == null ? \"\" : id).trim();\n            if (s && cleaned.indexOf(s) === -1) cleaned.push(s);\n        });\n        cfg.modeTabs[m] = cleaned;\n    });\n\n    saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n    return cfg;\n}\n\nvar TabConfig = loadConfig();\nvar manageMode = getItem(\"tab_manage_mode\", \"normal\");\nif (modeKeyList.indexOf(manageMode) === -1) manageMode = \"normal\";\n\nvar nowTabIdList = TabConfig.modeTabs[manageMode] || [];\nvar allTabIds = Object.keys(TabConfig.tabNames || {});\n\nvar editTid = getMyVar(\"tab_edit_state\", \"\");\nvar confirmDel = getMyVar(\"tab_delete_confirm\", \"\");\n\nif (editTid) {\n    var isAdd = (editTid === \"__ADD__\");\n    var isOp  = !isAdd;\n    var defaultName = isAdd ? \"\" : (TabConfig.tabNames[editTid] || \"\");\n    var defaultIcon = isAdd ? \"\" : (TabConfig.tabIcons[editTid] || \"\");\n    var defaultPage = isAdd ? \"\" : (TabConfig.tabPages[editTid] || \"\");\n    var isJoined = isAdd ? false : (nowTabIdList.indexOf(editTid) > -1);\n\n    d.push({\n        title: '<font color=\"' + MC + '\">' + (isAdd ? \"新增 Tab\" : (\"操作：「\" + defaultName + '」(ID:' + editTid + \")\")) + '</font>',\n        pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/122.png\",\n        col_type: \"avatar\",\n        url: \"hiker://empty\"\n    });\n    d.push({ col_type: \"blank_block\" });\n\n    if (confirmDel === editTid && isOp) {\n        // ★ 去掉 font 标签，纯文本显示，避免原样显示\n        d.push({\n            title: '⚠️ 确认删除「' + defaultName + '」？删除后比它大的ID会全部前移',\n            col_type: \"text_center_1\",\n            url: \"hiker://empty\"\n        });\n        d.push({ col_type: \"blank_block\" });\n        d.push({\n            title: \"✅ 确定删除\",\n            col_type: \"flex_button\",\n            url: $().lazyRule(function(tidArg, modeList, bigSrc) {\n                eval(bigSrc);\n                var cfg = JSON.parse(getBigItem(\"TabConfigData\") || \"{}\");\n                if (!cfg.tabNames) cfg.tabNames = {};\n                if (!cfg.tabIcons) cfg.tabIcons = {};\n                if (!cfg.tabPages) cfg.tabPages = {};\n\n                var delNum = parseInt(tidArg, 10);\n                if (isNaN(delNum)) { toast(\"ID非数字\"); return \"hiker://empty\"; }\n\n                var newNames = {}, newIcons = {}, newPages = {}, idMap = {};\n                Object.keys(cfg.tabNames).forEach(function(k) {\n                    var n = parseInt(k, 10);\n                    if (n === delNum) return;\n                    var newId = (n > delNum) ? String(n - 1) : k;\n                    newNames[newId] = cfg.tabNames[k];\n                    newIcons[newId] = cfg.tabIcons[k] || \"\";\n                    newPages[newId] = cfg.tabPages[k] || \"\";\n                    idMap[k] = newId;\n                });\n\n                var newModeTabs = {};\n                modeList.forEach(function(m) {\n                    var arr = cfg.modeTabs[m] || [];\n                    var newArr = [];\n                    arr.forEach(function(oldId) {\n                        if (idMap[oldId]) newArr.push(idMap[oldId]);\n                    });\n                    newModeTabs[m] = newArr;\n                });\n\n                cfg.tabNames = newNames;\n                cfg.tabIcons = newIcons;\n                cfg.tabPages = newPages;\n                cfg.modeTabs = newModeTabs;\n                saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n\n                putMyVar(\"tab_edit_state\", \"\");\n                putMyVar(\"tab_delete_confirm\", \"\");\n                toast(\"🗑️ 已删除\");\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }, editTid, [\"normal\", \"live\", \"short_drama\", \"adult\"], BIG_ITEM_SRC),\n            extra: { text_color: MC }\n        });\n        d.push({\n            title: \"❌ 取消删除\",\n            col_type: \"flex_button\",\n            url: $().lazyRule(function() {\n                putMyVar(\"tab_delete_confirm\", \"\");\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }),\n            extra: { text_color: MC }\n        });\n        d.push({ col_type: \"line\" });\n    } else {\n        d.push({\n            title: \"名字：\" + (defaultName || \"输入新名字\"),\n            desc: isAdd ? \"输入后自动创建\" : \"点击修改名字\",\n            col_type: \"input\",\n            extra: { defaultValue: defaultName },\n            url: $.toString(function(tidArg, isAddArg, bigSrc) {\n                eval(bigSrc);\n                var newName = (input || \"\").trim();\n                if (!newName) { toast(\"名字不能为空\"); return \"hiker://empty\"; }\n                var cfg = JSON.parse(getBigItem(\"TabConfigData\") || \"{}\");\n                if (!cfg.tabNames) cfg.tabNames = {};\n                if (!cfg.tabIcons) cfg.tabIcons = {};\n                if (!cfg.tabPages) cfg.tabPages = {};\n                if (isAddArg === \"1\") {\n                    var max = 0;\n                    var keys = Object.keys(cfg.tabNames);\n                    for (var i = 0; i < keys.length; i++) {\n                        var n = parseInt(keys[i], 10);\n                        if (!isNaN(n) && String(n) === keys[i] && n > max) max = n;\n                    }\n                    var newId = String(max + 1);\n                    cfg.tabNames[newId] = newName;\n                    cfg.tabIcons[newId] = \"\";\n                    cfg.tabPages[newId] = \"\";\n                    saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n                    putMyVar(\"tab_edit_state\", newId);\n                    toast(\"✅ 已创建 ID:\" + newId);\n                } else {\n                    cfg.tabNames[tidArg] = newName;\n                    saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n                    toast(\"名字已保存\");\n                }\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }, editTid, isAdd ? \"1\" : \"0\", BIG_ITEM_SRC)\n        });\n\n        if (isOp) {\n            d.push({\n                title: \"处理页面：\" + (defaultPage || \"点此输入\"),\n                desc: \"如 douyu / huya / madou\",\n                col_type: \"input\",\n                extra: { defaultValue: defaultPage },\n                url: $.toString(function(tidArg, bigSrc) {\n                    eval(bigSrc);\n                    var newPage = (input || \"\").trim();\n                    var cfg = JSON.parse(getBigItem(\"TabConfigData\") || \"{}\");\n                    if (!cfg.tabPages) cfg.tabPages = {};\n                    cfg.tabPages[tidArg] = newPage;\n                    saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n                    toast(\"已保存：\" + newPage);\n                    try { refreshPage(true); } catch(e) {}\n                    return \"hiker://empty\";\n                }, editTid, BIG_ITEM_SRC)\n            });\n        }\n\n        if (isOp) {\n            d.push({\n                title: \"图标：\" + (defaultIcon ? \"已设置\" : \"请输入链接\"),\n                desc: \"点击修改（留空清除）\",\n                col_type: \"input\",\n                extra: { defaultValue: defaultIcon },\n                url: $.toString(function(tidArg, bigSrc) {\n                    eval(bigSrc);\n                    var newIcon = (input || \"\").trim();\n                    var cfg = JSON.parse(getBigItem(\"TabConfigData\") || \"{}\");\n                    if (!cfg.tabIcons) cfg.tabIcons = {};\n                    cfg.tabIcons[tidArg] = newIcon;\n                    saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n                    toast(newIcon ? \"已保存\" : \"已清除\");\n                    try { refreshPage(true); } catch(e) {}\n                    return \"hiker://empty\";\n                }, editTid, BIG_ITEM_SRC)\n            });\n        }\n\n        if (isOp) {\n            d.push({\n                title: isJoined ? \"➖ 移出当前模式\" : \"➕ 加入当前模式\",\n                col_type: \"flex_button\",\n                url: $().lazyRule(function(tidArg, mode, bigSrc) {\n                    eval(bigSrc);\n                    var cfg = JSON.parse(getBigItem(\"TabConfigData\") || \"{}\");\n                    if (!cfg.modeTabs) cfg.modeTabs = {};\n                    if (!cfg.modeTabs[mode]) cfg.modeTabs[mode] = [];\n                    var arr = cfg.modeTabs[mode];\n                    var pos = arr.indexOf(tidArg);\n                    if (pos > -1) { arr.splice(pos, 1); toast(\"已移出\"); }\n                    else { arr.push(tidArg); toast(\"已加入\"); }\n                    saveBigItem(\"TabConfigData\", JSON.stringify(cfg));\n                    try { refreshPage(true); } catch(e) {}\n                    return \"hiker://empty\";\n                }, editTid, manageMode, BIG_ITEM_SRC),\n                extra: { text_color: MC }\n            });\n        }\n\n        if (isOp) {\n            d.push({\n                title: \"🗑️ 删除此Tab\",\n                col_type: \"flex_button\",\n                url: $().lazyRule(function(tidArg) {\n                    putMyVar(\"tab_delete_confirm\", tidArg);\n                    try { refreshPage(true); } catch(e) {}\n                    return \"hiker://empty\";\n                }, editTid),\n                extra: { text_color: MC }\n            });\n        }\n\n        d.push({\n            title: \"❌ 退出\",\n            col_type: \"flex_button\",\n            url: $().lazyRule(function() {\n                putMyVar(\"tab_edit_state\", \"\");\n                putMyVar(\"tab_delete_confirm\", \"\");\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }),\n            extra: { text_color: MC }\n        });\n    }\n    d.push({ col_type: \"line\" });\n}\n\nd.push({\n    title: '<font color=\"' + MC + '\">' + modeNameMap[manageMode] + \" ID</font>\",\n    desc: '<font color=\"' + MC + '\">' + (nowTabIdList.length ? nowTabIdList.join(\",\") : \"（空）\") + '</font>',\n    pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/122.png\",\n    col_type: \"avatar\",\n    url: \"hiker://empty\",\n    extra: { backgroundColor: bgTint, lineVisible: true }\n});\n\nfor (var mi = 0; mi < modeKeyList.length; mi++) {\n    (function() {\n        var mKey = modeKeyList[mi];\n        var mName = modeNameMap[mKey];\n        var mCount = (TabConfig.modeTabs[mKey] || []).length;\n        var isActive = (mKey === manageMode);\n        d.push({\n            title: (isActive ? \"● \" : \"\") + mName + \"(\" + mCount + \")\",\n            url: $().lazyRule(function(key) {\n                setItem(\"tab_manage_mode\", key);\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }, mKey),\n            col_type: \"flex_button\",\n            extra: isActive\n                ? { text_color: Color, text_bold: true }\n                : { text_color: MC }\n        });\n    })();\n}\n\nd.push({ col_type: \"line\" });\n\nd.push({\n    title: '<font color=\"' + MC + '\">新增Tab</font>',\n    desc: '<font color=\"' + MC + '\">点击进入新增模式，自动分配ID</font>',\n    pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/35.png\",\n    col_type: \"avatar\",\n    url: $().lazyRule(function() {\n        putMyVar(\"tab_edit_state\", \"__ADD__\");\n        putMyVar(\"tab_delete_confirm\", \"\");\n        try { refreshPage(true); } catch(e) {}\n        return \"hiker://empty\";\n    }),\n    extra: { backgroundColor: bgTint, lineVisible: true }\n});\n\n// ★ 删除「导出配置」按钮\n\nd.push({ col_type: \"line\" });\n\nfor (var k = 0; k < allTabIds.length; k++) {\n    (function() {\n        var tid = allTabIds[k];\n        var tabName = TabConfig.tabNames[tid] || \"未知Tab\";\n        var tabIconUrl = TabConfig.tabIcons[tid] || \"\";\n        var tabPageName = TabConfig.tabPages[tid] || \"\";\n        var isJoined = nowTabIdList.indexOf(tid) > -1;\n        var prefix = isJoined ? \"✅ \" : \"➕ \";\n\n        d.push({\n            title: '<font color=\"' + MC + '\">' + prefix + tabName + '</font>',\n            desc: '<font color=\"' + MC + '\">' + (isJoined ? \"已加入\" : \"未加入\") + \" | ID:\" + tid +\n                  (tabPageName ? \" | 页面:\" + tabPageName : \"\") + '</desc>',\n            pic_url: tabIconUrl,\n            col_type: 'avatar',\n            url: $().lazyRule(function(tidArg) {\n                putMyVar(\"tab_edit_state\", tidArg);\n                putMyVar(\"tab_delete_confirm\", \"\");\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }, tid),\n            extra: {\n                backgroundColor: isJoined ? bgTint : \"transparent\",\n                lineVisible: true\n            }\n        });\n    })();\n}\n\nsetResult(d);"},{"col_type":"movie_3","name":"管理","path":"管理","rule":"js:\nvar d = [];\nsetPageTitle(\"管理\");\n\ntry {\n    if (fileExist(\"hiker://files/Jm/pause_msg.txt\") && !getItem(\"pause_msg\", \"\")) {\n        var _pm = readFile(\"hiker://files/Jm/pause_msg.txt\");\n        if (_pm && _pm.trim()) setItem(\"pause_msg\", _pm.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/home_title.txt\") && !getItem(\"home_title\", \"\")) {\n        var _ht = readFile(\"hiker://files/Jm/home_title.txt\");\n        if (_ht && _ht.trim()) setItem(\"home_title\", _ht.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/home_desc.txt\") && !getItem(\"home_desc\", \"\")) {\n        var _hd = readFile(\"hiker://files/Jm/home_desc.txt\");\n        if (_hd && _hd.trim()) setItem(\"home_desc\", _hd.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/min_version.txt\") && !getItem(\"min_version\", \"\")) {\n        var _mv = readFile(\"hiker://files/Jm/min_version.txt\");\n        if (_mv && _mv.trim()) setItem(\"min_version\", _mv.trim());\n    }\n} catch(e) {}\ntry {\n    var _tkFile = \"hiker://files/Jm/tk.txt\";\n    if (fileExist(_tkFile)) {\n        var _savedTk = readFile(_tkFile);\n        if (_savedTk && _savedTk.trim() && !getItem(\"tab_gitee_token\", \"\")) {\n            setItem(\"tab_gitee_token\", _savedTk.trim());\n        }\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/jianguo_user.txt\") && !getItem(\"jianguo_user\", \"\")) {\n        var _ju = readFile(\"hiker://files/Jm/jianguo_user.txt\");\n        if (_ju && _ju.trim()) setItem(\"jianguo_user\", _ju.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/jianguo_pass.txt\") && !getItem(\"jianguo_pass\", \"\")) {\n        var _jp = readFile(\"hiker://files/Jm/jianguo_pass.txt\");\n        if (_jp && _jp.trim()) setItem(\"jianguo_pass\", _jp.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/cmd_stable.txt\") && !getItem(\"cmd_stable\", \"\")) {\n        var _c1 = readFile(\"hiker://files/Jm/cmd_stable.txt\");\n        if (_c1 && _c1.trim()) setItem(\"cmd_stable\", _c1.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/cmd_beta.txt\") && !getItem(\"cmd_beta\", \"\")) {\n        var _c2 = readFile(\"hiker://files/Jm/cmd_beta.txt\");\n        if (_c2 && _c2.trim()) setItem(\"cmd_beta\", _c2.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/ver_stable.txt\") && !getItem(\"ver_stable\", \"\")) {\n        var _vs = readFile(\"hiker://files/Jm/ver_stable.txt\");\n        if (_vs && _vs.trim()) setItem(\"ver_stable\", _vs.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/ver_beta.txt\") && !getItem(\"ver_beta\", \"\")) {\n        var _vb = readFile(\"hiker://files/Jm/ver_beta.txt\");\n        if (_vb && _vb.trim()) setItem(\"ver_beta\", _vb.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/log_stable.txt\") && !getItem(\"log_stable\", \"\")) {\n        var _ls = readFile(\"hiker://files/Jm/log_stable.txt\");\n        if (_ls && _ls.trim()) setItem(\"log_stable\", _ls.trim());\n    }\n} catch(e) {}\ntry {\n    if (fileExist(\"hiker://files/Jm/log_beta.txt\") && !getItem(\"log_beta\", \"\")) {\n        var _lb = readFile(\"hiker://files/Jm/log_beta.txt\");\n        if (_lb && _lb.trim()) setItem(\"log_beta\", _lb.trim());\n    }\n} catch(e) {}\n\nvar ADMIN_HASH = \"107655053eaa340d\";\nvar SALT = \"manage_salt_2026\";\n\nvar HASH_FN_SRC = \"function hashPwd(str){\" +\n    \"var h=5381;\" +\n    \"for(var i=0;i<str.length;i++){h=((h<<5)+h)+str.charCodeAt(i);h=h&0x7fffffff;}\" +\n    \"var h2=52711;\" +\n    \"for(var j=0;j<str.length;j++){h2=((h2<<5)+h2)^str.charCodeAt(j);h2=h2&0x7fffffff;}\" +\n    \"return (h.toString(16)+h2.toString(16)).padStart(16,'0');\" +\n    \"}\";\n\nvar COPY_FN_SRC = \"function doCopy(txt){\" +\n    \"try{if(typeof setClipboard==='function'){setClipboard(txt);return true;}}catch(e){}\" +\n    \"try{if(typeof copy==='function'){copy(txt);return true;}}catch(e){}\" +\n    \"try{if(typeof setClipboardText==='function'){setClipboardText(txt);return true;}}catch(e){}\" +\n    \"return false;\" +\n    \"}\";\n\nvar passed = getMyVar(\"manage_passed\", \"\");\n\nif (passed !== \"OK\") {\n    d.push({ col_type: \"big_blank_block\" });\n    if (ADMIN_HASH === \"INIT\") {\n        d.push({ title: \"首次使用请设置管理密码\", col_type: \"text_center_1\", url: \"hiker://empty\" });\n        d.push({ col_type: \"blank_block\" });\n        d.push({\n            title: \"确定\", desc: \"首次进入请设置密码\", col_type: \"input\",\n            extra: { defaultValue: \"\" },\n            url: $.toString(function(salt, fnSrc) {\n                eval(fnSrc);\n                var v = (input || \"\").trim();\n                if (!v) { toast(\"密码不能为空\"); return \"hiker://empty\"; }\n                if (v.length < 6) { toast(\"密码至少6位\"); return \"hiker://empty\"; }\n                var h = hashPwd(v + salt);\n                putMyVar(\"manage_new_hash\", h);\n                toast(\"✅ 已生成哈希\");\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            }, SALT, HASH_FN_SRC)\n        });\n        var _newHash = getMyVar(\"manage_new_hash\", \"\");\n        if (_newHash) {\n            d.push({ col_type: \"line\" });\n            d.push({ title: \"点击复制下面的哈希，填回代码第 8 行\", col_type: \"text_center_1\", url: \"hiker://empty\" });\n            d.push({\n                title: \"点击复制哈希\", col_type: \"flex_button\",\n                url: $('#noLoading#').lazyRule(function(h, fnSrc) {\n                    eval(fnSrc);\n                    var ok = doCopy(h);\n                    if (ok) toast(\"✅ 已复制，填回代码 ADMIN_HASH\");\n                    else toast(\"哈希：\" + h);\n                    return \"hiker://empty\";\n                }, _newHash, COPY_FN_SRC)\n            });\n            d.push({ col_type: \"blank_block\" });\n            d.push({ title: \"哈希预览：\", col_type: \"text_center_1\", url: \"hiker://empty\" });\n            d.push({ title: _newHash, col_type: \"text_center_1\", url: \"hiker://empty\" });\n        }\n        setResult(d);\n    } else {\n        d.push({ title: \"🔐 管理验证\", col_type: \"text_center_1\", url: \"hiker://empty\" });\n        d.push({ col_type: \"blank_block\" });\n        d.push({\n            title: \"确定\", desc: \"请输入密码\", col_type: \"input\",\n            extra: { defaultValue: \"\" },\n            url: $.toString(function(realHash, salt, fnSrc) {\n                eval(fnSrc);\n                var v = (input || \"\").trim();\n                if (!v) { toast(\"密码不能为空\"); return \"hiker://empty\"; }\n                var h = hashPwd(v + salt);\n                if (h === realHash) {\n                    putMyVar(\"manage_passed\", \"OK\");\n                    toast(\"✅ 验证通过\");\n                    try { refreshPage(true); } catch(e) {}\n                    return \"hiker://empty\";\n                } else {\n                    toast(\"❌ 密码错误\");\n                    return \"hiker://empty\";\n                }\n            }, ADMIN_HASH, SALT, HASH_FN_SRC)\n        });\n        setResult(d);\n    }\n} else {\n    var bgColor = getItem('主题颜色', '#F5F5F5');\n    var bgTint = '#15' + bgColor.replace('#', '');\n    var FontColor = getItem('manage_font_color', '#333333');\n\n    var view = getMyVar('manage_view', 'home');\n    var _stay = getMyVar('manage_stay', '');\n    if (_stay === '1') {\n        putMyVar('manage_stay', '');\n    } else {\n        view = 'home';\n        putMyVar('manage_view', 'home');\n    }\n\n    function pushBack() {\n        d.push({\n            title: '← 返回主页',\n            col_type: 'flex_button',\n            url: $('#noLoading#').lazyRule(function() {\n                putMyVar('manage_view', 'home');\n                putMyVar('manage_stay', '1');\n                refreshPage();\n                return 'hiker://empty';\n            }),\n            extra: { text_color: FontColor }\n        });\n        d.push({ col_type: 'blank_block' });\n    }\n\n    if (view === 'account') {\n        pushBack();\n        d.push({ title: '账号设置', desc: 'Token / 坚果云账号密码', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: FontColor, text_size: '16' } });\n        d.push({ col_type: 'line' });\n\n        d.push({\n            title: \"Token\" + (getItem(\"tab_gitee_token\", \"\") ? \"已设置\" : \"未设置\"),\n            desc: \"粘贴 Gitee 私人令牌（保留，暂时不用）\",\n            col_type: \"input\", extra: { defaultValue: \"\" },\n            url: $.toString(function() {\n                var v = (input || \"\").trim();\n                if (!v) { toast(\"不能为空\"); return \"hiker://empty\"; }\n                setItem(\"tab_gitee_token\", v);\n                try { writeFile(\"hiker://files/Jm/tk.txt\", v); } catch(e) {}\n                toast(\"✅ Token 已保存\");\n                putMyVar('manage_stay', '1');\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            })\n        });\n        d.push({\n            title: \"坚果云账号\", desc: getItem(\"jianguo_user\", \"\") ? \"已设置\" : \"未设置\",\n            col_type: \"input\", extra: { defaultValue: getItem(\"jianguo_user\", \"\") },\n            url: $.toString(function() {\n                var v = (input || \"\").trim();\n                setItem(\"jianguo_user\", v);\n                try { writeFile(\"hiker://files/Jm/jianguo_user.txt\", v); } catch(e) {}\n                toast(v ? \"✅ 已保存\" : \"已清空\");\n                putMyVar('manage_stay', '1');\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            })\n        });\n        d.push({\n            title: \"坚果云密码\", desc: getItem(\"jianguo_pass\", \"\") ? \"已设置\" : \"未设置\",\n            col_type: \"input\", extra: { defaultValue: \"\" },\n            url: $.toString(function() {\n                var v = (input || \"\").trim();\n                if (!v) { toast(\"不能为空\"); return \"hiker://empty\"; }\n                setItem(\"jianguo_pass\", v);\n                try { writeFile(\"hiker://files/Jm/jianguo_pass.txt\", v); } catch(e) {}\n                toast(\"✅ 已保存\");\n                putMyVar('manage_stay', '1');\n                try { refreshPage(true); } catch(e) {}\n                return \"hiker://empty\";\n            })\n        });\n        setResult(d);\n    }\n\n    else if (view === 'upload') {\n        pushBack();\n        d.push({ title: '上传管理', desc: '数据 / 配置 / 内容 / 缓存', col_type: 'text_center_1', url: 'hiker://empty', extra: { text_color: FontColor, text_size: '16' } });\n        d.push({ col_type: 'line' });\n\n        // ===== 1. 上传数据（从更新日志模块读取硬编码版本号） =====\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">上传数据</font></b>',\n            desc: '<font color=\"' + FontColor + '\">版本 / 公告 / 口令 / 描述 → 坚果云</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/36.png\",\n            col_type: \"avatar\",\n            url: $().lazyRule(function(jgUser, jgPass) {\n                if (!jgUser || !jgPass) { toast(\"❌ 请先设置坚果云账号密码\"); return \"hiker://empty\"; }\n                function b64(str) {\n                    var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n                    var utf8 = unescape(encodeURIComponent(str));\n                    var out = \"\", i = 0;\n                    while (i < utf8.length) {\n                        var c1 = utf8.charCodeAt(i++), c2 = utf8.charCodeAt(i++), c3 = utf8.charCodeAt(i++);\n                        var e1 = c1 >> 2, e2 = ((c1 & 3) << 4) | (c2 >> 4), e3 = ((c2 & 15) << 2) | (c3 >> 6), e4 = c3 & 63;\n                        if (isNaN(c2)) { e3 = e4 = 64; } else if (isNaN(c3)) { e4 = 64; }\n                        out += chars.charAt(e1) + chars.charAt(e2) + (e3 === 64 ? \"=\" : chars.charAt(e3)) + (e4 === 64 ? \"=\" : chars.charAt(e4));\n                    }\n                    return out;\n                }\n\n                var _logStable = {}, _logBeta = {};\n                try { _logStable = $.require('更新日志正式版') || {}; } catch(e) {}\n                try { _logBeta = $.require('更新日志Beta版') || {}; } catch(e) {}\n\n                function _pickLatestLog(mod) {\n                    try {\n                        var data = mod.getData ? mod.getData() : [];\n                        if (data && data.length > 0) {\n                            var first = data[0];\n                            var title = first.title || \"\";\n                            var recs = first.records || [];\n                            return title + \"\\n\" + recs.join(\"\\n\");\n                        }\n                    } catch(e) {}\n                    return \"\";\n                }\n\n                var _newVerStable = _logStable.CURRENT_VERSION || \"\";\n                var _newVerBeta = _logBeta.CURRENT_BETA_VERSION || \"\";\n                var _newLogStable = _pickLatestLog(_logStable);\n                var _newLogBeta = _pickLatestLog(_logBeta);\n\n                var json = JSON.stringify({\n                    announcement: getItem(\"tab_announcement\", \"\"),\n                    ver_stable: _newVerStable,\n                    log_stable: _newLogStable,\n                    cmd_stable: getItem(\"cmd_stable\", \"\"),\n                    ver_beta: _newVerBeta,\n                    log_beta: _newLogBeta,\n                    cmd_beta: getItem(\"cmd_beta\", \"\"),\n                    home_title: getItem(\"home_title\", \"\"),\n                    home_desc: getItem(\"home_desc\", \"\"),\n                    pause_msg: getItem(\"pause_msg\", \"\"),\n                    min_version: getItem(\"min_version\", \"\")\n                });\n\n                var jgUrl = \"https://dav.jianguoyun.com/dav/luke/app-config.json\";\n                var jgAuth = \"Basic \" + b64(jgUser + \":\" + jgPass);\n\n                try {\n                    request(jgUrl, {\n                        method: \"PUT\",\n                        headers: { \"Authorization\": jgAuth, \"Content-Type\": \"application/json; charset=utf-8\" },\n                        body: json, timeout: 15000\n                    });\n                    setItem(\"ver_stable\", _newVerStable);\n                    setItem(\"ver_beta\", _newVerBeta);\n                    setItem(\"log_stable\", _newLogStable);\n                    setItem(\"log_beta\", _newLogBeta);\n                    try { writeFile(\"hiker://files/Jm/ver_stable.txt\", _newVerStable); } catch(e) {}\n                    try { writeFile(\"hiker://files/Jm/ver_beta.txt\", _newVerBeta); } catch(e) {}\n                    try { writeFile(\"hiker://files/Jm/log_stable.txt\", _newLogStable); } catch(e) {}\n                    try { writeFile(\"hiker://files/Jm/log_beta.txt\", _newLogBeta); } catch(e) {}\n                    setItem(\"tab_cloud_time\", \"0\");\n                    setItem(\"status_gitcode\", JSON.stringify({ ok: true, msg: \"上传成功（稳定 \" + _newVerStable + \" / Beta \" + _newVerBeta + \"，共 \" + json.length + \" 字节）\", time: Date.now(), size: json.length }));\n                    toast(\"✅ 已上传：正式 \" + _newVerStable + \" / Beta \" + _newVerBeta);\n                } catch(e) {\n                    setItem(\"status_gitcode\", JSON.stringify({ ok: false, msg: \"上传失败：\" + e.message, time: Date.now() }));\n                    toast(\"❌ 上传失败：\" + e.message);\n                }\n                putMyVar('manage_stay', '1');\n                refreshPage();\n                return \"hiker://empty\";\n            }, getItem(\"jianguo_user\", \"\"), getItem(\"jianguo_pass\", \"\")),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n\n        // ===== 2. 上传配置 =====\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">上传配置</font></b>',\n            desc: '<font color=\"' + FontColor + '\">Tab 名字 / 代号 / 模式 → 坚果云</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/36.png\",\n            col_type: \"avatar\",\n            url: $().lazyRule(function(jgUser, jgPass) {\n                if (!jgUser || !jgPass) { toast(\"❌ 请先设置坚果云账号密码\"); return \"hiker://empty\"; }\n                function b64(str) {\n                    var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n                    var utf8 = unescape(encodeURIComponent(str));\n                    var out = \"\", i = 0;\n                    while (i < utf8.length) {\n                        var c1 = utf8.charCodeAt(i++), c2 = utf8.charCodeAt(i++), c3 = utf8.charCodeAt(i++);\n                        var e1 = c1 >> 2, e2 = ((c1 & 3) << 4) | (c2 >> 4), e3 = ((c2 & 15) << 2) | (c3 >> 6), e4 = c3 & 63;\n                        if (isNaN(c2)) { e3 = e4 = 64; } else if (isNaN(c3)) { e4 = 64; }\n                        out += chars.charAt(e1) + chars.charAt(e2) + (e3 === 64 ? \"=\" : chars.charAt(e3)) + (e4 === 64 ? \"=\" : chars.charAt(e4));\n                    }\n                    return out;\n                }\n\n                var cfg;\n                try {\n                    var _raw = \"\";\n                    var _tU = parseInt(getItem(\"TabConfigData_total\", \"0\"), 10) || 0;\n                    if (_tU > 0) { for (var _iU = 0; _iU < _tU; _iU++) _raw += getItem(\"TabConfigData_\" + _iU, \"\"); }\n                    else { _raw = getItem(\"TabConfigData\", \"\"); }\n                    if (_raw && _raw.trim()) cfg = JSON.parse(_raw);\n                } catch(e) {}\n                if (!cfg || !cfg.tabNames) {\n                    var _init = $.require(\"Tab配置\");\n                    cfg = { tabNames: _init.tabNames || {}, tabIcons: _init.tabIcons || {}, tabPages: _init.tabPages || {}, modeTabs: _init.modeTabs || {} };\n                }\n\n                var tabData = JSON.stringify({\n                    tabNames: cfg.tabNames, tabIcons: cfg.tabIcons,\n                    tabPages: cfg.tabPages || {}, modeTabs: cfg.modeTabs\n                });\n\n                if (tabData.length < 500) {\n                    toast(\"❌ 本地配置仅 \" + tabData.length + \" 字节，疑似空数据\");\n                    return \"hiker://empty\";\n                }\n\n                var jgUrl = \"https://dav.jianguoyun.com/dav/luke/tab-config.json\";\n                var jgAuth = \"Basic \" + b64(jgUser + \":\" + jgPass);\n\n                try {\n                    request(jgUrl, {\n                        method: \"PUT\",\n                        headers: { \"Authorization\": jgAuth, \"Content-Type\": \"application/json; charset=utf-8\" },\n                        body: tabData, timeout: 15000\n                    });\n                    setItem(\"tab_jg_time\", \"0\");\n                    setItem(\"cloud_tab_cache_time\", \"0\");\n                    setItem(\"status_jianguo\", JSON.stringify({ ok: true, msg: \"上传成功（\" + tabData.length + \" 字节）\", time: Date.now(), size: tabData.length }));\n                    toast(\"✅ 坚果云上传成功（\" + tabData.length + \" 字节）\");\n                } catch(e) {\n                    setItem(\"status_jianguo\", JSON.stringify({ ok: false, msg: \"PUT 异常：\" + e.message, time: Date.now() }));\n                    toast(\"❌ 坚果云异常：\" + e.message);\n                }\n                putMyVar('manage_stay', '1');\n                refreshPage();\n                return \"hiker://empty\";\n            }, getItem(\"jianguo_user\", \"\"), getItem(\"jianguo_pass\", \"\")),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n\n        // ===== 3. 上传内容 =====\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">上传内容</font></b>',\n            desc: '<font color=\"' + FontColor + '\">遍历所有源，全部传到坚果云</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/36.png\",\n            col_type: \"avatar\",\n            url: $().lazyRule(function(jgUser, jgPass) {\n                var lockKey = 'manage_uploading_lock';\n                if (getMyVar(lockKey, '') === '1') {\n                    toast(\"⏳ 正在上传中，请耐心等待...\");\n                    return \"hiker://empty\";\n                }\n                putMyVar(lockKey, '1');\n                toast(\"⏳ 开始解析并上传，请勿离开页面...\");\n\n                try {\n                    if (!jgUser || !jgPass) { toast(\"❌ 请先设置坚果云账号密码\"); return \"hiker://empty\"; }\n                    function b64(str) {\n                        var chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n                        var utf8 = unescape(encodeURIComponent(str));\n                        var out = \"\", i = 0;\n                        while (i < utf8.length) {\n                            var c1 = utf8.charCodeAt(i++), c2 = utf8.charCodeAt(i++), c3 = utf8.charCodeAt(i++);\n                            var e1 = c1 >> 2, e2 = ((c1 & 3) << 4) | (c2 >> 4), e3 = ((c2 & 15) << 2) | (c3 >> 6), e4 = c3 & 63;\n                            if (isNaN(c2)) { e3 = e4 = 64; } else if (isNaN(c3)) { e4 = 64; }\n                            out += chars.charAt(e1) + chars.charAt(e2) + (e3 === 64 ? \"=\" : chars.charAt(e3)) + (e4 === 64 ? \"=\" : chars.charAt(e4));\n                        }\n                        return out;\n                    }\n                    var auth = \"Basic \" + b64(jgUser + \":\" + jgPass);\n\n                    var TabCfg = $.require(\"Tab配置\");\n                    var allPages = TabCfg.tabPages || {};\n                    var allNames = TabCfg.tabNames || {};\n\n                    var list = [];\n                    var seen = {};\n                    for (var id in allPages) {\n                        if (!allPages.hasOwnProperty(id)) continue;\n                        var pk = allPages[id];\n                        if (!pk || seen[pk]) continue;\n                        seen[pk] = true;\n                        list.push({ pageKey: pk, name: allNames[id] || pk });\n                    }\n\n                    if (list.length === 0) {\n                        toast(\"❌ Tab配置里没有源\");\n                        return \"hiker://empty\";\n                    }\n\n                    var okCount = 0, failCount = 0, skipCount = 0;\n                    var failList = [], skipList = [];\n                    var tStart = Date.now();\n\n                    for (var i = 0; i < list.length; i++) {\n                        var item = list[i];\n                        var fileName = item.pageKey + \".js\";\n                        var filePath = \"hiker://files/Jm/tabs/\" + fileName;\n\n                        if (!fileExist(filePath)) {\n                            skipCount++;\n                            skipList.push(item.name + \"（\" + fileName + \"）\");\n                            continue;\n                        }\n\n                        var rule = \"\";\n                        try { rule = readFile(filePath); } catch(e) {\n                            failCount++;\n                            failList.push(item.name + \"：读取失败\");\n                            continue;\n                        }\n                        if (!rule || rule.length < 100) {\n                            skipCount++;\n                            skipList.push(item.name + \"（内容过短）\");\n                            continue;\n                        }\n\n                        var url = \"https://dav.jianguoyun.com/dav/luke/tabs/\" + fileName;\n                        try {\n                            request(url, {\n                                method: \"PUT\",\n                                headers: {\n                                    \"Authorization\": auth,\n                                    \"Content-Type\": \"text/plain; charset=utf-8\",\n                                    \"User-Agent\": \"Mozilla/5.0 (Linux; Android 15)\"\n                                },\n                                body: rule,\n                                timeout: 30000\n                            });\n                            var rec = { ok: true, name: fileName, pageKey: item.pageKey, size: rule.length, time: Date.now() };\n                            setItem(\"status_tab_content_\" + item.pageKey, JSON.stringify(rec));\n                            setItem(\"status_tab_content_last\", JSON.stringify(rec));\n                            okCount++;\n                        } catch(e) {\n                            var rec2 = { ok: false, name: fileName, pageKey: item.pageKey, size: rule.length, msg: e.message, time: Date.now() };\n                            setItem(\"status_tab_content_\" + item.pageKey, JSON.stringify(rec2));\n                            failCount++;\n                            failList.push(item.name + \"：\" + e.message);\n                        }\n\n                        if (i % 3 === 0) {\n                            var _w = Date.now(); while (Date.now() - _w < 50) {}\n                        }\n                    }\n\n                    var summary = \"\";\n                    summary += \"✅ 成功：\" + okCount + \"\\n\";\n                    if (failCount > 0) summary += \"❌ 失败：\" + failCount + \"\\n\";\n                    if (skipCount > 0) summary += \"⏭ 跳过：\" + skipCount + \"\\n\";\n                    summary += \"\\n总源数：\" + list.length;\n                    summary += \"\\n耗时：\" + Math.round((Date.now() - tStart) / 1000) + \" 秒\";\n                    if (failList.length > 0) summary += \"\\n\\n【失败详情】\\n\" + failList.slice(0, 15).join(\"\\n\");\n                    if (skipList.length > 0) summary += \"\\n\\n【跳过详情】（本地无源码文件）\\n\" + skipList.slice(0, 15).join(\"\\n\");\n\n                    toast(\"完成：成功 \" + okCount + \" / 失败 \" + failCount + \" / 跳过 \" + skipCount);\n\n                    var _pop = $.require('弹窗工具');\n                    _pop.show(\"📦 上传内容结果\", [{ title: \"统计\", records: [summary] }]);\n                } finally {\n                    putMyVar(lockKey, '');\n                    putMyVar('manage_stay', '1');\n                    refreshPage();\n                }\n                return \"hiker://empty\";\n            }, getItem(\"jianguo_user\", \"\"), getItem(\"jianguo_pass\", \"\")),\n            extra: { backgroundColor: bgTint, lineVisible: true }\n        });\n\n        // ===== 4. 导出配置 =====\n        d.push({\n            title: '<b><font color=\"' + FontColor + '\">导出配置</font></b>',\n            desc: '<font color=\"' + FontColor + '\">生成模块代码，整段覆盖</font>',\n            pic_url: \"https://ghproxy.net/https://raw.githubusercontent.com/ls125781003/tubiao/main/more/36.png\",\n            col_type: \"avatar\",\n            url: $('#noLoading#').lazyRule(function(fnSrc) {\n                eval(fnSrc);\n                var cfg = null;\n                try {\n                    var _raw = \"\";\n                    var _tU = parseInt(getItem(\"TabConfigData_total\", \"0\"), 10) || 0;\n                    if (_tU > 0) { for (var _iU = 0; _iU < _tU; _iU++) _raw += getItem(\"TabConfigData_\" + _iU, \"\"); }\n                    else { _raw = getItem(\"TabConfigData\", \"\"); }\n                    if (_raw && _raw.trim()) cfg = JSON.parse(_raw);\n                } catch(e) {}\n                if (!cfg || !cfg.tabNames) {\n                    var _init = $.require(\"Tab配置\");\n                    cfg = { tabNames: _init.tabNames || {}, tabIcons: _init.tabIcons || {}, tabPages: _init.tabPages || {}, modeTabs: _init.modeTabs || {} };\n                }\n\n                var NL = \"\\n\";\n                var code = \"\";\n                code += \"// ===== 读开关：cloud=拉云端，local=只读本地硬编码 =====\" + NL;\n                code += \"var _rtMode = getItem('tab_runtime_mode', 'cloud');\" + NL;\n                code += \"var _cloudCfg = null;\" + NL;\n                code += \"if (_rtMode === 'cloud') {\" + NL;\n                code += \"    try {\" + NL;\n                code += \"        var _ct = parseInt(getItem('cloud_tab_cache_time', '0'), 10) || 0;\" + NL;\n                code += \"        var _raw = '';\" + NL;\n                code += \"        if (Date.now() - _ct < 5 * 60 * 1000) {\" + NL;\n                code += \"            _raw = getItem('cloud_tab_cache', '');\" + NL;\n                code += \"        } else {\" + NL;\n                code += \"            try {\" + NL;\n                code += \"                var _auth = 'Basic ' + base64Encode('344009759@qq.com:a48q28fuzjp7qehc');\" + NL;\n                code += \"                var _resp = request('https://dav.jianguoyun.com/dav/luke/tab-config.json', { headers: { 'Authorization': _auth }, timeout: 8000 });\" + NL;\n                code += \"                if (_resp && _resp.length > 500) {\" + NL;\n                code += \"                    _raw = _resp;\" + NL;\n                code += \"                    setItem('cloud_tab_cache', _resp);\" + NL;\n                code += \"                    setItem('cloud_tab_cache_time', String(Date.now()));\" + NL;\n                code += \"                }\" + NL;\n                code += \"            } catch(e) {}\" + NL;\n                code += \"        }\" + NL;\n                code += \"        if (_raw) {\" + NL;\n                code += \"            var _c = JSON.parse(_raw);\" + NL;\n                code += \"            if (_c && _c.tabNames) {\" + NL;\n                code += \"                _cloudCfg = _c;\" + NL;\n                code += \"                setItem('pull_status_tabconfig', JSON.stringify({ ok: true, msg: '拉取成功', time: Date.now() }));\" + NL;\n                code += \"            }\" + NL;\n                code += \"        } else {\" + NL;\n                code += \"            setItem('pull_status_tabconfig', JSON.stringify({ ok: false, msg: '响应为空', time: Date.now() }));\" + NL;\n                code += \"        }\" + NL;\n                code += \"    } catch(e) {\" + NL;\n                code += \"        setItem('pull_status_tabconfig', JSON.stringify({ ok: false, msg: '异常：' + e.message, time: Date.now() }));\" + NL;\n                code += \"    }\" + NL;\n                code += \"}\" + NL;\n                code += NL;\n                code += \"var Tab配置 = {\" + NL;\n                code += \"    tabNames: (_cloudCfg && _cloudCfg.tabNames) || \" + JSON.stringify(cfg.tabNames || {}) + \",\" + NL;\n                code += \"    tabIcons: (_cloudCfg && _cloudCfg.tabIcons) || \" + JSON.stringify(cfg.tabIcons || {}) + \",\" + NL;\n                code += \"    tabPages: (_cloudCfg && _cloudCfg.tabPages) || \" + JSON.stringify(cfg.tabPages || {}) + \",\" + NL;\n                code += \"    modeTabs: (_cloudCfg && _cloudCfg.modeTabs) || \" + JSON.stringify(cfg.modeTabs || {}) + \",\" + NL;\n                code += NL;\n                code += \"    getTabInfo: function(mode) {\" + NL;\n                code += \"        var ids = this.modeTabs[mode] || [];\" + NL;\n                code += \"        var result = {};\" + NL;\n                code += \"        for (var i = 0; i < ids.length; i++) {\" + NL;\n                code += \"            var id = String(ids[i]);\" + NL;\n                code += \"            if (this.tabNames[id] !== undefined) result[id] = this.tabNames[id];\" + NL;\n                code += \"        }\" + NL;\n                code += \"        return result;\" + NL;\n                code += \"    },\" + NL;\n                code += NL;\n                code += \"    getTabIcon