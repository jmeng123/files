g().substr(3, length) + Date.now()).toString(36);\n    }\n\n    function getIconPath() {\n        var pic = {\n            TypeIconObject: {\n                \".js\": \"hiker://images/home_icon_code\",\n                \".txt\": \"hiker://images/icon_txt2\",\n                \".html\": \"hiker://images/icon_offline\",\n                \".apk\": \"hiker://images/icon_app3\",\n                \".json\": \"hiker://images/icon_txt2\",\n                \".zip\": \"hiker://images/icon_zip2\",\n                \".hiker\": \"hiker://images/home_icon_item\",\n                \".mp4\": \"hiker://images/icon_video2\",\n                \".gif\": \"hiker://images/icon_pic3\",\n                \".mp3\": \"hiker://images/icon_music3\"\n            },\n            typePic: [\".svg\", \".png\", \".jpg\"],\n            defaultIcon: \"hiker://images/icon_unknown\",\n            dirIcon: \"hiker://images/icon_folder3\"\n        };\n        var TypeIcon = new Map(Object.entries(pic.TypeIconObject));\n        return {\n            getIconPath: function(path, type) {\n                return (pic.typePic.indexOf(type) !== -1 ? path : TypeIcon.get(type)) || pic.defaultIcon;\n            },\n            dirIcon: pic.dirIcon\n        };\n    }\n\n    function getRank() {\n        var chnNumChar = {零:0,一:1,二:2,三:3,四:4,五:5,六:6,七:7,八:8,九:9};\n        var chnNameValue = {\n            十:{value:10,secUnit:false}, 百:{value:100,secUnit:false},\n            千:{value:1000,secUnit:false}, 万:{value:10000,secUnit:true},\n            亿:{value:100000000,secUnit:true}\n        };\n        function ChineseToNumber(chnStr) {\n            var rtn = 0, section = 0, number = 0, secUnit = false;\n            var str = chnStr.split('');\n            for (var i = 0; i < str.length; i++) {\n                var num = chnNumChar[str[i]];\n                if (typeof num !== 'undefined') {\n                    number = num;\n                    if (i === str.length - 1) section += number;\n                } else {\n                    var unit = chnNameValue[str[i]].value;\n                    secUnit = chnNameValue[str[i]].secUnit;\n                    if (secUnit) { section = (section + number) * unit; rtn += section; section = 0; }\n                    else { section += (number * unit); }\n                    number = 0;\n                }\n            }\n            return rtn + section;\n        }\n        function nameCompare(a, b) {\n            if (a == null || b == null) return a == null ? b == null ? 0 : -1 : 1;\n            a = a.replace(/([零一二三四五六七八九十百千万亿])/g, function(m) { return ChineseToNumber(m); });\n            b = b.replace(/([零一二三四五六七八九十百千万亿])/g, function(m) { return ChineseToNumber(m); });\n            var NUMBERS = java.util.regex.Pattern.compile(\"(?<=\\\\D)(?=\\\\d)|(?<=\\\\d)(?=\\\\D)\");\n            var split1 = NUMBERS.split(new java.lang.String(a));\n            var split2 = NUMBERS.split(new java.lang.String(b));\n            for (var i = 0; i < Math.min(split1.length, split2.length); i++) {\n                var c1 = split1[i].charCodeAt(0);\n                var c2 = split2[i].charCodeAt(0);\n                var cmp = 0;\n                var zero = '0'.charCodeAt(0), nine = '9'.charCodeAt(0);\n                if (c1 >= zero && c1 <= nine && c2 >= zero && c2 <= nine) {\n                    cmp = new java.math.BigInteger(split1[i]).compareTo(new java.math.BigInteger(split2[i]));\n                }\n                if (cmp === 0) {\n                    var regex = /[a-zA-Z0-9]/;\n                    var s1 = String(split1[i]), s2 = String(split2[i]);\n                    if (regex.test(s1) || regex.test(s2)) {\n                        cmp = new java.lang.String(split1[i]).compareTo(new java.lang.String(split2[i]));\n                    } else {\n                        cmp = s1.localeCompare(s2, 'zh');\n                    }\n                }\n                if (cmp !== 0) return cmp;\n            }\n            return split1.length - split2.length;\n        }\n        function rank(list, m, o) {\n            if (m === \"名称\") {\n                list = Array.from(list).sort(function(a, b) { return nameCompare(String(a.getName()).toUpperCase(), String(b.getName()).toUpperCase()); });\n            } else if (m === \"大小\") {\n                list = Array.from(list).sort(function(a, b) { return a.length() - b.length(); });\n            } else if (m === \"时间\") {\n                list = Array.from(list).sort(function(a, b) { return a.lastModified() - b.lastModified(); });\n            }\n            if (o === \"I\") return list.reverse();\n            return list;\n        }\n        return rank;\n    }\n\n    function getFileUtil() {\n        var StandardCopyOption = java.nio.file.StandardCopyOption;\n        var File = java.io.File;\n        var Files = java.nio.file.Files;\n        return {\n            renameFile: function(fromPath, name) {\n                var fromFile = new File(fromPath);\n                var toFile = new File(fromFile.getParent() + \"/\" + name);\n                try {\n                    if (!fromFile.exists()) return false;\n                    if (toFile.exists()) return false;\n                    Files.move(fromFile.toPath(), toFile.toPath(), StandardCopyOption.REPLACE_EXISTING);\n                    return toFile.toString();\n                } catch (e) {\n                    log(e.toString());\n                    return false;\n                }\n            }\n        };\n    }\n\n    function init() {\n        var Paths = java.nio.file.Paths;\n        var Files = java.nio.file.Files;\n        var File = java.io.File;\n        var Thread = java.lang.Thread;\n        var iconData = getIconPath();\n        var dirIcon = iconData.dirIcon;\n        var iconGetter = iconData.getIconPath;\n        var $this = fileSelectObj;\n        var exports = {};\n\n        function getExtension(originalFilename) {\n            originalFilename = String(originalFilename);\n            var i = originalFilename.lastIndexOf(\".\");\n            if (i === -1) return \"\";\n            return originalFilename.substring(i).toLowerCase();\n        }\n\n        function refreshDir(path, configs, isBack) {\n            var load = $.require(\"function\").fileSelect.init().loadFile;\n            load(path, configs);\n            if (isBack) back(false);\n            return \"hiker://empty\";\n        }\n\n        function choose(configs, isBack, id, menuType) {\n            function click(configs, isBack, id) {\n                var callbackFunc = new Function(\"PATH\", \"TYPE\", \"ID\", \"return \" + configs.callback);\n                var v = findItem(id).extra;\n                var path = v.path, type = v.type;\n                $.hiker.input = path;\n                var callbackResult = callbackFunc(path, type, id);\n                if (callbackResult === true) {\n                    if (isBack) {\n                        putMyVar(configs.uid + \":back\", \"true\");\n                        updateItem({ extra: findItem(configs.uid + \"#搜索框1\").extra });\n                    }\n                    back(false);\n                    return \"hiker://empty\";\n                } else if (callbackResult === false) {\n                    return \"hiker://empty\";\n                }\n                return callbackResult;\n            }\n            function menu(click, configs, isBack, id, input) {\n                if (input === \"打开\") return click(configs, isBack, id);\n                var v = findItem(id).extra;\n                var path = v.path;\n                var fileUtil = com.example.hikerview.utils.FileUtil;\n                switch (input) {\n                    case \"复制路径\": return \"copy://\" + path;\n                    case \"编辑文件\": return \"editFile://file://\" + path;\n                    case \"删除文件\": deleteFile(\"file://\" + path); deleteItem(id); return \"toast://已删除\";\n                    case \"分享文件\": return \"share://\" + path;\n                    case \"外部打开\": return \"openFile://file://\" + path;\n                    case \"文件详细\":\n                        try {\n                            var file = new File(path);\n                            return $(\"文件名称：\" + fileUtil.getFileName(path) + \"\\n文件大小：\" + fileUtil.getFormatedFileSize(fileUtil.getFolderSize(file)) + \"\\n最后修改时间：\" + $.dateFormat(file.lastModified(), \"yyyy/MM/dd/hh:mm:ss\")).confirm(function() {});\n                        } catch (e) { return \"toast://权限不足或获取失败\"; }\n                    case \"重命名\":\n                        var oldName = fileUtil.getFileName(path);\n                        return $(oldName, \"输入新的名字\").input(function(path, id, oldName, configs) {\n                            if (input.trim() === \"\" || oldName === input) return \"toast://请输入新名字\";\n                            var code = $.require(\"function\").fileSelect;\n                            try {\n                                var topath;\n                                if (!(topath = code.getFileUtil().renameFile(path, input))) return \"toast://重命名失败\";\n                                var extra = findItem(id).extra;\n                                extra.type = \".\" + com.example.hikerview.utils.FileUtil.getFileSuffix(input);\n                                extra.path = topath;\n                                updateItem({ title: input, pic_url: code.getIconPath().getIconPath(extra.path, extra.type), extra: extra });\n                                return \"toast://改名完成\";\n                            } catch (e) { return \"toast://\" + e.toString(); }\n                        }, path, id, oldName, configs);\n                }\n            }\n            if (menuType) return menu(click, configs, isBack, id, menuType);\n            return click(configs, isBack, id);\n        }\n\n        function findFile(baseDir, findFunc, callback, depth) {\n            depth = depth || 0;\n            if (!baseDir.exists() || !baseDir.isDirectory() || depth > 5) return;\n            var files = baseDir.listFiles();\n            if (files == null) return;\n            for (var i = 0; i < files.length; i++) {\n                var file = files[i];\n                var isDirectory = file.isDirectory();\n                if (findFunc(String(file.getName()))) callback(file, isDirectory);\n                if (isDirectory) findFile(file, findFunc, callback, depth + 1);\n            }\n        }\n\n        function labels(path, configs, count) {\n            var load = $.require(\"function\").fileSelect.init().loadFile;\n            var lastCount = findItem(configs.uid + \"#变量\").extra.count || count;\n            var del = [];\n            for (var i = count + 1; i <= lastCount; i++) del.push(configs.uid + \"#路径\" + i);\n            if (del.length > 0) deleteItem(del);\n            java.lang.Thread.sleep(50);\n            load(path, configs, true);\n            return \"hiker://empty\";\n        }\n\n        function loadTag(pathT, configs) {\n            var targetPath, datumPath;\n            if (configs === undefined) {\n                configs = pathT;\n                targetPath = configs.initialPath;\n                datumPath = configs.rootDirPath;\n            } else {\n                targetPath = pathT;\n                datumPath = findItem(configs.uid + \"#变量\").extra.currentPath;\n            }\n            targetPath = Paths.get(targetPath);\n            datumPath = Paths.get(datumPath);\n            var targetCount = targetPath.getNameCount();\n            var datumCount = datumPath.getNameCount();\n            var tempPath = datumPath;\n            if (targetCount >= datumCount) {\n                for (var i = datumCount; i > 0 && i < targetCount; i++) {\n                    tempPath = tempPath.resolve(targetPath.getName(i));\n                    addItemAfter(configs.uid + \"#路径\" + (i - 1), {\n                        title: tempPath.getFileName() + \" >\",\n                        col_type: \"scroll_button\",\n                        url: $(\"#noLoading#\").lazyRule(labels, tempPath.toString(), configs, i),\n                        extra: { id: configs.uid + \"#路径\" + i }\n                    });\n                }\n            } else {\n                var del = [];\n                for (var i = targetCount; i > 0 && i < datumCount; i++) del.push(configs.uid + \"#路径\" + i);\n                deleteItem(del);\n            }\n            return targetPath;\n        }\n\n        exports.loadFile = function(path, configs, noTag) {\n            var dirPath;\n            if (noTag) {\n                dirPath = Paths.get(path);\n            } else if (configs === undefined) {\n                configs = path;\n                dirPath = loadTag(configs);\n            } else {\n                dirPath = loadTag(path, configs);\n            }\n            updateItem(configs.uid + \"#Bottom\", { col_type: \"blank_block\" });\n            deleteItemByCls(configs.uid + \".文件(夹)\");\n            var files;\n            try { files = new File(dirPath).listFiles(); } catch (e) { toast(\"出错了\"); return; }\n            if (files == null) { toast(\"权限不足或获取失败\"); return; }\n            var values = findItem(configs.uid + \"#排序变量\") || { title: \"系统\", desc: \"P\" };\n            var rankMethod = values.title, rankOrder = values.desc;\n            files = $this.getRank()(files, rankMethod, rankOrder);\n            var wjj = [], wj = [];\n            var itemCls = $this.getId(4), itemId = $this.getId(5);\n            var targetType = new RegExp(\"(\" + configs.fileType + \")$\");\n            var tips = configs.onClickType === \"confirm\" ? configs.cHomeTips : \"#noLoading#\";\n            var iki = 0;\n            var colType;\n            try { colType = findItem(configs.uid + \"#样式\").extra.colType; } catch (e) { colType = \"avatar\"; }\n            var vv = findItem(configs.uid + \"#变量\").extra;\n            updateItem({ extra: Object.assign(vv, { id: configs.uid + \"#变量\", count: dirPath.getNameCount(), currentPath: dirPath.toString(), itemCls: itemCls }) });\n            files.forEach(function(dirPath) {\n                var name = String(dirPath.getName());\n                var fpath = String(dirPath.toString());\n                var id = fpath || itemId + iki++;\n                if (dirPath.isDirectory()) {\n                    wjj.push({\n                        title: name,\n                        url: $(\"#noLoading#\").lazyRule(refreshDir, fpath, configs),\n                        pic_url: dirIcon,\n                        col_type: colType,\n                        extra: {\n                            id: id, path: fpath,\n                            cls: configs.uid + \".文件(夹) \" + itemCls,\n                            longClick: [\n                                { title: \"复制路径\", js: $.toString(choose, configs, false, id, \"复制路径\") },\n                                { title: \"重命名\", js: $.toString(choose, configs, false, id, \"重命名\") },\n                                { title: \"文件详细\", js: $.toString(choose, configs, false, id, \"文件详细\") }\n                            ]\n                        }\n                    });\n                } else if (configs.pattern === 0) {\n                    var type = getExtension(name);\n                    if (configs.fileType && !targetType.test(type)) return;\n                    var pic_url = iconGetter(fpath, type);\n                    wj.push({\n                        title: name,\n                        url: $(tips.replace(\"${name}\", name).replace(\"${path}\", fpath))[configs.onClickType](choose, configs, false, id),\n                        pic_url: pic_url,\n                        col_type: colType,\n                        extra: {\n                            cls: configs.uid + \".文件(夹) \" + itemCls,\n                            id: id, path: fpath, type: type,\n                            longClick: [\n                                { title: \"复制路径\", js: $.toString(choose, configs, false, id, \"复制路径\") },\n                                { title: \"编辑文件\", js: $.toString(choose, configs, false, id, \"编辑文件\") },\n                                { title: \"重命名\", js: $.toString(choose, configs, false, id, \"重命名\") },\n                                { title: \"分享文件\", js: $.toString(choose, configs, false, id, \"分享文件\") },\n                                { title: \"文件详细\", js: $.toString(choose, configs, false, id, \"文件详细\") },\n                                { title: \"外部打开\", js: $.toString(choose, configs, false, id, \"外部打开\") },\n                                { title: \"删除文件\", js: $.toString(choose, configs, false, id, \"删除文件\") }\n                            ]\n                        }\n                    });\n                }\n            });\n            var fa = wjj.length > 0, fb = wj.length > 0;\n            java.lang.Thread.sleep(40);\n            if (fa) addItemAfter(configs.uid + \"#文件夹\", wjj);\n            if (fb) addItemAfter(configs.uid + \"#文件\", wj);\n            java.lang.Thread.sleep(65);\n            if (wjj.length > 10 || wj.length > 10 || wjj.length + wj.length > 10) {\n                updateItem(configs.uid + \"#Bottom\", { title: \"““””<small><font color='gray'>到底了哦</font></small>\", col_type: \"text_center_1\" });\n            } else if (!(fa || fb)) {\n                updateItem(configs.uid + \"#Bottom\", { title: \"““””<small><font color='gray'>什么都没有呢</font></small>\", col_type: \"text_center_1\" });\n            }\n        };\n\n        exports.loadSearch = function(key, configs) {\n            deleteItemByCls(configs.uid + \".搜索-文件夹\");\n            deleteItemByCls(configs.uid + \".搜索-文件\");\n            if (key == \"\") return;\n            var path = findItem(configs.uid + \"#变量\").extra.currentPath;\n            var targetType = new RegExp(\"(\" + configs.fileType + \")$\");\n            var wjj = [], wj = [];\n            var tips = configs.onClickType === \"confirm\" ? configs.cSearchTips : \"#noLoading#\";\n            var itemId = $this.getId(7);\n            var iki = 0;\n            var colType = findItem(configs.uid + \"#样式\").extra.colType;\n            var findFunc;\n            if (configs.isRegular) {\n                var keyReg = new RegExp(key);\n                findFunc = function(name) { return keyReg.test(name); };\n            } else {\n                findFunc = function(name) { return name.indexOf(key) !== -1; };\n            }\n            findFile(new File(path), findFunc, function(file, isDirectory) {\n                var name = String(file.getName());\n                var fpath = String(file.getPath());\n                if (isDirectory) {\n                    wjj.push({\n                        title: name,\n                        url: $(\"#noLoading#\").lazyRule(refreshDir, fpath, configs, true),\n                        pic_url: dirIcon,\n                        col_type: colType,\n                        extra: { cls: configs.uid + \".搜索-文件夹\" }\n                    });\n                } else if (configs.pattern === 0) {\n                    var type = getExtension(name);\n                    if (configs.fileType && !targetType.test(type)) return;\n                    var id = fpath || itemId + iki++;\n                    var pic_url = iconGetter(fpath, type);\n                    wj.push({\n                        title: name,\n                        url: $(tips.replace(\"${name}\", name).replace(\"${path}\", fpath))[configs.onClickType](choose, configs, true, id),\n                        pic_url: pic_url,\n                        col_type: colType,\n                        extra: { cls: configs.uid + \".搜索-文件\", id: id, path: fpath, type: type }\n                    });\n                }\n            });\n            Thread.sleep(50);\n            if (wjj.length > 0) addItemAfter(configs.uid + \"#搜索-文件夹\", wjj);\n            if (wj.length > 0) addItemAfter(configs.uid + \"#搜索-文件\", wj);\n        };\n\n        return exports;\n    }\n\n    function fileSelectionUri(configs) {\n        var url = \"hiker://empty#noRefresh##noRecordHistory##noHistory#\";\n        return $(url).rule(function(configs) {\n            $.require(\"function\").fileSelect.fileSelection(configs);\n        }, configs);\n    }\n\n    function fileSelection(MYPARAMS, d) {\n        var Paths = java.nio.file.Paths;\n        var Thread = java.lang.Thread;\n        var load = init().loadFile;\n\n        var configs = Object.assign({\n            callback: \"\",\n            fileType: \"\",\n            pattern: 0,\n            onClickType: \"lazyRule\",\n            cHomeTips: \"确认选择[${name}]\",\n            cSearchTips: \"确认选择[${path}]\",\n            initialPath: getPath(\"hiker://files/\").slice(7),\n            rootDirPath: getPath(\"hiker://files/\").slice(7)\n        }, MYPARAMS);\n        configs.initialPath = configs.initialPath || configs.rootDirPath;\n\n        if (![\"lazyRule\", \"confirm\"].includes(configs.onClickType)) throw new Error(\"错误的onClickType\");\n        configs.uid = getId(6);\n\n        var colTypes = [\"avatar\", \"icon_2\", \"icon_2_round\", \"icon_4\", \"icon_4_card\", \"icon_small_4\", \"icon_round_4\", \"icon_round_small_4\", \"icon_5\"];\n        var dirPath = Paths.get(configs.rootDirPath);\n        var file = dirPath.toFile();\n        if (!file.exists() || !file.isDirectory()) {\n            back(false);\n            toast(\"root:不存在该文件夹[\" + file.getName() + \"]\");\n            return;\n        }\n        var count = Number(dirPath.getNameCount());\n        var dirPathInit = Paths.get(configs.initialPath);\n        var fileInit = dirPathInit.toFile();\n        if (!fileInit.exists() || !fileInit.isDirectory()) {\n            toast(\"init:不存在该文件夹[\" + fileInit.getName() + \"]\");\n            configs.initialPath = configs.rootDirPath;\n        }\n        var countInit = Number(dirPathInit.getNameCount());\n        if (countInit < count) {\n            back(false);\n            toast(\"init:count<root:count\");\n            return;\n        }\n        var data = d || [];\n        data.push({\n            col_type: \"blank_block\",\n            extra: { id: configs.uid + \"#变量\", count: countInit, currentPath: configs.initialPath }\n        });\n\n        data.push({\n            title: \"搜索\",\n            url: $.toString(function(configs) {\n                input = input.trim();\n                if (input) {\n                    if (input.startsWith(\"/\") || input.startsWith(\"hiker://files/\")) {\n                        var path = input.replace(\"hiker://files/\", getPath(\"hiker://files/\").slice(7));\n                        if (!fileExist(\"file://\" + path)) return \"toast://该文件(夹)不存在\";\n                        var load = $.require(\"function\").fileSelect.init().loadFile;\n                        load(path, configs, false);\n                        return \"hiker://empty\";\n                    }\n                    var isRegular = findItem(configs.uid + \"#正则\").extra.isRegular || false;\n                    return $(\"hiker://empty#noRefresh##noRecordHistory##noHistory##fullTheme#\").rule(function(configs, key, isRegular) {\n                        configs.isRegular = isRegular;\n                        $.require(\"function\").fileSelect.search(configs, key);\n                    }, configs, input, isRegular);\n                }\n            }, configs),\n            desc: \"请输入文件名或文件路径\",\n            col_type: \"input\",\n            extra: { id: configs.uid + \"#搜索框1\", onChange: $.toString(function(uid) {\n                if (getMyVar(uid + \":back\", \"\") === \"true\") {\n                    clearMyVar(uid + \":back\");\n                    back(false);\n                }\n            }, configs.uid), configs: configs }\n        });\n\n        if (configs.pattern === 1) {\n            data.push({\n                title: \"''选择此文件夹''\",\n                url: $(\"#noLoading#\").lazyRule(function(callback, uid) {\n                    var v = findItem(uid + \"#变量\").extra;\n                    var path = v.currentPath;\n                    var cls = v.itemCls;\n                    var callbackFunc = new Function(\"PATH\", \"CLS\", \"return \" + callback);\n                    $.hiker.input = path;\n                    var callbackResult = callbackFunc(path, cls);\n                    if (callbackResult === true) { back(false); return \"hiker://empty\"; }\n                    if (callbackResult === false) return \"hiker://empty\";\n                    return callbackResult;\n                }, configs.callback, configs.uid),\n                col_type: \"text_2\"\n            });\n        }\n\n        var rankMethods = [\"系统\", \"大小\", \"名称\", \"时间\"];\n        var rankMethod = \"系统\", rankOrder = \"P\";\n        for (var mi = 0; mi < rankMethods.length; mi++) {\n            var mname = rankMethods[mi];\n            var a = rankMethod === mname;\n            var titlea = a ? \"''\" + mname + \"''\" : mname;\n            var titleb = a ? (rankOrder === \"P\" ? \"↓\" : \"↑\") : \"↕\";\n            data.push({\n                title: titlea + titleb,\n                col_type: \"flex_button\",\n                url: $(\"#noLoading#\").lazyRule(function(mname, configs) {\n                    var uid = configs.uid;\n                    var values = findItem(uid + \"#排序变量\");\n                    var rankMethod = values.title, rankOrder = values.desc;\n                    var id = uid + \"#rank:\" + mname;\n                    if (rankMethod === mname) {\n                        updateItem(id, { title: \"''\" + mname + \"''\" + (rankOrder !== \"P\" ? \"↓\" : \"↑\") });\n                        updateItem(uid + \"#排序变量\", { desc: rankOrder !== \"P\" ? \"P\" : \"I\" });\n                    } else {\n                        updateItem(id, { title: \"''\" + mname + \"''↓\" });\n                        updateItem(uid + \"#rank:\" + rankMethod, { title: rankMethod + \"↕\" });\n                        updateItem(uid + \"#排序变量\", { title: mname, desc: \"P\" });\n                    }\n                    var load = $.require(\"function\").fileSelect.init().loadFile;\n                    var basePath = findItem(configs.uid + \"#变量\").extra.currentPath;\n                    load(basePath, configs);\n                    return \"hiker://empty\";\n                }, mname, configs),\n                extra: { id: configs.uid + \"#rank:\" + mname }\n            });\n        }\n        data.push({ col_type: \"line\", desc: rankOrder, title: rankMethod, extra: { id: configs.uid + \"#排序变量\" } });\n\n        var funcType = \"flex_button\";\n        data.push({\n            title: \"🔍正则◎\",\n            col_type: funcType,\n            url: $(\"#noLoading#\").lazyRule(function(uid) {\n                var v = !!findItem(uid + \"#正则\").extra.isRegular;\n                updateItem({ title: \"🔍正则\" + [\"●\", \"◎\"][Number(v)], extra: { id: uid + \"#正则\", isRegular: !v } });\n                return \"hiker://empty\";\n            }, configs.uid),\n            extra: { id: configs.uid + \"#正则\", isRegular: false }\n        }, {\n            title: \"🧩\" + colTypes[0],\n            col_type: funcType,\n            url: $(colTypes, 2, \"选择-显示样式\").select(function(configs) {\n                updateItem({ title: \"🧩\" + input, extra: { id: configs.uid + \"#样式\", colType: input } });\n                var load = $.require(\"function\").fileSelect.init().loadFile;\n                var path = findItem(configs.uid + \"#变量\").extra.currentPath;\n                load(path, configs, true);\n            }, configs),\n            extra: { id: configs.uid + \"#样式\", colType: colTypes[0] }\n        });\n\n        data.push({ title: \"🗂初始\", col_type: funcType, url: $(\"#noLoading#\").lazyRule(function(configs, firstInitialPath) {\n            var load = $.require(\"function\").fileSelect.init().loadFile;\n            load(firstInitialPath, configs);\n            return \"hiker://empty\";\n        }, configs, configs.initialPath) });\n\n        data.push({ col_type: \"blank_block\" });\n        data.push({\n            title: \"🏠 ''\" + dirPath.getFileName() + \"'' >\",\n            col_type: \"scroll_button\",\n            url: $(\"#noLoading#\").lazyRule(function(configs, count) {\n                var load = $.require(\"function\").fileSelect.init().loadFile;\n                var lastCount = findItem(configs.uid + \"#变量\").extra.count || count;\n                var del = [];\n                for (var i = count; i <= lastCount; i++) del.push(configs.uid + \"#路径\" + i);\n                if (del.length > 0) deleteItem(del);\n                load(\"\" + configs.rootDirPath, configs, true);\n                return \"hiker://empty\";\n            }, configs, count),\n            extra: { id: configs.uid + \"#路径\" + (count - 1) }\n        });\n\n        data.push({ col_type: \"line_blank\", extra: { id: configs.uid + \"#文件夹\" } });\n        data.push({ col_type: \"blank_block\" });\n        data.push({ col_type: \"blank_block\" });\n        data.push({ col_type: \"line_blank\", extra: { id: configs.uid + \"#文件\" } });\n        data.push({ col_type: \"blank_block\" });\n        data.push({ col_type: \"blank_block\" });\n        data.push({ col_type: \"line_blank\" });\n        data.push({ col_type: \"blank_block\", url: \"hiker://empty\", extra: { id: configs.uid + \"#Bottom\", lineVisible: false } });\n\n        setResult(data);\n        try { Thread.sleep(50); load(configs); } catch (e) {}\n    }\n\n    function search(configs, key) {\n        var data = [];\n        var basePath = findItem(configs.uid + \"#变量\").extra.currentPath;\n        data.push({\n            title: \"❌\",\n            desc: \"搜索\",\n            url: \"back(false);\",\n            col_type: \"input\",\n            extra: {\n                defaultValue: key,\n                onChange: $.toString(function(configs) {\n                    try {\n                        var value1 = findItem(configs.uid + \